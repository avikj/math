; check.ctt — the type checker as a term (paper 5.26). Its input is the code of a term in which
; every node carries the term's value: the machine computed it from the compiled subterm, once,
; with each node's value built from its parts' values. A binder's code is a function: a term
; binder takes a variable's value and type, a dimension binder a dimension, and gives the code
; of the body; instantiating a binder is applying it. A variable's node carries its value and
; type, so there is no context: a fresh variable is (%var n T), a fresh dimension (%dim n) (n its
; source name, a word), each
; made once where it is introduced. A system's branches are thunks of their codes; under a
; clause the checker restricts the thunk and forces it, so a branch is computed under its face.
; The checker reads values through %view, which gives a value's head as data whose fields are
; the value's parts: application, projection, composition, Glue, transport and the endpoints of
; a path variable are the machine's own steps. Checked definitions, their types and the data
; types are reached through the tables %gval, %gty, %dtab and %dent (words index them).

; ---------------------------------------------------------------- codes
(data Tm
  (tv x T) (ti i) (tg n V)
  (tlam nm b V) (tapp f a V) (tpair a b V) (tfst p V) (tsnd p V)
  (tpi A nm b V) (tsigma A nm b V) (tuniv l V) (tpathp A a b V) (tplam nm b V) (tpapp p r V)
  (tc0) (tc1) (tneg r V) (tmeet r s V) (tjoin r s V)
  (teq0 r V) (teq1 r V) (tfand a b V) (tfor a b V) (ttt) (tff) (tforall nm b V)
  (tsys bs V) (tcomp A u a V) (tgluet A S V) (tglue S a V) (tunglue S b V)
  (tlet t nm b V) (tann t T V)
  ; a data type at its parameters; a constructor at its fields and dimensions; elimination
  ; with a motive, and without (F: the elimination as a function); formal hcomp
  (tdata d ps V) (tcon d c fs ds V) (telim d P B x F V) (tcase d B x F V) (thcomp u a V) (tforce t V)
  (tlevel) (tlzero) (tlsuc l V) (tlmax a b V)
  ; words: the type, a literal, the successor, an operation (0 = 1 < 2 + 3 max 4 -), the
  ; elimination with its motive
  (tword) (tlit V) (twsucc a V) (twop k a b V) (twelim P w z s V))
; a branch of an elimination: binders for its fields, hypotheses, dimensions, then the body
(data Br (bx nm b) (bi nm b) (be t))
; a telescope: a term binder over a type, a dimension binder, the end
(data Tel (tx A nm r) (ty nm r) (tz e))
(def tval (lam c (case c
  ((tv x T) x) ((ti i) i) ((tg n V) V)
  ((tlam nm b V) V) ((tapp f a V) V) ((tpair a b V) V) ((tfst p V) V) ((tsnd p V) V)
  ((tpi A nm b V) V) ((tsigma A nm b V) V) ((tuniv l V) V) ((tpathp A a b V) V) ((tplam nm b V) V) ((tpapp p r V) V)
  ((tc0) 0) ((tc1) 1) ((tneg r V) V) ((tmeet r s V) V) ((tjoin r s V) V)
  ((teq0 r V) V) ((teq1 r V) V) ((tfand a b V) V) ((tfor a b V) V) ((ttt) tt) ((tff) ff) ((tforall nm b V) V)
  ((tsys bs V) V) ((tcomp A u a V) V) ((tgluet A S V) V) ((tglue S a V) V) ((tunglue S b V) V)
  ((tlet t nm b V) V) ((tann t T V) V)
  ((tdata d ps V) V) ((tcon d c fs ds V) V) ((telim d P B x F V) V) ((tcase d B x F V) V) ((thcomp u a V) V) ((tforce t V) V)
  ((tlevel) Level) ((tlzero) lzero) ((tlsuc l V) V) ((tlmax a b V) V)
  ((tword) Word) ((tlit V) V) ((twsucc a V) V) ((twop k a b V) V) ((twelim P w z s V) V))))

; ---------------------------------------------------------------- basics
; Lst, Opt, View, CloCmp and DTab are declared in code.ctt
(def andb (lam a b (if a b false)))
(def orb (lam a b (if a true b)))
(def notb (lam a (if a false true)))
(def wle (lam a b (notb (%wlt b a))))
(def isnil (lam l (case l ((lnil) true) (_ false))))
(def lapp (lam l m (case l ((lnil) m) ((lcons x xs) (lcons x (lapp xs m))))))
(def lmap (lam f l (case l ((lnil) lnil) ((lcons x xs) (lcons (f x) (lmap f xs))))))
(def lany (lam p l (case l ((lnil) false) ((lcons x xs) (if (p x) true (lany p xs))))))
(def lall (lam p l (case l ((lnil) true) ((lcons x xs) (if (p x) (lall p xs) false)))))
(def lconcatmap (lam f l (case l ((lnil) lnil) ((lcons x xs) (lapp (f x) (lconcatmap f xs))))))
(def lnth (lam l n (case l
  ((lnil) none)
  ((lcons x xs) (if (%weq n #0) (some x) (lnth xs (%wsub n #1)))))))
(def lsnoc (lam l x (lapp l (lcons x lnil))))
; all pairs of distinct positions i < j
(def lpairs (lam l (case l
  ((lnil) lnil)
  ((lcons x xs) (lapp (lmap (lam y (pair x y)) xs) (lpairs xs))))))
(def fromopt (lam o d (case o ((none) d) ((some x) x))))
(def lall2 (lam p xs ys (case xs ((lnil) (isnil ys)) ((lcons x r) (case ys ((lnil) false) ((lcons y q) (andb (p x y) (lall2 p r q))))))))
(def single (lam x (lcons x lnil)))
(def lhead (lam l (case l ((lcons x r) x) ((lnil) lzero))))
(def ltail (lam l (case l ((lcons x r) r) ((lnil) lnil))))
; a value that equals nothing
(data Opq (opq))

; ---------------------------------------------------------------- intervals and faces
(def check-iv (lam r (case r
  ((ti i) true) ((tc0) true) ((tc1) true)
  ((tneg a V) (check-iv a))
  ((tmeet a b V) (andb (check-iv a) (check-iv b)))
  ((tjoin a b V) (andb (check-iv a) (check-iv b)))
  (_ false))))
(def check-face (lam p (case p
  ((teq0 r V) (check-iv r)) ((teq1 r V) (check-iv r))
  ((tfand a b V) (andb (check-face a) (check-face b)))
  ((tfor a b V) (andb (check-face a) (check-face b)))
  ((ttt) true) ((tff) true)
  ((tforall nm b V) (check-face (b (%dim nm))))
  (_ false))))

; ---------------------------------------------------------------- data types
; (dent telescope level): the parameters' telescope ending in the constructors' telescopes, each
; its fields, its dimensions, ending in its boundary (the code of a system)
(data DEnt (dent tel lvl))
(def dtel (lam de (case de ((dent t l) t))))
(def dlvl (lam de (case de ((dent t l) l))))
; a telescope instantiated at values (a term binder's type is its type's value)
(def tel-inst (lam tel xs (case xs
  ((lnil) tel)
  ((lcons x rest) (case tel
    ((tx A nm r) (tel-inst (r x (tval A)) rest))
    ((ty nm r) (tel-inst (r x) rest))
    ((tz e) tel))))))
(def tel-end (lam tel d (case tel ((tz e) e) (_ d))))
; the constructors' telescopes at the parameters
(def ctors-at (lam d ps (tel-end (tel-inst (dtel (%dent d)) ps) lnil)))
(def centry (lam d c ps (fromopt (lnth (ctors-at d ps) c) (tz (tsys lnil (sys))))))
; the parameters as fresh variables: (pair variables constructors)
(def params-fresh (lam tel pvs (case tel
  ((tx A nm r) (let Av (tval A) (let x (%var nm Av) (params-fresh (r x Av) (lsnoc pvs x)))))
  ((tz e) (pair pvs e))
  (_ (pair pvs lnil)))))
(def is-data-d (lam d c (case c ((tdata d2 ps V) (%weq d d2)) (_ false))))
; the machine's data type and constructor, from the table
(def mkdata (lam d ps (app-all (dt-former (%dtab d)) ps)))
(def mkcon (lam d c fs ds (app-all (cl-at (dt-cons (%dtab d)) c) (lapp fs ds))))

; ---------------------------------------------------------------- levels
; max(c, a1+o1, ...) over level variables a (their names); lvw: the level of types over levels
(data Lvl (lvl c ts) (lvw))
(def lv0 (lvl #0 lnil))
(def Uw (U lomega))
(def lvl-suc (lam l (case l ((lvl c ts) (lvl (%wsucc c) (lmap (lam p (pair (fst p) (%wsucc (snd p)))) ts))) ((lvw) lvw))))
(def lvl-max (lam l m (case l ((lvl c ts) (case m ((lvl d us) (lvl (%wmax c d) (lapp ts us))) ((lvw) lvw))) ((lvw) lvw))))
(declare lvl-of)
; Level's constructors: lzero lsuc lmax lomega
(def lvl-of (lam v (case (%view v)
  ((wcon d c fs ds) (if (%weq c #0) lv0
     (if (%weq c #1) (lvl-suc (lvl-of (lhead fs)))
     (if (%weq c #2) (lvl-max (lvl-of (lhead fs)) (lvl-of (lhead (ltail fs)))) lvw))))
  ((wvar l T) (lvl #0 (single (pair l #0))))
  (_ lv0))))
; max(c, ts) ≤ max(d, us) for every value of the variables iff c ≤ d or c ≤ some offset of us,
; and each a+o of ts has a+o' in us with o ≤ o'
(def lvl-le (lam l m (case l
  ((lvw) (case m ((lvw) true) (_ false)))
  ((lvl c ts) (case m
    ((lvw) true)
    ((lvl d us) (if (orb (wle c d) (lany (lam q (wle c (snd q))) us))
                    (lall (lam p (lany (lam q (andb (%weq (fst p) (fst q)) (wle (snd p) (snd q)))) us)) ts)
                    false)))))))
(def lvl-eq (lam l m (if (lvl-le l m) (lvl-le m l) false)))
(def lvl-closed (lam l (case l ((lvl c ts) (isnil ts)) ((lvw) false))))
(def is-w (lam l (case (lvl-of l) ((lvw) true) (_ false))))

; ---------------------------------------------------------------- conversion
; conv T u v: u = v at type T. At Π, Σ and path types by eliminating both (η), the variable at
; its type; at a universe as types; at Glue by unglue and on the face the fibre; at a data type
; by constructors; otherwise without the type. uconv: without a type, types by their former,
; neutrals by their spine, each argument at its type.
(declare conv uconv convneu conv-data)
; two λs of one record are equal when their environments are: neither is applied
(def env-pairs (lam ps (lall (lam p (uconv (fst p) (snd p))) ps)))
(def conv-ty (lam X Y (uconv X Y)))
(def conv (lam T u v (case (%view T)
  ((wpi A B) (case (%clos u v)
     ((csame ps u2 v2) (if (env-pairs ps) true (let x (%var A) (conv (B x) (u2 x) (v2 x)))))
     ((cdiff u2 v2) (let x (%var A) (conv (B x) (u2 x) (v2 x))))))
  ((wsigma A B) (if (conv A (fst u) (fst v)) (conv (B (fst u)) (snd u) (snd v)) false))
  ((wpath L a b) (let i (%dim) (conv (@ L i) (@ u i) (@ v i))))
  ((wu l) (conv-ty u v))
  ((wlevel) (lvl-eq (lvl-of u) (lvl-of v)))
  ((wglue A S) (if (conv A (unglue S u) (unglue S v))
                  (lall (lam d (conv (%restrict d (Glue A S)) (%restrict d u) (%restrict d v))) (%clauses (faceof S)))
                  false))
  ((wsys bs) (lall (lam b (let d (fst b) (conv (snd b) (%restrict d u) (%restrict d v)))) bs))
  ((wdata d ps) (conv-data d ps u v))
  (_ (uconv u v)))))
; a system against a value: each branch against the value under its clause
(def sys-vs (lam T bs v (lall (lam b (let d (fst b) (conv (%restrict d T) (snd b) (%restrict d v)))) bs)))
; fields along a constructor's telescope
(def conv-fields (lam tel fs gs (case tel
  ((tx A nm r) (case fs ((lnil) true) ((lcons f fr) (case gs ((lnil) false) ((lcons g gr)
     (let Av (tval A) (if (conv Av f g) (conv-fields (r f Av) fr gr) false)))))))
  (_ true))))
(def conv-data-ww (lam d ps u wu wv (case wv
  ((wsys bs) (sys-vs (mkdata d ps) bs u))
  (_ (case wu
    ((wcon d1 c fs ds) (case wv
       ((wcon d2 c2 fs2 ds2) (if (%weq c c2) (if (lall2 (lam r s (%ieq r s)) ds ds2)
          (conv-fields (centry d c ps) fs fs2) false) false))
       (_ false)))
    ((whcomp w a) (case wv
       ((whcomp w2 a2) (let T (mkdata d ps) (if (conv T a a2) (let i (%dim) (conv T (@ w i) (@ w2 i))) false)))
       (_ false)))
    (_ (case (convneu wu wv) ((some X) true) ((none) false))))))))
(def conv-data (lam d ps u v (case (%view u)
  ((wsys bs) (sys-vs (mkdata d ps) bs v))
  (wu (conv-data-ww d ps u wu (%view v))))))
; Glue types: the same face, and on it the same types and equivalences
(def conv-glue-sys (lam A S S2 (if (%feq (faceof S) (faceof S2))
  (lall (lam d (let te (%restrict d S) (let te2 (%restrict d S2)
     (if (conv-ty (fst te) (fst te2)) (conv (Equiv (fst te) (%restrict d A)) (snd te) (snd te2)) false))))
    (%clauses (faceof S)))
  false)))
; two families of types over A
(def conv-fam (lam A B B2 (case (%clos B B2)
  ((csame ps B3 B4) (if (env-pairs ps) true (let x (%var A) (conv-ty (B3 x) (B4 x)))))
  ((cdiff B3 B4) (let x (%var A) (conv-ty (B3 x) (B4 x)))))))
(def uconv-head (lam wu v wv (case wu
  ((wpi A B) (case wv ((wpi A2 B2) (if (conv-ty A A2) (conv-fam A B B2) false)) (_ false)))
  ((wsigma A B) (case wv ((wsigma A2 B2) (if (conv-ty A A2) (conv-fam A B B2) false)) (_ false)))
  ((wu l) (case wv ((wu m) (lvl-eq (lvl-of l) (lvl-of m))) (_ false)))
  ((wlevel) (case wv ((wlevel) true) (_ false)))
  ((wpath L a b) (case wv ((wpath M c d) (let i (%dim)
      (if (conv-ty (@ L i) (@ M i)) (if (conv (@ L 0) a c) (conv (@ L 1) b d) false) false))) (_ false)))
  ((wglue A S) (case wv ((wglue B S2) (if (conv-ty A B) (conv-glue-sys A S S2) false)) (_ false)))
  ((wgluev S a)
     (if (uconv a (unglue S v)) (lall (lam d (uconv (%restrict d (glue S a)) (%restrict d v))) (%clauses (faceof S))) false))
  ((wdata d ps) (case wv ((wdata d2 ps2) (if (%weq d d2) (lall2 uconv ps ps2) false)) (_ false)))
  ((wcon d c fs ds) (case wv ((wcon d2 c2 fs2 ds2)
      (if (%weq d d2) (if (%weq c c2) (if (lall2 (lam r s (%ieq r s)) ds ds2) (lall2 uconv fs fs2) false) false) false)) (_ false)))
  ((whcomp w a) (case wv ((whcomp w2 a2) (if (uconv a a2) (let i (%dim) (uconv (@ w i) (@ w2 i))) false)) (_ false)))
  ((wiv r) (case wv ((wiv s) (%ieq r s)) (_ false)))
  ((wface a) (case wv ((wface b) (%feq a b)) (_ false)))
  ((wword) (case wv ((wword) true) (_ false)))
  ((wwlit n) (case wv ((wwlit m) (%weq n m)) (_ false)))
  ((wwplus k x) (case wv ((wwplus j y) (if (%weq k j) (uconv x y) false)) (_ false)))
  ((wother) false)
  (_ (case (convneu wu wv) ((some X) true) ((none) false))))))
(def uconv-ww (lam u wu v wv (case wv
  ((wsys bs) (lall (lam b (let d (fst b) (uconv (%restrict d u) (snd b)))) bs))
  ((wlam g) (let x (%var Uw) (uconv (u x) (g x))))
  ((wplam q) (let i (%dim) (uconv (@ u i) (@ q i))))
  ((wpair a b) (if (uconv (fst u) a) (uconv (snd u) b) false))
  (_ (uconv-head wu v wv)))))
(def uconv (lam u v (case (%view u)
  ((wsys bs) (lall (lam b (let d (fst b) (uconv (snd b) (%restrict d v)))) bs))
  ((wlam f) (case (%clos f v)
     ((csame ps f2 v2) (if (env-pairs ps) true (let x (%var Uw) (uconv (f2 x) (v2 x)))))
     ((cdiff f2 v2) (let x (%var Uw) (uconv (f2 x) (v2 x))))))
  ((wplam p) (let i (%dim) (uconv (@ p i) (@ v i))))
  ((wpair a b) (if (uconv a (fst v)) (uconv b (snd v)) false))
  (wu (uconv-ww u wu v (%view v))))))
; two eliminations are equal when their branches are: each at fresh fields, hypotheses and
; dimensions (the hypotheses as variables: comparing them compares the eliminations)
(def elim-dims (lam f g c tel prm (case tel
  ((ty nm r) (let i (%dim nm) (elim-dims f g c (r i) (lsnoc prm i))))
  (_ (uconv (%branch f c prm) (%branch g c prm))))))
(def elim-hyps (lam f g c nr tel prm (if (%weq nr #0) (elim-dims f g c tel prm)
  (let h (%var Uw) (elim-hyps f g c (%wsub nr #1) tel (lsnoc prm h))))))
(def elim-fields (lam d f g c tel nr prm (case tel
  ((tx A nm r) (let Av (tval A) (let x (%var nm Av)
     (elim-fields d f g c (r x Av) (if (is-data-d d A) (%wsucc nr) nr) (lsnoc prm x)))))
  (_ (elim-hyps f g c nr tel prm)))))
(def conv-elims (lam d f g cs c (case cs
  ((lnil) true)
  ((lcons tel rest) (if (elim-fields d f g c tel #0 lnil) (conv-elims d f g rest (%wsucc c)) false)))))
; the constructors at the parameters of the scrutinee's type, else at fresh parameters
(def ctors-of (lam d X (case (%view X)
  ((wdata d3 ps) (ctors-at d ps))
  (_ (snd (params-fresh (dtel (%dent d)) lnil))))))
; neutrals: equal spines; the result is their type, computed along the spine from the head
; variable's (only a variable stores one); opq when it is not known
(def same-neu (lam p q (case (convneu (%view p) (%view q)) ((some X) (some opq)) ((none) none))))
(def convneu (lam wu wv (case wu
  ((wvar l T) (case wv ((wvar m T2) (if (%weq l m) (some T) none)) (_ none)))
  ((wapp f a T) (case wv ((wapp g b T2) (case (convneu (%view f) (%view g))
       ((some Tf) (case (%view Tf)
           ((wpi A B) (if (conv A a b) (some (B a)) none))
           (_ (if (uconv a b) (some opq) none))))
       ((none) none))) (_ none)))
  ((wfst p T) (case wv ((wfst q T2) (case (convneu (%view p) (%view q))
       ((some Tp) (case (%view Tp) ((wsigma A B) (some A)) (_ (some opq))))
       ((none) none))) (_ none)))
  ((wsnd p T) (case wv ((wsnd q T2) (case (convneu (%view p) (%view q))
       ((some Tp) (case (%view Tp) ((wsigma A B) (some (B (fst p)))) (_ (some opq))))
       ((none) none))) (_ none)))
  ((wpapp p r T) (case wv ((wpapp q s T2) (if (%ieq r s) (case (convneu (%view p) (%view q))
       ((some Tp) (case (%view Tp) ((wpath L a b) (some (@ L r))) (_ (some opq))))
       ((none) none)) none)) (_ none)))
  ((wcomp A u a0 T) (case wv ((wcomp B w b0 T2) (let i (%dim)
       (if (conv-ty (@ A i) (@ B i))
         (if (conv (@ A 0) a0 b0) (if (conv (@ A i) (@ u i) (@ w i)) (some (@ A 1)) none) none) none))) (_ none)))
  ((wunglue S b T) (case wv ((wunglue S2 c T2) (case (convneu (%view b) (%view c))
       ((some Tb) (case (%view Tb) ((wglue A S3) (some A)) (_ (some opq))))
       ((none) none))) (_ none)))
  ((welim d x f T) (case wv ((welim d2 y g T2) (if (%weq d d2)
       (case (convneu (%view x) (%view y))
         ; one table: equal when their motives and shared variables are, else by branches
         ((some X) (case (%clos f g)
            ((csame ps f2 g2) (if (env-pairs ps) (some T) (if (conv-elims d f2 g2 (ctors-of d X) #0) (some T) none)))
            ((cdiff f2 g2) (if (conv-elims d f2 g2 (ctors-of d X) #0) (some T) none))))
         ((none) none)) none)) (_ none)))
  ((wwop k a b) (case wv ((wwop j c e) (if (%weq k j) (if (uconv a c) (if (uconv b e) (some opq) none) none) none)) (_ none)))
  ((wwelim x z s) (case wv ((wwelim y z2 s2) (if (uconv x y) (if (uconv z z2) (if (uconv s s2) (some opq) none) none) none)) (_ none)))
  ((wtrans d psi ls x T) (case wv ((wtrans d2 psi2 ls2 y T2) (if (%weq d d2) (if (%feq psi psi2)
       (if (lall2 (lam l1 l2 (let i (%dim) (uconv (@ l1 i) (@ l2 i)))) ls ls2)
         (case (same-neu x y) ((some X) (some (mkdata d (lmap (lam l (@ l 1)) ls)))) ((none) none)) none) none) none)) (_ none)))
  (_ none))))

; ---------------------------------------------------------------- typing
; A judgment's normal form is ok (check), (yes T) (infer), or (no v why A B): the subterm whose
; value is v fails for the reason numbered why (named in src/lang.c), A and B the values it
; concerns (the expected and the actual type, the two sides that differ, ...).
(data Res (ok) (yes T) (no v why A B))
(def err (lam c why A B (no (tval c) why A B)))
(def then (lam r k (case r ((ok) k) (_ r))))
(def chk (lam b r (if b ok r)))
(def rall (lam f l (case l ((lnil) ok) ((lcons x xs) (then (f x) (rall f xs))))))
(def is-ok (lam r (case r ((ok) true) ((yes T) true) (_ false))))
; reasons
(def E-mismatch #0) (def E-notfun #1) (def E-notpair #2) (def E-notpath #3) (def E-nottype #4)
(def E-noinfer #5) (def E-notiv #6) (def E-end0 #7) (def E-end1 #8) (def E-sysdis #9) (def E-tube #10)
(def E-tubeface #11) (def E-notface #12) (def E-notsys #13) (def E-params #14) (def E-ctor #15)
(def E-nbranch #16) (def E-boundary #17) (def E-glueface #18) (def E-gluebr #19) (def E-notdata #20)
(def E-motive #21) (def E-notline #22) (def E-omega #23) (def E-positive #24) (def E-later #25)
(def E-openlevel #26) (def E-identity #27) (def E-notglue #28)

(declare infer check check-sys check-tele motive-level check-branches check-hcomp infer-binder case-type)
; a type's universe level (not ω), and a type's sort (a universe, U ω for types over levels)
(def infer-level (lam A (case (infer A)
  ((yes T) (case (%view T) ((wu l) (if (is-w l) (err A E-omega T opq) (yes l))) (_ (err A E-nottype T opq))))
  (r r))))
(def infer-sort (lam A (case (infer A)
  ((yes T) (case (%view T) ((wu l) (yes (U l))) (_ (err A E-nottype T opq))))
  (r r))))
(def sort-max (lam s1 s2 (case (%view s1) ((wu l1) (case (%view s2) ((wu l2) (U (lmax l1 l2))) (_ Uw))) (_ Uw))))
; a system's branches: (pair face-code thunk-of-term-code)
(def sys-bs (lam s (case s ((tsys bs V) bs) (_ lnil))))
(def is-sys (lam s (case s ((tsys bs V) true) (_ false))))
(def lfold-or (lam bs (case bs ((lnil) ff) ((lcons b r) (| (tval (fst b)) (lfold-or r))))))
(def sys-face (lam s (lfold-or (sys-bs s))))
; a branch's code under a clause
(def br-at (lam d b (force (%restrict d (snd b)))))
; a face that does not depend on the dimension i
(def face-indep (lam p i (if (%feq p (%restrict (= i 0) p)) (%feq p (%restrict (= i 1) p)) false)))
; each branch checked under each clause of its face; overlapping branches agree
(def check-sys (lam s T (case s
  ((tsys bs V)
    (then (rall (lam b (if (check-face (fst b))
            (rall (lam d (check (br-at d b) (%restrict d T))) (%clauses (tval (fst b))))
            (err (fst b) E-notface opq opq))) bs)
        (rall (lam bb (let b1 (fst bb) (let b2 (snd bb)
            (rall (lam d (let v1 (tval (br-at d b1)) (let v2 (tval (br-at d b2))
                    (chk (conv (%restrict d T) v1 v2) (no V E-sysdis v1 v2)))))
                  (%clauses (& (tval (fst b1)) (tval (fst b2))))))))
              (lpairs bs))))
  (_ (err s E-notsys opq opq)))))
; a tube over a line of types: Wi its code at the fresh dimension i, Li the line there; at 0 it
; agrees with the cap av
(def tube-ok (lam i Wi L0 Li av (let z (= i 0)
  (if (is-sys Wi)
    (then (check-sys Wi Li)
    (then (chk (face-indep (sys-face Wi) i) (err Wi E-tubeface opq opq))
      (rall (lam b (rall (lam d (let w (tval (br-at d (pair (fst b) (%restrict z (snd b))))) (let a (%restrict d av)
                                  (chk (conv (%restrict d L0) w a) (no w E-tube a w)))))
                         (%clauses (%restrict z (tval (fst b))))))
            (sys-bs Wi))))
    (then (check Wi Li) (let w (%restrict z (tval Wi)) (chk (conv L0 w av) (no w E-tube av w))))))))
; comp A u a: A a line of types, u a line of systems (faces free of the line) or a total line,
; a at 0 agreeing with u at 0; the result is at A 1
(def check-comp (lam c A u a (case A
  ((tplam nX X LV) (let i (%dim nX) (case (infer-level (X i))
    ((yes l) (case u
       ((tplam nW W UV) (let L0 (@ LV 0) (then (check a L0)
          (then (tube-ok i (W i) L0 (@ LV i) (tval a)) (yes (@ LV 1))))))
       (_ (err u E-notline opq opq))))
    (r r))))
  (_ (err A E-notline opq opq)))))
(def infer (lam c (case c
  ((tv x T) (yes T))
  ((tg n V) (yes (%gty n)))
  ((tapp f a V) (case (infer f)
     ((yes T) (case (%view T) ((wpi A B) (then (check a A) (yes (B (tval a))))) (_ (err f E-notfun T opq))))
     (r r)))
  ((tfst p V) (case (infer p) ((yes T) (case (%view T) ((wsigma A B) (yes A)) (_ (err p E-notpair T opq)))) (r r)))
  ((tsnd p V) (case (infer p)
     ((yes T) (case (%view T) ((wsigma A B) (yes (B (fst (tval p))))) (_ (err p E-notpair T opq))))
     (r r)))
  ((tpapp p r V) (case (infer p)
     ((yes T) (case (%view T)
        ((wpath L a b) (if (check-iv r) (yes (@ L (tval r))) (err r E-notiv opq opq)))
        (_ (err p E-notpath T opq))))
     (r2 r2)))
  ((tuniv l V) (then (check l Level) (yes (U (lsuc (tval l))))))
  ((tlevel) (yes Uw))
  ((tlzero) (yes Level))
  ((tlsuc l V) (then (check l Level) (yes Level)))
  ((tlmax a b V) (then (check a Level) (then (check b Level) (yes Level))))
  ((tpi A nm b V) (infer-binder A nm b))
  ((tsigma A nm b V) (infer-binder A nm b))
  ((tpathp A a b V) (case A
     ((tplam nX X LV) (let i (%dim nX) (case (infer-level (X i))
        ((yes l) (then (check a (@ LV 0)) (then (check b (@ LV 1)) (yes (U l)))))
        (r r))))
     ; a line of types given as a term: a path in a universe
     (_ (case (infer A)
          ((yes TA) (case (%view TA)
             ((wpath L T0 T1) (case (%view (@ L (%dim)))
                ((wu l) (let Lv (tval A) (then (check a (@ Lv 0)) (then (check b (@ Lv 1)) (yes (U l))))))
                (_ (err A E-notline TA opq))))
             (_ (err A E-notline TA opq))))
          (r r)))))
  ((tgluet A S V) (case (infer-level A)
     ((yes l) (let Av (tval A) (then (check-sys S (Sigma T (U l) (Equiv T Av))) (yes (U l)))))
     (r r)))
  ((tunglue S b V) (case (infer b) ((yes T) (case (%view T) ((wglue A S2) (yes A)) (_ (err b E-notglue T opq)))) (r r)))
  ((tcomp A u a V) (check-comp c A u a))
  ((tlet t nm b V) (case (infer t) ((yes T) (infer (b (tval t) T))) (r r)))
  ((tann t T V) (case (infer-sort T)
     ((yes s) (let Tv (tval T) (then (check t Tv) (yes Tv))))
     (r r)))
  ((tdata d ps V) (let de (%dent d) (then (check-tele c (dtel de) ps) (yes (U (dlvl de))))))
  ((telim d P B x F V) (case (infer x)
     ((yes T) (case (%view T) ((wdata d2 ps) (if (%weq d d2)
         (case (motive-level (mkdata d ps) P)
           ((yes s) (let Pv (tval P) (then (check-branches c d ps Pv F B) (yes (Pv (tval x))))))
           (r r))
         (err x E-notdata T opq))) (_ (err x E-notdata T opq))))
     (r r)))
  ((thcomp u a V) (case (infer a)
     ((yes T) (case (%view T) ((wdata d ps) (let Tv (mkdata d ps) (then (check-hcomp Tv u a) (yes Tv)))) (_ (err a E-notdata T opq))))
     (r r)))
  ; a case without a motive: the type of a branch without hypotheses, every branch checked at it
  ((tcase d B x F V) (case (infer x)
     ((yes X) (case (%view X) ((wdata d2 ps) (if (%weq d d2)
         (case (case-type d (ctors-at d ps) B)
           ((yes R) (then (check-branches c d ps (lam y R) F B) (yes R)))
           (_ (err c E-noinfer opq opq)))
         (err x E-notdata X opq))) (_ (err x E-notdata X opq))))
     (r r)))
  ((tforce t V) (infer t))
  ((tword) (yes U))
  ((tlit V) (yes Word))
  ((twsucc a V) (then (check a Word) (yes Word)))
  ((twop k a b V) (then (check a Word) (then (check b Word) (yes (if (%wlt k #2) Bool Word)))))
  ; the elimination of a word: P #0 at zero, P n → P (n+1) at a successor
  ((twelim P w z s V) (then (check w Word)
     (case (motive-level Word P)
       ((yes l) (let Pv (tval P)
          (then (check z (Pv #0)) (then (check s (Pi n Word (Pi h (Pv n) (Pv (%wsucc n))))) (yes (Pv (tval w)))))))
       (r r))))
  ; a line: its type is the path of its body's types between its ends
  ((tplam nm b V) (let i (%dim nm) (case (infer (b i))
     ((yes Ti) (yes (PathP (%abs i Ti) (@ V 0) (@ V 1))))
     (r r))))
  (_ (err c E-noinfer opq opq)))))
; the type of a branch's body at fresh fields and dimensions (no hypotheses)
(def br-infer (lam tel b (case tel
  ((tx A nm r) (case b ((bx nm b1) (let Av (tval A) (let x (%var nm Av) (br-infer (r x Av) (b1 x Av))))) (_ none)))
  ((ty nm r) (case b ((bi nm b1) (let i (%dim nm) (br-infer (r i) (b1 i)))) (_ none)))
  ((tz bdy) (case b ((be t) (infer t)) (_ none))))))
(def tel-rec (lam d tel (case tel ((tx A nm r) (orb (is-data-d d A) (tel-rec d (r (%var Uw) Uw)))) (_ false))))
(def case-type (lam d cs Bs (case cs
  ((lnil) none)
  ((lcons tel rest) (case Bs ((lnil) none) ((lcons b br)
     (if (tel-rec d tel) (case-type d rest br) (br-infer tel b))))))))
; parameters against their telescope
(def check-tele (lam c tel ps (case tel
  ((tx A nm r) (case ps ((lnil) (err c E-params opq opq)) ((lcons p pr)
    (let Av (tval A) (then (check p Av) (check-tele c (r (tval p) Av) pr))))))
  ((tz e) (chk (isnil ps) (err c E-params opq opq)))
  (_ (err c E-params opq opq)))))
(def motive-level (lam T P (case P
  ((tlam nm b V) (infer-sort (b (%var nm T) T)))
  (_ (case (infer P)
       ((yes Pt) (case (%view Pt)
          ((wpi A B) (if (conv-ty A T) (case (%view (B (%var A))) ((wu l) (yes (U l))) (_ (err P E-motive Pt T))) (err P E-motive Pt T)))
          (_ (err P E-motive Pt T))))
       (r r))))))
; each branch: binders for its fields, hypotheses (the eliminations of the recursive fields),
; dimensions, then a body of type P (c fields dims), on the boundary's faces equal to the
; elimination of the boundary
(declare check-branch)
(def check-brs (lam e d Pv F cs Bs c (case cs
  ((lnil) (chk (isnil Bs) (err e E-nbranch opq opq)))
  ((lcons tel rest) (case Bs ((lnil) (err e E-nbranch opq opq)) ((lcons b br)
     (then (check-branch e d Pv F c tel b) (check-brs e d Pv F rest br (%wsucc c)))))))))
(def check-branches (lam e d ps Pv F Bs (check-brs e d Pv F (ctors-at d ps) Bs #0)))
(def branch-boundary (lam Pv F t bs (case (%view bs)
  ((wsys bl) (let bodyv (tval t)
     (rall (lam br (let cl (fst br) (let w (snd br) (let v1 (%restrict cl bodyv) (let v2 (%restrict cl (F w))
        (chk (conv (%restrict cl (Pv w)) v1 v2) (no bodyv E-boundary v2 v1))))))) bl)))
  (_ ok))))
(def branch-dims (lam e d Pv F c tel b fs ds (case tel
  ((ty nm r) (case b ((bi nm b1) (let i (%dim nm) (branch-dims e d Pv F c (r i) (b1 i) fs (lsnoc ds i)))) (_ (err e E-ctor opq opq))))
  ((tz bdy) (case b
     ((be t) (then (check t (Pv (mkcon d c fs ds))) (branch-boundary Pv F t (tval bdy))))
     (_ (err e E-ctor opq opq))))
  (_ (err e E-ctor opq opq)))))
(def branch-hyps (lam e d Pv F c tel b fs rs (case rs
  ((lcons f rest) (case b ((bx nm b1) (branch-hyps e d Pv F c tel (b1 (F f) (Pv f)) fs rest)) (_ (err e E-ctor opq opq))))
  ((lnil) (branch-dims e d Pv F c tel b fs lnil)))))
(def branch-fields (lam e d Pv F c tel b fs rs (case tel
  ((tx A nm r) (case b ((bx nm b1) (let Av (tval A) (let x (%var nm Av)
       (branch-fields e d Pv F c (r x Av) (b1 x Av) (lsnoc fs x) (if (is-data-d d A) (lsnoc rs x) rs))))) (_ (err e E-ctor opq opq))))
  (_ (branch-hyps e d Pv F c tel b fs rs)))))
(def check-branch (lam e d Pv F c tel b (branch-fields e d Pv F c tel b lnil lnil)))
; a formal hcomp: a tube of lines in the type, agreeing with the cap at 0
(def check-hcomp (lam T u a (case u
  ((tplam nW W UV) (let i (%dim nW) (tube-ok i (W i) T T (tval a))))
  (_ (err u E-notline opq opq)))))
; a constructor's fields and dimensions along its telescope
(def check-con (lam c tel fs ds (case tel
  ((tx A nm r) (case fs ((lnil) (err c E-ctor opq opq)) ((lcons f fr)
     (let Av (tval A) (then (check f Av) (check-con c (r (tval f) Av) fr ds))))))
  ((ty nm r) (case fs
     ((lcons f fr) (err c E-ctor opq opq))
     ((lnil) (case ds ((lnil) (err c E-ctor opq opq)) ((lcons e er) (if (check-iv e) (check-con c (r (tval e)) lnil er) (err e E-notiv opq opq)))))))
  ((tz b) (chk (andb (isnil fs) (isnil ds)) (err c E-ctor opq opq))))))
(def infer-binder (lam A nm b (case (infer-sort A)
  ((yes s1) (let Av (tval A)
     (case (infer-sort (b (%var nm Av) Av))
       ((yes s2) (yes (sort-max s1 s2)))
       (r r))))
  (r r))))
(def check (lam c T (case c
  ((tlam nm b V) (case (%view T) ((wpi A B) (let x (%var nm A) (check (b x A) (B x)))) (_ (err c E-mismatch T opq))))
  ((tpair a b V) (case (%view T) ((wsigma A B) (then (check a A) (check b (B (tval a))))) (_ (err c E-mismatch T opq))))
  ((tplam nm b V) (case (%view T) ((wpath L a0 a1) (let i (%dim nm)
       (then (check (b i) (@ L i))
         (let v0 (@ V 0) (let v1 (@ V 1)
           (then (chk (conv (@ L 0) v0 a0) (err c E-end0 a0 v0)) (chk (conv (@ L 1) v1 a1) (err c E-end1 a1 v1))))))))
     (_ (err c E-mismatch T opq))))
  ((tglue S a V) (case (%view T) ((wglue A S2)
       (then (check a A)
       (then (chk (%feq (sys-face S) (faceof S2)) (err c E-glueface opq opq))
       (then (check-sys S (Glue A S2))
           (let av (tval a) (rall (lam b (rall (lam d (let w (unglue (%restrict d S2) (tval (br-at d b))) (let x (%restrict d av)
                  (chk (conv (%restrict d A) w x) (err c E-gluebr x w)))))
                (%clauses (tval (fst b))))) (sys-bs S)))))))
     (_ (err c E-mismatch T opq))))
  ((tlet t nm b V) (case (infer t)
     ((yes Ty) (check (b (tval t) Ty) T))
     (r r)))
  ((tcon d c2 fs ds V) (case (%view T) ((wdata d2 ps) (if (%weq d d2) (check-con c (centry d c2 ps) fs ds) (err c E-mismatch T opq))) (_ (err c E-mismatch T opq))))
  ((thcomp u a V) (case (%view T) ((wdata d ps) (let Tv (mkdata d ps) (then (check a Tv) (check-hcomp Tv u a)))) (_ (err c E-mismatch T opq))))
  ((tcase d B x F V) (case (infer x)
     ((yes X) (case (%view X) ((wdata d2 ps) (if (%weq d d2) (check-branches c d ps (lam y T) F B) (err x E-notdata X opq))) (_ (err x E-notdata X opq))))
     (r r)))
  (_ (case (infer c) ((yes T2) (chk (conv-ty T2 T) (err c E-mismatch T T2))) (r r))))))

; a definition: its type is a type, its term has that type
(def chk-def (lam cT ct (case (infer-sort cT)
  ((yes s) (check ct (tval cT)))
  (r r))))
; the type of a checked definition, as the table holds it
(def sig-type (lam cT (tval cT)))

; a data declaration: parameter types are types; each field type a type, strictly positive (D
; itself, at its own parameters, or not mentioning D); each boundary an element of D made of
; earlier constructors, its branches agreeing on overlaps. The table holds the declaration with
; level lzero while it is checked. Walking a code under a binder instantiates the binder.
(declare cany)
(def cany-b (lam p b (cany p (b (%var Uw) Uw))))
(def cany-br (lam p b (case b
  ((bx nm f) (cany-br p (f (%var Uw) Uw)))
  ((bi nm f) (cany-br p (f (%dim))))
  ((be t) (cany p t)))))
(def cany (lam p c (orb (p c) (case c
  ((tlam nm b V) (cany-b p b)) ((tplam nm b V) (cany p (b (%dim)))) ((tforall nm b V) (cany p (b (%dim))))
  ((tfst a V) (cany p a)) ((tsnd a V) (cany p a)) ((tforce a V) (cany p a)) ((tneg a V) (cany p a))
  ((teq0 a V) (cany p a)) ((teq1 a V) (cany p a)) ((tlsuc a V) (cany p a)) ((tuniv a V) (cany p a))
  ((tapp a b V) (orb (cany p a) (cany p b))) ((tpair a b V) (orb (cany p a) (cany p b)))
  ((tpi a nm b V) (orb (cany p a) (cany-b p b))) ((tsigma a nm b V) (orb (cany p a) (cany-b p b)))
  ((tlet a nm b V) (orb (cany p a) (cany-b p b)))
  ((tpapp a b V) (orb (cany p a) (cany p b))) ((tmeet a b V) (orb (cany p a) (cany p b))) ((tjoin a b V) (orb (cany p a) (cany p b)))
  ((tfand a b V) (orb (cany p a) (cany p b))) ((tfor a b V) (orb (cany p a) (cany p b))) ((tlmax a b V) (orb (cany p a) (cany p b)))
  ((tgluet a b V) (orb (cany p a) (cany p b))) ((tglue a b V) (orb (cany p a) (cany p b))) ((tunglue a b V) (orb (cany p a) (cany p b)))
  ((tann a b V) (orb (cany p a) (cany p b))) ((thcomp a b V) (orb (cany p a) (cany p b)))
  ((tpathp a b x V) (orb (cany p a) (orb (cany p b) (cany p x))))
  ((tcomp a b x V) (orb (cany p a) (orb (cany p b) (cany p x))))
  ((tsys bs V) (lany (lam b (orb (cany p (fst b)) (cany p (force (snd b))))) bs))
  ((tdata d ps V) (lany (cany p) ps))
  ((tcon d c fs ds V) (orb (lany (cany p) fs) (lany (cany p) ds)))
  ((telim d P B x F V) (orb (cany p P) (orb (lany (cany-br p) B) (cany p x))))
  ((tcase d B x F V) (orb (lany (cany-br p) B) (cany p x)))
  ((twsucc a V) (cany p a))
  ((twop k a b V) (orb (cany p a) (cany p b)))
  ((twelim P w z s V) (orb (cany p P) (orb (cany p w) (orb (cany p z) (cany p s)))))
  (_ false)))))
; D at its own parameters: each parameter the parameter variable, in order
(def var-name (lam v (case (%view v) ((wvar l T) (some l)) (_ none))))
(def same-var (lam a b (case (var-name a) ((some l) (case (var-name b) ((some m) (%weq l m)) ((none) false))) ((none) false))))
(def uniform-at (lam ps pvs (lall2 (lam p x (case p ((tv y T) (same-var y x)) (_ false))) ps pvs)))
(def positive (lam d pvs A (orb (notb (cany (is-data-d d) A))
  (case A ((tdata d2 ps V) (andb (%weq d2 d) (andb (lall (lam q (notb (cany (is-data-d d) q))) ps) (uniform-at ps pvs)))) (_ false)))))
(def earlier-only (lam d c bdy (notb (cany (lam x (case x ((tcon d2 c2 fs ds V) (andb (%weq d2 d) (notb (%wlt c2 c)))) (_ false))) bdy))))
(def check-ptys (lam tel (case tel
  ((tx A nm r) (case (infer-sort A)
     ((yes s) (let Av (tval A) (check-ptys (r (%var nm Av) Av))))
     (r2 r2)))
  (_ ok))))
(def check-ctor-dims (lam d pvs c tel (case tel
  ((ty nm r) (check-ctor-dims d pvs c (r (%dim nm))))
  ((tz bdy) (then (chk (earlier-only d c bdy) (err bdy E-later opq opq)) (check-sys bdy (mkdata d pvs))))
  (_ ok))))
(def check-ctor-fields (lam d pvs c tel (case tel
  ((tx A nm r) (then (chk (positive d pvs A) (err A E-positive opq opq))
     (case (infer-level A)
       ((yes l) (let Av (tval A) (check-ctor-fields d pvs c (r (%var nm Av) Av))))
       (r2 r2))))
  (_ (check-ctor-dims d pvs c tel)))))
(def check-ctors (lam d pvs cs c (case cs
  ((lnil) ok)
  ((lcons tel rest) (then (check-ctor-fields d pvs c tel) (check-ctors d pvs rest (%wsucc c)))))))
; the level of a data type: the largest of its fields' (a field of type D itself counted at lzero)
(def level-of (lam r (case r ((yes l) l) (_ lzero))))
(def field-levels (lam d tel (case tel
  ((tx A nm r) (let Av (tval A)
     (lcons (if (is-data-d d A) lzero (level-of (infer-level A))) (field-levels d (r (%var nm Av) Av)))))
  (_ lnil))))
(def lfold-lmax (lam xs (case xs ((lnil) lzero) ((lcons x r) (lmax x (lfold-lmax r))))))
(def data-level (lam d tel (lfold-lmax (lconcatmap (field-levels d) (snd (params-fresh tel lnil))))))
(def data-entry (lam d ent (case ent ((dent tel l) (dent tel (data-level d tel))))))
; a data type's level is closed: no field's universe depends on a parameter
(def chk-data (lam d ent (case ent ((dent tel l)
  (let lv (data-level d tel)
  (then (chk (lvl-closed (lvl-of lv)) (no lv E-openlevel opq opq))
  (then (check-ptys tel)
      (let pc (params-fresh tel lnil) (check-ctors d (fst pc) (snd pc) #0)))))))))

; an identity L = R with evidence p (paper 5.27): L and R checked definitions of one type,
; p : Π g1..gn. PathP (λ_. B) (L g) (R g), n the arguments the identity takes
(def id-tele (lam T VL VR n (if (%weq n #0) (PathP (plam i T) VL VR)
  (case (%view T) ((wpi A B) (Pi x A (id-tele (B x) (VL x) (VR x) (%wsub n #1)))) (_ opq)))))
(def id-type (lam gL gR n (if (conv-ty (%gty gL) (%gty gR)) (yes (id-tele (%gty gL) (%gval gL) (%gval gR) n))
  (no (%gval gL) E-identity (%gty gL) (%gty gR)))))
(def id-type-ok (lam gL gR n (case (id-type gL gR n) ((yes T) ok) (r r))))
; evidence a checked definition: its type is the identity's
(def chk-identity-def (lam gL gR n gp (case (id-type gL gR n)
  ((yes T) (chk (conv-ty (%gty gp) T) (no (%gval gp) E-mismatch T (%gty gp))))
  (r r))))
; evidence supplied later: its code checked at the identity's type
(def chk-identity (lam gL gR n ct (case (id-type gL gR n) ((yes T) (check ct T)) (r r))))
; an optimizer (5.26) is a term producing an identity: e : Σ (R : T_L). Π g. L g = R g
(def chk-optimizer (lam gL n ge (let T (Sigma R (%gty gL) (id-tele (%gty gL) (%gval gL) R n))
  (chk (conv-ty (%gty ge) T) (no (%gval ge) E-mismatch T (%gty ge))))))
