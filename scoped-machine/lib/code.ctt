(def cunglue (lam S b (lam h-var h-lam h-app h-pair h-fst h-snd h-pi h-sigma h-univ h-pathp h-plam h-papp h-pappe h-i0 h-i1 h-neg h-meet h-join h-eq0 h-eq1 h-fand h-for h-ftt h-fff h-forall h-faceof h-sys0 h-sysc h-sysmap h-comp h-gluet h-glue h-unglue h-let (h-unglue S b))))
(def clet (lam t b (lam h-var h-lam h-app h-pair h-fst h-snd h-pi h-sigma h-univ h-pathp h-plam h-papp h-pappe h-i0 h-i1 h-neg h-meet h-join h-eq0 h-eq1 h-fand h-for h-ftt h-fff h-forall h-faceof h-sys0 h-sysc h-sysmap h-comp h-gluet h-glue h-unglue h-let (h-let t b))))

(def eval (lam c e (c
    (lam n (fst (n (lam p (snd p)) e)))
    (lam b (lam x (eval b (pair x e))))
    (lam f a ((eval f e) (eval a e)))
    (lam a b (pair (eval a e) (eval b e)))
    (lam p (fst (eval p e)))
    (lam p (snd (eval p e)))
    (lam A B (Pi x (eval A e) (eval B (pair x e))))
    (lam A B (Sigma x (eval A e) (eval B (pair x e))))
    U
    (lam A a b (PathP (eval A e) (eval a e) (eval b e)))
    (lam b (plam i (eval b (pair i e))))
    (lam p r (@ (eval p e) (eval r e)))
    (lam p r a b (@ (eval p e) (eval r e) (eval a e) (eval b e)))
    0
    1
    (lam r (~ (eval r e)))
    (lam r s (/\ (eval r e) (eval s e)))
    (lam r s (\/ (eval r e) (eval s e)))
    (lam r (= (eval r e) 0))
    (lam r (= (eval r e) 1))
    (lam a b (& (eval a e) (eval b e)))
    (lam a b (| (eval a e) (eval b e)))
    tt
    ff
    (lam b (forall i (eval b (pair i e))))
    (lam s (faceof (eval s e)))
    (sys)
    (lam f t r (sys+ (eval f e) (eval t e) (eval r e)))
    (lam f s (sysmap (eval f e) (eval s e)))
    (lam A u a (comp (eval A e) (eval u e) (eval a e)))
    (lam A S (Glue (eval A e) (eval S e)))
    (lam S a (glue (eval S e) (eval a e)))
    (lam S b (unglue (eval S e) (eval b e)))
    (lam t b (let x (eval t e) (eval b (pair x e)))))))

; indices
(def v0 (cvar zero))
(def v1 (cvar (suc zero)))
(def v2 (cvar (suc (suc zero))))
(def v3 (cvar (suc (suc (suc zero)))))
