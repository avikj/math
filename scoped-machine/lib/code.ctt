; code.ctt — codes of terms as data, and the evaluator as a term (paper 5.26).
; Variables are de Bruijn indices (words) over one context of term and
; dimension variables; globals are indices (words) into a signature, data types
; and their constructors indices into its data part. (code t) writes the code of
; a source term. eval maps a code to the value the machine gives the term; a
; question about the evaluator is a term.
(data Lst (lnil) (lcons x xs))
(data Opt (none) (some x))
(data Code
  (cvar n) (cglob n) (clam b) (capp f a) (cpair a b) (cfst p) (csnd p)
  (cpi A B) (csigma A B) (cuniv l) (cpathp A a b) (cplam b) (cpapp p r)
  (ci0) (ci1) (cneg r) (cmeet r s) (cjoin r s)
  (ceq0 r) (ceq1 r) (cfand a b) (cfor a b) (cftt) (cfff) (cforall b)
  (csys0) (csysc f t r) (ccomp A u a) (cgluet A S) (cglue S a) (cunglue S b)
  (clet t b) (cann t T)
  ; data types: the type at its parameters; a constructor at its fields and
  ; dimensions; elimination with a motive, and without; formal hcomp; a
  ; branch's dimension binder (a branch binds its fields, then one induction
  ; hypothesis per recursive field, then its dimensions)
  (cdata d ps) (ccon d c fs ds) (celim d P B x) (ccase d B x) (chcomp u a) (cdlam b)
  ; a forced term: an induction hypothesis is a suspended elimination, forced where used
  (cforce t)
  ; universe levels: the type Level, zero, successor, max; (cuniv l) takes a level
  (clevel) (clzero) (clsuc l) (clmax a b))
; a value's head as data (%view, src/net.c): its parts are the value's own parts, values;
; data types, constructors and variables by words
(data View
  (wlam f) (wpair a b) (wpi A B) (wsigma A B) (wu l) (wpath A a b) (wplam p) (wiv r) (wface a)
  (wsys bs) (wglue A S) (wgluev S a) (wdata d ps) (wcon d c fs ds) (whcomp u a)
  ; neutrals, each with its type
  (wvar l T) (wapp f a T) (wfst p T) (wsnd p T) (wpapp p r T) (wcomp A u a0 T) (wunglue S b T)
  (welim d x f T) (wtrans d psi ls x T)
  (wlevel) (wother)
  ; words: the type, a literal, k successors of a neutral, an operation (0 = 1 < 2 + 3 max 4 -)
  ; stuck on a neutral, the elimination of a neutral
  (wword) (wwlit n) (wwplus k x) (wwop k a b) (wwelim x z s)
  ; an unsolved metavariable (a hole the checker solves); args unused (applications view as wapp)
  (wmeta k args))
; two λs of one record (%clos): the pairs of (copies of) their environments, and the λs; else
; both, untouched
(data CloCmp (csame ps f g) (cdiff f g))

(def cl-at (lam l n (case l ((lnil) l) ((lcons x xs) (if (%weq n #0) x (cl-at xs (%wsub n #1)))))))
(def cl-map (lam f l (case l ((lnil) lnil) ((lcons x xs) (lcons (f x) (cl-map f xs))))))
(def cl-app (lam l m (case l ((lnil) m) ((lcons x xs) (lcons x (cl-app xs m))))))
(def app-all (lam f xs (case xs ((lnil) f) ((lcons x r) (app-all (f x) r)))))
; the machine's data types, for the evaluator: (dtab former constructors elim case)
(data DTab (dtab former cons el cs))
(def dt-former (lam t (case t ((dtab f c e s) f))))
(def dt-cons (lam t (case t ((dtab f c e s) c))))
(def dt-elim (lam t (case t ((dtab f c e s) e))))
(def dt-case (lam t (case t ((dtab f c e s) s))))
; eval-g e c: the value of code c, e the values of its variables (a list); checked definitions
; and data types are read from the checker's tables (%gval, %dtab)
(def eval-g (lam e c (case c
  ((cvar n) (cl-at e n))
  ((cglob n) (%gval n))
  ((clam b) (lam x (eval-g (lcons x e) b)))
  ((capp f a) ((eval-g e f) (eval-g e a)))
  ((cpair a b) (pair (eval-g e a) (eval-g e b)))
  ((cfst p) (fst (eval-g e p)))
  ((csnd p) (snd (eval-g e p)))
  ((cpi A B) (Pi x (eval-g e A) (eval-g (lcons x e) B)))
  ((csigma A B) (Sigma x (eval-g e A) (eval-g (lcons x e) B)))
  ((cuniv l) (U (eval-g e l)))
  ((cpathp A a b) (PathP (eval-g e A) (eval-g e a) (eval-g e b)))
  ((cplam b) (plam i (eval-g (lcons i e) b)))
  ((cpapp p r) (@ (eval-g e p) (eval-g e r)))
  ((ci0) 0)
  ((ci1) 1)
  ((cneg r) (~ (eval-g e r)))
  ((cmeet r s) (/\ (eval-g e r) (eval-g e s)))
  ((cjoin r s) (\/ (eval-g e r) (eval-g e s)))
  ((ceq0 r) (= (eval-g e r) 0))
  ((ceq1 r) (= (eval-g e r) 1))
  ((cfand a b) (& (eval-g e a) (eval-g e b)))
  ((cfor a b) (| (eval-g e a) (eval-g e b)))
  ((cftt) tt)
  ((cfff) ff)
  ((cforall b) (forall i (eval-g (lcons i e) b)))
  ((csys0) (sys))
  ((csysc f t r) (sys+ (eval-g e f) (eval-g e t) (eval-g e r)))
  ((ccomp A u a) (comp (eval-g e A) (eval-g e u) (eval-g e a)))
  ((cgluet A S) (Glue (eval-g e A) (eval-g e S)))
  ((cglue S a) (glue (eval-g e S) (eval-g e a)))
  ((cunglue S b) (unglue (eval-g e S) (eval-g e b)))
  ((clet t b) (let x (eval-g e t) (eval-g (lcons x e) b)))
  ((cann t T) (eval-g e t))
  ((cdata d ps) (app-all (dt-former (%dtab d)) (cl-map (eval-g e) ps)))
  ((ccon d k fs ds) (app-all (cl-at (dt-cons (%dtab d)) k) (cl-app (cl-map (eval-g e) fs) (cl-map (eval-g e) ds))))
  ((celim d P B x) (app-all ((dt-elim (%dtab d)) (eval-g e P)) (cl-app (cl-map (eval-g e) B) (lcons (eval-g e x) lnil))))
  ((ccase d B x) (app-all (dt-case (%dtab d)) (cl-app (cl-map (eval-g e) B) (lcons (eval-g e x) lnil))))
  ((chcomp u a) (hcompD (eval-g e u) (eval-g e a)))
  ((cdlam b) (lam i (eval-g (lcons i e) b)))
  ((cforce t) (force (eval-g e t)))
  ((clevel) Level)
  ((clzero) lzero)
  ((clsuc l) (lsuc (eval-g e l)))
  ((clmax a b) (lmax (eval-g e a) (eval-g e b))))))
(def eval eval-g)
