(def cftt (lam h-var h-lam h-app h-pair h-fst h-snd h-pi h-sigma h-univ h-pathp h-plam h-papp h-pappe h-i0 h-i1 h-neg h-meet h-join h-eq0 h-eq1 h-fand h-for h-ftt h-fff h-forall h-faceof h-sys0 h-sysc h-sysmap h-comp h-gluet h-glue h-unglue h-let (h-ftt)))
