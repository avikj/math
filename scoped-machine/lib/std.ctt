; std.ctt — the checked library: data types, paths, equivalences, univalence,
; natural-number arithmetic. Every definition here is checked by lib/check.ctt.
; Loaded after prelude.ctt, code.ctt and check.ctt.

; ---------------------------------------------------------------- data
(check-data Bool)
(check-data Nat)
(check-data List)
(checked-data (data Empty))
(checked-data (data Unit (unit)))
(checked-data (data (Sum (A U) (B U)) (inl (a A)) (inr (b B))))
(checked-data (data Int (pos (n Nat)) (negsuc (n Nat))))

(checked Neg (Pi A U U) (lam A (Pi a A Empty)))
(checked Empty-rec (Pi ((l Level) (A (U l)) (e Empty)) A) (lam l A e (case e Empty)))

; ---------------------------------------------------------------- paths
(checked refl (Pi l Level (Pi A (U l) (Pi x A (PathP (plam i A) x x)))) (lam l A x (plam i x)))
(checked sym (Pi l Level (Pi A (U l) (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i A) y x))))))
  (lam l A x y p (plam i (@ p (~ i)))))
(checked cong (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi f (Pi a A B)
    (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i B) (f x) (f y))))))))))
  (lam l m A B f x y p (plam i (f (@ p i)))))
(checked funExt (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi f (Pi x A B) (Pi g (Pi x A B)
    (Pi h (Pi x A (PathP (plam i B) (f x) (g x))) (PathP (plam i (Pi x A B)) f g))))))))
  (lam l m A B f g h (plam i (lam x (@ (h x) i)))))
(checked happly (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi f (Pi x A B) (Pi g (Pi x A B)
    (Pi p (PathP (plam i (Pi x A B)) f g) (Pi x A (PathP (plam i B) (f x) (g x))))))))))
  (lam l m A B f g p x (plam i ((@ p i) x))))
; composition of paths, by hcomp
(checked concat (Pi l Level (Pi A (U l) (Pi x A (Pi y A (Pi z A (Pi p (PathP (plam i A) x y) (Pi q (PathP (plam i A) y z)
    (PathP (plam i A) x z))))))))
  (lam l A x y z p q (plam i (comp (plam j A) (plam j (sys ((= i 0) x) ((= i 1) (@ q j)))) (@ p i)))))
(checked transport (Pi l Level (Pi A (U l) (Pi B (U l) (Pi p (PathP (plam i (U l)) A B) (Pi a A B)))))
  (lam l A B p a (comp (plam i (@ p i)) (plam i (sys)) a)))
; transport along refl is the identity, up to a path (there is no regularity)
(checked transportRefl (Pi l Level (Pi A (U l) (Pi a A (PathP (plam i A) (transport l A A (plam i A) a) a))))
  (lam l A a (plam i (comp (plam j A) (plam j (sys ((= i 1) a))) a))))
(checked subst (Pi l Level (Pi m Level (Pi A (U l) (Pi B (Pi a A (U m)) (Pi x A (Pi y A (Pi p (PathP (plam i A) x y)
    (Pi b (B x) (B y)))))))))
  (lam l m A B x y p b (comp (plam i (B (@ p i))) (plam i (sys)) b)))
; a path over a line of types from transport: toPathP
(checked toPathP (Pi l Level (Pi A0 (U l) (Pi A1 (U l) (Pi A (PathP (plam i (U l)) A0 A1) (Pi x A0 (Pi y A1
    (Pi p (PathP (plam i A1) (transport l A0 A1 A x) y) (PathP A x y))))))))
  (lam l A0 A1 A x y p (plam i (comp (plam j (@ A i)) (plam j (sys ((= i 0) x) ((= i 1) (@ p j))))
                                (comp (plam j (@ A (/\ i j))) (plam j (sys ((= i 0) x))) x)))))

; ---------------------------------------------------------------- contractibility, equivalences
(checked isContr (Pi l Level (Pi A (U l) (U l))) (lam l A (Sigma c A (Pi x A (PathP (plam i A) c x)))))
(checked isProp (Pi l Level (Pi A (U l) (U l))) (lam l A (Pi a A (Pi b A (PathP (plam i A) a b)))))
(checked fiber (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi f (Pi x A B) (Pi y B (U (lmax l m))))))))
  (lam l m A B f y (Sigma x A (PathP (plam i B) (f x) y))))
(checked isEquiv (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi f (Pi x A B) (U (lmax l m)))))))
  (lam l m A B f (Pi y B (isContr (lmax l m) (fiber l m A B f y)))))
(checked Equiv (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (U (lmax l m))))))
  (lam l m A B (Sigma f (Pi x A B) (isEquiv l m A B f))))
(checked idIsEquiv (Pi l Level (Pi A (U l) (isEquiv l l A A (lam x x))))
  (lam l A (lam y (pair (pair y (plam i y))
                        (lam z (plam i (pair (@ (snd z) (~ i)) (plam j (@ (snd z) (\/ (~ i) j))))))))))
(checked idEquiv (Pi l Level (Pi A (U l) (Equiv l l A A))) (lam l A (pair (lam x x) (idIsEquiv l A))))
; an isomorphism is an equivalence (the fibre's contraction, lemIso)
(checked lemIso (Pi l Level (Pi A (U l) (Pi B (U l) (Pi f (Pi x A B) (Pi g (Pi y B A)
    (Pi s (Pi b B (PathP (plam i B) (f (g b)) b)) (Pi t (Pi a A (PathP (plam i A) (g (f a)) a))
    (Pi y B (Pi x0 A (Pi x1 A (Pi p0 (PathP (plam i B) (f x0) y) (Pi p1 (PathP (plam i B) (f x1) y)
      (PathP (plam i (fiber l l A B f y)) (pair x0 p0) (pair x1 p1))))))))))))))
  (lam l A B f g s t y x0 x1 p0 p1
    (let fill0 (plam i (plam j (comp (plam k A)
                 (plam k (sys ((= j 0) (g (@ p0 (~ i)))) ((= i 1) (@ (t x0) (/\ j k))) ((= i 0) (g y))))
                 (g (@ p0 (~ i))))))
    (let fill1 (plam i (plam j (comp (plam k A)
                 (plam k (sys ((= j 0) (g (@ p1 (~ i)))) ((= i 1) (@ (t x1) (/\ j k))) ((= i 0) (g y))))
                 (g (@ p1 (~ i))))))
    (let fill2 (plam i (plam j (comp (plam k A)
                 (plam k (sys ((= j 0) (g y)) ((= i 1) (@ (@ fill1 (/\ j k)) 1)) ((= i 0) (@ (@ fill0 (/\ j k)) 1))))
                 (g y))))
    (let p (plam i (@ (@ fill2 i) 1))
    (let sq (plam i (plam j (comp (plam k A)
              (plam k (sys ((= i 1) (@ (@ fill1 j) (~ k))) ((= i 0) (@ (@ fill0 j) (~ k)))
                           ((= j 1) (@ (t (@ p i)) (~ k))) ((= j 0) (g y))))
              (@ (@ fill2 i) j))))
    (let sq1 (plam i (plam j (comp (plam k B)
               (plam k (sys ((= i 1) (@ (s (@ p1 (~ j))) k)) ((= i 0) (@ (s (@ p0 (~ j))) k))
                            ((= j 1) (@ (s (f (@ p i))) k)) ((= j 0) (@ (s y) k))))
               (f (@ (@ sq i) j)))))
      (plam i (pair (@ p i) (plam j (@ (@ sq1 i) (~ j)))))))))))))
(checked isoToEquiv (Pi l Level (Pi A (U l) (Pi B (U l) (Pi f (Pi x A B) (Pi g (Pi y B A)
    (Pi s (Pi b B (PathP (plam i B) (f (g b)) b)) (Pi t (Pi a A (PathP (plam i A) (g (f a)) a))
      (Equiv l l A B))))))))
  (lam l A B f g s t (pair f (lam y (pair (pair (g y) (s y))
    (lam z (lemIso l A B f g s t y (g y) (fst z) (s y) (snd z))))))))

; ---------------------------------------------------------------- univalence
(checked ua (Pi ((l Level) (A (U l)) (B (U l)) (e (Equiv l l A B))) (PathP (plam i (U l)) A B))
  (lam l A B e (plam i (Glue B (sys ((= i 0) (pair A e)) ((= i 1) (pair B (idEquiv l B))))))))
; transport along ua e is e's map: unglue of the transport filler is a path from e a to it
(checked uaβ (Pi ((l Level) (A (U l)) (B (U l)) (e (Equiv l l A B)) (a A))
    (PathP (plam i B) (transport l A B (ua l A B e) a) ((fst e) a)))
  (lam l A B e a (plam k (unglue (sys ((= (~ k) 0) (pair A e)) ((= (~ k) 1) (pair B (idEquiv l B))))
    (comp (plam j (@ (ua l A B e) (/\ (~ k) j))) (plam j (sys ((= (~ k) 0) a))) a)))))
; a path of types gives an equivalence: transport, an equivalence by transport of the identity's.
; (η-expanded: its value is a closure over its code, which conversion compares without applying)
(checked transportIsEquiv (Pi ((l Level) (A (U l)) (B (U l)) (p (PathP (plam i (U l)) A B)))
    (isEquiv l l A B (transport l A B p)))
  (lam l A B p y ((comp (plam i (isEquiv l l A (@ p i) (lam x (comp (plam j (@ p (/\ i j))) (plam j (sys ((= i 0) x))) x))))
                        (plam i (sys)) (idIsEquiv l A)) y)))
(checked pathToEquiv (Pi ((l Level) (A (U l)) (B (U l)) (p (PathP (plam i (U l)) A B))) (Equiv l l A B))
  (lam l A B p (pair (transport l A B p) (transportIsEquiv l A B p))))

; ---------------------------------------------------------------- propositions
(checked isPropIsContr (Pi ((l Level) (A (U l))) (isProp l (isContr l A)))
  (lam l A z w (plam j (pair (@ ((snd z) (fst w)) j)
    (lam y (plam i (comp (plam k A)
      (plam k (sys ((= i 0) (@ ((snd z) (@ ((snd z) (fst w)) j)) k))
                   ((= i 1) (@ ((snd z) y) k))
                   ((= j 0) (@ ((snd z) (@ ((snd z) y) i)) k))
                   ((= j 1) (@ ((snd z) (@ ((snd w) y) i)) k))))
      (fst z))))))))
(checked isPropIsEquiv (Pi ((l Level) (m Level) (A (U l)) (B (U m)) (f (Pi x A B))) (isProp (lmax l m) (isEquiv l m A B f)))
  (lam l m A B f u v (plam i (lam y (@ (isPropIsContr (lmax l m) (fiber l m A B f y) (u y) (v y)) i)))))
; over a line of types whose end is a proposition, any two ends are joined
(checked isProp→PathP (Pi ((l Level) (B0 (U l)) (B1 (U l)) (B (PathP (plam i (U l)) B0 B1)) (h (isProp l B1)) (b0 B0) (b1 B1))
    (PathP B b0 b1))
  (lam l B0 B1 B h b0 b1 (toPathP l B0 B1 B b0 b1 (h (transport l B0 B1 B b0) b1))))
; a path in a Σ-type whose second components are propositions is a path of the first
; components (Σ≡Prop, at the family isEquiv; the propositionality is an argument)
(checked equivEq (Pi ((l Level) (A (U l)) (B (U l)) (hp (Pi f (Pi x A B) (isProp l (isEquiv l l A B f))))
                      (e1 (Equiv l l A B)) (e2 (Equiv l l A B)) (p (PathP (plam i (Pi x A B)) (fst e1) (fst e2))))
    (PathP (plam i (Equiv l l A B)) e1 e2))
  (lam l A B hp e1 e2 p (plam i (pair (@ p i)
    (@ (isProp→PathP l (isEquiv l l A B (fst e1)) (isEquiv l l A B (fst e2)) (plam j (isEquiv l l A B (@ p j)))
                     (hp (fst e2)) (snd e1) (snd e2)) i)))))
; ua is a section of pathToEquiv
(checked pathToEquiv-ua (Pi ((l Level) (A (U l)) (B (U l)) (e (Equiv l l A B)))
    (PathP (plam i (Equiv l l A B)) (pathToEquiv l A B (ua l A B e)) e))
  (lam l A B e (equivEq l A B (isPropIsEquiv l l A B) (pathToEquiv l A B (ua l A B e)) e
    (funExt l l A B (transport l A B (ua l A B e)) (fst e) (lam a (uaβ l A B e a))))))

; ---------------------------------------------------------------- natural numbers
(checked plus (Pi ((m Nat) (n Nat)) Nat) (lam m n (case m ((zero) n) ((suc k) (suc (rec k))))))
(checked times (Pi ((m Nat) (n Nat)) Nat) (lam m n (case m ((zero) zero) ((suc k) (plus n (rec k))))))
(checked pow (Pi ((m Nat) (n Nat)) Nat) (lam m n (case n ((zero) (suc zero)) ((suc k) (times m (rec k))))))
(checked fact (Pi n Nat Nat) (lam n (case n ((zero) (suc zero)) ((suc k) (times (suc k) (rec k))))))
(checked predN (Pi n Nat Nat) (lam n (case n ((zero) zero) ((suc k) k))))
(checked congN (Pi ((f (Pi x Nat Nat)) (a Nat) (b Nat) (p (PathP (plam i Nat) a b))) (PathP (plam i Nat) (f a) (f b)))
  (lam f a b p (plam i (f (@ p i)))))
(checked symN (Pi ((a Nat) (b Nat) (p (PathP (plam i Nat) a b))) (PathP (plam i Nat) b a)) (lam a b p (plam i (@ p (~ i)))))
(checked transN (Pi ((a Nat) (b Nat) (c Nat) (p (PathP (plam i Nat) a b)) (q (PathP (plam i Nat) b c))) (PathP (plam i Nat) a c))
  (lam a b c p q (plam i (comp (plam j Nat) (plam j (sys ((= i 0) a) ((= i 1) (@ q j)))) (@ p i)))))
; suc n is not zero: a predicate true at zero and empty at suc
(checked isZero (Pi n Nat U) (lam n (case n ((zero) Unit) ((suc k) Empty))))
(checked snotz (Pi ((n Nat) (p (PathP (plam i Nat) (suc n) zero))) Empty)
  (lam n p (comp (plam i (isZero (@ p (~ i)))) (plam i (sys)) unit)))
; the semiring laws, by induction
(checked plus-zero (Pi n Nat (PathP (plam i Nat) (plus n zero) n))
  (lam n (elim (lam y (PathP (plam i Nat) (plus y zero) y)) n ((zero) (plam i zero)) ((suc k) (plam i (suc (@ (rec k) i)))))))
(checked plus-suc (Pi ((m Nat) (n Nat)) (PathP (plam i Nat) (plus m (suc n)) (suc (plus m n))))
  (lam m n (elim (lam y (PathP (plam i Nat) (plus y (suc n)) (suc (plus y n)))) m
    ((zero) (plam i (suc n))) ((suc k) (plam i (suc (@ (rec k) i)))))))
(checked plus-comm (Pi ((m Nat) (n Nat)) (PathP (plam i Nat) (plus m n) (plus n m)))
  (lam m n (elim (lam y (PathP (plam i Nat) (plus y n) (plus n y))) m
    ((zero) (symN (plus n zero) n (plus-zero n)))
    ((suc k) (transN (suc (plus k n)) (suc (plus n k)) (plus n (suc k))
                     (plam i (suc (@ (rec k) i))) (symN (plus n (suc k)) (suc (plus n k)) (plus-suc n k)))))))
(checked plus-assoc (Pi ((a Nat) (b Nat) (c Nat)) (PathP (plam i Nat) (plus (plus a b) c) (plus a (plus b c))))
  (lam a b c (elim (lam y (PathP (plam i Nat) (plus (plus y b) c) (plus y (plus b c)))) a
    ((zero) (plam i (plus b c))) ((suc k) (plam i (suc (@ (rec k) i)))))))
(checked times-zero (Pi n Nat (PathP (plam i Nat) (times n zero) zero))
  (lam n (elim (lam y (PathP (plam i Nat) (times y zero) zero)) n ((zero) (plam i zero)) ((suc k) (rec k)))))
(checked times-suc (Pi ((m Nat) (n Nat)) (PathP (plam i Nat) (times m (suc n)) (plus m (times m n))))
  (lam m n (elim (lam y (PathP (plam i Nat) (times y (suc n)) (plus y (times y n)))) m
    ((zero) (plam i zero))
    ((suc k) (plam i (suc (@ (transN (plus n (times k (suc n))) (plus n (plus k (times k n)))
                                     (plus k (plus n (times k n)))
               (congN (plus n) (times k (suc n)) (plus k (times k n)) (rec k))
               (transN (plus n (plus k (times k n))) (plus (plus n k) (times k n)) (plus k (plus n (times k n)))
                 (symN (plus (plus n k) (times k n)) (plus n (plus k (times k n))) (plus-assoc n k (times k n)))
                 (transN (plus (plus n k) (times k n)) (plus (plus k n) (times k n)) (plus k (plus n (times k n)))
                   (congN (lam x (plus x (times k n))) (plus n k) (plus k n) (plus-comm n k))
                   (plus-assoc k n (times k n))))) i)))))))
(checked times-comm (Pi ((m Nat) (n Nat)) (PathP (plam i Nat) (times m n) (times n m)))
  (lam m n (elim (lam y (PathP (plam i Nat) (times y n) (times n y))) m
    ((zero) (symN (times n zero) zero (times-zero n)))
    ((suc k) (transN (plus n (times k n)) (plus n (times n k)) (times n (suc k))
               (congN (plus n) (times k n) (times n k) (rec k))
               (symN (times n (suc k)) (plus n (times n k)) (times-suc n k)))))))
(checked times-distr (Pi ((a Nat) (b Nat) (c Nat)) (PathP (plam i Nat) (times (plus a b) c) (plus (times a c) (times b c))))
  (lam a b c (elim (lam y (PathP (plam i Nat) (times (plus y b) c) (plus (times y c) (times b c)))) a
    ((zero) (plam i (times b c)))
    ((suc k) (transN (plus c (times (plus k b) c)) (plus c (plus (times k c) (times b c))) (plus (plus c (times k c)) (times b c))
               (congN (plus c) (times (plus k b) c) (plus (times k c) (times b c)) (rec k))
               (symN (plus (plus c (times k c)) (times b c)) (plus c (plus (times k c) (times b c)))
                     (plus-assoc c (times k c) (times b c))))))))
(checked times-assoc (Pi ((a Nat) (b Nat) (c Nat)) (PathP (plam i Nat) (times (times a b) c) (times a (times b c))))
  (lam a b c (elim (lam y (PathP (plam i Nat) (times (times y b) c) (times y (times b c)))) a
    ((zero) (plam i zero))
    ((suc k) (transN (times (plus b (times k b)) c) (plus (times b c) (times (times k b) c)) (plus (times b c) (times k (times b c)))
               (times-distr b (times k b) c)
               (congN (plus (times b c)) (times (times k b) c) (times k (times b c)) (rec k)))))))
(checked times-one (Pi n Nat (PathP (plam i Nat) (times n (suc zero)) n))
  (lam n (elim (lam y (PathP (plam i Nat) (times y (suc zero)) y)) n ((zero) (plam i zero)) ((suc k) (plam i (suc (@ (rec k) i)))))))
; the order: m ≤ n is a k with k + m = n
(checked cong2N (Pi ((f (Pi x Nat (Pi y Nat Nat))) (a Nat) (a2 Nat) (b Nat) (b2 Nat)
                     (p (PathP (plam i Nat) a a2)) (q (PathP (plam i Nat) b b2)))
    (PathP (plam i Nat) (f a b) (f a2 b2)))
  (lam f a a2 b b2 p q (plam i (f (@ p i) (@ q i)))))
(checked le (Pi ((m Nat) (n Nat)) U) (lam m n (Sigma k Nat (PathP (plam i Nat) (plus k m) n))))
(checked le-refl (Pi n Nat (le n n)) (lam n (pair zero (plam i n))))

; ---------------------------------------------------------------- booleans, integers
(checked not (Pi b Bool Bool) (lam b (if b false true)))
(checked isTrue (Pi b Bool U) (lam b (if b Unit Empty)))
(checked true≢false (Pi p (PathP (plam i Bool) true false) Empty)
  (lam p (comp (plam i (isTrue (@ p i))) (plam i (sys)) unit)))
(checked negZ (Pi z Int Int) (lam z (case z ((pos n) (case n ((zero) (pos zero)) ((suc k) (negsuc k)))) ((negsuc n) (pos (suc n))))))

; ---------------------------------------------------------------- words
; A word is a natural number held in one cell: #n, the successor (%wsucc w), and the elimination
; (%welimP P w z s): z : P #0, s : Π n. P n → P (n+1). Word ≃ Nat is proved here, and each of the
; machine's operations on words (%wadd %weq %wlt %wmax %wsub) is the 1-end of a checked identity
; whose 0-end is its definition by induction (paper 5.26): the machine computing one cell at a
; time is a theorem of the theory, not an outside convention. Words are exact: a number that does
; not fit in 64 bits is held as its limbs.
(checked toNat (Pi w Word Nat) (lam w (%welimP (lam v Nat) w zero (lam n h (suc h)))))
(checked fromNat (Pi n Nat Word) (lam n (case n ((zero) #0) ((suc k) (%wsucc (rec k))))))
(checked toNat-fromNat (Pi n Nat (PathP (plam i Nat) (toNat (fromNat n)) n))
  (lam n (elim (lam y (PathP (plam i Nat) (toNat (fromNat y)) y)) n
    ((zero) (plam i zero)) ((suc k) (plam i (suc (@ (rec k) i)))))))
(checked fromNat-toNat (Pi w Word (PathP (plam i Word) (fromNat (toNat w)) w))
  (lam w (%welimP (lam v (PathP (plam i Word) (fromNat (toNat v)) v)) w
    (plam i #0) (lam n h (plam i (%wsucc (@ h i)))))))
(checked Word≃Nat (Equiv lzero lzero Word Nat) (isoToEquiv lzero Word Nat toNat fromNat toNat-fromNat fromNat-toNat))
(checked Word≡Nat (PathP (plam i U) Word Nat) (ua lzero Word Nat Word≃Nat))
; addition, by recursion on the second argument
(checked plusw (Pi ((a Word) (b Word)) Word) (lam a b (%welimP (lam v Word) b a (lam n h (%wsucc h)))))
(checked wadd (Pi ((a Word) (b Word)) Word) (lam a b (%wadd a b)))
(checked plusw≡wadd (Pi ((a Word) (b Word)) (PathP (plam i Word) (plusw a b) (wadd a b)))
  (lam a b (%welimP (lam v (PathP (plam i Word) (plusw a v) (wadd a v))) b
    (plam i a) (lam n h (plam i (%wsucc (@ h i)))))))
; IDENTITIES (declared L = R makes every call of L run R): retarded non-core feature with no bearing on intended design.
(checked-identity plusw wadd plusw≡wadd 2)
(same (plusw #3 #4) #7)
; equality, order, max and truncated subtraction, by recursion on both arguments
(checked eqw (Pi ((a Word) (b Word)) Bool)
  (lam a (%welimP (lam v (Pi b Word Bool)) a
    (lam b (%welimP (lam v Bool) b true (lam m g false)))
    (lam n h b (%welimP (lam v Bool) b false (lam m g (h m)))))))
(checked weq (Pi ((a Word) (b Word)) Bool) (lam a b (%weq a b)))
(checked eqw≡weq (Pi ((a Word) (b Word)) (PathP (plam i Bool) (eqw a b) (weq a b)))
  (lam a (%welimP (lam v (Pi b Word (PathP (plam i Bool) (eqw v b) (weq v b)))) a
    (lam b (%welimP (lam v (PathP (plam i Bool) (eqw #0 v) (weq #0 v))) b (plam i true) (lam m g (plam i false))))
    (lam n h b (%welimP (lam v (PathP (plam i Bool) (eqw (%wsucc n) v) (weq (%wsucc n) v))) b
      (plam i false) (lam m g (h m)))))))
(checked-identity eqw weq eqw≡weq 2)
(checked ltw (Pi ((a Word) (b Word)) Bool)
  (lam a (%welimP (lam v (Pi b Word Bool)) a
    (lam b (%welimP (lam v Bool) b false (lam m g true)))
    (lam n h b (%welimP (lam v Bool) b false (lam m g (h m)))))))
(checked wlt (Pi ((a Word) (b Word)) Bool) (lam a b (%wlt a b)))
(checked ltw≡wlt (Pi ((a Word) (b Word)) (PathP (plam i Bool) (ltw a b) (wlt a b)))
  (lam a (%welimP (lam v (Pi b Word (PathP (plam i Bool) (ltw v b) (wlt v b)))) a
    (lam b (%welimP (lam v (PathP (plam i Bool) (ltw #0 v) (wlt #0 v))) b (plam i false) (lam m g (plam i true))))
    (lam n h b (%welimP (lam v (PathP (plam i Bool) (ltw (%wsucc n) v) (wlt (%wsucc n) v))) b
      (plam i false) (lam m g (h m)))))))
(checked-identity ltw wlt ltw≡wlt 2)
(checked maxw (Pi ((a Word) (b Word)) Word)
  (lam a (%welimP (lam v (Pi b Word Word)) a
    (lam b b)
    (lam n h b (%welimP (lam v Word) b (%wsucc n) (lam m g (%wsucc (h m))))))))
(checked wmax (Pi ((a Word) (b Word)) Word) (lam a b (%wmax a b)))
(checked maxw≡wmax (Pi ((a Word) (b Word)) (PathP (plam i Word) (maxw a b) (wmax a b)))
  (lam a (%welimP (lam v (Pi b Word (PathP (plam i Word) (maxw v b) (wmax v b)))) a
    (lam b (plam i b))
    (lam n h b (%welimP (lam v (PathP (plam i Word) (maxw (%wsucc n) v) (wmax (%wsucc n) v))) b
      (plam i (%wsucc n)) (lam m g (plam i (%wsucc (@ (h m) i)))))))))
(checked-identity maxw wmax maxw≡wmax 2)
(checked subw (Pi ((a Word) (b Word)) Word)
  (lam a (%welimP (lam v (Pi b Word Word)) a
    (lam b #0)
    (lam n h b (%welimP (lam v Word) b (%wsucc n) (lam m g (h m)))))))
(checked wsub (Pi ((a Word) (b Word)) Word) (lam a b (%wsub a b)))
(checked subw≡wsub (Pi ((a Word) (b Word)) (PathP (plam i Word) (subw a b) (wsub a b)))
  (lam a (%welimP (lam v (Pi b Word (PathP (plam i Word) (subw v b) (wsub v b)))) a
    (lam b (plam i #0))
    (lam n h b (%welimP (lam v (PathP (plam i Word) (subw (%wsucc n) v) (wsub (%wsucc n) v))) b
      (plam i (%wsucc n)) (lam m g (h m)))))))
(checked-identity subw wsub subw≡wsub 2)
(same (eqw #5 #5) true)
(same (ltw #2 #9) true)
(same (maxw #4 #9) #9)
(same (subw #4 #9) #0)
; a wrong identity is rejected: its evidence does not have the identity's type
(checked-identity-fail eqw wlt eqw≡weq 2)
(check-fail (Pi ((a Word) (b Word)) (PathP (plam i Bool) (eqw a b) (wlt a b)))
  (lam a b (plam i (eqw a b))))
; words are exact: past 2^64 a word cell holds its digits
(same (plusw (plusw #9223372036854775807 #9223372036854775807) #2) #18446744073709551616)
(same (eqw (plusw #18446744073709551615 #1) #0) false)
(same (subw #340282366920938463463374607431768211456 #1) #340282366920938463463374607431768211455)
