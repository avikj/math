; core.ctt — the evaluator and the library, as programs of the language.
;
; A program here computes on codes: (quote t) is the record of the term t
; itself. eval takes the code of the ambient face and the code of a term and
; returns the code of the term's weak-head value; the library below builds
; the codes of the clause instances composition reduces to.

(axiom hole (U 0))

; ---------------- constructors: a template record with fields replaced
(defn mk-app (f a) (cset 1 (cset 0 (quote (hole hole)) f) a))
(defn mk-fst (p) (cset 0 (quote (fst hole)) p))
(defn mk-snd (p) (cset 0 (quote (snd hole)) p))
(defn mk-lam (l A (b 1)) (csetlv (cset 1 (cset 0 (quote (lam (x hole) x)) A) b) l (qlv none)))
(defn mk-pi (m n A (B 1)) (csetlv (cset 1 (cset 0 (quote (Pi (x hole) hole)) A) B) m n))
(defn mk-sigma (m n A (B 1)) (csetlv (cset 1 (cset 0 (quote (Sigma (x hole) hole)) A) B) m n))
(defn mk-pair (l a b S) (csetlv (cset 2 (cset 1 (cset 0 (quote (pair hole hole hole)) a) b) S) l (qlv none)))
(defn mk-path (n (B 1) a b) (csetlv (cset 2 (cset 1 (cset 0 (quote (Path (i) hole hole hole)) B) a) b) n (qlv none)))
(defn mk-plam ((b 1)) (cset 0 (quote (plam (i) hole)) b))
(defn mk-papp (n (B 1) a b p r)
  (csetlv (cset 4 (cset 3 (cset 2 (cset 1 (cset 0 (quote (papp (i) hole hole hole hole 0)) B) a) b) p) r) n (qlv none)))
(defn mk-comp (n (A 1) phi (u 1) cap)
  (csetlv (cset 3 (cset 2 (cset 1 (cset 0 (quote (comp 0 (i) hole false hole hole)) A) phi) u) cap) n (qlv none)))
(defn mk-glue (n A phi T e)
  (csetlv (cset 3 (cset 2 (cset 1 (cset 0 (quote (Glue 0 hole false hole hole)) A) phi) T) e) n (qlv none)))
(defn mk-glue-intro (n A phi T e t a)
  (csetlv (cset 5 (cset 4 (cset 3 (cset 2 (cset 1 (cset 0 (quote (glue 0 hole false hole hole hole hole)) A) phi) T) e) t) a) n (qlv none)))
(defn mk-unglue (n A phi T e v)
  (csetlv (cset 4 (cset 3 (cset 2 (cset 1 (cset 0 (quote (unglue 0 hole false hole hole hole)) A) phi) T) e) v) n (qlv none)))
(defn sys1 (p t) (csyscons p t (quote (sys))))
(defn sys2 (p t q s) (csyscons p t (sys1 q s)))
(defn sys3 (p t q s o w) (csyscons p t (sys2 q s o w)))

; ---------------- the library
(defn path-const (l A a b) (mk-path l (fn (j) A) a b))
(defn refl (l A a) (mk-plam (fn (j) a)))
(defn papp-const (l A a b p r) (mk-papp l (fn (j) A) a b p r))
(defn fun (l m X Y) (mk-pi l m X (fn (x) Y)))
(defn contr (l X) (mk-sigma l l X (fn (c) (mk-pi l l X (fn (x) (path-const l X c x))))))
(defn fib (l m X Y f y) (mk-sigma l m X (fn (x) (path-const m Y (mk-app f x) y))))
(defn equiv (l m X Y)
  (let (mx (clmax l m))
    (mk-sigma mx mx (fun l m X Y) (fn (f) (mk-pi m mx Y (fn (y) (contr mx (fib l m X Y f y))))))))
(defn id-fun (l X) (mk-lam l X (fn (x) x)))
(defn equiv-map (l m X Y e) (mk-fst e))
(defn equiv-contr (l m X Y e y) (mk-app (mk-snd e) y))
(defn id-equiv (l X)
  (let (f (id-fun l X))
    (mk-pair l f
      (mk-lam l X (fn (y)
        (let (fb (fib l l X X f y))
          (mk-pair l
            (mk-pair l y (refl l X y) fb)
            (mk-lam l fb (fn (w)
              (let (p (mk-snd w))
                (let (fx (mk-app f (mk-fst w)))
                  (mk-plam (fn (i)
                    (mk-pair l (papp-const l X fx y p (civneg i))
                               (mk-plam (fn (j) (papp-const l X fx y p (civor (civneg i) j))))
                               fb)))))))
            (contr l fb)))))
      (equiv l l X X))))
(defn fill (l (A 1) phi (u 1) cap r)
  (let (r0 (cfcend 0 r))
    (mk-comp l (fn (j) (A (civand r j))) (cfcor phi r0) (fn (j) (sys2 phi (u (civand r j)) r0 cap)) cap)))
(defn hcomp (l X phi (u 1) cap) (mk-comp l (fn (j) X) phi u cap))
(defn coe (l (A 1) cap) (mk-comp l A (qfc false) (fn (i) (quote (sys))) cap))
(defn extend-contr (l X c k theta v) (hcomp l X theta (fn (j) (papp-const l X c v (mk-app k v) j)) c))
(defn line-equiv (l (X 1))
  (let (X0 (X (qiv 0))) (coe l (fn (i) (equiv l l X0 (X i))) (id-equiv l X0))))
(defn ua (l X Y e)
  (mk-plam (fn (i)
    (let (f0 (cfcend 0 i))
      (let (f1 (cfcend 1 i))
        (mk-glue l Y (cfcor f0 f1) (sys2 f0 X f1 Y) (sys2 f0 e f1 (id-equiv l Y))))))))

; ---------------- composition: the clause of the family's former
(defn pi-comp (m n (D 1) (E 2) phi (u 1) cap)
  (mk-lam m (D (qiv 1)) (fn (x1)
    (let ((V 1) (fn (r) (fill m (fn (j) (D (civneg j))) (qfc false) (fn (j) (quote (sys))) x1 (civneg r))))
      (mk-comp n (fn (i) (E i (V i))) phi (fn (i) (mk-app (u i) (V i))) (mk-app cap (V (qiv 0))))))))
(defn sigma-comp (m n (D 1) (E 2) phi (u 1) cap)
  (let ((Af 1) (fn (r) (fill m D phi (fn (i) (mk-fst (u i))) (mk-fst cap) r)))
    (mk-pair (clmax m n) (Af (qiv 1))
      (mk-comp n (fn (i) (E i (Af i))) phi (fn (i) (mk-snd (u i))) (mk-snd cap))
      (mk-sigma m n (D (qiv 1)) (fn (x1) (E (qiv 1) x1))))))
(defn path-comp (n (B 2) (lft 1) (rgt 1) phi (u 1) cap)
  (mk-plam (fn (j)
    (let (j0 (cfcend 0 j))
      (let (j1 (cfcend 1 j))
        (mk-comp n (fn (i) (B i j)) (cfcor phi (cfcor j0 j1))
          (fn (i) (sys3 phi (mk-papp n (fn (k) (B i k)) (lft i) (rgt i) (u i) j) j0 (lft i) j1 (rgt i)))
          (mk-papp n (fn (k) (B (qiv 0) k)) (lft (qiv 0)) (rgt (qiv 0)) cap j)))))))
(defn univ-comp (l phi (u 1) cap)
  (mk-glue l cap phi (u (qiv 1)) (line-equiv l (fn (i) (u (civneg i))))))
(defn glue-comp (n jv (A 1) (alpha 1) (T 1) (e 1) psi (u 1) cap)
  (let (A1 (A (qiv 1))) (let (T1 (T (qiv 1))) (let (e1 (e (qiv 1))) (let (alpha1 (alpha (qiv 1)))
  (let (a0 (mk-unglue n (A (qiv 0)) (alpha (qiv 0)) (T (qiv 0)) (e (qiv 0)) cap))
  (let ((Afill 1) (fn (r) (fill n A psi (fn (i) (mk-unglue n (A i) (alpha i) (T i) (e i) (u i))) a0 r)))
  (let (a1 (Afill (qiv 1)))
  (let (delta (cforall jv (alpha jv)))
  (let ((Tfill 1) (fn (r) (fill n T psi u cap r)))
  (let (omega (mk-plam (fn (q)
                (mk-comp n A (cfcor psi (cfcor (cfcend 0 q) (cfcend 1 q)))
                  (fn (i) (sys3 psi (Afill i) (cfcend 0 q) (mk-app (equiv-map n n (T i) (A i) (e i)) (Tfill i)) (cfcend 1 q) (Afill i)))
                  a0))))
  (let (f1 (equiv-map n n T1 A1 e1))
  (let (fibre (fib n n T1 A1 f1 a1))
  (let (contraction (equiv-contr n n T1 A1 e1 a1))
  (let (extension (extend-contr n fibre (mk-fst contraction) (mk-snd contraction) (cfcor delta psi)
                     (sys2 delta (mk-pair n (Tfill (qiv 1)) omega fibre) psi (mk-pair n (u (qiv 1)) (refl n A1 a1) fibre))))
  (let (t1 (mk-fst extension))
  (let (p (mk-snd extension))
    (mk-glue-intro n A1 alpha1 T1 e1 t1
      (hcomp n A1 (cfcor alpha1 psi) (fn (q) (sys2 alpha1 (papp-const n A1 (mk-app f1 t1) a1 p (civneg q)) psi a1)) a1)))))))))))))))))))

;  ---------------- systems
; A face-indexed value: the evaluator's value under χ is an introduction, a
; neutral, or a system of values (each under χ ∧ its guard); `invalid` is the
; value of an ill-formed demand.
(axiom invalid (U 0))
(defn bad? (v t f) (ceq v (quote invalid) t f))
(defn consistent (chi p t f) (ceq (cfcand chi p) (qfc false) f t))
; the first branch χ entails, given to k; none otherwise
(defn sys-first ((k 1) chi s none)
  (cmatch sys s (fn (p t rest) (cent chi p (k t) (sys-first k chi rest none))) none))
; the join of the guards consistent with χ
(defn sys-join (chi s)
  (cmatch sys s (fn (p t rest) (consistent chi p (cfcor p (sys-join chi rest)) (sys-join chi rest))) (qfc false)))
(defn sys-append (a b)
  (cmatch sys a (fn (q w rest) (csyscons q w (sys-append rest b))) b))
; the branches consistent with χ, f applied to each term
(defn sys-map ((f 1) chi s)
  (cmatch sys s (fn (p t rest) (consistent chi p (csyscons p (f t) (sys-map f chi rest)) (sys-map f chi rest))) (quote (sys))))
; a value v under the guard p as branches: a system's branches consistent with
; χ ∧ p, guarded by p ∧ ψ; another value one branch
(defn flat-in (cp p s)
  (cmatch sys s (fn (q w rest) (consistent cp q (csyscons (cfcand p q) w (flat-in cp p rest)) (flat-in cp p rest))) (quote (sys))))
(defn flat (chi p v)
  (cmatch sys v (fn (q w rest) (flat-in (cfcand chi p) p v))
  (cmatch sys0 v (quote (sys))
    (sys1 p v))))
; each branch of s evaluated under χ ∧ its guard, nested systems flattened;
; invalid when a branch is
(defn branchwise ((ev 2) chi s)
  (cmatch sys s (fn (p t rest)
      (let (v (ev (cfcand chi p) t))
        (bad? v v
          (let (r (branchwise ev chi rest))
            (bad? r r (sys-append (flat chi p v) r))))))
    (quote (sys))))
; an eliminator whose scrutinee is the system value v: rebuilt around each
; consistent branch, evaluated branchwise
(defn distribute ((ev 2) chi (rb 1) v) (branchwise ev chi (sys-map rb chi v)))

; ---------------- the evaluator
(defn comp-branches (chi jv c F)
  (cmatch sys F (fn (g b rest)
      (consistent chi g
        (let (G (cforall jv g))
          (consistent chi G
            (csyscons G (cset 0 c (fn (j) (csubst b jv j))) (comp-branches chi jv c rest))
            (comp-branches chi jv c rest)))
        (comp-branches chi jv c rest)))
    (quote (sys))))
(defn eval-comp ((ev 2) chi c n (A 1) phi (u 1) cap)
  (cent chi phi (ev chi (u (qiv 1)))
    (let (jv (cvar c))
      (let (F (ev chi (A jv)))
        (let ((at 2) (fn (x r) (csubst x jv r)))
          (cmatch Pi F (fn (Dj (Ej 1))
              (clevels F (fn (m nn) (ev chi (pi-comp m nn (fn (r) (at Dj r)) (fn (r x) (cinst 1 (at F r) x)) phi u cap)))))
          (cmatch Sigma F (fn (Dj (Ej 1))
              (clevels F (fn (m nn) (ev chi (sigma-comp m nn (fn (r) (at Dj r)) (fn (r x) (cinst 1 (at F r) x)) phi u cap)))))
          (cmatch Path F (fn ((Bj 1) Lj Rj)
              (clevels F (fn (m nn) (ev chi (path-comp m (fn (r k) (cinst 0 (at F r) k)) (fn (r) (at Lj r)) (fn (r) (at Rj r)) phi u cap)))))
          (cmatch Glue F (fn (Aj alj Tj ej)
              (clevels F (fn (m nn) (ev chi (glue-comp m jv (fn (r) (at Aj r)) (fn (r) (at alj r)) (fn (r) (at Tj r)) (fn (r) (at ej r)) phi u cap)))))
          (cmatch U F
              (clevels F (fn (m nn) (ev chi (univ-comp m phi u cap))))
          (cmatch sys F (fn (g b rest)
              ; a family system: the composition in each branch available
              ; along the whole line (guard ∀j.g)
              (let (S (comp-branches chi jv c F))
                (cent chi (sys-join chi S)
                  (sys-first (fn (x) (ev chi x)) chi S (branchwise ev chi S))
                  (quote invalid))))
            (bad? F F c))))))))))))
(defn eval (chi c)
  (cmatch app c (fn (f a)
      (let (v (eval chi f))
        (cmatch lam v (fn (A (b 1)) (eval chi (b a)))
        (cmatch sys v (fn (q w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (bad? v v c)))))
  (cmatch fst c (fn (p)
      (let (v (eval chi p))
        (cmatch pair v (fn (x y S) (eval chi x))
        (cmatch sys v (fn (q w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (bad? v v c)))))
  (cmatch snd c (fn (p)
      (let (v (eval chi p))
        (cmatch pair v (fn (x y S) (eval chi y))
        (cmatch sys v (fn (q w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (bad? v v c)))))
  (cmatch papp c (fn ((A 1) a b p r)
      (cent chi (cfcend 0 r) (eval chi a)
      (cent chi (cfcend 1 r) (eval chi b)
        (let (v (eval chi p))
          (cmatch plam v (fn ((t 1)) (eval chi (t r)))
          (cmatch sys v (fn (q w rest) (distribute eval chi (fn (x) (cset 3 c x)) v))
            (bad? v v c)))))))
  (cmatch global c
      (cunfold c (fn (u) (eval chi u)) c)
  (cmatch sys c (fn (p t rest)
      (sys-first (fn (x) (eval chi x)) chi c (cent chi (sys-join chi c) c (quote invalid))))
  (cmatch sys0 c (quote invalid)
  (cmatch Glue c (fn (A phi T e) (cent chi phi (eval chi T) c))
  (cmatch glue c (fn (A phi T e t a) (cent chi phi (eval chi t) c))
  (cmatch unglue c (fn (A phi T e v)
      (cent chi phi (eval chi (mk-app (mk-fst e) v))
        (let (w (eval chi v))
          (cmatch glue w (fn (A2 phi2 T2 e2 t a) (eval chi a))
          (cmatch sys w (fn (q x rest) (distribute eval chi (fn (y) (cset 4 c y)) w))
            (bad? w w c))))))
  (cmatch comp c (fn ((A 1) phi (u 1) cap)
      (clevels c (fn (n m) (eval-comp eval chi c n A phi u cap))))
    c))))))))))))
