; core.ctt — the evaluator and the library, as programs of the language.
;
; A program here computes on codes: (quote t) is the record of the term t
; itself; (qiv r), (qfc φ), (qlv l) are codes of intervals, faces and
; levels, of types (ICode), (FCode), (LCode); in argument positions I, F, L,
; C, k (a k-ary function on term codes) and (-> T ... R). eval takes the
; code of a face and the code of a term and returns the code of the term it
; reaches: a value, or the residual of a stuck computation (its operands
; replaced by their values), where computation continues when an open input
; is supplied. The library builds the codes of the clause instances
; composition reduces to.

(axiom hole (U 0))

; ---------------- constructors: a template record with fields replaced
(defn mk-app (f a) (cset 1 (cset 0 (quote (hole hole)) f) a))
(defn mk-fst (p) (cset 0 (quote (fst hole)) p))
(defn mk-snd (p) (cset 0 (quote (snd hole)) p))
(defn mk-lam ((l L) A (b 1)) (csetlv (csetb 1 (cset 0 (quote (lam (x hole) x)) A) b) l (qlv none)))
(defn mk-pi ((m L) (n L) A (B 1)) (csetlv (csetb 1 (cset 0 (quote (Pi (x hole) hole)) A) B) m n))
(defn mk-sigma ((m L) (n L) A (B 1)) (csetlv (csetb 1 (cset 0 (quote (Sigma (x hole) hole)) A) B) m n))
(defn mk-pair ((l L) a b S) (csetlv (cset 2 (cset 1 (cset 0 (quote (pair hole hole hole)) a) b) S) l (qlv none)))
(defn mk-path ((n L) (B (-> I C)) a b)
  (csetlv (cset 2 (cset 1 (csetbi 0 (quote (Path (i) hole hole hole)) B) a) b) n (qlv none)))
(defn mk-plam ((b (-> I C))) (csetbi 0 (quote (plam (i) hole)) b))
(defn mk-papp ((n L) (B (-> I C)) a b p (r I))
  (csetlv (cset 4 (cset 3 (cset 2 (cset 1 (csetbi 0 (quote (papp (i) hole hole hole hole 0)) B) a) b) p) r) n (qlv none)))
(defn mk-comp ((n L) (A (-> I C)) (phi F) (u (-> I C)) cap)
  (csetlv (cset 3 (csetbi 2 (cset 1 (csetbi 0 (quote (comp 0 (i) hole false hole hole)) A) phi) u) cap) n (qlv none)))
(defn mk-glue ((n L) A (phi F) T e)
  (csetlv (cset 3 (cset 2 (cset 1 (cset 0 (quote (Glue 0 hole false hole hole)) A) phi) T) e) n (qlv none)))
(defn mk-glue-intro ((n L) A (phi F) T e t a)
  (csetlv (cset 5 (cset 4 (cset 3 (cset 2 (cset 1 (cset 0 (quote (glue 0 hole false hole hole hole hole)) A) phi) T) e) t) a) n (qlv none)))
(defn mk-unglue ((n L) A (phi F) T e v)
  (csetlv (cset 4 (cset 3 (cset 2 (cset 1 (cset 0 (quote (unglue 0 hole false hole hole hole)) A) phi) T) e) v) n (qlv none)))
(defn sys1 ((p F) t) (csyscons p t (quote (sys))))
(defn sys2 ((p F) t (q F) s) (csyscons p t (sys1 q s)))
(defn sys3 ((p F) t (q F) s (o F) w) (csyscons p t (sys2 q s o w)))

; ---------------- the library
(defn path-const ((l L) A a b) (mk-path l (fn ((j I)) A) a b))
(defn refl ((l L) A a) (mk-plam (fn ((j I)) a)))
(defn papp-const ((l L) A a b p (r I)) (mk-papp l (fn ((j I)) A) a b p r))
(defn fun ((l L) (m L) X Y) (mk-pi l m X (fn (x) Y)))
(defn contr ((l L) X) (mk-sigma l l X (fn (c) (mk-pi l l X (fn (x) (path-const l X c x))))))
(defn fib ((l L) (m L) X Y f y) (mk-sigma l m X (fn (x) (path-const m Y (mk-app f x) y))))
(defn equiv ((l L) (m L) X Y)
  (let ((mx L) (clmax l m))
    (mk-sigma mx mx (fun l m X Y) (fn (f) (mk-pi m mx Y (fn (y) (contr mx (fib l m X Y f y))))))))
(defn id-fun ((l L) X) (mk-lam l X (fn (x) x)))
(defn equiv-map ((l L) (m L) X Y e) (mk-fst e))
(defn equiv-contr ((l L) (m L) X Y e y) (mk-app (mk-snd e) y))
(defn id-equiv ((l L) X)
  (let (f (id-fun l X))
    (mk-pair l f
      (mk-lam l X (fn (y)
        (let (fb (fib l l X X f y))
          (mk-pair l
            (mk-pair l y (refl l X y) fb)
            (mk-lam l fb (fn (w)
              (let (p (mk-snd w))
                (let (fx (mk-app f (mk-fst w)))
                  (mk-plam (fn ((i I))
                    (mk-pair l (papp-const l X fx y p (civneg i))
                               (mk-plam (fn ((j I)) (papp-const l X fx y p (civor (civneg i) j))))
                               fb)))))))
            (contr l fb)))))
      (equiv l l X X))))
(defn fill ((l L) (A (-> I C)) (phi F) (u (-> I C)) cap (r I))
  (let ((r0 F) (cfcend 0 r))
    (mk-comp l (fn ((j I)) (A (civand r j))) (cfcor phi r0) (fn ((j I)) (sys2 phi (u (civand r j)) r0 cap)) cap)))
(defn hcomp ((l L) X (phi F) (u (-> I C)) cap) (mk-comp l (fn ((j I)) X) phi u cap))
(defn coe ((l L) (A (-> I C)) cap) (mk-comp l A (qfc false) (fn ((i I)) (quote (sys))) cap))
(defn extend-contr ((l L) X c k (theta F) v) (hcomp l X theta (fn ((j I)) (papp-const l X c v (mk-app k v) j)) c))
(defn line-equiv ((l L) (X (-> I C)))
  (let (X0 (X (qiv 0))) (coe l (fn ((i I)) (equiv l l X0 (X i))) (id-equiv l X0))))
(defn ua ((l L) X Y e)
  (mk-plam (fn ((i I))
    (let ((f0 F) (cfcend 0 i))
      (let ((f1 F) (cfcend 1 i))
        (mk-glue l Y (cfcor f0 f1) (sys2 f0 X f1 Y) (sys2 f0 e f1 (id-equiv l Y))))))))

; ---------------- composition: the clause of the family's former
(defn pi-comp ((m L) (n L) (D (-> I C)) (E (-> I C C)) (phi F) (u (-> I C)) cap)
  (mk-lam m (D (qiv 1)) (fn (x1)
    (let ((V (-> I C)) (fn ((r I)) (fill m (fn ((j I)) (D (civneg j))) (qfc false) (fn ((j I)) (quote (sys))) x1 (civneg r))))
      (mk-comp n (fn ((i I)) (E i (V i))) phi (fn ((i I)) (mk-app (u i) (V i))) (mk-app cap (V (qiv 0))))))))
(defn sigma-comp ((m L) (n L) (D (-> I C)) (E (-> I C C)) (phi F) (u (-> I C)) cap)
  (let ((Af (-> I C)) (fn ((r I)) (fill m D phi (fn ((i I)) (mk-fst (u i))) (mk-fst cap) r)))
    (mk-pair (clmax m n) (Af (qiv 1))
      (mk-comp n (fn ((i I)) (E i (Af i))) phi (fn ((i I)) (mk-snd (u i))) (mk-snd cap))
      (mk-sigma m n (D (qiv 1)) (fn (x1) (E (qiv 1) x1))))))
(defn path-comp ((n L) (B (-> I I C)) (lft (-> I C)) (rgt (-> I C)) (phi F) (u (-> I C)) cap)
  (mk-plam (fn ((j I))
    (let ((j0 F) (cfcend 0 j))
      (let ((j1 F) (cfcend 1 j))
        (mk-comp n (fn ((i I)) (B i j)) (cfcor phi (cfcor j0 j1))
          (fn ((i I)) (sys3 phi (mk-papp n (fn ((k I)) (B i k)) (lft i) (rgt i) (u i) j) j0 (lft i) j1 (rgt i)))
          (mk-papp n (fn ((k I)) (B (qiv 0) k)) (lft (qiv 0)) (rgt (qiv 0)) cap j)))))))
(defn univ-comp ((l L) (phi F) (u (-> I C)) cap)
  (mk-glue l cap phi (u (qiv 1)) (line-equiv l (fn ((i I)) (u (civneg i))))))
(defn glue-comp ((n L) (jv I) (A (-> I C)) (alpha (-> I F)) (T (-> I C)) (e (-> I C)) (psi F) (u (-> I C)) cap)
  (let (A1 (A (qiv 1))) (let (T1 (T (qiv 1))) (let (e1 (e (qiv 1))) (let ((alpha1 F) (alpha (qiv 1)))
  (let (a0 (mk-unglue n (A (qiv 0)) (alpha (qiv 0)) (T (qiv 0)) (e (qiv 0)) cap))
  (let ((Afill (-> I C)) (fn ((r I)) (fill n A psi (fn ((i I)) (mk-unglue n (A i) (alpha i) (T i) (e i) (u i))) a0 r)))
  (let (a1 (Afill (qiv 1)))
  (let ((delta F) (cforall jv (alpha jv)))
  (let ((Tfill (-> I C)) (fn ((r I)) (fill n T psi u cap r)))
  (let (omega (mk-plam (fn ((q I))
                (mk-comp n A (cfcor psi (cfcor (cfcend 0 q) (cfcend 1 q)))
                  (fn ((i I)) (sys3 psi (Afill i) (cfcend 0 q) (mk-app (equiv-map n n (T i) (A i) (e i)) (Tfill i)) (cfcend 1 q) (Afill i)))
                  a0))))
  (let (f1 (equiv-map n n T1 A1 e1))
  (let (fibre (fib n n T1 A1 f1 a1))
  (let (contraction (equiv-contr n n T1 A1 e1 a1))
  (let (extension (extend-contr n fibre (mk-fst contraction) (mk-snd contraction) (cfcor delta psi)
                     (sys2 delta (mk-pair n (Tfill (qiv 1)) omega fibre) psi (mk-pair n (u (qiv 1)) (refl n A1 a1) fibre))))
  (let (t1 (mk-fst extension))
  (let (p (mk-snd extension))
    (mk-glue-intro n A1 alpha1 T1 e1 t1
      (hcomp n A1 (cfcor alpha1 psi) (fn ((q I)) (sys2 alpha1 (papp-const n A1 (mk-app f1 t1) a1 p (civneg q)) psi a1)) a1)))))))))))))))))))

;  ---------------- systems
; The value under χ of a system: its first branch χ entails; otherwise the
; system itself (a system value, each branch under χ ∧ its guard).
(defn consistent ((chi F) (p F) t f) (ceq (cfcand chi p) (qfc false) f t))
(defn sys-first ((k 1) (chi F) s none)
  (cmatch sys s (fn ((p F) t rest) (cent chi p (k t) (sys-first k chi rest none))) none))
(defn sys-join ((chi F) s) F
  (cmatch sys s (fn ((p F) t rest)
      (ceq (cfcand chi p) (qfc false) (sys-join chi rest) (cfcor p (sys-join chi rest))))
    (qfc false)))
(defn sys-append (a b)
  (cmatch sys a (fn ((q F) w rest) (csyscons q w (sys-append rest b))) b))
; the branches consistent with χ, f applied to each term
(defn sys-map ((f 1) (chi F) s)
  (cmatch sys s (fn ((p F) t rest) (consistent chi p (csyscons p (f t) (sys-map f chi rest)) (sys-map f chi rest))) (quote (sys))))
; a value v under the guard p as branches: a system's branches consistent with
; χ ∧ p, guarded by p ∧ ψ; another value one branch
(defn flat-in ((cp F) (p F) s)
  (cmatch sys s (fn ((q F) w rest) (consistent cp q (csyscons (cfcand p q) w (flat-in cp p rest)) (flat-in cp p rest))) (quote (sys))))
(defn flat ((chi F) (p F) v)
  (cmatch sys v (fn ((q F) w rest) (flat-in (cfcand chi p) p v))
  (cmatch sys0 v (quote (sys))
    (sys1 p v))))
; each branch of s evaluated under χ ∧ its guard, nested systems flattened
(defn branchwise ((ev (-> F C C)) (chi F) s)
  (cmatch sys s (fn ((p F) t rest)
      (sys-append (flat chi p (ev (cfcand chi p) t)) (branchwise ev chi rest)))
    (quote (sys))))
; an eliminator whose scrutinee is the system value v: rebuilt around each
; consistent branch, evaluated branchwise
(defn distribute ((ev (-> F C C)) (chi F) (rb 1) v) (branchwise ev chi (sys-map rb chi v)))

; ---------------- the evaluator
(defn comp-branches ((chi F) (jv I) c S)
  (cmatch sys S (fn ((g F) b rest)
      (consistent chi g
        (let ((G F) (cforall jv g))
          (consistent chi G
            (csyscons G (csetbi 0 c (fn ((j I)) (csubst b jv j))) (comp-branches chi jv c rest))
            (comp-branches chi jv c rest)))
        (comp-branches chi jv c rest)))
    (quote (sys))))
(defn eval-comp ((ev (-> F C C)) (chi F) c (n L) (A (-> I C)) (phi F) (u (-> I C)) cap)
  (cent chi phi (ev chi (u (qiv 1)))
    (let ((jv I) (cvari c))
      (let (Fm (ev chi (A jv)))
        (let ((at (-> C I C)) (fn (x (r I)) (csubst x jv r)))
        (let ((atf (-> F I F)) (fn ((x F) (r I)) (csubst x jv r)))
          (cmatch Pi Fm (fn (Dj (Ej 1))
              (clevels Fm (fn ((m L) (nn L)) (ev chi (pi-comp m nn (fn ((r I)) (at Dj r)) (fn ((r I) x) (cinst 1 (at Fm r) x)) phi u cap)))))
          (cmatch Sigma Fm (fn (Dj (Ej 1))
              (clevels Fm (fn ((m L) (nn L)) (ev chi (sigma-comp m nn (fn ((r I)) (at Dj r)) (fn ((r I) x) (cinst 1 (at Fm r) x)) phi u cap)))))
          (cmatch Path Fm (fn ((Bj (-> I C)) Lj Rj)
              (clevels Fm (fn ((m L) (nn L)) (ev chi (path-comp m (fn ((r I) (k I)) (cinsti 0 (at Fm r) k)) (fn ((r I)) (at Lj r)) (fn ((r I)) (at Rj r)) phi u cap)))))
          (cmatch Glue Fm (fn (Aj (alj F) Tj ej)
              (clevels Fm (fn ((m L) (nn L)) (ev chi (glue-comp m jv (fn ((r I)) (at Aj r)) (fn ((r I)) (atf alj r)) (fn ((r I)) (at Tj r)) (fn ((r I)) (at ej r)) phi u cap)))))
          (cmatch U Fm
              (clevels Fm (fn ((m L) (nn L)) (ev chi (univ-comp m phi u cap))))
          (cmatch sys Fm (fn ((g F) b rest)
              ; a family system: the composition in each branch available
              ; along the whole line (guard ∀j.g)
              (let (S (comp-branches chi jv c Fm))
                (sys-first (fn (x) (ev chi x)) chi S (branchwise ev chi S))))
            ; a stuck family: the residual, the family's value in place
            (csetbi 0 c (fn ((j I)) (csubst Fm jv j)))))))))))))))
; a code operation whose operands are values: its rule as one represented
; step, and evaluation continues from the step's result
(defn code-step ((ev (-> F C C)) (chi F) c)
  (let (s (cstep c)) (ceq s c c (ev chi s))))
(defn eval ((chi F) c)
  (cmatch app c (fn (f a)
      (let (v (eval chi f))
        (cmatch lam v (fn (A (b 1)) (eval chi (b a)))
        (cmatch sys v (fn ((q F) w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (cset 0 c v)))))
  (cmatch fst c (fn (p)
      (let (v (eval chi p))
        (cmatch pair v (fn (x y S) (eval chi x))
        (cmatch sys v (fn ((q F) w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (cset 0 c v)))))
  (cmatch snd c (fn (p)
      (let (v (eval chi p))
        (cmatch pair v (fn (x y S) (eval chi y))
        (cmatch sys v (fn ((q F) w rest) (distribute eval chi (fn (x) (cset 0 c x)) v))
          (cset 0 c v)))))
  (cmatch papp c (fn ((A (-> I C)) a b p (r I))
      (cent chi (cfcend 0 r) (eval chi a)
      (cent chi (cfcend 1 r) (eval chi b)
        (let (v (eval chi p))
          (cmatch plam v (fn ((t (-> I C))) (eval chi (t r)))
          (cmatch sys v (fn ((q F) w rest) (distribute eval chi (fn (x) (cset 3 c x)) v))
            (cset 3 c v)))))))
  (cmatch global c
      (cunfold c (fn (u) (eval chi u)) c)
  (cmatch sys c (fn ((p F) t rest) (sys-first (fn (x) (eval chi x)) chi c c))
  (cmatch Glue c (fn (A (phi F) T e) (cent chi phi (eval chi T) c))
  (cmatch glue c (fn (A (phi F) T e t a) (cent chi phi (eval chi t) c))
  (cmatch unglue c (fn (A (phi F) T e v)
      (cent chi phi (eval chi (mk-app (mk-fst e) v))
        (let (w (eval chi v))
          (cmatch glue w (fn (A2 (phi2 F) T2 e2 t a) (eval chi a))
          (cmatch sys w (fn ((q F) x rest) (distribute eval chi (fn (y) (cset 4 c y)) w))
            (cset 4 c w))))))
  (cmatch comp c (fn ((A (-> I C)) (phi F) (u (-> I C)) cap)
      (clevels c (fn ((n L) (m L)) (eval-comp eval chi c n A phi u cap))))
  ; the code operations: operands evaluated, then the operation's rule
  (cmatch cmatch c (fn (x h d) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch cinst c (fn (x a) (code-step eval chi (cset 1 (cset 0 c (eval chi x)) (eval chi a))))
  (cmatch cinsti c (fn (x a) (code-step eval chi (cset 1 (cset 0 c (eval chi x)) (eval chi a))))
  (cmatch cset c (fn (x d) (code-step eval chi (cset 1 (cset 0 c (eval chi x)) (eval chi d))))
  (cmatch csetb c (fn (x d) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch csetbi c (fn (x d) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch ceq c (fn (a b t f) (code-step eval chi (cset 1 (cset 0 c (eval chi a)) (eval chi b))))
  (cmatch cent c (fn (a b t f) (code-step eval chi (cset 1 (cset 0 c (eval chi a)) (eval chi b))))
  (cmatch cfcend c (fn (r) (code-step eval chi (cset 0 c (eval chi r))))
  (cmatch cunfold c (fn (x h d) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch clevels c (fn (x h) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch csetlv c (fn (x l m) (code-step eval chi (cset 2 (cset 1 (cset 0 c (eval chi x)) (eval chi l)) (eval chi m))))
  (cmatch clsucc c (fn (l) (code-step eval chi (cset 0 c (eval chi l))))
  (cmatch clmax c (fn (l m) (code-step eval chi (cset 1 (cset 0 c (eval chi l)) (eval chi m))))
  (cmatch cop c (fn (a b) (code-step eval chi (cset 1 (cset 0 c (eval chi a)) (eval chi b))))
  (cmatch csyscons c (fn (p t s) (code-step eval chi (cset 2 (cset 1 (cset 0 c (eval chi p)) (eval chi t)) (eval chi s))))
  (cmatch cvar c (fn (x) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch cvari c (fn (x) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch csubst c (fn (x v a) (code-step eval chi (cset 2 (cset 1 (cset 0 c (eval chi x)) (eval chi v)) (eval chi a))))
  (cmatch ctype c (fn (x) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch cpayload c (fn (x) (code-step eval chi (cset 0 c (eval chi x))))
  (cmatch cfield c (fn (f k) (code-step eval chi (cset 1 (cset 0 c (eval chi f)) (eval chi k))))
  (cmatch cquote c (fn (w) (code-step eval chi (cset 0 c (eval chi w))))
  (cmatch cstep c (fn (x) (code-step eval chi (cset 0 c (eval chi x))))
    c)))))))))))))))))))))))))))))))))))
