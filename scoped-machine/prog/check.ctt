; check.ctt — the type checker, a program of the language (after core.ctt).
;
; Types are codes; a variable's type is its declaration (ctype), so the
; context is the variables themselves: a binder is entered at the code of
; its own variable (cvar, cvari). A partial element has the type
; (Partial φ A): a variable of that type is used only under faces entailing
; φ, and checking against it checks under φ. Judgements return the code
; `ok` or `invalid`; inference returns a type's code or `invalid`. χ is the
; code of the face the judgement is made under.

(axiom ok (U 0))
(axiom invalid (U 0))
(defn bad? (v t f) (ceq v (quote invalid) t f))
(defn ok? (v t f) (ceq v (quote ok) t f))
(defn both (a b) (ok? a b a))
(defn on-false ((chi F) t f) (ceq chi (qfc false) t f))
(defn mk-univ ((l L)) (csetlv (quote (U 0)) l (qlv none)))
(defn leq ((l L) (k L) t f) (ceq (clmax l k) k t f))

; ---------------- conversion
(declare conv-w ((chi F) a b))
(declare conv-head ((chi F) a b))
(declare infer ((chi F) c))
(declare check ((chi F) c A))
(declare check-infer ((chi F) c a))
(declare infer-code ((chi F) c))
(defn sys-all ((chi F) s (k (-> F C C)))
  (cmatch sys s (fn ((p F) t rest)
      (consistent chi p (both (k (cfcand chi p) t) (sys-all chi rest k)) (sys-all chi rest k)))
    (quote ok)))
;  a path applied at an interval, for comparison only (conversion of a path
;  application reads its path and its interval)
(defn papp-at (p (r I)) (mk-papp (qlv none) (fn ((k I)) (quote hole)) (quote hole) (quote hole) p r))
(defn conv ((chi F) a0 b0)
  (on-false chi (quote ok)
  (ceq a0 b0 (quote ok)
    (let (a (eval chi a0))
      (let (b (eval chi b0))
        (ceq a b (quote ok) (conv-w chi a b)))))))
(defn conv-w ((chi F) a b)
  (cmatch sys a (fn ((p F) t rest) (sys-all chi a (fn ((c F) t) (conv c t b))))
  (cmatch sys b (fn ((p F) t rest) (sys-all chi b (fn ((c F) t) (conv c a t))))
  (cmatch lam a (fn (A (f 1)) (let (x (cvar a)) (conv chi (f x) (mk-app b x))))
  (cmatch lam b (fn (A (f 1)) (let (x (cvar b)) (conv chi (mk-app a x) (f x))))
  (cmatch pair a (fn (x y S) (both (conv chi x (mk-fst b)) (conv chi y (mk-snd b))))
  (cmatch pair b (fn (x y S) (both (conv chi (mk-fst a) x) (conv chi (mk-snd a) y)))
  (cmatch plam a (fn ((t (-> I C))) (let ((j I) (cvari a)) (conv chi (t j) (papp-at b j))))
  (cmatch plam b (fn ((t (-> I C))) (let ((j I) (cvari b)) (conv chi (papp-at a j) (t j))))
    (conv-head chi a b))))))))))
(defn conv-head ((chi F) a b)
  (cmatch Pi a (fn (A (B 1)) (cmatch Pi b (fn (A2 (B2 1))
      (both (conv chi A A2) (let (x (cvar a)) (conv chi (B x) (B2 x))))) (quote invalid)))
  (cmatch Sigma a (fn (A (B 1)) (cmatch Sigma b (fn (A2 (B2 1))
      (both (conv chi A A2) (let (x (cvar a)) (conv chi (B x) (B2 x))))) (quote invalid)))
  (cmatch Path a (fn ((P (-> I C)) l r) (cmatch Path b (fn ((P2 (-> I C)) l2 r2)
      (both (let ((j I) (cvari a)) (conv chi (P j) (P2 j))) (both (conv chi l l2) (conv chi r r2)))) (quote invalid)))
  (cmatch Partial a (fn ((p F) A) (cmatch Partial b (fn ((p2 F) A2)
      (ceq p p2 (conv (cfcand chi p) A A2) (quote invalid))) (quote invalid)))
  (cmatch Glue a (fn (A (phi F) T e) (cmatch Glue b (fn (A2 (phi2 F) T2 e2)
      (ceq phi phi2
        (both (conv chi A A2) (both (conv (cfcand chi phi) T T2) (conv (cfcand chi phi) e e2)))
        (quote invalid))) (quote invalid)))
  (cmatch glue a (fn (A (phi F) T e t x) (cmatch glue b (fn (A2 (phi2 F) T2 e2 t2 x2)
      (both (conv chi x x2) (conv (cfcand chi phi) t t2))) (quote invalid)))
  (cmatch app a (fn (f x) (cmatch app b (fn (f2 x2) (both (conv chi f f2) (conv chi x x2))) (quote invalid)))
  (cmatch fst a (fn (p) (cmatch fst b (fn (p2) (conv chi p p2)) (quote invalid)))
  (cmatch snd a (fn (p) (cmatch snd b (fn (p2) (conv chi p p2)) (quote invalid)))
  (cmatch papp a (fn ((A (-> I C)) l r p (s I)) (cmatch papp b (fn ((A2 (-> I C)) l2 r2 p2 (s2 I))
      (ceq s s2 (conv chi p p2) (quote invalid))) (quote invalid)))
  (cmatch unglue a (fn (A (phi F) T e v) (cmatch unglue b (fn (A2 (phi2 F) T2 e2 v2) (conv chi v v2)) (quote invalid)))
  (cmatch comp a (fn ((A (-> I C)) (phi F) (u (-> I C)) cap) (cmatch comp b (fn ((A2 (-> I C)) (phi2 F) (u2 (-> I C)) cap2)
      (ceq phi phi2
        (let ((j I) (cvari a))
          (both (conv chi (A j) (A2 j)) (both (conv (cfcand chi phi) (u j) (u2 j)) (conv chi cap cap2))))
        (quote invalid))) (quote invalid)))
    (quote invalid))))))))))))))
; T a subtype of A: universes by level (cumulativity), otherwise conversion
(defn sub ((chi F) T A)
  (let (t (eval chi T)) (let (a (eval chi A))
    (cmatch U t (cmatch U a
        (clevels t (fn ((l L) (m L)) (clevels a (fn ((k L) (n L)) (leq l k (quote ok) (quote invalid))))))
        (conv chi t a))
      (conv chi t a)))))

; ---------------- inference and checking
; the universe a type lives in, or invalid; with-level continues at its level
(defn sort-of ((chi F) A)
  (let (T (infer chi A))
    (bad? T T (let (t (eval chi T)) (cmatch U t t (quote invalid))))))
(defn with-level (u (k (-> L C))) (bad? u u (clevels u (fn ((l L) (m L)) (k l)))))
(defn infer-binder ((chi F) c A (B 1))
  (with-level (sort-of chi A) (fn ((lA L))
    (with-level (sort-of chi (B (cvar c))) (fn ((lB L)) (mk-univ (clmax lA lB)))))))
(defn infer ((chi F) c)
  (on-false chi (quote invalid)
  (cmatch var c
      ; a partial variable is used only under its face
      (let (T (ctype c)) (cmatch Partial (eval chi T) (fn ((p F) A) (cent chi p A (quote invalid))) T))
  (cmatch global c (ctype c)
  (cmatch U c (clevels c (fn ((l L) (m L)) (mk-univ (clsucc l))))
  (cmatch Pi c (fn (A (B 1)) (infer-binder chi c A B))
  (cmatch Sigma c (fn (A (B 1)) (infer-binder chi c A B))
  (cmatch Partial c (fn ((p F) A)
      (let ((c2 F) (cfcand chi p)) (on-false c2 (mk-univ (qlv 0)) (sort-of c2 A))))
  (cmatch lam c (fn (A (b 1))
      (with-level (sort-of chi A) (fn ((lA L))
        (let (x (cvar c))
          (let (Bx (infer chi (b x)))
            (bad? Bx Bx (mk-pi (qlv none) (qlv none) A (fn (y) (csubst Bx x y)))))))))
  (cmatch app c (fn (f a)
      (let (T (infer chi f))
        (bad? T T (cmatch Pi (eval chi T) (fn (A (B 1)) (ok? (check chi a A) (B a) (quote invalid))) (quote invalid)))))
  (cmatch pair c (fn (x y S)
      (ceq S (cnone)
        (let (A (infer chi x)) (let (B (infer chi y))
          (bad? A A (bad? B B (mk-sigma (qlv none) (qlv none) A (fn (z) B))))))
        (ok? (check chi c S) S (quote invalid))))
  (cmatch fst c (fn (p)
      (let (T (infer chi p)) (bad? T T (cmatch Sigma (eval chi T) (fn (A (B 1)) A) (quote invalid)))))
  (cmatch snd c (fn (p)
      (let (T (infer chi p)) (bad? T T (cmatch Sigma (eval chi T) (fn (A (B 1)) (B (mk-fst p))) (quote invalid)))))
  (cmatch Path c (fn ((A (-> I C)) a b)
      (with-level (sort-of chi (A (cvari c))) (fn ((l L))
        (both (check chi a (A (qiv 0))) (ok? (check chi b (A (qiv 1))) (mk-univ l) (quote invalid))))))
  (cmatch plam c (fn ((t (-> I C)))
      (let ((j I) (cvari c))
        (let (Tj (infer chi (t j)))
          (bad? Tj Tj (mk-path (qlv none) (fn ((i I)) (csubst Tj j i)) (t (qiv 0)) (t (qiv 1)))))))
  (cmatch papp c (fn ((A (-> I C)) a b p (r I))
      (ok? (check chi p (mk-path (qlv none) A a b)) (A r) (quote invalid)))
  (cmatch comp c (fn ((A (-> I C)) (phi F) (u (-> I C)) cap)
      (let ((j I) (cvari c))
        (with-level (sort-of chi (A j)) (fn ((l L))
          (ok? (both (check (cfcand chi phi) (u j) (A j))
                 (both (check chi cap (A (qiv 0)))
                       (conv (cfcand chi phi) (u (qiv 0)) cap)))
            (A (qiv 1)) (quote invalid))))))
  (cmatch Glue c (fn (A (phi F) T e)
      (with-level (sort-of chi A) (fn ((l L))
        (let ((c2 F) (cfcand chi phi))
          (ok? (both (check c2 T (mk-univ l)) (check c2 e (equiv l l T A))) (mk-univ l) (quote invalid))))))
  (cmatch glue c (fn (A (phi F) T e t a)
      (clevels c (fn ((n L) (m L))
        (ok? (both (check chi a A)
               (both (check (cfcand chi phi) t T)
                     (conv (cfcand chi phi) (mk-app (mk-fst e) t) a)))
          (mk-glue n A phi T e) (quote invalid)))))
  (cmatch unglue c (fn (A (phi F) T e v)
      (clevels c (fn ((n L) (m L)) (ok? (check chi v (mk-glue n A phi T e)) A (quote invalid)))))
  (cmatch sys c (fn ((p F) t rest) (sys-first (fn (x) (infer chi x)) chi c (quote invalid)))
    (infer-code chi c))))))))))))))))))))))
;  programs over codes: the types of codes are types; a code is data of its
;  kind's type; a code operation's operands are codes of the kinds it
;  takes, its branches of one type X; a cmatch handler has the type its
;  former's arguments give (cfield, the definition cmatch itself reads)
(defn code-kind? ((chi F) T t f) (cmatch Code (eval chi T) t f))
(defn fun-code (A X) (mk-pi (qlv none) (qlv none) A (fn (x) X)))
(defn arg-type ((d L))
  (ceq d (qlv 1) (quote (Code)) (ceq d (qlv 9) (quote (Code)) (ceq d (qlv 2) (quote (ICode)) (ceq d (qlv 3) (quote (FCode))
  (ceq d (qlv 4) (fun-code (quote (Code)) (quote (Code))) (ceq d (qlv 5) (fun-code (quote (ICode)) (quote (Code))) (cnone))))))))
(defn handler-type ((f L) X (k L))
  (let ((d L) (cfield f k))
    (ceq d (qlv 0) X (fun-code (arg-type d) (handler-type f X (clsucc k))))))
; operands checked at their kinds, then the result type
(defn at-kind ((chi F) a K r) (ok? (check chi a K) r (quote invalid)))
(defn ops2 ((chi F) a K b K2 r) (ok? (both (check chi a K) (check chi b K2)) r (quote invalid)))
(defn ops3 ((chi F) a K b K2 c K3 r) (ok? (both (check chi a K) (both (check chi b K2) (check chi c K3))) r (quote invalid)))
; branches t, f of one type X
(defn branches ((chi F) ops t f)
  (bad? ops ops (let (X (infer chi t)) (bad? X X (ok? (check chi f X) X (quote invalid))))))
(defn infer-code ((chi F) c)
  (cmatch Code c (mk-univ (qlv 0))
  (cmatch quote c (fn (t) (quote (Code)))
  (cmatch qiv c (fn ((r I)) (quote (ICode)))
  (cmatch qfc c (fn ((p F)) (quote (FCode)))
  (cmatch qlv c (quote (LCode))
  (cmatch cnone c (quote (Code))
  (cmatch cmatch c (fn (x h d)
      (let (T (infer chi x))
        (bad? T T (code-kind? chi T
          (let (X (infer chi d))
            (bad? X X (ok? (check chi h (handler-type (cpayload c) X (qlv 0))) X (quote invalid))))
          (quote invalid)))))
  (cmatch cinst c (fn (x a) (ops2 chi x (quote (Code)) a (quote (Code)) (quote (Code))))
  (cmatch cinsti c (fn (x a) (ops2 chi x (quote (Code)) a (quote (ICode)) (quote (Code))))
  (cmatch cset c (fn (x d)
      (let (K (infer chi d)) (bad? K K (code-kind? chi K (at-kind chi x (quote (Code)) (quote (Code))) (quote invalid)))))
  (cmatch csetb c (fn (x d) (ops2 chi x (quote (Code)) d (fun-code (quote (Code)) (quote (Code))) (quote (Code))))
  (cmatch csetbi c (fn (x d) (ops2 chi x (quote (Code)) d (fun-code (quote (ICode)) (quote (Code))) (quote (Code))))
  (cmatch ceq c (fn (a b t f)
      (let (K (infer chi a)) (bad? K K (code-kind? chi K (branches chi (check chi b K) t f) (quote invalid)))))
  (cmatch cent c (fn (a b t f) (branches chi (both (check chi a (quote (FCode))) (check chi b (quote (FCode)))) t f))
  (cmatch cfcend c (fn (r) (at-kind chi r (quote (ICode)) (quote (FCode))))
  (cmatch cunfold c (fn (x h d)
      (let (X (infer chi d))
        (bad? X X (ops2 chi x (quote (Code)) h (fun-code (quote (Code)) X) X))))
  (cmatch clevels c (fn (x h)
      (let (T (infer chi h))
        (bad? T T (cmatch Pi (eval chi T) (fn (A (B 1))
            (let (T2 (eval chi (B (cvar (eval chi T)))))
              (cmatch Pi T2 (fn (A2 (B2 1))
                  (let (X (B2 (cvar T2)))
                    (ops2 chi x (quote (Code)) h (fun-code (quote (LCode)) (fun-code (quote (LCode)) X)) X)))
                (quote invalid))))
          (quote invalid)))))
  (cmatch csetlv c (fn (x l m) (ops3 chi x (quote (Code)) l (quote (LCode)) m (quote (LCode)) (quote (Code))))
  (cmatch clsucc c (fn (l) (at-kind chi l (quote (LCode)) (quote (LCode))))
  (cmatch clmax c (fn (l m) (ops2 chi l (quote (LCode)) m (quote (LCode)) (quote (LCode))))
  (cmatch cop c (fn (a b)
      (let ((o L) (cpayload c))
        (ceq o (qlv 1) (at-kind chi a (quote (ICode)) (quote (ICode)))
        (ceq o (qlv 2) (ops2 chi a (quote (ICode)) b (quote (ICode)) (quote (ICode)))
        (ceq o (qlv 3) (ops2 chi a (quote (ICode)) b (quote (ICode)) (quote (ICode)))
        (ceq o (qlv 6) (ops2 chi a (quote (ICode)) b (quote (FCode)) (quote (FCode)))
          (ops2 chi a (quote (FCode)) b (quote (FCode)) (quote (FCode)))))))))
  (cmatch csyscons c (fn (p t r) (ops3 chi p (quote (FCode)) t (quote (Code)) r (quote (Code)) (quote (Code))))
  (cmatch cvar c (fn (x) (at-kind chi x (quote (Code)) (quote (Code))))
  (cmatch cvari c (fn (x) (at-kind chi x (quote (Code)) (quote (ICode))))
  (cmatch csubst c (fn (x v a)
      (let (K (infer chi v)) (let (K2 (infer chi x))
        (bad? K K (bad? K2 K2 (code-kind? chi K (code-kind? chi K2 (at-kind chi a K K2) (quote invalid)) (quote invalid)))))))
  (cmatch ctype c (fn (x) (at-kind chi x (quote (Code)) (quote (Code))))
  (cmatch cpayload c (fn (x) (at-kind chi x (quote (Code)) (quote (LCode))))
  (cmatch cfield c (fn (f k) (ops2 chi f (quote (LCode)) k (quote (LCode)) (quote (LCode))))
  (cmatch cquote c (fn (w) (let (K (infer chi w)) (bad? K K (code-kind? chi K (quote (Code)) (quote invalid)))))
  (cmatch cstep c (fn (x) (at-kind chi x (quote (Code)) (quote (Code))))
    (quote invalid))))))))))))))))))))))))))))))))
; the pairwise agreement of a system's branches, each pair under both guards
(defn sys-agree ((chi F) s)
  (cmatch sys s (fn ((p F) t rest)
      (both (sys-all (cfcand chi p) rest (fn ((c F) u) (conv c t u))) (sys-agree chi rest)))
    (quote ok)))
(defn check ((chi F) c A)
  (on-false chi (quote ok)
  (let (a (eval chi A))
  (cmatch Partial a (fn ((p F) A2) (check (cfcand chi p) c A2))
  (cmatch lam c (fn (D (b 1))
      (cmatch Pi a (fn (D2 (B 1))
          ; the λ's declared domain is a type (the premise of its binder), and is the expected one
          (with-level (sort-of chi D) (fn ((l L))
            (let (x (cvar c)) (both (conv chi D D2) (check chi (b x) (B x))))))) (quote invalid)))
  (cmatch pair c (fn (x y S)
      (cmatch Sigma a (fn (D (B 1)) (both (check chi x D) (check chi y (B x)))) (check-infer chi c a)))
  (cmatch plam c (fn ((t (-> I C)))
      (cmatch Path a (fn ((P (-> I C)) l r)
          (let ((j I) (cvari c)) (both (check chi (t j) (P j)) (both (conv chi (t (qiv 0)) l) (conv chi (t (qiv 1)) r)))))
        (quote invalid)))
  (cmatch sys c (fn ((p F) t rest)
      (cent chi (sys-join chi c)
        (both (sys-all chi c (fn ((c2 F) u) (check c2 u a))) (sys-agree chi c))
        (quote invalid)))
    (check-infer chi c a)))))))))
(defn check-infer ((chi F) c a) (let (T (infer chi c)) (bad? T T (sub chi T a))))
