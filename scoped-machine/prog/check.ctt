; check.ctt — the type checker, a program of the language (after core.ctt).
;
; Types are codes; a variable's type is its declaration (ctype), so the
; context is the variables themselves: a binder is entered at the code of
; its own variable (cvar). Judgements return the code `ok` or `invalid`;
; inference returns a type's code or `invalid`. χ is the code of the face
; the judgement is made under.

(axiom ok (U 0))
(defn ok? (v t f) (ceq v (quote ok) t f))
(defn both (a b) (ok? a b a))
(defn on-false (chi t f) (ceq chi (qfc false) t f))
(defn mk-univ (l) (csetlv (quote (U 0)) l (qlv none)))
(defn leq (l k t f) (ceq (clmax l k) k t f))

; ---------------- conversion
(declare conv-w (chi a b))
(declare conv-head (chi a b))
(declare infer (chi c))
(declare check (chi c A))
(declare check-infer (chi c a))
(defn sys-all (chi s (k 2))
  (cmatch sys s (fn (p t rest)
      (consistent chi p (both (k (cfcand chi p) t) (sys-all chi rest k)) (sys-all chi rest k)))
    (quote ok)))
;  a path applied at an interval, for comparison only (conversion of a path
;  application reads its path and its interval)
(defn papp-at (p r) (mk-papp (qlv none) (fn (k) (quote hole)) (quote hole) (quote hole) p r))
(defn conv (chi a0 b0)
  (on-false chi (quote ok)
  (ceq a0 b0 (quote ok)
    (let (a (eval chi a0))
      (let (b (eval chi b0))
        (bad? a a (bad? b b
          (ceq a b (quote ok) (conv-w chi a b)))))))))
(defn conv-w (chi a b)
  (cmatch sys a (fn (p t rest) (sys-all chi a (fn (c t) (conv c t b))))
  (cmatch sys b (fn (p t rest) (sys-all chi b (fn (c t) (conv c a t))))
  (cmatch lam a (fn (A (f 1)) (let (x (cvar a)) (conv chi (f x) (mk-app b x))))
  (cmatch lam b (fn (A (f 1)) (let (x (cvar b)) (conv chi (mk-app a x) (f x))))
  (cmatch pair a (fn (x y S) (both (conv chi x (mk-fst b)) (conv chi y (mk-snd b))))
  (cmatch pair b (fn (x y S) (both (conv chi (mk-fst a) x) (conv chi (mk-snd a) y)))
  (cmatch plam a (fn ((t 1)) (let (j (cvar a)) (conv chi (t j) (papp-at b j))))
  (cmatch plam b (fn ((t 1)) (let (j (cvar b)) (conv chi (papp-at a j) (t j))))
    (conv-head chi a b))))))))))
(defn conv-head (chi a b)
  (cmatch Pi a (fn (A (B 1)) (cmatch Pi b (fn (A2 (B2 1))
      (both (conv chi A A2) (let (x (cvar a)) (conv chi (B x) (B2 x))))) (quote invalid)))
  (cmatch Sigma a (fn (A (B 1)) (cmatch Sigma b (fn (A2 (B2 1))
      (both (conv chi A A2) (let (x (cvar a)) (conv chi (B x) (B2 x))))) (quote invalid)))
  (cmatch Path a (fn ((P 1) l r) (cmatch Path b (fn ((P2 1) l2 r2)
      (both (let (j (cvar a)) (conv chi (P j) (P2 j))) (both (conv chi l l2) (conv chi r r2)))) (quote invalid)))
  (cmatch plam a (fn ((t 1)) (cmatch plam b (fn ((t2 1))
      (let (j (cvar a)) (conv chi (t j) (t2 j)))) (quote invalid)))
  (cmatch Glue a (fn (A phi T e) (cmatch Glue b (fn (A2 phi2 T2 e2)
      (ceq phi phi2
        (both (conv chi A A2) (both (conv (cfcand chi phi) T T2) (conv (cfcand chi phi) e e2)))
        (quote invalid))) (quote invalid)))
  (cmatch glue a (fn (A phi T e t x) (cmatch glue b (fn (A2 phi2 T2 e2 t2 x2)
      (both (conv chi x x2) (conv (cfcand chi phi) t t2))) (quote invalid)))
  (cmatch app a (fn (f x) (cmatch app b (fn (f2 x2) (both (conv chi f f2) (conv chi x x2))) (quote invalid)))
  (cmatch fst a (fn (p) (cmatch fst b (fn (p2) (conv chi p p2)) (quote invalid)))
  (cmatch snd a (fn (p) (cmatch snd b (fn (p2) (conv chi p p2)) (quote invalid)))
  (cmatch papp a (fn ((A 1) l r p s) (cmatch papp b (fn ((A2 1) l2 r2 p2 s2)
      (ceq s s2 (conv chi p p2) (quote invalid))) (quote invalid)))
  (cmatch unglue a (fn (A phi T e v) (cmatch unglue b (fn (A2 phi2 T2 e2 v2) (conv chi v v2)) (quote invalid)))
  (cmatch comp a (fn ((A 1) phi (u 1) cap) (cmatch comp b (fn ((A2 1) phi2 (u2 1) cap2)
      (ceq phi phi2
        (let (j (cvar a))
          (both (conv chi (A j) (A2 j)) (both (conv (cfcand chi phi) (u j) (u2 j)) (conv chi cap cap2))))
        (quote invalid))) (quote invalid)))
    (quote invalid))))))))))))))
; T a subtype of A: universes by level (cumulativity), otherwise conversion
(defn sub (chi T A)
  (let (t (eval chi T)) (let (a (eval chi A))
    (cmatch U t (cmatch U a
        (clevels t (fn (l m) (clevels a (fn (k n) (leq l k (quote ok) (quote invalid))))))
        (conv chi t a))
      (conv chi t a)))))

; ---------------- inference and checking
; the level of a type, or invalid
(defn sort-of (chi A)
  (let (T (infer chi A))
    (bad? T T (let (t (eval chi T)) (cmatch U t (clevels t (fn (l m) l)) (quote invalid))))))
(defn with-level (l (k 1)) (bad? l l (k l)))
(defn infer-binder (chi c A (B 1))
  (with-level (sort-of chi A) (fn (lA)
    (with-level (sort-of chi (B (cvar c))) (fn (lB) (mk-univ (clmax lA lB)))))))
(defn infer (chi c)
  (on-false chi (quote invalid)
  (cmatch var c (ctype c)
  (cmatch global c (ctype c)
  (cmatch U c (clevels c (fn (l m) (mk-univ (clsucc l))))
  (cmatch Pi c (fn (A (B 1)) (infer-binder chi c A B))
  (cmatch Sigma c (fn (A (B 1)) (infer-binder chi c A B))
  (cmatch lam c (fn (A (b 1))
      (with-level (sort-of chi A) (fn (lA)
        (let (x (cvar c))
          (let (Bx (infer chi (b x)))
            (bad? Bx Bx (mk-pi (qlv none) (qlv none) A (fn (y) (csubst Bx x y)))))))))
  (cmatch app c (fn (f a)
      (let (T (infer chi f))
        (bad? T T (cmatch Pi (eval chi T) (fn (A (B 1)) (ok? (check chi a A) (B a) (quote invalid))) (quote invalid)))))
  (cmatch pair c (fn (x y S)
      (ceq S (qlv none)
        (let (A (infer chi x)) (let (B (infer chi y))
          (bad? A A (bad? B B (mk-sigma (qlv none) (qlv none) A (fn (z) B))))))
        (ok? (check chi c S) S (quote invalid))))
  (cmatch fst c (fn (p)
      (let (T (infer chi p)) (bad? T T (cmatch Sigma (eval chi T) (fn (A (B 1)) A) (quote invalid)))))
  (cmatch snd c (fn (p)
      (let (T (infer chi p)) (bad? T T (cmatch Sigma (eval chi T) (fn (A (B 1)) (B (mk-fst p))) (quote invalid)))))
  (cmatch Path c (fn ((A 1) a b)
      (with-level (sort-of chi (A (cvar c))) (fn (l)
        (both (check chi a (A (qiv 0))) (ok? (check chi b (A (qiv 1))) (mk-univ l) (quote invalid))))))
  (cmatch plam c (fn ((t 1))
      (let (j (cvar c))
        (let (Tj (infer chi (t j)))
          (bad? Tj Tj (mk-path (qlv none) (fn (i) (csubst Tj j i)) (t (qiv 0)) (t (qiv 1)))))))
  (cmatch papp c (fn ((A 1) a b p r)
      (ok? (check chi p (mk-path (qlv none) A a b)) (A r) (quote invalid)))
  (cmatch comp c (fn ((A 1) phi (u 1) cap)
      (let (j (cvar c))
        (with-level (sort-of chi (A j)) (fn (l)
          (ok? (both (check (cfcand chi phi) (u j) (A j))
                 (both (check chi cap (A (qiv 0)))
                       (conv (cfcand chi phi) (u (qiv 0)) cap)))
            (A (qiv 1)) (quote invalid))))))
  (cmatch Glue c (fn (A phi T e)
      (with-level (sort-of chi A) (fn (l)
        (let (c2 (cfcand chi phi))
          (ok? (both (check c2 T (mk-univ l)) (check c2 e (equiv l l T A))) (mk-univ l) (quote invalid))))))
  (cmatch glue c (fn (A phi T e t a)
      (clevels c (fn (n m)
        (ok? (both (check chi a A)
               (both (check (cfcand chi phi) t T)
                     (conv (cfcand chi phi) (mk-app (mk-fst e) t) a)))
          (mk-glue n A phi T e) (quote invalid)))))
  (cmatch unglue c (fn (A phi T e v)
      (clevels c (fn (n m) (ok? (check chi v (mk-glue n A phi T e)) A (quote invalid)))))
  (cmatch sys c (fn (p t rest) (sys-first (fn (x) (infer chi x)) chi c (quote invalid)))
    (quote invalid)))))))))))))))))))))
; the pairwise agreement of a system's branches, each pair under both guards
(defn sys-agree (chi s)
  (cmatch sys s (fn (p t rest)
      (both (sys-all (cfcand chi p) rest (fn (c u) (conv c t u))) (sys-agree chi rest)))
    (quote ok)))
(defn check (chi c A)
  (on-false chi (quote ok)
  (let (a (eval chi A))
  (bad? a a
  (cmatch lam c (fn (D (b 1))
      (cmatch Pi a (fn (D2 (B 1)) (let (x (cvar c)) (both (conv chi D D2) (check chi (b x) (B x))))) (quote invalid)))
  (cmatch pair c (fn (x y S)
      (cmatch Sigma a (fn (D (B 1)) (both (check chi x D) (check chi y (B x)))) (check-infer chi c a)))
  (cmatch plam c (fn ((t 1))
      (cmatch Path a (fn ((P 1) l r)
          (let (j (cvar c)) (both (check chi (t j) (P j)) (both (conv chi (t (qiv 0)) l) (conv chi (t (qiv 1)) r)))))
        (quote invalid)))
  (cmatch sys c (fn (p t rest)
      (cent chi (sys-join chi c)
        (both (sys-all chi c (fn (c2 u) (check c2 u a))) (sys-agree chi c))
        (quote invalid)))
    (check-infer chi c a)))))))))
(defn check-infer (chi c a) (let (T (infer chi c)) (bad? T T (sub chi T a))))
