; an ordering of the whole is the interleaving with an ordering of each run
(checked il-fact (Pi ((a Nat) (b Nat)) (PathP (plam i Nat) (times (il a b) (times (fact a) (fact b))) (fact (plus a b))))
  (lam a (elim (lam y (Pi b Nat (PathP (plam i Nat) (times (il y b) (times (fact y) (fact b))) (fact (plus y b))))) a
    ((zero) (lam b (transN (times (suc zero) (times (suc zero) (fact b))) (times (suc zero) (fact b)) (fact b)
