  (lam k (elim (lam y (PathP (plam i Nat) (cost (bal y)) (times y (pow (suc (suc zero)) y)))) k
    ((zero) (plam i zero))
    ((suc j) (transN (plus (plus (size (bal j)) (size (bal j))) (plus (cost (bal j)) (cost (bal j))))
                     (plus (plus (pow (suc (suc zero)) j) (pow (suc (suc zero)) j)) (plus (times j (pow (suc (suc zero)) j)) (times j (pow (suc (suc zero)) j))))
                     (times (suc j) (times (suc (suc zero)) (pow (suc (suc zero)) j)))
       (cong2N plus (plus (size (bal j)) (size (bal j))) (plus (pow (suc (suc zero)) j) (pow (suc (suc zero)) j))
                    (plus (cost (bal j)) (cost (bal j))) (plus (times j (pow (suc (suc zero)) j)) (times j (pow (suc (suc zero)) j)))
         (cong2N plus (size (bal j)) (pow (suc (suc zero)) j) (size (bal j)) (pow (suc (suc zero)) j) (size-bal j) (size-bal j))
         (cong2N plus (cost (bal j)) (times j (pow (suc (suc zero)) j)) (cost (bal j)) (times j (pow (suc (suc zero)) j)) (rec j) (rec j)))
       (cost-bal-step j (pow (suc (suc zero)) j)))))))
