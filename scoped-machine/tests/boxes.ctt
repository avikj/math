; tests/boxes.ctt — the paper's checked Agda terms (docs/index.html), stated and proved in
; the machine's language and checked by lib/check.ctt over lib/std.ctt. Module parameters
; become leading Π-binders; records become Σ-types with projections; implicit arguments
; are explicit; Type ℓ is (U l).

; ---- box 0 (0.8): the singleton is contractible
(checked singleton-contractible (Pi ((l Level) (A (U l)) (x A)) (isContr l (Sigma y A (PathP (plam i A) x y))))
  (lam l A x (pair (pair x (plam i x)) (lam z (plam i (pair (@ (snd z) i) (plam j (@ (snd z) (/\ i j)))))))))

; ---- box 2 (1.2): every map is the partition of its domain by its output
(checked partition (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B))) (Equiv l l A (Sigma b B (fiber l l A B f b))))
  (lam l A B f (isoToEquiv l A (Sigma b B (fiber l l A B f b))
     (lam a (pair (f a) (pair a (plam i (f a)))))
     (lam z (fst (snd z)))
     (lam z (plam i (pair (@ (snd (snd z)) i) (pair (fst (snd z)) (plam j (@ (snd (snd z)) (/\ i j)))))))
     (lam a (plam i a)))))

; ---- box 3 (3.2): every reversible operation is a transport
(checked its-equivalence (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (g (Pi b B A))
                              (fg (Pi b B (PathP (plam i B) (f (g b)) b))) (gf (Pi a A (PathP (plam i A) (g (f a)) a))))
    (Equiv l l A B))
  (lam l A B f g fg gf (isoToEquiv l A B f g fg gf)))
(checked its-path (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (g (Pi b B A))
                       (fg (Pi b B (PathP (plam i B) (f (g b)) b))) (gf (Pi a A (PathP (plam i A) (g (f a)) a))))
    (PathP (plam i (U l)) A B))
  (lam l A B f g fg gf (ua l A B (its-equivalence l A B f g fg gf))))
(checked reversible-is-transport (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (g (Pi b B A))
                       (fg (Pi b B (PathP (plam i B) (f (g b)) b))) (gf (Pi a A (PathP (plam i A) (g (f a)) a))) (a A))
    (PathP (plam i B) (transport l A B (its-path l A B f g fg gf) a) (f a)))
  (lam l A B f g fg gf a (uaβ l A B (its-equivalence l A B f g fg gf) a)))
(checked the-path-is-unique (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (g (Pi b B A))
                       (fg (Pi b B (PathP (plam i B) (f (g b)) b))) (gf (Pi a A (PathP (plam i A) (g (f a)) a))))
    (PathP (plam i (Equiv l l A B)) (pathToEquiv l A B (its-path l A B f g fg gf)) (its-equivalence l A B f g fg gf)))
  (lam l A B f g fg gf (pathToEquiv-ua l A B (its-equivalence l A B f g fg gf))))

; ---- box 4 (3.5): a grading on a group vanishes
(checked +≡0→≡0 (Pi ((m Nat) (n Nat) (p (PathP (plam i Nat) (plus m n) zero))) (PathP (plam i Nat) m zero))
  (lam m n p ((elim (lam y (Pi q (PathP (plam i Nat) (plus y n) zero) (PathP (plam i Nat) y zero))) m
                ((zero) (lam q (plam i zero)))
                ((suc k) (lam q (Empty-rec lzero (PathP (plam i Nat) (suc k) zero) (snotz (plus k n) q)))))
              p)))
(checked grading-vanishes (Pi ((G U) (op (Pi g G (Pi h G G))) (e G) (inv (Pi g G G))
                               (invr (Pi g G (PathP (plam i G) (op g (inv g)) e)))
                               (len (Pi g G Nat)) (lene (PathP (plam i Nat) (len e) zero))
                               (lenop (Pi g G (Pi h G (PathP (plam i Nat) (len (op g h)) (plus (len g) (len h))))))
                               (g G))
    (PathP (plam i Nat) (len g) zero))
  (lam G op e inv invr len lene lenop g
    (+≡0→≡0 (len g) (len (inv g))
      (transN (plus (len g) (len (inv g))) (len (op g (inv g))) zero
        (symN (len (op g (inv g))) (plus (len g) (len (inv g))) (lenop g (inv g)))
        (transN (len (op g (inv g))) (len e) zero
          (plam i (len (@ (invr g) i)))
          lene)))))

; ---- box 6 (4.2): Lawvere's fixed point theorem, Cantor
(checked PtSurj (Pi ((A U) (B U) (phi (Pi a A (Pi b A B)))) U)
  (lam A B phi (Pi g (Pi a A B) (Sigma a A (PathP (plam i (Pi x A B)) (phi a) g)))))
(checked twist (Pi ((A U) (B U) (phi (Pi a A (Pi b A B))) (f (Pi b B B))) (Pi a A B))
  (lam A B phi f a (f (phi a a))))
(checked lawvere-one-row (Pi ((A U) (B U) (phi (Pi a A (Pi b A B))) (f (Pi b B B))
                              (row (Sigma a A (PathP (plam i (Pi x A B)) (phi a) (twist A B phi f)))))
    (Sigma b B (PathP (plam i B) (f b) b)))
  (lam A B phi f row (pair (phi (fst row) (fst row)) (plam i ((@ (snd row) (~ i)) (fst row))))))
(checked lawvere (Pi ((A U) (B U) (phi (Pi a A (Pi b A B))) (surj (PtSurj A B phi)) (f (Pi b B B)))
    (Sigma b B (PathP (plam i B) (f b) b)))
  (lam A B phi surj f (lawvere-one-row A B phi f (surj (twist A B phi f)))))
(checked noFix→noPtSurj (Pi ((A U) (B U) (phi (Pi a A (Pi b A B))) (f (Pi b B B))
                             (nofix (Pi b B (Neg (PathP (plam i B) (f b) b)))))
    (Neg (PtSurj A B phi)))
  (lam A B phi f nofix surj (nofix (fst (lawvere A B phi surj f)) (snd (lawvere A B phi surj f)))))
(checked not-no-fix (Pi b Bool (Neg (PathP (plam i Bool) (not b) b)))
  (lam b (elim (lam y (Neg (PathP (plam i Bool) (not y) y))) b
    ((true) (lam p (true≢false (plam i (@ p (~ i))))))
    ((false) (lam p (true≢false p))))))
(checked cantor (Pi ((A U) (phi (Pi a A (Pi b A Bool)))) (Neg (PtSurj A Bool phi)))
  (lam A phi (noFix→noPtSurj A Bool phi not not-no-fix)))

; ---- box 11 (7.2): the quarter-turn squares to negation, on the nose
(checked sigma (Pi p (Sigma x Int Int) (Sigma x Int Int)) (lam p (pair (negZ (snd p)) (fst p))))
(checked sigma²≡neg (Pi p (Sigma x Int Int) (PathP (plam i (Sigma x Int Int)) (sigma (sigma p)) (pair (negZ (fst p)) (negZ (snd p)))))
  (lam p (plam i (pair (negZ (fst p)) (negZ (snd p))))))

; ---- box 12 (8.6): decide = verify
(checked decide (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (a A)) (Sigma b B (fiber l l A B f b)))
  (lam l A B f a (pair (f a) (pair a (plam i (f a))))))
(checked verify (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (z (Sigma b B (fiber l l A B f b)))) A)
  (lam l A B f z (fst (snd z))))
(checked verify-inverts-decide (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (a A))
    (PathP (plam i A) (verify l A B f (decide l A B f a)) a))
  (lam l A B f a (plam i a)))
(checked witness-self-certifies (Pi ((l Level) (A (U l)) (B (U l)) (f (Pi a A B)) (a A))
    (PathP (plam i (PathP (plam j B) (f a) (f a))) (snd (snd (decide l A B f a))) (plam j (f a))))
  (lam l A B f a (plam i (plam j (f a)))))

; ---- box 7 (4.6–4.9): Gödel, from consistency, D1 and the fixed point; a countermodel; the diagonal
(checked NegL (Pi ((l Level) (A (U l))) (U l)) (lam l A (Pi a A Empty)))
(checked Theory (Pi l Level (U (lsuc l)))
  (lam l (Sigma Sent (U l) (Sigma Pf (Pi s Sent (U l)) (Sigma neg (Pi s Sent Sent) (Pi s Sent Sent))))))
(checked Sent (Pi ((l Level) (T (Theory l))) (U l)) (lam l T (fst T)))
(checked Pf (Pi ((l Level) (T (Theory l)) (s (Sent l T))) (U l)) (lam l T s ((fst (snd T)) s)))
(checked neg (Pi ((l Level) (T (Theory l)) (s (Sent l T))) (Sent l T)) (lam l T s ((fst (snd (snd T))) s)))
(checked prov (Pi ((l Level) (T (Theory l)) (s (Sent l T))) (Sent l T)) (lam l T s ((snd (snd (snd T))) s)))
(checked Consistent (Pi ((l Level) (T (Theory l))) (U l))
  (lam l T (Pi s (Sent l T) (Pi a (Pf l T s) (Pi b (Pf l T (neg l T s)) Empty)))))
(checked HBL1 (Pi ((l Level) (T (Theory l))) (U l))
  (lam l T (Pi s (Sent l T) (Pi a (Pf l T s) (Pf l T (prov l T s))))))
(checked GoedelFix (Pi ((l Level) (T (Theory l)) (G (Sent l T))) (U l))
  (lam l T G (Sigma fwd (Pi a (Pf l T G) (Pf l T (neg l T (prov l T G)))) (Pi b (Pf l T (neg l T (prov l T G))) (Pf l T G)))))
(checked OmegaBad (Pi ((l Level) (T (Theory l)) (G (Sent l T))) (U l))
  (lam l T G (Sigma a (Pf l T (prov l T G)) (NegL l (Pf l T G)))))
(checked Independent (Pi ((l Level) (T (Theory l)) (s (Sent l T))) (U l))
  (lam l T s (Sigma a (NegL l (Pf l T s)) (NegL l (Pf l T (neg l T s))))))
(checked goedelHalfOne (Pi ((l Level) (T (Theory l)) (G (Sent l T)) (con (Consistent l T)) (d1 (HBL1 l T)) (gf (GoedelFix l T G)))
    (NegL l (Pf l T G)))
  (lam l T G con d1 gf pG (con (prov l T G) (d1 G pG) ((fst gf) pG))))
(checked fixIsAlwaysVacuous (Pi ((l Level) (T (Theory l)) (G (Sent l T)) (con (Consistent l T)) (d1 (HBL1 l T)) (gf (GoedelFix l T G)))
    (Pi a (Pf l T G) (Pf l T (neg l T (prov l T G)))))
  (lam l T G con d1 gf pG (Empty-rec l (Pf l T (neg l T (prov l T G))) (goedelHalfOne l T G con d1 gf pG))))
(checked provNegEmpty (Pi ((l Level) (T (Theory l)) (G (Sent l T)) (con (Consistent l T)) (d1 (HBL1 l T)) (gf (GoedelFix l T G)))
    (NegL l (Pf l T (neg l T (prov l T G)))))
  (lam l T G con d1 gf pNP (goedelHalfOne l T G con d1 gf ((snd gf) pNP))))
; the countermodel: four sentences, consistency, D1 and the fixed point, and ⊢ ¬G
(checked-data (data W (wtop) (wbot) (wg) (wng)))
(checked wneg (Pi w W W) (lam w (case w ((wtop) wbot) ((wbot) wtop) ((wg) wng) ((wng) wg))))
(checked wPf (Pi w W U) (lam w (case w ((wtop) Unit) ((wbot) Empty) ((wg) Empty) ((wng) Unit))))
(checked Wit (Theory lzero) (pair W (pair wPf (pair wneg (lam s wtop)))))
(checked witCon (Consistent lzero Wit)
  (lam s (elim (lam y (Pi a (wPf y) (Pi b (wPf (wneg y)) Empty))) s
    ((wtop) (lam a b b)) ((wbot) (lam a b a)) ((wg) (lam a b a)) ((wng) (lam a b b)))))
(checked witHBL1 (HBL1 lzero Wit) (lam s p unit))
(checked witFix (GoedelFix lzero Wit wg) (pair (lam a (Empty-rec lzero Empty a)) (lam b (Empty-rec lzero Empty b))))
(checked witProvesNegG (wPf (wneg wg)) unit)
(checked noHalfTwo (Pi half2 (Pi ((T (Theory lzero)) (G (Sent lzero T)) (con (Consistent lzero T)) (d1 (HBL1 lzero T))
                                  (gf (GoedelFix lzero T G)))
                               (NegL lzero (Pf lzero T (neg lzero T G))))
                     Empty)
  (lam half2 (half2 Wit wg witCon witHBL1 witFix witProvesNegG)))
; representability, as the structure the diagonal lemma needs
(checked HasDiagonal (Pi ((l Level) (T (Theory l))) (U (lsuc l)))
  (lam l T (Sigma imp (Pi a (Sent l T) (Pi b (Sent l T) (Sent l T)))
    (Sigma mp (Pi a (Sent l T) (Pi b (Sent l T) (Pi h (Pf l T (imp a b)) (Pi x (Pf l T a) (Pf l T b)))))
    (Sigma Form (U l)
    (Sigma apF (Pi f Form (Pi s (Sent l T) (Sent l T)))
    (Sigma fix (Pi f Form (Sigma G (Sent l T) (Sigma h1 (Pf l T (imp G (apF f G))) (Pf l T (imp (apF f G) G)))))
    (Sigma negProv Form
      (Pi s (Sent l T) (PathP (plam i (Sent l T)) (apF negProv s) (neg l T (prov l T s))))))))))))
(checked dimp (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T)) (a (Sent l T)) (b (Sent l T))) (Sent l T))
  (lam l T D (fst D)))
(checked dmp (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T)) (a (Sent l T)) (b (Sent l T))
                  (h (Pf l T (dimp l T D a b))) (x (Pf l T a))) (Pf l T b))
  (lam l T D (fst (snd D))))
(checked dForm (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))) (U l)) (lam l T D (fst (snd (snd D)))))
(checked dapp (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T)) (f (dForm l T D)) (s (Sent l T))) (Sent l T))
  (lam l T D (fst (snd (snd (snd D))))))
(checked dfix (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T)) (f (dForm l T D)))
    (Sigma G (Sent l T) (Sigma h1 (Pf l T (dimp l T D G (dapp l T D f G))) (Pf l T (dimp l T D (dapp l T D f G) G)))))
  (lam l T D (fst (snd (snd (snd (snd D)))))))
(checked dnegProv (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))) (dForm l T D))
  (lam l T D (fst (snd (snd (snd (snd (snd D))))))))
(checked dnegProv-is (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T)) (s (Sent l T)))
    (PathP (plam i (Sent l T)) (dapp l T D (dnegProv l T D) s) (neg l T (prov l T s))))
  (lam l T D (snd (snd (snd (snd (snd (snd D))))))))
(checked goedelSentence (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))) (Sent l T))
  (lam l T D (fst (dfix l T D (dnegProv l T D)))))
(checked diagonalGivesGoedelFix (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))) (GoedelFix l T (goedelSentence l T D)))
  (lam l T D
    (let G (goedelSentence l T D)
    (let fx (dfix l T D (dnegProv l T D))
      (pair (lam pG (subst l l (Sent l T) (Pf l T) (dapp l T D (dnegProv l T D) G) (neg l T (prov l T G)) (dnegProv-is l T D G)
                       (dmp l T D G (dapp l T D (dnegProv l T D) G) (fst (snd fx)) pG)))
            (lam pNP (dmp l T D (dapp l T D (dnegProv l T D) G) G (snd (snd fx))
                       (subst l l (Sent l T) (Pf l T) (neg l T (prov l T G)) (dapp l T D (dnegProv l T D) G)
                              (plam i (@ (dnegProv-is l T D G) (~ i))) pNP))))))))
; full independence, given ω-consistency and contraposition, double negation, transitivity
(checked internalFix (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))
      (contra (Pi ((a (Sent l T)) (b (Sent l T)) (h (Pf l T (dimp l T D a b)))) (Pf l T (dimp l T D (neg l T b) (neg l T a)))))
      (dne (Pi a (Sent l T) (Pf l T (dimp l T D (neg l T (neg l T a)) a))))
      (trans (Pi ((a (Sent l T)) (b (Sent l T)) (c (Sent l T)) (h (Pf l T (dimp l T D a b))) (k (Pf l T (dimp l T D b c))))
                 (Pf l T (dimp l T D a c)))))
    (Pf l T (dimp l T D (neg l T (goedelSentence l T D)) (prov l T (goedelSentence l T D)))))
  (lam l T D contra dne trans
    (let G (goedelSentence l T D)
    (let bwd (subst l l (Sent l T) (lam s (Pf l T (dimp l T D s G))) (dapp l T D (dnegProv l T D) G) (neg l T (prov l T G))
                    (dnegProv-is l T D G) (snd (snd (dfix l T D (dnegProv l T D)))))
      (trans (neg l T G) (neg l T (neg l T (prov l T G))) (prov l T G)
             (contra (neg l T (prov l T G)) G bwd) (dne (prov l T G)))))))
(checked secondConjunct (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))
      (contra (Pi ((a (Sent l T)) (b (Sent l T)) (h (Pf l T (dimp l T D a b)))) (Pf l T (dimp l T D (neg l T b) (neg l T a)))))
      (dne (Pi a (Sent l T) (Pf l T (dimp l T D (neg l T (neg l T a)) a))))
      (trans (Pi ((a (Sent l T)) (b (Sent l T)) (c (Sent l T)) (h (Pf l T (dimp l T D a b))) (k (Pf l T (dimp l T D b c))))
                 (Pf l T (dimp l T D a c))))
      (notG (NegL l (Pf l T (goedelSentence l T D))))
      (notOmega (NegL l (OmegaBad l T (goedelSentence l T D)))))
    (NegL l (Pf l T (neg l T (goedelSentence l T D)))))
  (lam l T D contra dne trans notG notOmega pNegG
    (notOmega (pair (dmp l T D (neg l T (goedelSentence l T D)) (prov l T (goedelSentence l T D))
                         (internalFix l T D contra dne trans) pNegG)
                    notG))))
(checked independenceFromRepresentability (Pi ((l Level) (T (Theory l)) (D (HasDiagonal l T))
      (contra (Pi ((a (Sent l T)) (b (Sent l T)) (h (Pf l T (dimp l T D a b)))) (Pf l T (dimp l T D (neg l T b) (neg l T a)))))
      (dne (Pi a (Sent l T) (Pf l T (dimp l T D (neg l T (neg l T a)) a))))
      (trans (Pi ((a (Sent l T)) (b (Sent l T)) (c (Sent l T)) (h (Pf l T (dimp l T D a b))) (k (Pf l T (dimp l T D b c))))
                 (Pf l T (dimp l T D a c))))
      (con (Consistent l T)) (d1 (HBL1 l T)) (notOmega (NegL l (OmegaBad l T (goedelSentence l T D)))))
    (Independent l T (goedelSentence l T D)))
  (lam l T D contra dne trans con d1 notOmega
    (let half (goedelHalfOne l T (goedelSentence l T D) con d1 (diagonalGivesGoedelFix l T D))
      (pair half (secondConjunct l T D contra dne trans half notOmega)))))

; ---- box 9 (5.13): equal length. A trace of n steps from s to t, by recursion on n
; (Trace 0 s t is s = t; Trace (n+1) s t is a step to some u and a trace from u)
(checked Trace (Pi ((S U) (Step (Pi a S (Pi b S U))) (n Nat) (s S) (t S)) U)
  (lam S Step n s t ((elim (lam y (Pi s S (Pi t S U))) n
      ((zero) (lam s t (PathP (plam i S) s t)))
      ((suc m) (lam s t (Sigma u S (Sigma st (Step s u) ((rec m) u t))))))
    s t)))
(checked Normal (Pi ((S U) (Step (Pi a S (Pi b S U))) (t S)) U)
  (lam S Step t (Pi u S (Pi st (Step t u) Empty))))
(checked Diamond (Pi ((S U) (Step (Pi a S (Pi b S U)))) U)
  (lam S Step (Pi ((s S) (a S) (b S) (x (Step s a)) (y (Step s b)))
                  (Sum (PathP (plam i S) a b) (Sigma c S (Sigma l (Step a c) (Step b c)))))))
; any available first interaction removes exactly one unit from any terminating reduction
(checked peel (Pi ((S U) (Step (Pi a S (Pi b S U))) (diamond (Diamond S Step)) (n Nat)
                   (s S) (u S) (t S) (jump (Step s u)) (tr (Trace S Step (suc n) s t)) (normal (Normal S Step t)))
    (Trace S Step n u t))
  (lam S Step diamond n (elim (lam y (Pi ((s S) (u S) (t S) (jump (Step s u)) (tr (Trace S Step (suc y) s t))
                                         (normal (Normal S Step t)))
                                       (Trace S Step y u t))) n
    ((zero) (lam s u t jump tr normal
       (case (diamond s (fst tr) u (fst (snd tr)) jump)
         ((inl same) (concat lzero S u (fst tr) t (plam i (@ same (~ i))) (snd (snd tr))))
         ((inr w) (Empty-rec lzero (PathP (plam i S) u t)
                    (normal (fst w) (subst lzero lzero S (lam v (Step v (fst w))) (fst tr) t (snd (snd tr)) (fst (snd w)))))))))
    ((suc m) (lam s u t jump tr normal
       (case (diamond s (fst tr) u (fst (snd tr)) jump)
         ((inl same) (subst lzero lzero S (lam v (Trace S Step (suc m) v t)) (fst tr) u same (snd (snd tr))))
         ((inr w) (pair (fst w) (pair (snd (snd w))
                    ((rec m) (fst tr) (fst w) t (fst (snd w)) (snd (snd tr)) normal))))))))))
(checked normal-length-zero (Pi ((S U) (Step (Pi a S (Pi b S U))) (n Nat) (s S) (t S)
                                 (normal (Normal S Step s)) (tr (Trace S Step n s t)))
    (PathP (plam i Nat) n zero))
  (lam S Step n (elim (lam y (Pi ((s S) (t S) (normal (Normal S Step s)) (tr (Trace S Step y s t))) (PathP (plam i Nat) y zero))) n
    ((zero) (lam s t normal tr (plam i zero)))
    ((suc m) (lam s t normal tr (Empty-rec lzero (PathP (plam i Nat) (suc m) zero) (normal (fst tr) (fst (snd tr)))))))))
(checked zero-endpoints (Pi ((S U) (Step (Pi a S (Pi b S U))) (s S) (t S) (tr (Trace S Step zero s t))) (PathP (plam i S) s t))
  (lam S Step s t tr tr))
; all complete reductions of this object to this normal form have one length
(checked same-normalization-length (Pi ((S U) (Step (Pi a S (Pi b S U))) (diamond (Diamond S Step)) (n Nat) (m Nat)
                                        (s S) (t S) (tr1 (Trace S Step n s t)) (tr2 (Trace S Step m s t)) (normal (Normal S Step t)))
    (PathP (plam i Nat) n m))
  (lam S Step diamond n (elim (lam y (Pi ((m Nat) (s S) (t S) (tr1 (Trace S Step y s t)) (tr2 (Trace S Step m s t))
                                        (normal (Normal S Step t)))
                                      (PathP (plam i Nat) y m))) n
    ((zero) (lam m s t tr1 tr2 normal
       (symN m zero (normal-length-zero S Step m s t
                      (subst lzero lzero S (lam v (Normal S Step v)) t s (plam i (@ tr1 (~ i))) normal) tr2))))
    ((suc k) (lam m s t tr1 tr2 normal
       ((elim (lam y (Pi tr (Trace S Step y s t) (PathP (plam i Nat) (suc k) y))) m
          ((zero) (lam tr (Empty-rec lzero (PathP (plam i Nat) (suc k) zero)
                            (normal (fst tr1) (subst lzero lzero S (lam v (Step v (fst tr1))) s t tr (fst (snd tr1)))))))
          ((suc m1) (lam tr (plam i (suc (@ ((rec k) m1 (fst tr1) t (snd (snd tr1))
                                               (peel S Step diamond m1 s (fst tr1) t (fst (snd tr1)) tr normal) normal) i))))))
        tr2))))))
(checked normalization-is-geodesic (Pi ((S U) (Step (Pi a S (Pi b S U))) (diamond (Diamond S Step)) (n Nat) (m Nat)
                                        (s S) (t S) (tr1 (Trace S Step n s t)) (tr2 (Trace S Step m s t)) (normal (Normal S Step t)))
    (le n m))
  (lam S Step diamond n m s t tr1 tr2 normal
    (subst lzero lzero Nat (lam x (le n x)) n m (same-normalization-length S Step diamond n m s t tr1 tr2 normal) (le-refl n))))

; ---- box 15 (9.7–9.8): every + is a merge; the information is fixed by the endpoints
(checked-data (data Shape (one) (node (l Shape) (r Shape))))
(checked size (Pi t Shape Nat) (lam t (case t ((one) (suc zero)) ((node l r) (plus (rec l) (rec r))))))
(checked cost (Pi t Shape Nat) (lam t (case t ((one) zero) ((node l r) (plus (plus (size l) (size r)) (plus (rec l) (rec r)))))))
(checked paid (Pi ((d Nat) (t Shape)) Nat)
  (lam d t ((elim (lam y (Pi d Nat Nat)) t ((one) (lam d d)) ((node l r) (lam d (plus ((rec l) (suc d)) ((rec r) (suc d)))))) d)))
; the arithmetic the solver did: rearrangements under the semiring laws. Paths are combined by
; lemmas (cong2N, in lib/std.ctt), not pointwise under a dimension: checking an application looks
; only at types
(checked times-distl (Pi ((d Nat) (a Nat) (b Nat)) (PathP (plam i Nat) (times d (plus a b)) (plus (times d a) (times d b))))
  (lam d a b (transN (times d (plus a b)) (times (plus a b) d) (plus (times d a) (times d b)) (times-comm d (plus a b)) (transN (times (plus a b) d) (plus (times a d) (times b d)) (plus (times d a) (times d b)) (times-distr a b d) (cong2N plus (times a d) (times d a) (times b d) (times d b) (times-comm a d) (times-comm b d))))))
(checked swap-mid (Pi ((a Nat) (b Nat) (c Nat) (d Nat)) (PathP (plam i Nat) (plus (plus a b) (plus c d)) (plus (plus a c) (plus b d))))
  (lam a b c d (transN (plus (plus a b) (plus c d)) (plus a (plus b (plus c d))) (plus (plus a c) (plus b d)) (plus-assoc a b (plus c d)) (transN (plus a (plus b (plus c d))) (plus a (plus (plus b c) d)) (plus (plus a c) (plus b d)) (congN (plus a) (plus b (plus c d)) (plus (plus b c) d) (symN (plus (plus b c) d) (plus b (plus c d)) (plus-assoc b c d))) (transN (plus a (plus (plus b c) d)) (plus a (plus (plus c b) d)) (plus (plus a c) (plus b d)) (congN (plus a) (plus (plus b c) d) (plus (plus c b) d) (congN (lam x (plus x d)) (plus b c) (plus c b) (plus-comm b c))) (transN (plus a (plus (plus c b) d)) (plus a (plus c (plus b d))) (plus (plus a c) (plus b d)) (congN (plus a) (plus (plus c b) d) (plus c (plus b d)) (plus-assoc c b d)) (symN (plus (plus a c) (plus b d)) (plus a (plus c (plus b d))) (plus-assoc a c (plus b d)))))))))
(checked rearrange6 (Pi ((a Nat) (b Nat) (c Nat) (d Nat) (e Nat) (f Nat))
    (PathP (plam i Nat) (plus (plus a (plus b c)) (plus d (plus e f))) (plus (plus (plus b e) (plus a d)) (plus c f))))
  (lam a b c d e f (transN (plus (plus a (plus b c)) (plus d (plus e f))) (plus (plus (plus a b) c) (plus (plus d e) f)) (plus (plus (plus b e) (plus a d)) (plus c f)) (cong2N plus (plus a (plus b c)) (plus (plus a b) c) (plus d (plus e f)) (plus (plus d e) f) (symN (plus (plus a b) c) (plus a (plus b c)) (plus-assoc a b c)) (symN (plus (plus d e) f) (plus d (plus e f)) (plus-assoc d e f))) (transN (plus (plus (plus a b) c) (plus (plus d e) f)) (plus (plus (plus a b) (plus d e)) (plus c f)) (plus (plus (plus b e) (plus a d)) (plus c f)) (swap-mid (plus a b) c (plus d e) f) (transN (plus (plus (plus a b) (plus d e)) (plus c f)) (plus (plus (plus a d) (plus b e)) (plus c f)) (plus (plus (plus b e) (plus a d)) (plus c f)) (congN (lam x (plus x (plus c f))) (plus (plus a b) (plus d e)) (plus (plus a d) (plus b e)) (swap-mid a b d e)) (congN (lam x (plus x (plus c f))) (plus (plus a d) (plus b e)) (plus (plus b e) (plus a d)) (plus-comm (plus a d) (plus b e))))))))
(checked paid≡ (Pi ((t Shape) (d Nat)) (PathP (plam i Nat) (paid d t) (plus (cost t) (times d (size t)))))
  (lam t (elim (lam y (Pi d Nat (PathP (plam i Nat) (paid d y) (plus (cost y) (times d (size y)))))) t
    ((one) (lam d (symN (times d (suc zero)) d (times-one d))))
    ((node l r) (lam d (transN (plus (paid (suc d) l) (paid (suc d) r)) (plus (plus (cost l) (times (suc d) (size l))) (plus (cost r) (times (suc d) (size r)))) (plus (plus (plus (size l) (size r)) (plus (cost l) (cost r))) (times d (plus (size l) (size r)))) (cong2N plus (paid (suc d) l) (plus (cost l) (times (suc d) (size l))) (paid (suc d) r) (plus (cost r) (times (suc d) (size r))) ((rec l) (suc d)) ((rec r) (suc d))) (transN (plus (plus (cost l) (times (suc d) (size l))) (plus (cost r) (times (suc d) (size r)))) (plus (plus (plus (size l) (size r)) (plus (cost l) (cost r))) (plus (times d (size l)) (times d (size r)))) (plus (plus (plus (size l) (size r)) (plus (cost l) (cost r))) (times d (plus (size l) (size r)))) (rearrange6 (cost l) (size l) (times d (size l)) (cost r) (size r) (times d (size r))) (congN (plus (plus (plus (size l) (size r)) (plus (cost l) (cost r)))) (plus (times d (size l)) (times d (size r))) (times d (plus (size l) (size r))) (symN (times d (plus (size l) (size r))) (plus (times d (size l)) (times d (size r))) (times-distl d (size l) (size r)))))))))))
; the sum of the intermediate sums is the sum over elements of their depth
(checked cost≡depth (Pi t Shape (PathP (plam i Nat) (cost t) (paid zero t)))
  (lam t (symN (paid zero t) (cost t) (transN (paid zero t) (plus (cost t) zero) (cost t) (paid≡ t zero) (plus-zero (cost t))))))
(checked bal (Pi k Nat Shape) (lam k (case k ((zero) one) ((suc j) (node (rec j) (rec j))))))
(checked double (Pi x Nat (PathP (plam i Nat) (plus x x) (times (suc (suc zero)) x)))
  (lam x (congN (plus x) x (plus x zero) (symN (plus x zero) x (plus-zero x)))))
