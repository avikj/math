      ((zero) (transN (times (suc zero) (times (fact (suc a1)) (suc zero))) (times (fact (suc a1)) (suc zero)) (fact (plus (suc a1) zero)) (times-one-left (times (fact (suc a1)) (suc zero))) (transN (times (fact (suc a1)) (suc zero)) (fact (suc a1)) (fact (plus (suc a1) zero)) (times-one (fact (suc a1))) (congN fact (suc a1) (plus (suc a1) zero) (symN (plus (suc a1) zero) (suc a1) (plus-zero (suc a1)))))))
      ((suc b1) (transN (times (plus (il a1 (suc b1)) (il (suc a1) b1)) (times (times (suc a1) (fact a1)) (times (suc b1) (fact b1)))) (plus (times (suc a1) (times (il a1 (suc b1)) (times (fact a1) (times (suc b1) (fact b1))))) (times (suc b1) (times (il (suc a1) b1) (times (times (suc a1) (fact a1)) (fact b1))))) (times (suc (plus a1 (suc b1))) (fact (plus a1 (suc b1)))) (il-split (il a1 (suc b1)) (il (suc a1) b1) (fact a1) (fact b1) a1 b1) (transN (plus (times (suc a1) (times (il a1 (suc b1)) (times (fact a1) (times (suc b1) (fact b1))))) (times (suc b1) (times (il (suc a1) b1) (times (times (suc a1) (fact a1)) (fact b1))))) (plus (times (suc a1) (fact (plus a1 (suc b1)))) (times (suc b1) (fact (plus a1 (suc b1))))) (times (suc (plus a1 (suc b1))) (fact (plus a1 (suc b1)))) (cong2N (lam x y (plus (times (suc a1) x) (times (suc b1) y))) (times (il a1 (suc b1)) (times (fact a1) (times (suc b1) (fact b1)))) (fact (plus a1 (suc b1))) (times (il (suc a1) b1) (times (times (suc a1) (fact a1)) (fact b1))) (fact (plus a1 (suc b1))) ((rec a1) (suc b1)) (transN (times (il (suc a1) b1) (times (times (suc a1) (fact a1)) (fact b1))) (fact (suc (plus a1 b1))) (fact (plus a1 (suc b1))) (rec b1) (congN fact (suc (plus a1 b1)) (plus a1 (suc b1)) (symN (plus a1 (suc b1)) (suc (plus a1 b1)) (plus-suc a1 b1))))) (il-close a1 b1 (fact (plus a1 (suc b1)))))))))))))
; what every merge settles, multiplied over the sum: n! whatever the shape
(checked info (Pi t Shape Nat) (lam t (case t ((one) (suc zero)) ((node l r) (times (il (size l) (size r)) (times (rec l) (rec r)))))))
(checked info≡ (Pi t Shape (PathP (plam i Nat) (info t) (fact (size t))))
  (lam t (elim (lam y (PathP (plam i Nat) (info y) (fact (size y)))) t
    ((one) (plam i (suc zero)))
    ((node l r) (transN (times (il (size l) (size r)) (times (info l) (info r)))
                        (times (il (size l) (size r)) (times (fact (size l)) (fact (size r))))
                        (fact (plus (size l) (size r)))
                  (cong2N (lam x y (times (il (size l) (size r)) (times x y))) (info l) (fact (size l)) (info r) (fact (size r)) (rec l) (rec r))
                  (il-fact (size l) (size r)))))))
