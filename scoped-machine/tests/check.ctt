; tests/check.ctt — the type checker (a term, lib/check.ctt) on codes of terms.
(checked idf (Pi A U (Pi x A A)) (lam A x x))
(checked refl (Pi A U (Pi x A (PathP (plam i A) x x))) (lam A x (plam i x)))
(check-fail (Pi A U (Pi x A (Pi y A (PathP (plam i A) x y)))) (lam A x y (plam i x)))
(check-fail (Pi A U (Pi x A A)) (lam A x A))
(checked sym (Pi A U (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i A) y x)))))
  (lam A x y p (plam i (@ p (~ i)))))
(checked funext (Pi A U (Pi B U (Pi f (Pi x A B) (Pi g (Pi x A B)
    (Pi h (Pi x A (PathP (plam i B) (f x) (g x))) (PathP (plam i (Pi x A B)) f g))))))
  (lam A B f g h (plam i (lam x (@ (h x) i)))))
(check (Pi A U (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i A) x y)))))
  (lam A x y p (idf (PathP (plam i A) x y) p)))
(checked transport (Pi A U (Pi B U (Pi p (PathP (plam i U) A B) (Pi a A B))))
  (lam A B p a (comp (plam i (@ p i)) (plam i (sys)) a)))
(check-fail (Pi A U (Pi B U (Pi p (PathP (plam i U) A B) (Pi a A A))))
  (lam A B p a (comp (plam i (@ p i)) (plam i (sys)) a)))
; composition of paths by hcomp, with a tube on both ends of the square
(checked concat (Pi A U (Pi x A (Pi y A (Pi z A (Pi p (PathP (plam i A) x y) (Pi q (PathP (plam i A) y z)
    (PathP (plam i A) x z)))))))
  (lam A x y z p q (plam i (comp (plam j A) (plam j (sys ((= i 0) x) ((= i 1) (@ q j)))) (@ p i)))))
; a tube that does not agree with the base is rejected
(check-fail (Pi A U (Pi x A (Pi y A (Pi z A (Pi p (PathP (plam i A) x y) (Pi q (PathP (plam i A) y z)
    (PathP (plam i A) x z)))))))
  (lam A x y z p q (plam i (comp (plam j A) (plam j (sys ((= i 0) z) ((= i 1) (@ q j)))) (@ p i)))))
; equivalences and univalence through the Glue rule
(checked Contr (Pi X U U) (lam X (Sigma c X (Pi x X (PathP (plam i X) c x)))))
(checked fib (Pi X U (Pi Y U (Pi f (Pi x X Y) (Pi y Y U)))) (lam X Y f y (Sigma x X (PathP (plam i Y) (f x) y))))
(checked Equiv (Pi X U (Pi Y U U)) (lam X Y (Sigma f (Pi x X Y) (Pi y Y (Contr (fib X Y f y))))))
(checked idequiv (Pi X U (Equiv X X))
  (lam X (pair (lam x x)
               (lam y (pair (pair y (plam i y))
                            (lam z (plam i (pair (@ (snd z) (~ i)) (plam j (@ (snd z) (\/ (~ i) j)))))))))))
(checked ua (Pi A U (Pi B U (Pi e (Equiv A B) (PathP (plam i U) A B))))
  (lam A B e (plam i (Glue B (sys ((= i 0) (pair A e)) ((= i 1) (pair B (idequiv B))))))))
(check-fail (Pi A U (Pi B U (Pi e (Equiv A B) (PathP (plam i U) A B))))
  (lam A B e (plam i (Glue B (sys ((= i 1) (pair A e)) ((= i 0) (pair B (idequiv B))))))))
; a checked definition also runs on the machine
(axiom T0 t0)
(same (idf T0 t0) t0)

; data types, checked: declarations, constructors, elimination, hcomp
(checked-data (data B (bt) (bf)))
(checked bnot (Pi x B B) (lam x (case x ((bt) bf) ((bf) bt))))
(checked bnot2 (Pi x B B) (lam x (elim (lam y B) x ((bt) bf) ((bf) bt))))
(check-fail (Pi x B B) (lam x (case x ((bt) bf) ((bf) (lam y y)))))
(checked-data (data N2 (z2) (s2 (n N2))))
(checked one N2 (s2 z2))
(check-fail N2 (s2 bt))
; recursion is elimination with induction hypotheses: (rec k) has type P k
(checked add2 (Pi m N2 (Pi n N2 N2)) (lam m n (case m ((z2) n) ((s2 k) (s2 (rec k))))))
(same (add2 (s2 z2) (s2 z2)) (s2 (s2 z2)))
(checked add2-zero (Pi n N2 (PathP (plam i N2) (add2 n z2) n))
  (lam n (elim (lam y (PathP (plam i N2) (add2 y z2) y)) n ((z2) (plam i z2)) ((s2 k) (plam i (s2 (@ (rec k) i)))))))
(check-fail (Pi n N2 (PathP (plam i N2) (add2 n z2) n))
  (lam n (elim (lam y (PathP (plam i N2) (add2 y z2) y)) n ((z2) (plam i z2)) ((s2 k) (rec k)))))
(check-fail (Pi m N2 B) (lam m (case m ((z2) bt) ((s2 k) (s2 (rec k))))))
; dependent elimination: the motive varies with the scrutinee
(checked bdep (Pi x B (elim (lam y U) x ((bt) B) ((bf) N2))) (lam x (elim (lam y (elim (lam z U) y ((bt) B) ((bf) N2))) x ((bt) bf) ((bf) z2))))
; the circle: a path constructor, elimination with its loop branch
(checked-data (data C1 (cb) (cl (dims i) ((= i 0) cb) ((= i 1) cb))))
(checked cloop (PathP (plam i C1) cb cb) (plam i (cl i)))
(checked cflip (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) cb) ((cl i) (cl (~ i))))))
; a loop branch must agree with the eliminated boundary
(check (Pi x C1 B) (lam x (case x ((cb) bt) ((cl i) bt))))
(check-fail (Pi x C1 B) (lam x (case x ((cb) bt) ((cl i) bf))))
(check (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) cb) ((cl i) (cl (/\ i (~ i)))))))
(check-fail (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) (hcompD (plam j (sys)) cb)) ((cl i) (cl i)))))
; formal hcomp in a data type, and elimination on it
(check C1 (hcompD (plam j (sys)) cb))
(check (PathP (plam i C1) (cflip (hcompD (plam j (sys)) cb)) (hcompD (plam j (sys)) cb)) (plam i (hcompD (plam j (sys)) cb)))
(check-fail C1 (hcompD (plam j (sys ((= j 0) cb))) cb))
; a recursive path constructor: its branch agrees on the boundary with the hypotheses
(checked-data (data (Tr (T U)) (tin (t T)) (tsq (x (Tr T)) (y (Tr T)) (dims i) ((= i 0) x) ((= i 1) y))))
(checked trmap (Pi A U (Pi C U (Pi f (Pi a A C) (Pi t (Tr A) (Tr C)))))
  (lam A C f t (case t ((tin a) (tin (f a))) ((tsq x y i) (tsq (rec x) (rec y) i)))))
(check-fail (Pi A U (Pi C U (Pi f (Pi a A C) (Pi t (Tr A) (Tr C)))))
  (lam A C f t (case t ((tin a) (tin (f a))) ((tsq x y i) (tsq (rec y) (rec x) i)))))
; a parameterized higher inductive type
(checked-data (data (Su (T U)) (sn) (ss) (sm (t T) (dims i) ((= i 0) sn) ((= i 1) ss))))
(checked meridian (Pi T U (Pi t T (PathP (plam i (Su T)) sn ss))) (lam T t (plam i (sm t i))))
(check (Pi T U (Pi t T (Su T))) (lam T t (comp (plam i (Su T)) (plam i (sys)) (sm t 0))))
; strict positivity, and boundaries made of earlier constructors
(checked-data-fail (data Neg (mk (f (Pi x Neg B)))))
(checked-data-fail (data Ov (o1) (o2) (ov (dims i) ((= i 0) o1) ((= i 0) o2))))
; the evaluator over codes of data
(same (eval-g (pair no-globals %dtab4) t0 (code (s2 (s2 z2)))) (s2 (s2 z2)))
(same (eval-g (pair no-globals %dtab4) t0 (code (elim (lam y C1) (cl 1) ((cb) cb) ((cl i) (cl (~ i)))))) cb)
