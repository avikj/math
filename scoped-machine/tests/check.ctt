; tests/check.ctt — the type checker (a term, lib/check.ctt) on codes of terms.
(checked idf (Pi A U (Pi x A A)) (lam A x x))
(checked refl (Pi A U (Pi x A (PathP (plam i A) x x))) (lam A x (plam i x)))
(check-fail (Pi A U (Pi x A (Pi y A (PathP (plam i A) x y)))) (lam A x y (plam i x)))
(check-fail (Pi A U (Pi x A A)) (lam A x A))
(checked sym (Pi A U (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i A) y x)))))
  (lam A x y p (plam i (@ p (~ i)))))
(checked funext (Pi A U (Pi B U (Pi f (Pi x A B) (Pi g (Pi x A B)
    (Pi h (Pi x A (PathP (plam i B) (f x) (g x))) (PathP (plam i (Pi x A B)) f g))))))
  (lam A B f g h (plam i (lam x (@ (h x) i)))))
(check (Pi A U (Pi x A (Pi y A (Pi p (PathP (plam i A) x y) (PathP (plam i A) x y)))))
  (lam A x y p (idf (PathP (plam i A) x y) p)))
(checked transport (Pi A U (Pi B U (Pi p (PathP (plam i U) A B) (Pi a A B))))
  (lam A B p a (comp (plam i (@ p i)) (plam i (sys)) a)))
(check-fail (Pi A U (Pi B U (Pi p (PathP (plam i U) A B) (Pi a A A))))
  (lam A B p a (comp (plam i (@ p i)) (plam i (sys)) a)))
; composition of paths by hcomp, with a tube on both ends of the square
(checked concat (Pi A U (Pi x A (Pi y A (Pi z A (Pi p (PathP (plam i A) x y) (Pi q (PathP (plam i A) y z)
    (PathP (plam i A) x z)))))))
  (lam A x y z p q (plam i (comp (plam j A) (plam j (sys ((= i 0) x) ((= i 1) (@ q j)))) (@ p i)))))
; a tube that does not agree with the base is rejected
(check-fail (Pi A U (Pi x A (Pi y A (Pi z A (Pi p (PathP (plam i A) x y) (Pi q (PathP (plam i A) y z)
    (PathP (plam i A) x z)))))))
  (lam A x y z p q (plam i (comp (plam j A) (plam j (sys ((= i 0) z) ((= i 1) (@ q j)))) (@ p i)))))
; equivalences and univalence through the Glue rule
(checked Contr (Pi X U U) (lam X (Sigma c X (Pi x X (PathP (plam i X) c x)))))
(checked fib (Pi X U (Pi Y U (Pi f (Pi x X Y) (Pi y Y U)))) (lam X Y f y (Sigma x X (PathP (plam i Y) (f x) y))))
(checked Equiv (Pi X U (Pi Y U U)) (lam X Y (Sigma f (Pi x X Y) (Pi y Y (Contr (fib X Y f y))))))
(checked idequiv (Pi X U (Equiv X X))
  (lam X (pair (lam x x)
               (lam y (pair (pair y (plam i y))
                            (lam z (plam i (pair (@ (snd z) (~ i)) (plam j (@ (snd z) (\/ (~ i) j)))))))))))
(checked ua (Pi A U (Pi B U (Pi e (Equiv A B) (PathP (plam i U) A B))))
  (lam A B e (plam i (Glue B (sys ((= i 0) (pair A e)) ((= i 1) (pair B (idequiv B))))))))
(check-fail (Pi A U (Pi B U (Pi e (Equiv A B) (PathP (plam i U) A B))))
  (lam A B e (plam i (Glue B (sys ((= i 1) (pair A e)) ((= i 0) (pair B (idequiv B))))))))
; a checked definition also runs on the machine
(axiom T0 t0)
(same (idf T0 t0) t0)

; data types, checked: declarations, constructors, elimination, hcomp
(checked-data (data B (bt) (bf)))
(checked bnot (Pi x B B) (lam x (case x ((bt) bf) ((bf) bt))))
(checked bnot2 (Pi x B B) (lam x (elim (lam y B) x ((bt) bf) ((bf) bt))))
(check-fail (Pi x B B) (lam x (case x ((bt) bf) ((bf) (lam y y)))))
(checked-data (data N2 (z2) (s2 (n N2))))
(checked one N2 (s2 z2))
(check-fail N2 (s2 bt))
; recursion is elimination with induction hypotheses: (rec k) has type P k
(checked add2 (Pi m N2 (Pi n N2 N2)) (lam m n (case m ((z2) n) ((s2 k) (s2 (rec k))))))
(same (add2 (s2 z2) (s2 z2)) (s2 (s2 z2)))
(checked add2-zero (Pi n N2 (PathP (plam i N2) (add2 n z2) n))
  (lam n (elim (lam y (PathP (plam i N2) (add2 y z2) y)) n ((z2) (plam i z2)) ((s2 k) (plam i (s2 (@ (rec k) i)))))))
(check-fail (Pi n N2 (PathP (plam i N2) (add2 n z2) n))
  (lam n (elim (lam y (PathP (plam i N2) (add2 y z2) y)) n ((z2) (plam i z2)) ((s2 k) (rec k)))))
(check-fail (Pi m N2 B) (lam m (case m ((z2) bt) ((s2 k) (s2 (rec k))))))
; dependent elimination: the motive varies with the scrutinee
(checked bdep (Pi x B (elim (lam y U) x ((bt) B) ((bf) N2))) (lam x (elim (lam y (elim (lam z U) y ((bt) B) ((bf) N2))) x ((bt) bf) ((bf) z2))))
; the circle: a path constructor, elimination with its loop branch
(checked-data (data C1 (cb) (cl (dims i) ((= i 0) cb) ((= i 1) cb))))
(checked cloop (PathP (plam i C1) cb cb) (plam i (cl i)))
(checked cflip (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) cb) ((cl i) (cl (~ i))))))
; a loop branch must agree with the eliminated boundary
(check (Pi x C1 B) (lam x (case x ((cb) bt) ((cl i) bt))))
(check-fail (Pi x C1 B) (lam x (case x ((cb) bt) ((cl i) bf))))
(check (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) cb) ((cl i) (cl (/\ i (~ i)))))))
(check-fail (Pi x C1 C1) (lam x (elim (lam y C1) x ((cb) (hcompD (plam j (sys)) cb)) ((cl i) (cl i)))))
; formal hcomp in a data type, and elimination on it
(check C1 (hcompD (plam j (sys)) cb))
(check (PathP (plam i C1) (cflip (hcompD (plam j (sys)) cb)) (hcompD (plam j (sys)) cb)) (plam i (hcompD (plam j (sys)) cb)))
(check-fail C1 (hcompD (plam j (sys ((= j 0) cb))) cb))
; an inductive family generated by rules, from a uniform data type and recursion into U:
; Trace S St n s t (n steps of St from s to t) is a list of states with its validity
(checked-data (data (Ls (S U)) (lnl) (lcs (u S) (r (Ls S)))))
(checked lenl (Pi S U (Pi l (Ls S) N2)) (lam S l (case l ((lnl) z2) ((lcs u r) (s2 (rec r))))))
(checked valid (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi l (Ls S) (Pi n N2 (Pi s S (Pi t S U))))))
  (lam S St l (elim (lam y (Pi n N2 (Pi s S (Pi t S U)))) l
    ((lnl) (lam n s t (Sigma p (PathP (plam i N2) n z2) (PathP (plam i S) s t))))
    ((lcs u r) (lam n s t (Sigma m N2 (Sigma e (PathP (plam i N2) n (s2 m)) (Sigma st (St s u) ((rec r) m u t)))))))))
(checked Trace (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi n N2 (Pi s S (Pi t S U)))))
  (lam S St n s t (Sigma l (Ls S) (valid S St l n s t))))
(checked done (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi s S (Trace S St z2 s s))))
  (lam S St s (pair lnl (pair (plam i z2) (plam i s)))))
(checked step (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi m N2 (Pi s S (Pi u S (Pi t S
    (Pi st (St s u) (Pi tr (Trace S St m u t) (Trace S St (s2 m) s t)))))))))
  (lam S St m s u t st tr (pair (lcs u (fst tr)) (pair m (pair (plam i (s2 m)) (pair st (snd tr)))))))
; elimination of the family by recursion on the derivation: a trace's length is its index
(checked trace-length (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi l (Ls S)
    (Pi n N2 (Pi s S (Pi t S (Pi v (valid S St l n s t) (PathP (plam i N2) (lenl S l) n))))))))
  (lam S St l (elim (lam y (Pi n N2 (Pi s S (Pi t S (Pi v (valid S St y n s t) (PathP (plam i N2) (lenl S y) n)))))) l
    ((lnl) (lam n s t v (plam i (@ (fst v) (~ i)))))
    ((lcs u r) (lam n s t v
       (concat N2 (s2 (lenl S r)) (s2 (fst v)) n
         (plam i (s2 (@ ((rec r) (fst v) u t (snd (snd (snd v)))) i)))
         (plam i (@ (fst (snd v)) (~ i)))))))))
(check-fail (Pi S U (Pi St (Pi s S (Pi t S U)) (Pi l (Ls S)
    (Pi n N2 (Pi s S (Pi t S (Pi v (valid S St l n s t) (PathP (plam i N2) (lenl S l) n))))))))
  (lam S St l (elim (lam y (Pi n N2 (Pi s S (Pi t S (Pi v (valid S St y n s t) (PathP (plam i N2) (lenl S y) n)))))) l
    ((lnl) (lam n s t v (plam i (@ (fst v) (~ i)))))
    ((lcs u r) (lam n s t v (plam i (s2 (@ ((rec r) (fst v) u t (snd (snd (snd v)))) i))))))))
; a recursive path constructor: its branch agrees on the boundary with the hypotheses
(checked-data (data (Tr (T U)) (tin (t T)) (tsq (x (Tr T)) (y (Tr T)) (dims i) ((= i 0) x) ((= i 1) y))))
(checked trmap (Pi A U (Pi C U (Pi f (Pi a A C) (Pi t (Tr A) (Tr C)))))
  (lam A C f t (case t ((tin a) (tin (f a))) ((tsq x y i) (tsq (rec x) (rec y) i)))))
(check-fail (Pi A U (Pi C U (Pi f (Pi a A C) (Pi t (Tr A) (Tr C)))))
  (lam A C f t (case t ((tin a) (tin (f a))) ((tsq x y i) (tsq (rec y) (rec x) i)))))
; a parameterized higher inductive type
(checked-data (data (Su (T U)) (sn) (ss) (sm (t T) (dims i) ((= i 0) sn) ((= i 1) ss))))
(checked meridian (Pi T U (Pi t T (PathP (plam i (Su T)) sn ss))) (lam T t (plam i (sm t i))))
(check (Pi T U (Pi t T (Su T))) (lam T t (comp (plam i (Su T)) (plam i (sys)) (sm t 0))))
; strict positivity, and boundaries made of earlier constructors
(checked-data-fail (data Neg (mk (f (Pi x Neg B)))))
(checked-data-fail (data Ov (o1) (o2) (ov (dims i) ((= i 0) o1) ((= i 0) o2))))
; the evaluator over codes of data
(same (eval-g t0 (code (s2 (s2 z2)))) (s2 (s2 z2)))
(same (eval-g t0 (code (elim (lam y C1) (cl 1) ((cb) cb) ((cl i) (cl (~ i)))))) cb)
; universe levels: one definition at every level
(checked pidf (Pi l Level (Pi A (U l) (Pi x A A))) (lam l A x x))
(check (Pi A U (Pi x A A)) (lam A x (pidf lzero A x)))
(check (Pi A (U 1) (Pi x A A)) (lam A x (pidf (lsuc lzero) A x)))
(check-fail (Pi A (U 1) (Pi x A A)) (lam A x (pidf lzero A x)))
(checked pconst (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (Pi a A (Pi b B A)))))) (lam l m A B a b a))
(check (Pi l Level (Pi A (U l) (U (lsuc l)))) (lam l A (U l)) )
(checked lmaxc (Pi l Level (Pi m Level (Pi A (U l) (Pi B (U m) (U (lmax l m)))))) (lam l m A B (Pi x A B)))
; levels are equal as joins: max l m = max m (max l l)
(check (Pi l Level (Pi m Level (Pi A (U (lmax l m)) (U (lmax m (lmax l l)))))) (lam l m A A))
(check (Pi l Level (Pi A (U (lmax l lzero)) (U l))) (lam l A A))
(check (Pi l Level (Pi A (U (lsuc (lmax l l))) (U (lmax (lsuc l) (lsuc lzero))))) (lam l A A))
(check-fail (Pi l Level (Pi m Level (Pi A (U (lmax l m)) (U (lsuc l))))) (lam l m A A))
(check-fail (Pi l Level (Pi A (U (lsuc l)) (U l))) (lam l A A))
(check-fail (Pi l Level (Pi A (U l) (U l))) (lam l A (U l)))
(checked pId (Pi l Level (Pi A (U l) (Pi x A (Pi y A (U l))))) (lam l A x y (PathP (plam i A) x y)))
(checked prefl (Pi l Level (Pi A (U l) (Pi x A (pId l A x x)))) (lam l A x (plam i x)))
(check-fail U (Pi l Level U))
(checked-data-fail (data (Bx (l Level) (A (U l))) (bx (a A))))
; a level-polymorphic definition runs on the machine, which carries levels and ignores them
(same (pidf lzero T0 t0) t0)
(same (eval-g t0 (code (U (lsuc lzero)))) (U 1))
; checked identities: L and R checked, the evidence checked at Π n. L n = R n
(checked addz (Pi n N2 N2) (lam n (add2 n z2)))
(checked idn (Pi n N2 N2) (lam n n))
(checked-identity addz idn add2-zero)
; the answer is R's: the identity's 1-end
(same (addz (s2 (s2 z2))) (s2 (s2 z2)))
(checked rfl2 (Pi n N2 (PathP (plam i N2) n n)) (lam n (plam i n)))
(checked-identity-fail addz idn rfl2)
; evidence not yet supplied: its supply is checked
(checked twice (Pi n N2 N2) (lam n (add2 n n)))
(checked twice2 (Pi n N2 N2) (lam n (add2 n n)))
(input tw)
(checked-identity twice twice2 tw)
(supply-fail tw (lam n (plam i z2)))
(supply tw (lam n (plam i (add2 n n))))
(same (twice (s2 z2)) (s2 (s2 z2)))
; the optimizer as a term: map fusion, a checked term producing an identity
(checked lmapc (Pi S U (Pi f (Pi x S S) (Pi l (Ls S) (Ls S))))
  (lam S f l (case l ((lnl) lnl) ((lcs u r) (lcs (f u) (rec r))))))
(checked fuse (Pi S U (Pi f (Pi x S S) (Pi g (Pi x S S)
    (Sigma R (Pi l (Ls S) (Ls S)) (Pi l (Ls S) (PathP (plam i (Ls S)) (lmapc S f (lmapc S g l)) (R l)))))))
  (lam S f g (pair (lam l (lmapc S (lam x (f (g x))) l))
    (lam l (elim (lam y (PathP (plam i (Ls S)) (lmapc S f (lmapc S g y)) (lmapc S (lam x (f (g x))) y))) l
      ((lnl) (plam i lnl))
      ((lcs u r) (plam i (lcs (f (g u)) (@ (rec r) i)))))))))
(checked twomaps (Pi l (Ls N2) (Ls N2)) (lam l (lmapc N2 s2 (lmapc N2 s2 l))))
(checked fuse-s2 (Sigma R (Pi l (Ls N2) (Ls N2)) (Pi l (Ls N2) (PathP (plam i (Ls N2)) (twomaps l) (R l))))
  (fuse N2 s2 s2))
(checked-identity-from twomaps fuse-s2)
(same (twomaps (lcs z2 (lcs (s2 z2) lnl))) (lcs (s2 (s2 z2)) (lcs (s2 (s2 (s2 z2))) lnl)))
(checked notopt (Sigma R (Pi l (Ls N2) (Ls N2)) (Pi l (Ls N2) (PathP (plam i (Ls N2)) (R l) (R l))))
  (pair (lam l l) (lam l (plam i l))))
(checked-identity-from-fail twomaps notopt)
; nested eliminations without a motive convert: the inner one's type is unknown
(check (Pi S U (Pi f (Pi x S S) (Pi g (Pi x S S) (Pi r (Ls S) (PathP (plam i (Ls S)) (lmapc S f (lmapc S g r)) (lmapc S f (lmapc S g r)))))))
  (lam S f g r (plam i (lmapc S f (lmapc S g r)))))
