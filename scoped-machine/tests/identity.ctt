; IDENTITIES (declared L = R makes every call of L run R): retarded non-core feature with no bearing on intended design.
; tests/identity.ctt — identities act on running applications.
; Following p : L g = R g puts the line (p g @ i) on L g's output wire,
; endpoints annotated: the answer (i = 1) is R g and needs no evidence; the
; 0-end is L's run; the witness is the line itself.
(axiom A a b c pth pth2 pth3)
(input w pp)
(def L (lam x (fst x)))
(def R (lam x a))
(identity L R pp)          ; pp : (x) -> L x = R x, not yet supplied

; the answer is the 1-end: neither the evidence nor L's input is needed
(watch before (pair (L w) c))
(same-watch before (pair a c))
(same (L (pair b b)) a)
; the witness waits on the evidence; once supplied it is read in normal form
(witness-watch before)
(supply pp (lam x pth))
(witness-watch before)
(witness (L (pair b b)))
; the 0-end is L's run, which waits on its input
(supply w (pair b b))
(same-watch before (pair a c))
(same-watch before (pair b c) 0)

; a divergent application: the answer does not run it
(input pq)
(def slow (lam x ((lam y (y y)) (lam y (y y)))))
(identity slow R pq)
(watch d (slow b))
(same-watch d a)

; curried: the application collects both arguments
(input w2 pp2)
(def g2 (lam x y (fst x)))
(def h2 (lam x y y))
(identity g2 h2 pp2)
(watch cur (g2 w2 b))
(same-watch cur b)

; associativity on numerals, one orientation (both would pose a cycle,
; which has no normal form)
(def three (suc (suc (suc zero))))
(def addl3 (lam x y z (add (add x y) z)))
(def addr3 (lam x y z (add x (add y z))))
(def assoc3 (lam x y z (plam i (addr3 x y z))))
(identity addl3 addr3 assoc3)
(same (addl3 three three three) (suc (suc (suc (suc (suc (suc (suc (suc (suc zero))))))))))
(defect (addl3 three three three))

; a chain of identities: f1 -> f2 -> f3
(def f1 (lam x (pair x b)))
(def f2 (lam x (pair x c)))
(def f3 (lam x (pair x a)))
(def q12 (lam x pth2))
(def q23 (lam x pth3))
(identity f1 f2 q12)
(identity f2 f3 q23)
(same (f1 b) (pair b a))
(witness (f1 b))

; the answer does not depend on how far the run got before the evidence came
(input pps)
(def Ls (lam x (fst x)))
(def Rs (lam x a))
(identity Ls Rs pps)
(watch sw (pair (Ls (pair (add three (add three three)) b)) c))
(show (fst (pair c c)))
(supply pps (lam x pth))
(same-watch sw (pair a c))

; a typed observation: the declared type moves along the identity's line, and
; the answer is transported back to it
(input pp3)
(def L3 (lam x (fst x)))
(def R3 (lam x a))
(identity L3 R3 pp3)
(supply pp3 (lam x pth))
(show (the (PathP (plam i A) (L3 (pair b b)) (L3 (pair b b))) (plam i (L3 (pair b b)))))
(same (the A (L3 (pair b b))) a)

; inside a function: the reading takes a use of L in a body it builds to the same end
(watch fw (lam y (L y)))
(same-watch fw (lam y a))
(same-watch fw (lam y (fst y)) 0)
(same (lam y (pair (L y) c)) (lam y (pair a c)))
; a neutral case's branches read back whole while identities are declared
(same (lam n (case n ((zero) n) ((suc k) (pair k k)))) (lam n (case n ((zero) zero) ((suc k) (pair k k)))))
