diff --git a/streams.bend b/streams.bend
new file mode 100644
index 0000000..39dbe00
--- /dev/null
+++ b/streams.bend
@@ -0,0 +1,36 @@
+type Stream:
+  case @Cons:
+    head: Nat
+    tail: Stream
+# corecursive, constructor-guarded: an infinite stream
+def ones() -> Stream:
+  @Cons{1n, ones()}
+def from(n: Nat) -> Stream:
+  @Cons{n, from(1n + n)}
+# NOT guarded: a loop
+def bad() -> Stream:
+  bad()
+def hd(s: Stream) -> Nat:
+  match s:
+    case @Cons{h, t}:
+      h
+def tl(s: Stream) -> Stream:
+  match s:
+    case @Cons{h, t}:
+      t
+# a corecursive PATH between two corecursive streams (bisimulation as a path)
+def rep(n: Nat) -> Stream:
+  @Cons{n, rep(n)}
+def repOnes() -> Path(Stream, rep(1n), ones()):
+  <i> @Cons{1n, repOnes() @ i}
+# structural recursion on a possibly-infinite value: accepted?
+def sumTo(k: Nat, s: Stream) -> Nat:
+  match k:
+    case 0n:
+      0n
+    case 1n + p:
+      match s:
+        case @Cons{h, t}:
+          1n + sumTo(p, t)
+def main() -> Nat:
+  hd(tl(tl(from(5n))))
diff --git a/supline.bend b/supline.bend
new file mode 100644
index 0000000..540592d
--- /dev/null
+++ b/supline.bend
@@ -0,0 +1,23 @@
+# A SUPERPOSED type line: transport along &0{negPath @ i, Bool} routes each
+# universe along its own line — the DUP-SUP rule as the fibre discriminator.
+# On the full runtime this needs NO rule: the coe dispatch (a match) commutes
+# over the superposition and the same-label dup of the value annihilates.
+def neg(x: Bool) -> Bool:
+  if x:
+    False
+  else:
+    True
+def negLnv(x: Bool) -> Path(Bool, neg(neg(x)), x):
+  if x:
+    <_> True
+  else:
+    <_> False
+def negPath() -> Path(Set, Bool, Bool):
+  ua(Bool, Bool, neg, neg, negLnv, negLnv)
+def supLine() -> Interval -> Set:
+  lambda i. &0{negPath() @ i, Bool}
+# checked definitionally (cubical_test4): &0{True,True} goes to &0{False,True}
+def sup_transport() -> Path(&0{Bool, Bool}, coe(lambda i. supLine()(i), i0, i1, &0{True, True}), &0{False, True}):
+  <i> &0{False, True}
+def main() -> &0{Bool, Bool}:
+  coe(lambda i. supLine()(i), i0, i1, &0{True, True})
