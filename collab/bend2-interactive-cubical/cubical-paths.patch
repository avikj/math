+-- | Glue(A, [(φ, T, e), ...])
+parseGlue :: Parser Term
+parseGlue = label "Glue" $ do
+  _ <- try $ keyword "Glue" <* symbol "("
+  a <- parseTerm
+  _ <- symbol ","
+  _ <- symbol "["
+  fs <- many triple
+  _ <- symbol "]"
+  _ <- symbol ")"
+  return (Glu a fs)
