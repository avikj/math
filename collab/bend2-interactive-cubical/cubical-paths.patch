diff --git a/braid.bend b/braid.bend
new file mode 100644
index 0000000..de7aee3
--- /dev/null
+++ b/braid.bend
@@ -0,0 +1,126 @@
+# THE BRAID FABRIC (VeniBandha / AnantaVeni), carried to Bend and run.
+#
+# Strands are interdependent pairs Sūtra = Bool × Bool; the crossing σᵢ is the
+# twisted swap: the strand that passes over is turned by the quarter turn
+# caturaṃśa (a, b) = (not b, a).  The rope is the coinductive stream Dhārā of
+# strands; Bend2 has no coinduction, so the rope is carried as its observation
+# function Nat -> Sūtra (bisimilar = equal at every depth: the
+# ProductiveObservabilityBridge), on which every σᵢ is total and every braid
+# relation holds at every position — pointwise, by the same induction as the
+# Agda (peel to the base at i = 0, then the head is preserved and the tail
+# recurses).
+def neg(x: Bool) -> Bool:
+  if x:
+    False
+  else:
+    True
+def Sutra() -> Set:
+  any a: Bool. Bool
+def quarter(s: Sutra) -> Sutra:
+  match s:
+    case (a, b):
+      (neg(b), a)
+def Rajju() -> Set:
+  Nat -> Sutra
+
+# σᵢ on the rope: cross strands i and i+1, turning the one that passes over
+def veni(i: Nat, s: Rajju, n: Nat) -> Sutra:
+  match i:
+    case 0n:
+      match n:
+        case 0n:
+          quarter(s(1n))
+        case 1n + m:
+          match m:
+            case 0n:
+              s(0n)
+            case 1n + k:
+              s(2n + k)
+    case 1n + j:
+      match n:
+        case 0n:
+          s(0n)
+        case 1n + m:
+          veni(j, lambda k. s(1n + k), m)
+
+# ---------------------------------------------------------------------------
+# The braid relation σᵢ σᵢ₊₁ σᵢ = σᵢ₊₁ σᵢ σᵢ₊₁ at every position, pointwise.
+# The base i = 0 is definitional at every depth after splitting n into
+# 0 / 1 / 2+ (both sides compute to the same strand); the step preserves the
+# head and recurses on the tail.
+# ---------------------------------------------------------------------------
+def veniBase(s: Rajju, n: Nat) -> Path(Sutra, veni(0n, lambda k. veni(1n, lambda k. veni(0n, s, k), k), n), veni(1n, lambda k. veni(0n, lambda k. veni(1n, s, k), k), n)):
+  match n:
+    case 0n:
+      <_> quarter(quarter(s(2n)))
+    case 1n + m:
+      match m:
+        case 0n:
+          <_> quarter(s(1n))
+        case 1n + k:
+          match k:
+            case 0n:
+              <_> s(0n)
+            case 1n + q:
+              <_> s(3n + q)
+def veniRel(i: Nat, s: Rajju, n: Nat) -> Path(Sutra, veni(i, lambda k. veni(1n + i, lambda k. veni(i, s, k), k), n), veni(1n + i, lambda k. veni(i, lambda k. veni(1n + i, s, k), k), n)):
+  match i:
+    case 0n:
+      veniBase(s, n)
+    case 1n + j:
+      match n:
+        case 0n:
+          <_> s(0n)
+        case 1n + m:
+          veniRel(j, lambda k. s(1n + k), m)
+
+# The distant commutation σᵢ σⱼ = σⱼ σᵢ for j ≥ i + 2, at every gap, pointwise.
+def duraBase(k: Nat, s: Rajju, n: Nat) -> Path(Sutra, veni(0n, lambda m. veni(2n + k, s, m), n), veni(2n + k, lambda m. veni(0n, s, m), n)):
+  match n:
+    case 0n:
+      <_> quarter(s(1n))
+    case 1n + m:
+      match m:
+        case 0n:
+          <_> s(0n)
+        case 1n + q:
+          <_> veni(k, lambda r. s(2n + r), q)
+def add(a: Nat, b: Nat) -> Nat:
+  match a:
+    case 0n:
+      b
+    case 1n + p:
+      1n + add(p, b)
+def duraRel(i: Nat, k: Nat, s: Rajju, n: Nat) -> Path(Sutra, veni(i, lambda m. veni(2n + add(i, k), s, m), n), veni(2n + add(i, k), lambda m. veni(i, s, m), n)):
+  match i:
+    case 0n:
+      duraBase(k, s, n)
+    case 1n + j:
+      match n:
+        case 0n:
+          <_> s(0n)
+        case 1n + m:
+          duraRel(j, k, lambda r. s(1n + r), m)
+
+# ---------------------------------------------------------------------------
+# A concrete rope, run: strand n = (n even?, True); observe the rope after
+# σ₀σ₁σ₀ and after σ₁σ₀σ₁ at depth 0..3 — equal, as the relation says.
+# ---------------------------------------------------------------------------
+def even(n: Nat) -> Bool:
+  match n:
+    case 0n:
+      True
+    case 1n + m:
+      neg(even(m))
+def rope(n: Nat) -> Sutra:
+  (even(n), True)
+def lhs(n: Nat) -> Sutra:
+  veni(0n, lambda k. veni(1n, lambda k. veni(0n, rope, k), k), n)
+def rhs(n: Nat) -> Sutra:
+  veni(1n, lambda k. veni(0n, lambda k. veni(1n, rope, k), k), n)
+def fstS(s: Sutra) -> Bool:
+  match s:
+    case (a, b):
+      a
+def main() -> Bool:
+  fstS(lhs(0n))
diff --git a/chain.bend b/chain.bend
new file mode 100644
index 0000000..d021e3f
--- /dev/null
+++ b/chain.bend
@@ -0,0 +1,60 @@
+# Transport across COMPOSITE equivalences, performed by the net.
+# Every definition below is checked, then run in three ways: in-process
+# (normaliser), --to-hvm4-raw (no pre-normalisation) and --to-hvm (HVM3).
+def neg(x: Bool) -> Bool:
+  if x:
+    False
+  else:
+    True
+def negLnv(x: Bool) -> Path(Bool, neg(neg(x)), x):
+  if x:
+    <_> True
+  else:
+    <_> False
+def negPath() -> Path(Set, Bool, Bool):
+  ua(Bool, Bool, neg, neg, negLnv, negLnv)
+
+# composition of universe paths (hcomp in Set): neg then neg
+def negNeg() -> Path(Set, Bool, Bool):
+  <i> hcomp(Set, i, <_> Bool, <k> negPath() @ k, negPath() @ i)
+# three negations
+def neg3() -> Path(Set, Bool, Bool):
+  <i> hcomp(Set, i, <_> Bool, <k> negPath() @ k, negNeg() @ i)
+
+def viaNegNeg(x: Bool) -> Bool:
+  coe(lambda i. negNeg() @ i, i0, i1, x)
+def viaNeg3(x: Bool) -> Bool:
+  coe(lambda i. neg3() @ i, i0, i1, x)
+def viaNeg3Bwd(x: Bool) -> Bool:
+  coe(lambda i. neg3() @ i, i1, i0, x)
+# inverse line
+def viaInv(x: Bool) -> Bool:
+  coe(lambda i. negPath() @ inot(i), i0, i1, x)
+# Pi line: a function Bool -> Bool transported along (negPath -> Bool)
+def viaPi(x: Bool) -> Bool:
+  (coe(lambda i. (negPath() @ i) -> Bool, i0, i1, lambda y. y))(x)
+# Sigma line: a pair transported componentwise along Σ (negPath) Bool
+def viaSig(x: Bool) -> Bool:
+  match coe(lambda i. any a: (negPath() @ i). Bool, i0, i1, (x, x)):
+    case (a, b):
+      a
+
+# the laws on closed values, definitional in the checker (on a variable x,
+# neg(neg(x)) = x is only propositional, as in cubical Agda)
+def negNeg_T() -> Path(Bool, viaNegNeg(True), True):
+  <_> True
+def negNeg_F() -> Path(Bool, viaNegNeg(False), False):
+  <_> False
+def neg3_T() -> Path(Bool, viaNeg3(True), False):
+  <_> False
+def neg3Bwd_F() -> Path(Bool, viaNeg3Bwd(False), True):
+  <_> True
+def inv_T() -> Path(Bool, viaInv(True), False):
+  <_> False
+def pi_T() -> Path(Bool, viaPi(True), False):
+  <_> False
+def sig_T() -> Path(Bool, viaSig(True), False):
+  <_> False
+
+def main() -> Bool:
+  viaNeg3(True)
diff --git a/coinduction.bend b/coinduction.bend
new file mode 100644
index 0000000..bb09c15
--- /dev/null
+++ b/coinduction.bend
@@ -0,0 +1,71 @@
+# THE INTERACTIVE MACHINE, COINDUCTIVELY: infinite histories as one object.
+# Bend2 types are records read lazily; a corecursive definition is typed by
+# assuming itself at its declared type (Fix), the runtime unfolds on demand,
+# and the totality classifier tags constructor-guarded corecursion
+# [productive] (--total refuses [unchecked]).  So IExec / Answers are the
+# coinductive records themselves, and bisimulations are corecursive paths.
+def isContr(A: Set) -> Set:
+  any c: A. (all x: A. Path(A, c, x))
+
+# the open machine on Nat: the environment answers a Bool; +1 or reset
+def Q(x: Nat) -> Set:
+  Bool
+def step(x: Nat, b: Bool) -> Nat:
+  if b:
+    1n + x
+  else:
+    0n
+
+# Answers x : an answer now, and answers forever after (coinductive)
+type Answers(x: Nat):
+  case @More:
+    ans: Q(x)
+    more: Answers(step(x, ans))
+# IExec x : a now, a receipt now ≡ x, an answer, and the rest (coinductive)
+type IExec(x: Nat):
+  case @Run:
+    now: Nat
+    here: Path(Nat, now, x)
+    ans: Q(x)
+    next: IExec(step(x, ans))
+
+# the environment that always says True (an infinite answer stream)
+def always(x: Nat) -> Answers(x):
+  @More{True, always(step(x, True))}
+# alternating True/False
+def alt(x: Nat, b: Bool) -> Answers(x):
+  @More{b, alt(step(x, b), match b: case True: False case False: True)}
+
+# forgetting the states of a history leaves its answers (corecursive)
+def forgetStates(x: Nat, e: IExec(x)) -> Answers(x):
+  match e:
+    case @Run{now, here, a, rest}:
+      @More{a, forgetStates(step(x, a), rest)}
+# replaying the answers rebuilds the history, receipts refl (corecursive)
+def replay(x: Nat, s: Answers(x)) -> IExec(x):
+  match s:
+    case @More{a, more}:
+      @Run{x, <_> x, a, replay(step(x, a), more)}
+
+# THE THEOREM run-is-answers, coinductively: both round trips are
+# corecursive paths (bisimulations), the receipt collapsed by the ∨-square.
+def forgetReplay(x: Nat, s: Answers(x)) -> Path(Answers(x), forgetStates(x, replay(x, s)), s):
+  match s:
+    case @More{a, more}:
+      <i> @More{a, forgetReplay(step(x, a), more) @ i}
+def replayForget(x: Nat, e: IExec(x)) -> Path(IExec(x), replay(x, forgetStates(x, e)), e):
+  match e:
+    case @Run{now, here, a, rest}:
+      <i> @Run{here @ inot(i), <j> here @ ior(inot(i), j), a, replayForget(step(x, a), rest) @ i}
+
+# observe a history: the state after n steps
+def stateAt(x: Nat, e: IExec(x), n: Nat) -> Nat:
+  match n:
+    case 0n:
+      x
+    case 1n + p:
+      match e:
+        case @Run{now, here, a, rest}:
+          stateAt(step(x, a), rest, p)
+def main() -> Nat:
+  stateAt(0n, replay(0n, alt(0n, True)), 5n)
diff --git a/coinduction_mustfail.bend b/coinduction_mustfail.bend
new file mode 100644
index 0000000..13a0a6c
--- /dev/null
+++ b/coinduction_mustfail.bend
@@ -0,0 +1,23 @@
+type Stream:
+  case @Cons:
+    head: Nat
+    tail: Stream
+def ones() -> Stream:
+  @Cons{1n, ones()}
+def rep(n: Nat) -> Stream:
+  @Cons{n, rep(n)}
+def twos() -> Stream:
+  @Cons{2n, twos()}
+# UNGUARDED corecursive "proof": must be [unchecked] (refused by --total)
+def cheat() -> Path(Stream, ones(), twos()):
+  cheat()
+# FALSE bisimulation: heads differ, must ✗
+def wrong() -> Path(Stream, ones(), twos()):
+  <i> @Cons{1n, wrong() @ i}
+# guarded but through a non-constructor (tail of): must NOT be [productive]
+def viaTail() -> Stream:
+  match ones():
+    case @Cons{h, t}:
+      viaTail()
+def main() -> Nat:
+  0n
diff --git a/corpus_calculus.bend b/corpus_calculus.bend
new file mode 100644
index 0000000..2888f4e
--- /dev/null
+++ b/corpus_calculus.bend
@@ -0,0 +1,42 @@
+# Translation of formal/cubical/theorems/residue/CorpusCalculus.agda
+# Point = Σ[ A ∈ Type ] A ; Question s = Σ[ B ∈ Type ] (fst s → B)
+# target, Event, step, twoSteps — refl theorems check by computation.
+
+def Point() -> Set:
+  any A: Set. A
+
+def point(A: Set, a: A) -> Point():
+  (A, a)
+
+def Src(s: Point()) -> Set:
+  match s:
+    case (A, a):
+      A
+
+def src(s: Point()) -> Src(s):
+  match s:
+    case (A, a):
+      a
+
+def Question(s: Point()) -> Set:
+  any B: Set. (Src(s) -> B)
+
+def target(s: Point(), q: Question(s)) -> Point():
+  match q:
+    case (B, f):
+      (B, f(src(s)))
+
+# Event s q s' = target s q ≡ s'   (as a Path)
+def Event(s: Point(), q: Question(s), s2: Point()) -> Set:
+  Path(Point(), target(s, q), s2)
+
+# step : fst (target (point a) (B , f)) ≡ B with value f a  — by refl
+def step(A: Set, B: Set, a: A, f: A -> B) -> Path(Point(), target(point(A, a), (B, f)), point(B, f(a))):
+  <i> target(point(A, a), (B, f))
+
+# twoSteps : target (target (point a) (B,f)) (C,g) ≡ point (g (f a)) — by refl
+def twoSteps(A: Set, B: Set, C: Set, a: A, f: A -> B, g: B -> C) -> Path(Point(), target(target(point(A, a), (B, f)), (C, g)), point(C, g(f(a)))):
+  <i> point(C, g(f(a)))
+
+def main() -> Nat:
+  0n
