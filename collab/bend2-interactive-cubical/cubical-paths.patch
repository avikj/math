   Pat _ _ _  -> error "unreachable"
 
+-- | The JS backend erases; a cubical term must not be silently dropped.
+cubicalUnsupported :: String -> a
+cubicalUnsupported what =
+  error ("JavaScript backend: " ++ what ++ " has no JavaScript representation. \
+         \Compile cubical programs with --to-hvm4-full (the full cubical runtime).")
+
