+    LstM x n c     -> "λ{#Nil: " ++ go d n ++ "; #Con: " ++ go d c ++ "}(" ++ go d x ++ ")"
+    UniM x f       -> "λ{1: " ++ go d f ++ "}(" ++ go d x ++ ")"
+    SigM x f       -> "λ{#Pair: " ++ go d f ++ "}(" ++ go d x ++ ")"
