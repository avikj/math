+parseQsquash :: Parser Term
+parseQsquash = label "qsquash" $ do
+  _ <- try $ keyword "qsquash"
+  return QSq
+
+-- | qrec(x, setB, f, resp) : B — the recursor SQ.rec into a set B.
+parseQrec :: Parser Term
+parseQrec = label "qrec" $ do
+  _ <- try $ keyword "qrec" <* symbol "("
+  x <- parseTerm
+  _ <- symbol ","
+  s <- parseTerm
+  _ <- symbol ","
+  f <- parseTerm
+  _ <- symbol ","
+  r <- parseTerm
+  _ <- symbol ")"
+  return (QRec x s f r)
