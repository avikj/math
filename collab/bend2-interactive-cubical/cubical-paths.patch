+-- | Adjusts the constructor signatures of a HIT declaration (they are terms
+-- like any other: pattern matches flattened, names bound).
+adjustHit :: Book -> HitDecl -> HitDecl
+adjustHit book h = h
+  { hitType  = adjust book (hitType h)
+  , hitCtors = [ (c, k { ctorType = adjust book (ctorType k) }) | (c, k) <- hitCtors h ] }
