@@ -0,0 +1,198 @@
+{-./../Core/Type.hs-}
+
+-- Bend2 -> hyper: the checked book, emitted as the kernel's own text (hyper/read.c).
+--
+-- Nothing is erased or pre-normalised. Every definition is a typed point
+-- `(def b/NAME : TYPE = TERM)`; types are constructor cells; the interval,
+-- paths, transport, composition, Glue and the HIT schema are the kernel's
+-- own cells, so this file is a table of correspondences and no rule lives
+-- here. The Bend dialect is thereby a certified translator (MAP.md §5.1):
+-- the certificate is the check that produced the book.
+module Target.Hyper (compileHyper) where
+
+import Data.List (intercalate)
+import qualified Data.Map as M
+import GHC.Float (castDoubleToWord64)
+
+import Core.Type
+import Core.WHNF (termToInt)
+
+compileHyper :: Book -> String
+compileHyper book@(Book defs hits) =
+  unlines (map hitDecl (M.toList hits) ++ concatMap def (M.toList defs))
+  where
+    def (nam, (_, tm, ty)) = [ "(def " ++ defName nam ++ " : " ++ emit book ty ++ " = " ++ emit book tm ++ ")" ]
+    hitDecl (t, h) =
+      "(hit " ++ hitName t ++ " (" ++ unwords [ "p" ++ show i | i <- [1 .. hitArity h] ] ++ ") : " ++ emit book (hitType h)
+        ++ concat [ " (" ++ ctorName c ++ " : " ++ ctorTypeText book t (hitArity h) (ctorType k) ++ ")" | (c, k) <- hitCtors h ] ++ ")"
+
+-- A constructor's closed type: the outer Pis bind the HIT's parameters, and the bare
+-- constructors written in its endpoints (@north) take those parameters (fillHitHeads).
+ctorTypeText :: Book -> Name -> Int -> Term -> String
+ctorTypeText book t n0 ty0 = go [] n0 ty0 where
+  go env 0 ty = emitIn book (Just (t, reverse env)) ty
+  go env n ty = case cut ty of
+    All a (Lam k f) -> let k' = if null k then "p" ++ show (length env) else k; v = Var k' 0 in
+      "(ctr Pi " ++ emitIn book (Just (t, reverse env)) a ++ " (lam " ++ k' ++ " " ++ go (v : env) (n - 1) (f v) ++ "))"
+    _ -> emitIn book (Just (t, reverse env)) ty
+
+-- Namespaces: definitions `b/`, HIT types `h/`, HIT constructors `@`, enum symbols `&`.
+defName, hitName, ctorName, symName :: Name -> String
+defName  n = "b/" ++ n
+hitName  n = "h/" ++ n
+ctorName n = "@" ++ n
+symName  n = "&" ++ n
+
+emit :: Book -> Term -> String
+emit book = emitIn book Nothing
+
+emitIn :: Book -> Maybe (Name, [Term]) -> Term -> String
+emitIn book hitEnv t0 = go 0 t0 where
+  go :: Int -> Term -> String
+  go d t = case t of
+    Var n _        -> n
+    Ref k          -> "(ref " ++ defName k ++ ")"
+    Sub x          -> go d x
+    Loc _ x        -> go d x
+    Ind x          -> go d x
+    Frz x          -> go d x
+    Chk x ty       -> "(chk " ++ go d ty ++ " " ++ go d x ++ ")"
+    Fix k f        -> let n = nm k d in "(fix " ++ n ++ " " ++ go (d+1) (f (Var n d)) ++ ")"
+    Let v f        -> case cut f of
+                        Lam k g -> let n = nm k d in "(let " ++ n ++ " " ++ go d v ++ " " ++ go (d+1) (g (Var n d)) ++ ")"
+                        _       -> "(app " ++ go d f ++ " " ++ go d v ++ ")"
+    Lam k f        -> let n = nm k d in "(lam " ++ n ++ " " ++ go (d+1) (f (Var n d)) ++ ")"
+    App f x        -> "(app " ++ go d f ++ " " ++ go d x ++ ")"
+    -- types are cells
+    Set            -> "(ctr Set)"
+    Emp            -> "(ctr Empty)"
+    Uni            -> "(ctr Unit)"
+    Bit            -> "(ctr Bool)"
+    Nat            -> "(ctr Nat)"
+    Lst e          -> ctr "List" [go d e]
+    Enu ss         -> ctr "Enum" [list [ "(ctr " ++ symName s ++ ")" | s <- ss ]]
+    Num k          -> ctr "Num" ["(ctr " ++ symName (numTag k) ++ ")"]
+    Sig a b        -> ctr "Sig" [go d a, go d b]
+    All a b        -> ctr "Pi" [go d a, go d b]
+    Eql a x y      -> ctr "Eql" [go d a, go d x, go d y]
+    Itv            -> "(ctr Itv)"
+    Pth a u v      -> ctr "Path" [line d a, go d u, go d v]
+    Prt p a        -> ctr "Partial" [go d p, go d a]
+    Rst a p u      -> ctr "Sub" [go d a, go d p, go d u]
+    Tru a          -> ctr (hitName "Trunc") [go d a]
+    Cir            -> "(ctr " ++ hitName "S1" ++ ")"
+    Quo a r        -> ctr (hitName "Quot") [go d a, go d r]
+    HTy t' ps      -> ctr (hitName t') (map (go d) ps)
+    -- points are cells
+    One            -> "(ctr Tt)"
+    Bt0            -> "(ctr False)"
+    Bt1            -> "(ctr True)"
+    Zer            -> "(ctr Zer)"
+    Suc n          -> ctr "Suc" [go d n]
+    Nil            -> "(ctr Nil)"
+    Con h tl       -> ctr "Cons" [go d h, go d tl]
+    Sym s          -> "(ctr " ++ symName s ++ ")"
+    Tup a b        -> ctr "Pair" [go d a, go d b]
+    Rfl            -> "(ctr Refl)"
+    Val (U64_V v)  -> "(num " ++ show v ++ ")"
+    Val (CHR_V c)  -> "(chr " ++ show (fromEnum c) ++ ")"
+    Val (I64_V v)  -> "(i64 " ++ show v ++ ")"
+    Val (F64_V x)  -> "(f64 " ++ show (castDoubleToWord64 x) ++ ")"
+    Op2 o a b      -> "(op2 " ++ op2 o ++ " " ++ go d a ++ " " ++ go d b ++ ")"
+    Op1 o a        -> "(op1 " ++ op1 o ++ " " ++ go d a ++ ")"
+    Pri U64_TO_CHAR -> "(lam x (op1 tochar x))"
+    InS x          -> ctr "InS" [go d x]
+    Sys fs         -> ctr "Sys" [faces d fs]
+    -- the checker's three built-in HITs are instances of the schema (bend.hyper declares them)
+    TIn a          -> ctr (ctorName "Trunc/tin") [go d a]
+    TSq x y        -> ctr (ctorName "Trunc/tsquash") [go d x, go d y]
+    CBase          -> "(ctr " ++ ctorName "S1/base" ++ ")"
+    CLoop          -> "(ctr " ++ ctorName "S1/loop" ++ ")"
+    QCl a          -> ctr (ctorName "Quot/cl") [go d a]
+    QEq a b w      -> ctr (ctorName "Quot/eq") [go d a, go d b, go d w]
+    QSq            -> "(ctr " ++ ctorName "Quot/sq" ++ ")"
+    -- a declared HIT's constructor carries its parameters (the checker read them off the goal)
+    HCon t c ps as ivs -> case derefHit book t of
+      Just h | null ps && hitArity h > 0 -> case hitEnv of
+        Just (t', vs) | t' == t -> apply (ctr (ctorName c) (map (go d) (vs ++ as)))
+        _ -> error ("hyper emission: a constructor of the parametric HIT " ++ t ++ " reached emission without its parameters; the term was not checked")
+      _ -> apply (ctr (ctorName c) (map (go d) (ps ++ as)))
+      where apply h = foldl (\acc i -> "(app " ++ acc ++ " " ++ go d i ++ ")") h ivs
+    -- eliminators are case trees; a branch over fields is opened in place
+    EmpM x         -> "(case " ++ go d x ++ ")"
+    UniM x f       -> "(case " ++ go d x ++ " (Tt () " ++ go d f ++ "))"
+    BitM x f tr    -> "(case " ++ go d x ++ " (False () " ++ go d f ++ ") (True () " ++ go d tr ++ "))"
+    NatM x z s     -> "(case " ++ go d x ++ " (Zer () " ++ go d z ++ ") " ++ branch d "Suc" 1 s ++ ")"
+    LstM x n c     -> "(case " ++ go d x ++ " (Nil () " ++ go d n ++ ") " ++ branch d "Cons" 2 c ++ ")"
+    SigM x f       -> "(case " ++ go d x ++ " " ++ branch d "Pair" 2 f ++ ")"
+    EqlM x f       -> "(case " ++ go d x ++ " (Refl () " ++ go d f ++ "))"
+    EnuM x cs df   -> "(case " ++ go d x ++ concat [ " (" ++ symName s ++ " () " ++ go d b ++ ")" | (s, b) <- cs ]
+                        ++ " (_ () (app " ++ go d df ++ " " ++ go d x ++ ")))"
+    OutS x         -> "(case " ++ go d x ++ " (InS (" ++ var d ++ ") " ++ var d ++ "))"
+    HEl p bs x     -> "(helim " ++ go d p ++ " " ++ go d x ++ concatMap (hbranch d) bs ++ ")"
+    HRec bs x      -> "(hrec " ++ go d x ++ concatMap (hbranch d) bs ++ ")"
+    TRec x p f     -> "(trec " ++ go d x ++ " " ++ go d p ++ " " ++ go d f ++ ")"
+    CRec x b l     -> "(srec " ++ go d x ++ " " ++ go d b ++ " " ++ go d l ++ ")"
+    QRec x s f r   -> "(qrec " ++ go d x ++ " " ++ go d s ++ " " ++ go d f ++ " " ++ go d r ++ ")"
+    POut u         -> "(pout " ++ go d u ++ ")"
+    -- superpositions: a numeric label is one global choice name; the match is two faces
+    Sup l a b      -> "(sup " ++ label d l ++ " " ++ go d a ++ " " ++ go d b ++ ")"
+    SupM x l f     -> let lb = label d l in
+                      "(app (app " ++ go d f ++ " (fce " ++ lb ++ " 0 " ++ go d x ++ ")) (fce " ++ lb ++ " 1 " ++ go d x ++ "))"
+    Frk _ _ _      -> error "hyper emission: a fork survived unfrk"
+    Era            -> "(era)"
+    -- the interval and the Kan cells
+    I0             -> "i0"
+    I1             -> "i1"
+    INot a         -> "(inot " ++ go d a ++ ")"
+    IAnd a b       -> "(iand " ++ go d a ++ " " ++ go d b ++ ")"
+    IOr a b        -> "(ior " ++ go d a ++ " " ++ go d b ++ ")"
+    PLm k f        -> let n = nm k d in "(plm " ++ n ++ " " ++ go (d+1) (f (Var n d)) ++ ")"
+    PAp p r        -> "(app " ++ go d p ++ " " ++ go d r ++ ")"
+    Coe pP r s x   -> "(trp " ++ line d pP ++ " " ++ go d r ++ " " ++ go d s ++ " " ++ go d x ++ ")"
+    Trp l p x      -> "(transp " ++ line d l ++ " " ++ go d p ++ " " ++ go d x ++ ")"
+    HCm a fs x     -> "(hcm " ++ go d a ++ " " ++ go d x ++ " " ++ faces d fs ++ ")"
+    Glu a fs       -> "(Glue " ++ go d a ++ " " ++ list [ ctr "GFace" [go d p, go d ty, go d e] | (p, ty, e) <- fs ] ++ ")"
+    GlB a fs x     -> "(glue " ++ faces d fs ++ " (chk " ++ go d a ++ " " ++ go d x ++ "))"   -- the base type rides with the point
+    UnG g          -> "(unglue " ++ go d g ++ ")"
+    Ua a b f g gf fg -> ctr "UaU" (map (go d) [a, b, f, g, gf, fg])
+    -- refused
+    Met _ _ _      -> error "hyper emission: an unsolved metavariable has no cell"
+    Pat _ _ _      -> error "hyper emission: an unflattened pattern match"
+    -- dropped: a log is an ASK the host answers; a rewrite is checker-internal
+    Log _ x        -> go d x
+    Rwt _ _ x      -> go d x
+
+  -- a line of types is a λ over the interval: emitted as a path lambda, so its binder is a dimension name
+  line d t = case cut t of
+    Lam k f -> let n = nm k d in "(plm " ++ n ++ " " ++ go (d+1) (f (Var n d)) ++ ")"
+    _       -> go d t
+  var d = "x" ++ show d
+  -- a binder keeps its written name (the presentation of an open normal form is Bend2's)
+  nm k d = if null k || k == "i0" || k == "i1" || all (`elem` "0123456789") k then var d else k
+  ctr n xs = "(ctr " ++ n ++ concatMap (' ' :) xs ++ ")"
+  list xs = foldr (\x acc -> "(ctr Cons " ++ x ++ " " ++ acc ++ ")") "(ctr Nil)" xs
+  faces d fs = list [ ctr "Face" [go d p, go d u] | (p, u) <- fs ]
+
+  -- a branch of arity n: open the body's lambdas over fresh field names, or apply it
+  branch d c n body = "(" ++ c ++ " (" ++ unwords names ++ ") " ++ open d body names ++ ")"
+    where names = [ var (d + i) | i <- [0 .. n - 1] ]
+  open d body [] = go d body
+  open d body (n : ns) = case cut body of
+    Lam _ f -> open (d + 1) (f (Var n d)) ns
+    _       -> open (d + 1) (App body (Var n d)) ns
+  hbranch d (c, b) = case derefCtor book c of
+    Just (_, _, k) -> " " ++ branch d (ctorName c) (ctorNArgs k) b
+    Nothing        -> error ("hyper emission: helim branch for an unknown constructor " ++ c)
+
+  -- a label: a closed numeral is a global choice name; a variable is itself
+  label d l = case termToInt book l of
+    Just k  -> show k
+    Nothing -> go d l
+
+  op2 o = case o of
+    ADD -> "add"; SUB -> "sub"; MUL -> "mul"; DIV -> "div"; MOD -> "mod"; POW -> "pow"
+    EQL -> "eq"; NEQ -> "ne"; LST -> "lt"; GRT -> "gt"; LEQ -> "le"; GEQ -> "ge"
+    AND -> "and"; OR -> "or"; XOR -> "xor"; SHL -> "shl"; SHR -> "shr"
+  op1 o = case o of { NOT -> "not"; NEG -> "neg" }
+  numTag k = case k of { U64_T -> "U64"; I64_T -> "I64"; F64_T -> "F64"; CHR_T -> "Char" }
