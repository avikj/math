+  , "@piB = λ{#Pi: λA. λB. B; λt. λv. #StuckCod{t}}"
+  , "@sgA = λ{#Sig: λA. λB. A; λt. #StuckDom{t}}"
+  , "@sgB = λ{#Sig: λA. λB. B; λt. λv. #StuckCod{t}}"
