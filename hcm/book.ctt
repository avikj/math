-- book.ctt: examples.  No number appears as a tally.

-- A discrete type, with its Kan structure added as clauses of compH
-- (spec section 13: a box whose cap is a constructor reduces to it).
data Two = Two
data Bit = true' | false'

not true' = false'
not false' = true'

compH Two n L phi u true' = true'
compH Two n L phi u false' = false'

postulate A : U
postulate B : U
postulate a : A
postulate b : A
postulate p : Path A a b
postulate f : A -> B
postulate h : A -> B
postulate k : B -> B
postulate P : A -> U
postulate pa : P a
postulate q : (x : A) -> Path B (k (f x)) (h x)

-- ordinary elimination
eval not (not true')

-- a postulated path keeps its endpoints
eval p 0
eval p 1
eval reverse (reverse p)
eval ap f p

-- the interval and faces are list programs over names
eval <i> <j> (i /\ j) \/ (~ i)
eval <i> (i = 0)
eval <i> fjoin (i = 0) (i = 1)

-- transport in a discrete type, in Pi, Sigma, PathP
eval transport (\x -> Two) p true'
eval coe (<i> Pi Two (\_ -> Two)) not
eval coe (<i> Sigma Two (\_ -> Two)) (true' , false')
eval coe (<i> Path Two true' true') (refl true')

-- transport at a neutral family suspends; reindexing would reactivate it
eval transport P (refl a) pa

-- composition in the universe gives a Glue type
eval coe (<i> U) Two

-- univalence: transport along ua runs through the Glue clause
eval coe (ua Two Two (idEquiv Two)) true'

-- a singleton contracts
eval contractSingleton a p

-- the identity agent of q : (x : A) -> k (f x) = h x
agent q
eval q-cLinv a (k (f a)) (refl (k (f a)))
eval q-forward a (k (f a)) (q-cLinv a (k (f a)) (refl (k (f a))))
