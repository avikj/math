-- core.cell: equivalences, univalence, path operations, the identity agent.
-- Universe levels are explicit (handoff section 33): U l : U (suc l), no
-- cumulativity.  The composition clauses in cell.c use fib, Equiv and
-- lineEquiv from here, at the level of the family they compose.

def Contr (l : Level) (A : U l) : U l = (c : A) * ((x : A) -> Path A c x)
def fib (l : Level) (A B : U l) (f : A -> B) (y : B) : U l = (x : A) * Path B (f x) y
def Equiv (l : Level) (A B : U l) : U l = (f : A -> B) * ((y : B) -> Contr l (fib l A B f y))

-- IdEquiv: centre (y , refl), contraction <i> (p (~i) , <j> p (~i \/ j))  (section 15)
def idEquiv (l : Level) (A : U l) : Equiv l A A =
  (\(x : A) -> x ,
   \(y : A) -> ((y , <i> y) ,
                \(z : fib l A A (\(x : A) -> x) y) -> <i> (z.2 @ (~ i) , <j> z.2 @ (~ i \/ j))))

-- LineEquiv (section 17): coe along i |-> Equiv (A 0) (A i) of IdEquiv (A 0)
def lineEquiv (l : Level) (A0 A1 : U l) (p : Path (U l) A0 A1) : Equiv l A0 A1 =
  coe <i> (Equiv l A0 (p @ i)) (idEquiv l A0)

-- the Glue path of an equivalence (section 17)
def ua (l : Level) (A B : U l) (e : Equiv l A B) : Path (U l) A B =
  <i> Glue B [ (i = 0) -> (A , e) , (i = 1) -> (B , idEquiv l B) ]

-- Paths (section 18)
def refl (l : Level) (A : U l) (a : A) : Path A a a = <i> a
def reverse (l : Level) (A : U l) (a b : A) (p : Path A a b) : Path A b a = <i> p @ (~ i)
def compose (l : Level) (A : U l) (a b c : A) (p : Path A a b) (q : Path A b c) : Path A a c =
  <i> hcomp <j> A [ (i = 0) -> a , (i = 1) -> q @ j ] (p @ i)
def ap (l : Level) (A B : U l) (f : A -> B) (a b : A) (p : Path A a b) : Path B (f a) (f b) = <i> f (p @ i)
def transport (l : Level) (A : U l) (P : A -> U l) (a b : A) (p : Path A a b) (x : P a) : P b = coe <i> (P (p @ i)) x

-- Singletons at b contract: <i> (k (~i) , <j> k (~i \/ j))
def contractSingleton (l : Level) (A : U l) (a b : A) (k : Path A a b) :
    Path ((h : A) * Path A h b) (b , <i> b) (a , k) =
  <i> (k @ (~ i) , <j> k @ (~ i \/ j))

-- The identity agent, forward and reverse (NET_SPEC 1)
def agentForward (l : Level) (B : U l) (L R : B) (p : Path B L R) (y : B) (q : Path B L y) : Path B R y =
  <i> hcomp <j> B [ (i = 0) -> R , (i = 1) -> q @ j ] (p @ (~ i))
def agentBackward (l : Level) (B : U l) (L R : B) (p : Path B L R) (y : B) (r : Path B R y) : Path B L y =
  <i> hcomp <j> B [ (i = 0) -> L , (i = 1) -> r @ j ] (p @ i)

-- Wire elimination (section 21): (b , (s , t)) |-> ap g s . t,  w |-> (f a , (refl , w))
def elim (l : Level) (A B C : U l) (f : A -> B) (g : B -> C) (a : A) (c : C)
    (x : (b : B) * ((s : Path B (f a) b) * Path C (g b) c)) : Path C (g (f a)) c =
  compose l C (g (f a)) (g x.1) c (ap l B C g (f a) x.1 x.2.1) x.2.2
def unelim (l : Level) (A B C : U l) (f : A -> B) (g : B -> C) (a : A) (c : C) (w : Path C (g (f a)) c) :
    (b : B) * ((s : Path B (f a) b) * Path C (g b) c) =
  (f a , (<i> f a , w))

-- Handles (NET_SPEC 3)
def Handle (l : Level) (X : U l) (P : X -> U l) (x : X) : U l = (r : X) * ((v : P r) * Path X r x)
def readHandle (l : Level) (X : U l) (P : X -> U l) (x : X) (h : Handle l X P x) : P x =
  transport l X P h.1 x h.2.2 h.2.1
def canonHandle (l : Level) (X : U l) (P : X -> U l) (x : X) (v : P x) : Handle l X P x = (x , (v , <i> x))
def extendHandle (l : Level) (X : U l) (P : X -> U l) (x y : X) (h : Handle l X P x) (s : Path X x y) : Handle l X P y =
  (h.1 , (h.2.1 , compose l X h.1 x y h.2.2 s))

-- Cut and difference (NET_SPEC 5)
def cut (l : Level) (A : U l) (x y z : A) (u : Path A x y) (v : Path A z y) : Path A x z =
  compose l A x y z u (reverse l A z y v)
def difference (l : Level) (A : U l) (x y : A) (p h : Path A x y) : Path A y y =
  compose l A y x y (reverse l A x y p) h

-- Section 21: the realization replacements, as checked definitions.
-- The fibre-augmented representation of f : A -> B: a |-> (f a , a , refl),
-- (b , a , p) |-> a, and the homotopy i |-> (p i , a , <j> p (i /\ j)) from
-- the round trip to the original point.
def augment (l : Level) (A B : U l) (f : A -> B) (a : A) : (b : B) * ((x : A) * Path B (f x) b) =
  (f a , (a , <i> f a))
def forget (l : Level) (A B : U l) (f : A -> B) (t : (b : B) * ((x : A) * Path B (f x) b)) : A = t.2.1
def augmentRound (l : Level) (A B : U l) (f : A -> B) (t : (b : B) * ((x : A) * Path B (f x) b)) :
    Path ((b : B) * ((x : A) * Path B (f x) b)) (augment l A B f (forget l A B f t)) t =
  <i> (t.2.2 @ i , (t.2.1 , <j> t.2.2 @ (i /\ j)))

-- Associativity alpha : (a*b)*c = a*(b*c) acting on realizations:
-- forward (u , s , t) = (b*c , refl , alpha^-1 . ap_(z -> z*c) s . t)
-- reverse (v , s , t) = (a*b , refl , alpha . ap_(z -> a*z) s . t)
def assocForward (l : Level) (A : U l) (m : A -> A -> A) (a b c y : A)
    (alpha : Path A (m (m a b) c) (m a (m b c)))
    (x : (u : A) * ((s : Path A (m a b) u) * Path A (m u c) y)) :
    (v : A) * ((s : Path A (m b c) v) * Path A (m a v) y) =
  (m b c , (<i> m b c ,
    compose l A (m a (m b c)) (m (m a b) c) y (reverse l A (m (m a b) c) (m a (m b c)) alpha)
      (compose l A (m (m a b) c) (m x.1 c) y (ap l A A (\(z : A) -> m z c) (m a b) x.1 x.2.1) x.2.2)))
def assocReverse (l : Level) (A : U l) (m : A -> A -> A) (a b c y : A)
    (alpha : Path A (m (m a b) c) (m a (m b c)))
    (x : (v : A) * ((s : Path A (m b c) v) * Path A (m a v) y)) :
    (u : A) * ((s : Path A (m a b) u) * Path A (m u c) y) =
  (m a b , (<i> m a b ,
    compose l A (m (m a b) c) (m a (m b c)) y alpha
      (compose l A (m a (m b c)) (m a x.1) y (ap l A A (\(z : A) -> m a z) (m b c) x.1 x.2.1) x.2.2)))

-- Sigma z. (C = z) * (D = z) ~ (C = D): (z , u , v) |-> u . v^-1, h |-> (D , h , refl)
def meetForward (l : Level) (A : U l) (C D : A) (x : (z : A) * (Path A C z * Path A D z)) : Path A C D =
  compose l A C x.1 D x.2.1 (reverse l A D x.1 x.2.2)
def meetReverse (l : Level) (A : U l) (C D : A) (h : Path A C D) : (z : A) * (Path A C z * Path A D z) =
  (D , (h , <i> D))

-- The action of a given identity p : C_L = C_R between two realizations:
-- F_p = c_R^-1 . (q |-> p^-1 . q) . c_L, its inverse c_L^-1 . (q |-> p . q) . c_R
def Fp (l : Level) (A RL RR : U l) (CL CR y : A) (p : Path A CL CR)
    (cL : RL -> Path A CL y) (cRinv : Path A CR y -> RR) (r : RL) : RR =
  cRinv (compose l A CR CL y (reverse l A CL CR p) (cL r))
def FpInverse (l : Level) (A RL RR : U l) (CL CR y : A) (p : Path A CL CR)
    (cR : RR -> Path A CR y) (cLinv : Path A CL y -> RL) (r : RR) : RL =
  cLinv (compose l A CL CR y p (cR r))
