-- No numbers.  Postulated types are neutral: composition over a constant
-- neutral type stays a composition (CCHM has no regularity).
postulate A : U
postulate B : U
postulate a : A
postulate b : A
postulate c : A
postulate p : Path A a b
postulate q : Path A b c
postulate e : Equiv 0 A B
postulate P : A -> U
postulate x : P a
postulate f : (y : A) -> P y

-- endpoints of a neutral path, and of an operation on it
eval (reverse 0 A a b p) @ 0
eval reverse 0 A b a (reverse 0 A a b p)
-- full-face composition at a neutral type gives the tube at 1
eval (compose 0 A a b c p q) @ 0
eval (compose 0 A a b c p q) @ 1
eval compose 0 A a b c p q
-- singleton contraction and its endpoint
eval (contractSingleton 0 A a b p) @ 1
-- transport along ua runs the Glue clause (section 16)
eval coe <i> ((ua 0 A B e) @ i) a
eval coe <i> ((ua 0 A A (idEquiv 0 A)) @ i) a
-- composition in the universe gives a Glue type (section 17)
eval coe <i> U A
-- transport in Pi, Sigma and PathP families
eval coe <i> ((y : A) -> P y) f
eval coe <i> ((y : A) * P y) (a , x)
eval coe <i> (Path A a a) (refl 0 A a)
-- the identity agent's forward body
eval agentForward 0 A a b p c (compose 0 A a b c p q)
-- section 21: the fibre-augmentation round trip at its ends, and the
-- associativity transport of a realization
postulate m : A -> A -> A
postulate al : Path A (m (m a b) c) (m a (m b c))
postulate y : A
postulate t : Path A (m (m a b) c) y
postulate t2 : Path A (m a b) y
eval (augmentRound 0 A A (m a) (y , (b , t2))) @ 0
eval (augmentRound 0 A A (m a) (y , (b , t2))) @ 1
eval assocForward 0 A m a b c y al (m a b , (<i> m a b , t))
