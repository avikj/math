// sort : Π A. Σ B. (bag A ≡ bag B) × Sorted B, and nothing else.
type Empty { }
type Unit { U }
type Bool { F, T }
type List { N, C(h: U32, t: List) }
// B is a permutation of A: B's head is taken out of A, and B's tail is a permutation of what remains
@Perm = λA λB (λ{#N: (≡ A #N); #C: λy λys Σ R: List. (× (@Del y A R) (@Perm R ys))} B)
// R is A with one y taken out
@Del = λy λA λR (λ{#N: Empty; #C: λa λas Σ b: Bool. (λ{#T: (× (≡ y a) (≡ R as)); #F: Σ R2: List. (× (≡ R #C{a, R2}) (@Del y as R2))} b)} A)
// Sorted: each element is less than or equal to all following
@All = λx λ{#N: Unit; #C: λy λys (× (≡ (<= x y) 1) (@All x ys))}
@Sorted = λ{#N: Unit; #C: λx λxs (× (@All x xs) (@Sorted xs))}
@sort : Π A: List. Σ B: List. (× (@Perm A B) (@Sorted B))
@A = #C{3, #C{1, #C{2, #N}}}
@main = (@sort @A)
