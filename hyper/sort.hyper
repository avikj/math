// Sorted: each element is less than all following.  Given A, that fixes B: its first element is the one
// below all others of A's bag, and the rest is the same over what remains.  Nothing is open, so nothing is
// superposed and nothing is filtered: the bag is presented as its least element and the remainder
// (S ≅ (⋀S, S∖⋀S), the fibre law at "least"), and B is read off that presentation.
type Bool { F, T }
type Nat { Z, S(p: Nat) }
type List { N, C(h: Nat, t: List) }
type Least { None, One(m: Nat, rest: List) }

@le = λ{#Z: λb #T; #S: λp λ{#Z: #F; #S: λq (@le p q)}}

// a bag as its least element and what remains
@least = λ{#N: #None; #C: λx λxs (@put x (@least xs))}
@put = λx λ{#None: #One{x, #N}; #One: λm λr (@keep x m r (@le x m))}
@keep = λx λm λr λ{#T: #One{x, #C{m, r}}; #F: #One{m, #C{x, r}}}

@present = λS (@presentK (@least S))
@presentK = λ{#None: #N; #One: λm λr #C{m, (@present r)}}

@main = (@present @input)
