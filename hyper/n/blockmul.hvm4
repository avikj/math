#include "bits.hvm4"
// index 9.11 / 1.2 / 5.24 for the N×N product: the index is a cube, so the product of 2^k × 2^k matrices is, along
// the top bit of the index, a 2×2 product of blocks (partition by output, forced as 9.8 is), and at every node the
// object is the 2×2 product again.  A writing of that object — a list of rank-one terms (u, v, w) over the four
// entries, read as data — is applied at each node: U = u·A (a signed block sum), V = v·B, P = the product of U and
// V by the same writing one level down, and C_k gains w_k P.  Each product is one cell, read by the sums that feed
// it (5.24).  Entries are integers built from bits; nothing is primitive.  Every result carries the list of entry
// products formed, so the count is read off the proof: with the definition's own writing (the eight terms
// E_ij ⊗ E_jk ⊗ E_ki) a level costs eight; with the writing read from n/rank7.hvm4's fibre it costs seven.
@zpos = λ&a. #Z{a, #Nil}
@addZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. #Z{@add(a, c), @add(b, d)}}}
@negZ = λ{#Z: λ&a. λ&b. #Z{b, a}}
@mulN = λ{#Nil: λ&y. #Nil; #Cons: λ{#F: λ&t. λ&y. #Cons{#F, @mulN(t, y)}; #T: λ&t. λ&y. @add(y, #Cons{#F, @mulN(t, y)})}}
@mulZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. #Z{@add(@mulN(a, c), @mulN(b, d)), @add(@mulN(a, d), @mulN(b, c))}}}
@eqZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. (λ{#Eq: #T; λ&r. #F})(@cmp(@add(a, d), @add(b, c)))}}
@zeroZ = #Z{#Nil, #Nil}
// matrices: a leaf entry or four blocks in entry order 11, 12, 21, 22
@zeroM = λ{#Leaf: λ&x. #Leaf{@zeroZ}; #Blk: λ&a. λ&b. λ&c. λ&d. #Blk{@zeroM(a), @zeroM(b), @zeroM(c), @zeroM(d)}}
@addM = λ{#Leaf: λ&x. λ{#Leaf: λ&y. #Leaf{@addZ(x, y)}}; #Blk: λ&a. λ&b. λ&c. λ&d. λ{#Blk: λ&e. λ&f. λ&g. λ&h. #Blk{@addM(a, e), @addM(b, f), @addM(c, g), @addM(d, h)}}}
@negM = λ{#Leaf: λ&x. #Leaf{@negZ(x)}; #Blk: λ&a. λ&b. λ&c. λ&d. #Blk{@negM(a), @negM(b), @negM(c), @negM(d)}}
@scaleM = λ{#O: λ&m. @zeroM(m); #P: λ&m. m; #N: λ&m. @negM(m)}
@blocks = λ{#Blk: λ&a. λ&b. λ&c. λ&d. #Cons{a, #Cons{b, #Cons{c, #Cons{d, #Nil}}}}}
// u·A over the four blocks: the signed sum
@dot = λ{#Nil: λ&bs. #Nil; #Cons: λ&s. λ&ss. λ{#Cons: λ&m. λ&ms. (λ{#Nil: @scaleM(s, m); λ&rest. @addM(@scaleM(s, m), rest)})(@dot(ss, ms))}}
@dotM = λ&u. λ&A. (λ{#Nil: @zeroM(@head(@blocks(A))); λ&m. m})(@dot(u, @blocks(A)))
@head = λ{#Cons: λ&h. λ&t. h}
@eqM = λ{#Leaf: λ&x. λ{#Leaf: λ&y. @eqZ(x, y)}; #Blk: λ&a. λ&b. λ&c. λ&d. λ{#Blk: λ&e. λ&f. λ&g. λ&h. @andT(@eqM(a, e), @andT(@eqM(b, f), @andT(@eqM(c, g), @eqM(d, h))))}}
@andT = λ{#T: λ&b. b; #F: λ&b. #F}
// the product by a writing W: at a leaf the entry product (one cell, certified); at a node each term once
@prodW = λ&W. λ{#Leaf: λ&x. λ{#Leaf: λ&y. #Pair{#Leaf{@mulZ(x, y)}, #Cons{#M, #Nil}}};
  #Blk: λ&a. λ&b. λ&c. λ&d. λ&B. @assemble(@terms(W, W, #Blk{a, b, c, d}, B))}
@terms = λ&W. λ{#Nil: λ&A. λ&B. #Nil; #Cons: λ{#T: λ&u. λ&v. λ&w. λ&rest. λ&A. λ&B.
  ! &p = @prodW(W, @dotM(u, A), @dotM(v, B)); #Cons{#Pair{w, p}, @terms(W, rest, A, B)}}}
// C_k = Σ_terms w_k · P: the four blocks assembled from the terms, certificates concatenated
@assemble = λ&ts. ! &z = @zeroM(@fstP(@sndP(@headT(ts)))); #Pair{#Blk{@sumK(#E0, ts, z), @sumK(#E1, ts, z), @sumK(#E2, ts, z), @sumK(#E3, ts, z)}, @certs(ts)}
@headT = λ{#Cons: λ&h. λ&t. h}
@fstP = λ{#Pair: λ&a. λ&b. a}
@sndP = λ{#Pair: λ&a. λ&b. b}
@nthS = λ{#Cons: λ&h. λ&t. λ{#E0: h; #E1: @nthS(t, #E0); #E2: @nthS(t, #E1); #E3: @nthS(t, #E2)}}
@sumK = λ&k. λ{#Nil: λ&z. z; #Cons: λ{#Pair: λ&w. λ&p. λ&rest. λ&z. @addM(@scaleM(@nthS(w, k), @fstP(p)), @sumK(k, rest, z))}}
@certs = λ{#Nil: #Nil; #Cons: λ{#Pair: λ&w. λ&p. λ&rest. @lcat(@sndP(p), @certs(rest))}}
@lenN = λ{#Nil: #Z0; #Cons: λ&h. λ&t. #S{@lenN(t)}}
// the definition's own writing: a_ij b_jk → c_ik, as rank-one terms E_ij ⊗ E_jk ⊗ E_ik
@e = λ&i. (λ{#E0: #Cons{#P,#Cons{#O,#Cons{#O,#Cons{#O,#Nil}}}}; #E1: #Cons{#O,#Cons{#P,#Cons{#O,#Cons{#O,#Nil}}}}; #E2: #Cons{#O,#Cons{#O,#Cons{#P,#Cons{#O,#Nil}}}}; #E3: #Cons{#O,#Cons{#O,#Cons{#O,#Cons{#P,#Nil}}}}})(i)
@W8 = #Cons{#T{@e(#E0),@e(#E0),@e(#E0)}, #Cons{#T{@e(#E1),@e(#E2),@e(#E0)}, #Cons{#T{@e(#E0),@e(#E1),@e(#E1)}, #Cons{#T{@e(#E1),@e(#E3),@e(#E1)},
      #Cons{#T{@e(#E2),@e(#E0),@e(#E2)}, #Cons{#T{@e(#E3),@e(#E2),@e(#E2)}, #Cons{#T{@e(#E2),@e(#E1),@e(#E3)}, #Cons{#T{@e(#E3),@e(#E3),@e(#E3)}, #Nil}}}}}}}}
// inputs
@z = λ&n. #Leaf{@zpos(n)}
@n0 = #Nil
@n1 = #Cons{#T, #Nil}
@n2 = #Cons{#F, #Cons{#T, #Nil}}
@n3 = #Cons{#T, #Cons{#T, #Nil}}
@n4 = #Cons{#F, #Cons{#F, #Cons{#T, #Nil}}}
@n5 = #Cons{#T, #Cons{#F, #Cons{#T, #Nil}}}
@A2 = #Blk{@z(@n1), @z(@n2), @z(@n3), @z(@n4)}
@B2 = #Blk{@z(@n5), @z(@n0), @z(@n2), @z(@n1)}
@A4 = #Blk{@A2, @B2, @B2, @A2}
@B4 = #Blk{@B2, @A2, @A2, @B2}
// the writing read from n/rank7.hvm4's fibre (u1 = E11 class, first point): the fixed term I⊗I⊗I and the two
// generators with their rotations under the derived 3-cycle — as data, exactly as % printed it
@sg = λ{#P: #P; #N: #N; #O: #O}
@vI = #Cons{#P, #Cons{#O, #Cons{#O, #Cons{#P, #Nil}}}}
@g1u = #Cons{#P, #Cons{#O, #Cons{#O, #Cons{#O, #Nil}}}}
@g1v = #Cons{#O, #Cons{#P, #Cons{#O, #Cons{#N, #Nil}}}}
@g1w = #Cons{#O, #Cons{#O, #Cons{#P, #Cons{#P, #Nil}}}}
@g2u = #Cons{#O, #Cons{#O, #Cons{#O, #Cons{#N, #Nil}}}}
@g2v = #Cons{#P, #Cons{#O, #Cons{#N, #Cons{#O, #Nil}}}}
@g2w = #Cons{#P, #Cons{#P, #Cons{#O, #Cons{#O, #Nil}}}}
@orbit = λ&u. λ&v. λ&w. #Cons{#T{u, v, w}, #Cons{#T{v, w, u}, #Cons{#T{w, u, v}, #Nil}}}
// the fibre's w indexes the third matrix of the trace form, c_ki against the output C_ik: the output entry is w's transpose
@trW = λ{#Cons: λ&a. λ{#Cons: λ&b. λ{#Cons: λ&c. λ{#Cons: λ&d. λ&n. #Cons{a, #Cons{c, #Cons{b, #Cons{d, #Nil}}}}}}}}
@toOut = λ{#T: λ&u. λ&v. λ&w. #T{u, v, @trW(w)}}
@W7 = @map(@toOut, #Cons{#T{@vI, @vI, @vI}, @lcat(@orbit(@g1u, @g1v, @g1w), @orbit(@g2u, @g2v, @g2w))})
@map = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{f(h), @map(f, t)}}
@run = λ&A. λ&B. ! &p8 = @prodW(@W8, A, B); ! &p7 = @prodW(@W7, A, B); #Pair{@eqM(@fstP(p8), @fstP(p7)), #Pair{@lenN(@sndP(p8)), @lenN(@sndP(p7))}}
@main = #Pair{@run(@A2, @B2), @run(@A4, @B4)}
