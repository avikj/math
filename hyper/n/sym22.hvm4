// The symmetry group of the 2×2 product tr(ABC), derived from its generators (nothing of the orbit posed): the
// cyclic shift (A,B,C) ↦ (B,C,A); the transpose-reversal (A,B,C) ↦ (Cᵀ,Bᵀ,Aᵀ); the simultaneous conjugation by
// the swap S = [[0,1],[1,0]]; the simultaneous conjugation by D = diag(1,−1). An element acts on a cell
// u ⊗ v ⊗ w (each a 2×2 of coefficients over the entries 11, 12, 21, 22) by permuting the three slots and
// acting on each slot's entries. The group is the closure of the generators; its elements are kept as their
// action tables on the twelve positions with signs; the order of each is read by iteration; the generator of
// maximal order is read off, and its orbit on positions gives the fixed cell's shape (one coordinate per orbit).
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@lenN = λ{#Nil: #Z; #Cons: λ&h. λ&t. #S{@lenN(t)}}
@map = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{f(h), @map(f, t)}}
@any = λ&f. λ{#Nil: #F; #Cons: λ&h. λ&t. (λ{#T: #T; #F: @any(f, t)})(f(h))}
@filter = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. (λ{#T: #Cons{h, @filter(f, t)}; #F: @filter(f, t)})(f(h))}
@and = λ{#T: λ&b. b; #F: λ&b. #F}
@or = λ{#T: λ&b. #T; #F: λ&b. b}
// a position: slot (#A #B #C) and entry (#E11 #E12 #E21 #E22); a signed position
@positions = #Cons{#Pos{#A,#E11}, #Cons{#Pos{#A,#E12}, #Cons{#Pos{#A,#E21}, #Cons{#Pos{#A,#E22},
  #Cons{#Pos{#B,#E11}, #Cons{#Pos{#B,#E12}, #Cons{#Pos{#B,#E21}, #Cons{#Pos{#B,#E22},
  #Cons{#Pos{#C,#E11}, #Cons{#Pos{#C,#E12}, #Cons{#Pos{#C,#E21}, #Cons{#Pos{#C,#E22}, #Nil}}}}}}}}}}}}
@eqSlot = λ{#A: λ{#A: #T; λ&x. #F}; #B: λ{#B: #T; λ&x. #F}; #C: λ{#C: #T; λ&x. #F}}
@eqEnt = λ{#E11: λ{#E11: #T; λ&x. #F}; #E12: λ{#E12: #T; λ&x. #F}; #E21: λ{#E21: #T; λ&x. #F}; #E22: λ{#E22: #T; λ&x. #F}}
@eqPos = λ{#Pos: λ&s. λ&e. λ{#Pos: λ&s2. λ&e2. @and(@eqSlot(s, s2), @eqEnt(e, e2))}}
@mulS = λ{#P: λ&y. y; #N: λ{#P: #N; #N: #P}}
// an element is its action: a function from a position to a signed position; composed by application
@cyc = λ{#Pos: λ&s. λ&e. #SP{#P, #Pos{(λ{#A: #C; #B: #A; #C: #B})(s), e}}}
@tr = λ{#E11: #E11; #E12: #E21; #E21: #E12; #E22: #E22}
@rev = λ{#Pos: λ&s. λ&e. #SP{#P, #Pos{(λ{#A: #C; #B: #B; #C: #A})(s), @tr(e)}}}
@swp = λ{#Pos: λ&s. λ&e. #SP{#P, #Pos{s, (λ{#E11: #E22; #E12: #E21; #E21: #E12; #E22: #E11})(e)}}}
@dia = λ{#Pos: λ&s. λ&e. #SP{(λ{#E11: #P; #E12: #N; #E21: #N; #E22: #P})(e), #Pos{s, e}}}
// an element as its table: the list of signed images of the twelve positions
@table = λ&f. @map(f, @positions)
@apply = λ&tab. λ{#Pos: λ&s. λ&e. @lookup(tab, @positions, #Pos{s, e})}
@lookup = λ&tab. λ&ps. λ&p. (λ{#Cons: λ&img. λ&tr. λ{#Cons: λ&q. λ&qs. (λ{#T: img; #F: @lookup(tr, qs, p)})(@eqPos(p, q))}})(tab, ps)
@compose = λ&g. λ&h. @map(λ&p. (λ{#SP: λ&s1. λ&q. (λ{#SP: λ&s2. λ&r. #SP{@mulS(s1, s2), r}})(@apply(g, q))})(@apply(h, p)), @positions)
@eqSP = λ{#SP: λ&s. λ&p. λ{#SP: λ&s2. λ&p2. @and((λ{#P: λ{#P: #T; #N: #F}; #N: λ{#N: #T; #P: #F}})(s, s2), @eqPos(p, p2))}}
@eqTab = λ{#Nil: λ&y. #T; #Cons: λ&a. λ&as. λ{#Nil: #F; #Cons: λ&b. λ&bs. @and(@eqSP(a, b), @eqTab(as, bs))}}
@member = λ&t. @any(λ&u. @eqTab(t, u))
@gens = #Cons{@table(@cyc), #Cons{@table(@rev), #Cons{@table(@swp), #Cons{@table(@dia), #Nil}}}}
@identity = @map(λ&p. #SP{#P, p}, @positions)
// closure: elements, with a frontier; every product of a frontier element with a generator that is new is added
@closure = λ&els. λ{#Nil: els; #Cons: λ&f. λ&fs. ! &new = @filter(λ&t. (λ{#T: #F; #F: #T})(@member(t, els)), @distinct(@map(λ&g. @compose(g, f), @gens)));
  @closure(@lcat(new, els), @lcat(fs, new))}
@distinct = λ{#Nil: #Nil; #Cons: λ&t. λ&ts. #Cons{t, @distinct(@filter(λ&u. (λ{#T: #F; #F: #T})(@eqTab(t, u)), ts))}}
@group = @closure(#Cons{@identity, #Nil}, #Cons{@identity, #Nil})
// the order of an element: iterate until the identity
@order = λ&g. @orderGo(g, g, #S{#Z})
@orderGo = λ&g. λ&h. λ&n. (λ{#T: n; #F: @orderGo(g, @compose(g, h), #S{n})})(@eqTab(h, @identity))
@orders = @map(@order, @group)


// ---- cells and the identities that act on them ----
// a cell is #W{u, v, w}, each a 2×2 of signs #O #P #N over the entries 11, 12, 21, 22 as #Q{a, b, c, d}
@addS = λ{#O: λ&y. y; #P: λ{#O: #P; #P: #Big; #N: #O; #Big: #Big}; #N: λ{#O: #N; #P: #O; #N: #Big; #Big: #Big}; #Big: λ&y. #Big}
@mulZ = λ{#O: λ&y. #O; #P: λ&y. y; #N: λ{#O: #O; #P: #N; #N: #P; #Big: #Big}; #Big: λ&y. (λ{#O: #O; λ&z. #Big})(y)}
@eqS = λ{#O: λ{#O: #T; λ&q. #F}; #P: λ{#P: #T; λ&q. #F}; #N: λ{#N: #T; λ&q. #F}; #Big: λ&q. #F}
@eqQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. λ{#Q: λ&e. λ&f. λ&g. λ&h. @and(@eqS(a, e), @and(@eqS(b, f), @and(@eqS(c, g), @eqS(d, h))))}}
@eqW = λ{#W: λ&u. λ&v. λ&w. λ{#W: λ&x. λ&y. λ&z. @and(@eqQ(u, x), @and(@eqQ(v, y), @eqQ(w, z)))}}
@inQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. @and(@inS(a), @and(@inS(b), @and(@inS(c), @inS(d))))}
@inS = λ{#Big: #F; λ&q. #T}
@inW = λ{#W: λ&u. λ&v. λ&w. @and(@inQ(u), @and(@inQ(v), @inQ(w)))}
// a relabelling (an element's table) on a cell: coefficient at position p goes to its image with its sign
@entryOf = λ{#Q: λ&a. λ&b. λ&c. λ&d. λ{#E11: a; #E12: b; #E21: c; #E22: d}}
@slotOf = λ{#W: λ&u. λ&v. λ&w. λ{#A: u; #B: v; #C: w}}
@coef = λ&cell. λ{#Pos: λ&s. λ&e. @entryOf(@slotOf(cell, s), e)}
// the image cell: at each position q, the coefficient of the position p with g(p) = q, times the sign
@preimage = λ&tab. λ&q. @preGo(tab, @positions, q)
@preGo = λ&tab. λ&ps. λ&q. (λ{#Cons: λ{#SP: λ&sg. λ&img. λ&tr. λ{#Cons: λ&p. λ&qs. (λ{#T: #SP{sg, p}; #F: @preGo(tr, qs, q)})(@eqPos(img, q))}}})(tab, ps)
@atPos = λ&tab. λ&cell. λ&q. (λ{#SP: λ&sg. λ&p. @mulZ(sg, @coef(cell, p))})(@preimage(tab, q))
@actCell = λ&tab. λ&cell.
  #W{#Q{@atPos(tab, cell, #Pos{#A,#E11}), @atPos(tab, cell, #Pos{#A,#E12}), @atPos(tab, cell, #Pos{#A,#E21}), @atPos(tab, cell, #Pos{#A,#E22})},
     #Q{@atPos(tab, cell, #Pos{#B,#E11}), @atPos(tab, cell, #Pos{#B,#E12}), @atPos(tab, cell, #Pos{#B,#E21}), @atPos(tab, cell, #Pos{#B,#E22})},
     #Q{@atPos(tab, cell, #Pos{#C,#E11}), @atPos(tab, cell, #Pos{#C,#E12}), @atPos(tab, cell, #Pos{#C,#E21}), @atPos(tab, cell, #Pos{#C,#E22})}}
// the shear: A ↦ P A P⁻¹, B ↦ P B P⁻¹, C ↦ P C P⁻¹ with P = [[1,1],[0,1]], P⁻¹ = [[1,−1],[0,1]], fixes tr(ABC).
// On a functional u (u·A = Σ u_ij A_ij) it acts by u·(P A P⁻¹) = (Pᵀ u P⁻ᵀ)·A: u' = Pᵀ u P⁻ᵀ.
// Pᵀ u = [[a, b],[a + c, b + d]]; then · P⁻ᵀ = [[1,0],[−1,1]] on the right: [[x − y, y],[z − t, t]].
@shearQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. ! &x = a; ! &y = b; ! &z = @addS(a, c); ! &t = @addS(b, d);
  #Q{@addS(x, @mulZ(#N, y)), y, @addS(z, @mulZ(#N, t)), t}}
@shearW = λ{#W: λ&u. λ&v. λ&w. #W{@shearQ(u), @shearQ(v), @shearQ(w)}}
// the faces: a writing of tr(ABC) satisfies, at every (i,j),(j',k),(k',i'): Σ cells u_ij v_j'k w_k'i' = [j=j'][k=k'][i'=i]
@ents = #Cons{#E11, #Cons{#E12, #Cons{#E21, #Cons{#E22, #Nil}}}}
@row = λ{#E11: #R1; #E12: #R1; #E21: #R2; #E22: #R2}
@col = λ{#E11: #R1; #E12: #R2; #E21: #R1; #E22: #R2}
@eqR = λ{#R1: λ{#R1: #T; #R2: #F}; #R2: λ{#R2: #T; #R1: #F}}
@target = λ&i. λ&j. λ&k. @and(@eqR(@col(i), @row(j)), @and(@eqR(@col(j), @row(k)), @eqR(@col(k), @row(i))))
@sumAt = λ&W. λ&i. λ&j. λ&k. (λ{#Nil: #O; #Cons: λ&c. λ&rest. @addS(@mulZ(@mulZ(@coef(c, #Pos{#A, i}), @coef(c, #Pos{#B, j})), @coef(c, #Pos{#C, k})), @sumAt(rest, i, j, k))})(W)
@holds = λ&W. @all3(λ&i. λ&j. λ&k. @eqS(@sumAt(W, i, j, k), (λ{#T: #P; #F: #O})(@target(i, j, k))))
@all3 = λ&f. @allL(λ&i. @allL(λ&j. @allL(λ&k. f(i, j, k), @ents), @ents), @ents)
@allL = λ&f. λ{#Nil: #T; #Cons: λ&h. λ&t. @and(f(h), @allL(f, t))}
// Strassen's writing as a term, to verify the identities against (it is not posed anywhere else)
@st = λ&a. λ&b. λ&c. λ&d. #Q{a, b, c, d}
@strassen = #Cons{#W{@st(#P,#O,#O,#P), @st(#P,#O,#O,#P), @st(#P,#O,#O,#P)},
  #Cons{#W{@st(#O,#O,#P,#P), @st(#P,#O,#O,#O), @st(#O,#P,#O,#N)},
  #Cons{#W{@st(#P,#O,#O,#O), @st(#O,#P,#O,#N), @st(#O,#O,#P,#P)},
  #Cons{#W{@st(#O,#O,#O,#P), @st(#N,#O,#P,#O), @st(#P,#P,#O,#O)},
  #Cons{#W{@st(#P,#P,#O,#O), @st(#O,#O,#O,#P), @st(#N,#O,#P,#O)},
  #Cons{#W{@st(#N,#O,#P,#O), @st(#P,#P,#O,#O), @st(#O,#O,#O,#P)},
  #Cons{#W{@st(#O,#P,#O,#N), @st(#O,#O,#P,#P), @st(#P,#O,#O,#O)}, #Nil}}}}}}}
// the defining writing: E_ij ⊗ E_jk ⊗ E_ki, eight cells
@e = λ{#E11: @st(#P,#O,#O,#O); #E12: @st(#O,#P,#O,#O); #E21: @st(#O,#O,#P,#O); #E22: @st(#O,#O,#O,#P)}
@defining = #Cons{#W{@e(#E11), @e(#E11), @e(#E11)}, #Cons{#W{@e(#E11), @e(#E12), @e(#E21)}, #Cons{#W{@e(#E12), @e(#E21), @e(#E11)}, #Cons{#W{@e(#E12), @e(#E22), @e(#E21)},
  #Cons{#W{@e(#E21), @e(#E11), @e(#E12)}, #Cons{#W{@e(#E21), @e(#E12), @e(#E22)}, #Cons{#W{@e(#E22), @e(#E21), @e(#E12)}, #Cons{#W{@e(#E22), @e(#E22), @e(#E22)}, #Nil}}}}}}}}
@g6 = @headL(@filter(λ&g. @eqN(@order(g), #S{#S{#S{#S{#S{#S{#Z}}}}}}), @group))
@headL = λ{#Cons: λ&h. λ&t. h}
@eqN = λ{#Z: λ{#Z: #T; #S: λ&b. #F}; #S: λ&a. λ{#Z: #F; #S: λ&b. @eqN(a, b)}}
// alphabet-orbit of a cell under the relabellings and the shear: closure within the alphabet
@gensC = @lcat(@map(λ&t. @actCell(t), @gens), #Cons{@shearW, #Nil})
@orbitC = λ&start. @orbGo(#Cons{start, #Nil}, #Cons{start, #Nil})
@orbGo = λ&els. λ{#Nil: els; #Cons: λ&f. λ&fs. ! &new = @filter(λ&c. @and(@inW(c), (λ{#T: #F; #F: #T})(@memW(c, els))), @distinctW(@map(λ&g. g(f), @gensC)));
  @orbGo(@lcat(new, els), @lcat(fs, new))}
@memW = λ&c. @any(λ&d. @eqW(c, d))
@distinctW = λ{#Nil: #Nil; #Cons: λ&c. λ&cs. #Cons{c, @distinctW(@filter(λ&d. (λ{#T: #F; #F: #T})(@eqW(c, d)), cs))}}
// the symmetries that keep slot A at slot A (no cyclic shift): the ones under which a first factor u is a class
@keepsA = λ&tab. @allL(λ&e. (λ{#SP: λ&sg. λ{#Pos: λ&sl. λ&e2. @eqSlot(sl, #A)}})(@apply(tab, #Pos{#A, e})), @ents)
@gensA = @lcat(@map(λ&t. @actCell(t), @filter(@keepsA, @group)), #Cons{@shearW, #Nil})
@orbitBy = λ&gs. λ&start. @orbGoBy(gs, #Cons{start, #Nil}, #Cons{start, #Nil})
@orbGoBy = λ&gs. λ&els. λ{#Nil: els; #Cons: λ&f. λ&fs. ! &new = @filter(λ&c. @and(@inW(c), (λ{#T: #F; #F: #T})(@memW(c, els))), @distinctW(@map(λ&g. g(f), gs)));
  @orbGoBy(gs, @lcat(new, els), @lcat(fs, new))}
// all nonzero 2×2 over the alphabet
@signs = #Cons{#O, #Cons{#P, #Cons{#N, #Nil}}}
@concatMap = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. @lcat(f(h), @concatMap(f, t))}
@allQ = @concatMap(λ&a. @concatMap(λ&b. @concatMap(λ&c. @map(λ&d. #Q{a, b, c, d}, @signs), @signs), @signs), @signs)
@nonzeroQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. @or((λ{#O: #F; λ&x. #T})(a), @or((λ{#O: #F; λ&x. #T})(b), @or((λ{#O: #F; λ&x. #T})(c), (λ{#O: #F; λ&x. #T})(d))))}
@eye = @st(#P,#O,#O,#P)
// representatives: a candidate is new when no earlier representative's orbit contains it
// each representative carries its orbit, computed once; a candidate is new when no stored orbit contains it
@classes = λ&gs. λ&mk. λ&cands. @map(λ{#Pair: λ&r. λ&o. r}, @clGo(gs, mk, cands, #Nil))
@clGo = λ&gs. λ&mk. λ{#Nil: λ&reps. reps; #Cons: λ&q. λ&qs. λ&reps. ! &c = mk(q);
  (λ{#T: @clGo(gs, mk, qs, reps); #F: @clGo(gs, mk, qs, #Cons{#Pair{q, @orbitBy(gs, c)}, reps})})(@any(λ{#Pair: λ&r. λ&o. @memW(c, o)}, reps))}
@uClasses = @classes(@gensA, λ&u. #W{u, @eye, @eye}, @filter(@nonzeroQ, @allQ))
// for a representative u, the symmetries keeping slot B at slot B and fixing u as a matrix: v's classes
@keepsB = λ&tab. @allL(λ&e. (λ{#SP: λ&sg. λ{#Pos: λ&sl. λ&e2. @eqSlot(sl, #B)}})(@apply(tab, #Pos{#B, e})), @ents)
@fixesU = λ&u. λ&g. (λ{#W: λ&u2. λ&v2. λ&w2. @eqQ(u, u2)})(g(#W{u, @eye, @eye}))
@gensBU = λ&u. @filter(@fixesU(u), @lcat(@map(λ&t. @actCell(t), @filter(λ&t. @and(@keepsA(t), @keepsB(t)), @group)), #Cons{@shearW, #Nil}))
@vClasses = λ&u. @classes(@gensBU(u), λ&v. #W{u, v, @eye}, @filter(@nonzeroQ, @allQ))
// the cell scaling: negating u and v together is the same cell (6.1); a generator for the classes
@scaleW = λ{#W: λ&u. λ&v. λ&w. #W{@negQ(u), @negQ(v), w}}
@negQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. #Q{@mulZ(#N, a), @mulZ(#N, b), @mulZ(#N, c), @mulZ(#N, d)}}
@gensA2 = #Cons{@scaleW, @gensA}
@zeroQ = @st(#O,#O,#O,#O)
@uClasses2 = @classes(@gensA2, λ&u. #W{u, @zeroQ, @zeroQ}, @filter(@nonzeroQ, @allQ))
@scaleVW = λ{#W: λ&u. λ&v. λ&w. #W{u, @negQ(v), @negQ(w)}}
@gensBU2 = λ&u. #Cons{@scaleVW, @gensBU(u)}
@vClasses2 = λ&u. @classes(@gensBU2(u), λ&v. #W{u, v, @eye}, @filter(@nonzeroQ, @allQ))
// the class of the orbit cell's u is under the symmetries that commute with the orbit generator (they carry a
// g-orbit to a g-orbit) and keep slot A; the scaling commutes; the shear is kept only if it commutes with g on cells
@commutes = λ&g. λ&t. @eqTab(@compose(g, t), @compose(t, g))
@shearCommutes = λ&g. @allL(λ&c. @eqW(@actCell(g, @shearW(c)), @shearW(@actCell(g, c))), @strassen)
@gensA3 = λ&g. #Cons{@scaleW, @lcat(@map(λ&t. @actCell(t), @filter(λ&t. @and(@keepsA(t), @commutes(g, t)), @group)),
  (λ{#T: #Cons{@shearW, #Nil}; #F: #Nil})(@shearCommutes(g)))}
@uClasses3 = λ&g. @classes(@gensA3(g), λ&u. #W{u, @zeroQ, @zeroQ}, @filter(@nonzeroQ, @allQ))
@main = #Pair{#Pair{@lenN(@group), @holds(@strassen)},
        #Pair{#Pair{@holds(@map(@shearW, @strassen)), @holds(@map(@actCell(@g6), @strassen))},
        #Pair{@lenN(@orbitC(#W{@st(#P,#O,#O,#P), @st(#P,#O,#O,#P), @st(#P,#O,#O,#P)})),
        #Pair{@lenN(@orbitC(#W{@st(#O,#P,#P,#O), @st(#O,#P,#P,#O), @st(#O,#P,#P,#O)})),
               @lenN(@orbitC(#W{@st(#O,#O,#P,#P), @st(#P,#O,#O,#O), @st(#O,#P,#O,#N)}))}}}}
