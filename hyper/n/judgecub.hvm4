#include "judgment.hvm4"
// the cubical formers: paths, path application, coe, ua, hcomp, Glue/glue/unglue, and a superposed cubical point
@idS = #SLam{#SVar{0}}
@reflS = #SLam{#SPlm{#SVar{1}}}
@main = #Cons{@judge(#Pair{#Path{λi. #Bool, #T, #T}, #SPlm{#STrue}}),                                  // 1
        #Cons{@judge(#Pair{#Path{λi. #Bool, #T, #F}, #SPlm{#STrue}}),                                  // 0: wrong end
        #Cons{@judge(#Pair{#Bool, #SPap{#SAnn{#SPlm{#STrue}, #SPath{#SBool, #STrue, #STrue}}, #SI1}}),  // 1
        #Cons{@judge(#Pair{#Bool, #SCoe{#SBool, #SI0, #SI1, #SFalse}}),                                // 1: a constant line
        #Cons{@judge(#Pair{#Nat, #SCoe{#SBool, #SI0, #SI1, #SFalse}}),                                 // 0: lands in Bool
        #Cons{@judge(#Pair{#Path{λi. #Set, #Bool, #Bool}, #SUa{#SBool, #SBool, @idS, @idS, @reflS, @reflS}}), // 1
        #Cons{@judge(#Pair{#Nat, #SHcm{#SNat, #Cons{#SFace{#SI1, #SPlm{#SZer}}, #Nil}, #SZer}}),        // 1: the tube's i0 end is the base
        #Cons{@judge(#Pair{#Nat, #SHcm{#SNat, #Cons{#SFace{#SI1, #SPlm{#SSuc{#SZer}}}, #Nil}, #SZer}}), // 0: it is not
        #Cons{@judge(#Pair{#Set, #SGlue{#SBool, #Nil}}),                                                // 1
        #Cons{@judge(#Pair{#Bool, #SUnglue{#SAnn{#SGlb{#SBool, #Nil, #STrue}, #SGlue{#SBool, #Nil}}}}),  // 1
        #Cons{@judge(#Pair{#Set, #SGlue{#SBool, #Cons{#SGFace{#SI1, #SBool, #SPair{@idS, #SLam{#SPair{#SPair{#SVar{0}, #SPlm{#SVar{1}}}, #SLam{#SPlm{#SVar{1}}}}}}}, #Nil}}}), // the identity equivalence on a face: 1 if its contractibility proof checks
        #Cons{%(@judge(#Pair{#Bool, &(?){#SCoe{#SBool, #SI0, #SI1, #SFalse}, #SI0}})),                  // [1, 0]
        #Nil}}}}}}}}}}}}
