#include "judgment.hvm4"
// MAP §0 on the net, with types: a declaration with no body is a coordinate.  The typed point #Pair{T, D} has D a
// line over the type's points (one fresh coordinate per choice); the judgment T === @infer(D) runs once on the
// line (EQL commutes over superpositions), a side where it reduces to 0 is erased, and % is the fibre: the
// points of the specification, as a value.  Nothing written for sorting, searching or solving.
@keep = λ&D. (λ{1: D; λ&q. &{}})(@judge(#Pair{@Tspec, D}))
// the coordinate over a type: its points as one line, lazily, one fresh coordinate per choice.  Nat and List are
// infinite lines; a Σ's second coordinate depends on the first (the same choice, shared); the only coordinate over an
// equation is refl.  The judgment cuts the line: a world dies as soon as a rule fails on it, so an infinite line is
// read finitely.  Nothing here knows what A, perm or sorted are.
@any = λ&T. (λ{
  #Bool: &(?){#STrue, #SFalse};
  #Nat: &(?){#SZer, #SSuc{@any(#Nat)}};
  #List: λ&A. &(?){#SNil, #SCons{@any(A), @any(#List{A})}};
  #Sig: λ&A. λ&B. ! &a = @any(A); #SPair{a, @any(B(@eval(#Nil, a)))};
  #Eql: λ&X. λ&u. λ&v. #SRefl;
  λ&t. #SIll})(T)
// the specification's vocabulary, on values: sorted, and perm as multiset equality.  Each recurses on the declared
// coordinate B, so every rule fires on a finite prefix of B: a wrong element, or an element past A's length, kills
// the world before B's tail is ever unfolded — that is what makes the infinite line over List Nat readable finitely.
@leqN = λ{#Zer: λ&b. #T; #Suc: λ&a. λ{#Zer: #F; #Suc: λ&b. @leqN(a, b)}}
@eqN = λ{#Zer: λ{#Zer: #T; #Suc: λ&b. #F}; #Suc: λ&a. λ{#Zer: #F; #Suc: λ&b. @eqN(a, b)}}
@sorted = λ{#Nil: #T; #Cons: λ&h. λ{#Nil: #T; #Cons: λ&h2. λ&t. (λ{#T: @sorted(#Cons{h2, t}); #F: #F})(@leqN(h, h2))}}
@remove = λ&x. λ{#Nil: #Pair{#F, #Nil}; #Cons: λ&h. λ&t. (λ{#T: #Pair{#T, t}; #F: (λ{#Pair: λ&f. λ&r. #Pair{f, #Cons{h, r}}})(@remove(x, t))})(@eqN(x, h))}
@andV = λ{#T: λ&b. b; #F: λ&b. #F}
@perm = λ&a. λ{#Nil: (λ{#Nil: #T; #Cons: λ&h. λ&t. #F})(a); #Cons: λ&h. λ&t. (λ{#Pair: λ{#T: λ&r. @perm(r, t); #F: λ&r. #F}})(@remove(h, a))}
// the declaration: sort A = Σ B : List Nat. (perm A B && sorted B) ≡ True, at A = [2, 0, 1].  The conjunction is
// read left to right, as a Bool conjunction is; perm refutes every infinite path of the line on a finite prefix.
@A = #Cons{#Suc{#Suc{#Zer}}, #Cons{#Zer, #Cons{#Suc{#Zer}, #Nil}}}
@Tspec = #Sig{#List{#Nat}, λ&B. #Eql{#Bool, @andV(@perm(@A, B), @sorted(B)), #T}}
// the declaration is the program: its point is the coordinate over its type, cut by its own judgment
@main = %(@keep(@any(@Tspec)))
