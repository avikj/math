#include "number.hvm4"
// The type of the matrix product, generic in its entries. An entry is an indeterminate: a unit that carries its
// name and nothing else (6.1), so a_ij is the one-unit multitude #A11 … #B22. The type is the shape
// C_ik = Σ_j a_ij × b_jk on the complex: product is product of multitudes, sum is disjoint union (6.3); the ring
// identities hold by construction (a coordinate is a label). Nothing is evaluated: the entries are never values.
// The normal form of each C_ik is read by %: its vertices are its monomials, the pairs (a_ij, b_jk), one cell
// each, and the ledger is the geodesic (5.14, 5.17) of forming them.
@entry = λ&a. λ&b. λ&c. λ&d. @plus(@times(a, b), @times(c, d))
@C11 = @entry(#A11, #B11, #A12, #B21)
@C12 = @entry(#A11, #B12, #A12, #B22)
@C21 = @entry(#A21, #B11, #A22, #B21)
@C22 = @entry(#A21, #B12, #A22, #B22)
@main = #Pair{#Blk{%(@C11), %(@C12), %(@C21), %(@C22)}, @lenN(@lcat(%(@C11), @lcat(%(@C12), @lcat(%(@C21), %(@C22)))))}
