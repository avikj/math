// Complete inference (index 5.27) as net programs with no problem in them.  An object is a trilinear form given by
// its monomials over three slots of entries; the question is its writings as sums of r rank-one terms.
//   @aut       6.1 / 9.2   the object's symmetries, a fibre over the relabelling cube
//   @quotient  6.1 / 9.5   the writing cube up to the derived group: a generator of maximal order read from the group,
//                          orbits by iterating it, fixed terms by invariance, representatives by canonicity under the
//                          group and under the stabiliser
//   @order     9.4         the constraints (the tensor's entries) sorted by how many coordinates each opens, computed
//                          from the coordinates' names; supports before signs; the equation mod 2 before the equation
// Naturals are tallies (#Z0, #S); a coordinate's name is the number ? gave it (the machine's own name for a label).
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@map = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{f(h), @map(f, t)}}
@all = λ&f. λ{#Nil: 1; #Cons: λ&h. λ&t. (λ{1: @all(f, t); 0: 0})(f(h))}
@any = λ&f. λ{#Nil: 0; #Cons: λ&h. λ&t. (λ{1: 1; 0: @any(f, t)})(f(h))}
@filter = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. (λ{1: #Cons{h, @filter(f, t)}; 0: @filter(f, t)})(f(h))}
@and = λ{1: λ&b. b; 0: λ&b. 0}
@xor = λ{0: λ&b. b; 1: λ{0: 1; 1: 0}}
@lenN = λ{#Nil: #Z0; #Cons: λ&h. λ&t. #S{@lenN(t)}}
@take = λ{#Z0: λ&l. #Nil; #S: λ&n. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{h, @take(n, t)}}}
@nth = λ{#Cons: λ&h. λ&t. λ{#Z0: h; #S: λ&n. @nth(t, n)}}
@eqN = λ{#Z0: λ{#Z0: 1; #S: λ&b. 0}; #S: λ&a. λ{#Z0: 0; #S: λ&b. @eqN(a, b)}}
@ltN = λ{#Z0: λ{#Z0: 0; #S: λ&b. 1}; #S: λ&a. λ{#Z0: 0; #S: λ&b. @ltN(a, b)}}
@range = λ{#Z0: #Nil; #S: λ&n. @lcat(@range(n), #Cons{n, #Nil})}
// ---- the rearrangement cube (9.2, 9.8) and the relabelling cube ----
@cube = λ&c. λ{#Nil: λ&y. y; #Cons: λ&h. λ&t. λ{#Nil: #Cons{h, t}; #Cons: λ&h2. λ&t2. &(c){#Cons{h2, @cubeRest(#Cons{h, t}, t2)}, #Cons{h, @cubeRest(t, #Cons{h2, t2})}}}}
@cubeRest = λ&x. λ&y. ! &c = ?; @cube(c, x, y)
@perms = λ{#Nil: #Nil; #Cons: λ&h. λ{#Nil: #Cons{h, #Nil}; λ&t. @cubeRest(#Cons{h, #Nil}, @perms(t))}}
@slot = λ{#S0: λ&a. λ&b. λ&c. #M{a, b, c}; #S1: λ&a. λ&b. λ&c. #M{b, c, a}; #S2: λ&a. λ&b. λ&c. #M{c, a, b};
         #S3: λ&a. λ&b. λ&c. #M{a, c, b}; #S4: λ&a. λ&b. λ&c. #M{c, b, a}; #S5: λ&a. λ&b. λ&c. #M{b, a, c}}
@slots = &(?){#S0, &(?){#S1, &(?){#S2, &(?){#S3, &(?){#S4, #S5}}}}}
@actM = λ{#R: λ&pa. λ&pb. λ&pc. λ&s. λ{#M: λ&a. λ&b. λ&c. @slot(s, @nth(pa, a), @nth(pb, b), @nth(pc, c))}}
@eqM = λ{#M: λ&a. λ&b. λ&c. λ{#M: λ&d. λ&e. λ&f. @and(@eqN(a, d), @and(@eqN(b, e), @eqN(c, f)))}}
@member = λ&m. λ{#Nil: 0; #Cons: λ&h. λ&t. (λ{1: 1; 0: @member(m, t)})(@eqM(m, h))}
@inRange = λ&sizes. λ{#M: λ&a. λ&b. λ&c. @and(@ltN(a, @nth(sizes, #Z0)), @and(@ltN(b, @nth(sizes, #S{#Z0})), @ltN(c, @nth(sizes, #S{#S{#Z0}}))))}
// the symmetries: relabellings carrying the object's monomials onto themselves (entries out of range die)
@aut = λ&phi. λ&sizes. ! &R = #R{@perms(@range(@nth(sizes, #Z0))), @perms(@range(@nth(sizes, #S{#Z0}))), @perms(@range(@nth(sizes, #S{#S{#Z0}}))), @slots};
  %((λ&r. (λ{1: r; 0: &{}})(@all(λ&m. ! &im = @actM(r, m); @and(@inRange(sizes, im), @member(im, phi)), phi)))(R))
// ---- group operations on relabellings ----
@inv = λ&p. @map(λ&i. @indexOf(p, i, #Z0), @range(@lenN(p)))
@indexOf = λ{#Cons: λ&h. λ&t. λ&x. λ&k. (λ{1: k; 0: @indexOf(t, x, #S{k})})(@eqN(h, x))}
@composeP = λ&p. λ&q. @map(λ&i. @nth(p, @nth(q, i)), @range(@lenN(q)))
@slotPerm = λ{#S0: #Cons{#Z0, #Cons{#S{#Z0}, #Cons{#S{#S{#Z0}}, #Nil}}}; #S1: #Cons{#S{#Z0}, #Cons{#S{#S{#Z0}}, #Cons{#Z0, #Nil}}}; #S2: #Cons{#S{#S{#Z0}}, #Cons{#Z0, #Cons{#S{#Z0}, #Nil}}};
             #S3: #Cons{#Z0, #Cons{#S{#S{#Z0}}, #Cons{#S{#Z0}, #Nil}}}; #S4: #Cons{#S{#S{#Z0}}, #Cons{#S{#Z0}, #Cons{#Z0, #Nil}}}; #S5: #Cons{#S{#Z0}, #Cons{#Z0, #Cons{#S{#S{#Z0}}, #Nil}}}}
@isIdP = λ&p. @all(λ&i. @eqN(@nth(p, i), i), @range(@lenN(p)))
@isId = λ{#R: λ&pa. λ&pb. λ&pc. λ&s. @and(@isIdP(@slotPerm(s)), @and(@isIdP(pa), @and(@isIdP(pb), @isIdP(pc))))}
// g^k on a monomial, and the order of g: least k ≥ 1 with g^k the identity on every monomial of a full entry set
@powM = λ&g. λ{#Z0: λ&m. m; #S: λ&k. λ&m. @powM(g, k, @actM(g, m))}
@ordG = λ&g. λ&sizes. @orderGo(g, @allMon(sizes), #S{#Z0})
@allMon = λ&sizes. @concatMap(λ&a. @concatMap(λ&b. @map(λ&c. #M{a, b, c}, @range(@nth(sizes, #S{#S{#Z0}}))), @range(@nth(sizes, #S{#Z0}))), @range(@nth(sizes, #Z0)))
@concatMap = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. @lcat(f(h), @concatMap(f, t))}
@orderGo = λ&g. λ&ms. λ&k. (λ{1: k; 0: @orderGo(g, ms, #S{k})})(@all(λ&m. @eqM(@powM(g, k, m), m), ms))
// an element of maximal order in the group
@maxOrder = λ&G. λ&sizes. @maxGo(G, sizes, #Nil, #Z0)
@maxGo = λ{#Nil: λ&sizes. λ&best. λ&bo. best; #Cons: λ&g. λ&rest. λ&sizes. λ&best. λ&bo. ! &o = @ordG(g, sizes); (λ{1: @maxGo(rest, sizes, g, o); 0: @maxGo(rest, sizes, best, bo)})(@ltN(bo, o))}
// ---- terms, cells, and the action on terms ----
// a cell: its name (0 when fixed), its support, its sign; the sign is read only where the support is 1 (9.4)
@fresh = ! &n = ?; ! &m = ?; #Sg{n, m, &(n){0, 1}, &(m){#P, #N}}
@fixed = λ&g. #Sg{0, 0, 1, g}
@zero = #Sg{0, 0, 0, #P}
@val = λ{#Sg: λ&n. λ&m. λ&s. λ&g. (λ{0: #O; 1: g})(s)}
@sup = λ{#Sg: λ&n. λ&m. λ&s. λ&g. s}
@name = λ{#Sg: λ&n. λ&m. λ&s. λ&g. n}
@sname = λ{#Sg: λ&n. λ&m. λ&s. λ&g. m}
// one unfolding per cell: a shared lambda body would make every cell one coordinate
@pat = λ{#Z0: #Nil; #S: λ&n. #Cons{@fresh, @pat(n)}}
@mulS = λ{#O: λ&y. #O; #P: λ&y. y; #N: λ{#O: #O; #P: #N; #N: #P}}
// g acting on a term: entries relabelled (u'[pa a] = u[a]) and slots permuted
@permute = λ&p. λ&u. ! &q = @inv(p); @map(λ&i. @nth(u, @nth(q, i)), @range(@lenN(u)))
@actT = λ{#R: λ&pa. λ&pb. λ&pc. λ&s. λ{#T: λ&u. λ&v. λ&w. (λ{#M: λ&x. λ&y. λ&z. #T{x, y, z}})(@slot(s, @permute(pa, u), @permute(pb, v), @permute(pc, w)))}}
@valsT = λ{#T: λ&u. λ&v. λ&w. #T{@map(@val, u), @map(@val, v), @map(@val, w)}}
@eqS = λ{#O: λ{#O: 1; λ&q. 0}; #P: λ{#P: 1; λ&q. 0}; #N: λ{#N: 1; λ&q. 0}}
@eqL = λ{#Nil: λ&y. 1; #Cons: λ&a. λ&as. λ{#Nil: 0; #Cons: λ&b. λ&bs. @and(@eqS(a, b), @eqL(as, bs))}}
@eqTv = λ{#T: λ&u. λ&v. λ&w. λ{#T: λ&x. λ&y. λ&z. @and(@eqL(u, x), @and(@eqL(v, y), @eqL(w, z)))}}
// lexicographic order on sign lists and terms (O < P < N), for canonical representatives (6.1)
@rk = λ{#O: #Z0; #P: #S{#Z0}; #N: #S{#S{#Z0}}}
@leL = λ{#Nil: λ&y. 1; #Cons: λ&a. λ&as. λ{#Nil: 0; #Cons: λ&b. λ&bs. (λ{1: 1; 0: (λ{1: @leL(as, bs); 0: 0})(@eqN(@rk(a), @rk(b)))})(@ltN(@rk(a), @rk(b)))}}
@leT = λ{#T: λ&u. λ&v. λ&w. λ{#T: λ&x. λ&y. λ&z. (λ{1: 1; 0: (λ{1: (λ{1: 1; 0: (λ{1: @leL(w, z); 0: 0})(@eqL(v, y))})(@leL(v, y)); 0: 0})(@eqL(u, x))})(@ltL(u, x))}}
@ltL = λ&a. λ&b. @and(@leL(a, b), (λ{1: 0; 0: 1})(@eqL(a, b)))
// a term is canonical under G when it is ≤ every image of itself
@canonT = λ&G. λ&T. ! &Tv = @valsT(T); @all(λ&g. @leT(Tv, @valsT(@actT(g, T))), G)
@stab = λ&G. λ&T. ! &Tv = @valsT(T); @filter(λ&g. @eqTv(Tv, @valsT(@actT(g, T))), G)
// ---- the quotient: writings of length r up to G ----
// a generator g of maximal order k splits a writing into fixed terms (g·T = T) and orbits (T, gT, …, g^(k-1)T);
// r = f + m·k for each f; the fixed terms and the first generator are canonical (6.1, 9.5)
@orbit = λ&g. λ&k. λ&T. @orbitGo(g, k, T)
@orbitGo = λ&g. λ{#Z0: λ&T. #Nil; #S: λ&k. λ&T. #Cons{T, @orbitGo(g, k, @actT(g, T))}}
// a term fixed by g has one coordinate per orbit of g on positions (slot, index): the cells of an orbit are one
// cell (6.1 one level down), so invariance is built, not cut
@positions = λ&sizes. @concatMap(λ&sl. @map(λ&i. #Pos{sl, i}, @range(@nth(sizes, sl))), @range(#S{#S{#S{#Z0}}}))
@permOf = λ{#R: λ&pa. λ&pb. λ&pc. λ&s. λ{#Z0: pa; #S: λ{#Z0: pb; #S: λ&q. pc}}}
@tgtSlot = λ{#R: λ&pa. λ&pb. λ&pc. λ&s. @inv(@slotPerm(s))}
@actPos = λ&g. λ{#Pos: λ&sl. λ&i. #Pos{@nth(@tgtSlot(g), sl), @nth(@permOf(g, sl), i)}}
@eqPos = λ{#Pos: λ&a. λ&i. λ{#Pos: λ&b. λ&j. @and(@eqN(a, b), @eqN(i, j))}}
@memPos = λ&p. λ{#Nil: 0; #Cons: λ&h. λ&t. (λ{1: 1; 0: @memPos(p, t)})(@eqPos(p, h))}
@orbitPos = λ&g. λ&p. @orbitPosGo(g, p, @actPos(g, p), #Cons{p, #Nil})
@orbitPosGo = λ&g. λ&p0. λ&p. λ&acc. (λ{1: acc; 0: @orbitPosGo(g, p0, @actPos(g, p), #Cons{p, acc})})(@eqPos(p, p0))
@orbitsPos = λ&g. λ{#Nil: #Nil; #Cons: λ&p. λ&rest. ! &orb = @orbitPos(g, p); #Cons{orb, @orbitsPos(g, @filter(λ&q. (λ{1: 0; 0: 1})(@memPos(q, orb)), rest))}}
// one fresh cell per orbit; a position's cell is its orbit's
@cellsFor = λ{#Nil: #Nil; #Cons: λ&orb. λ&rest. #Cons{#Pair{orb, @fresh}, @cellsFor(rest)}}
@cellAt = λ&cells. λ&p. (λ{#Cons: λ{#Pair: λ&orb. λ&c. λ&rest. (λ{1: c; 0: @cellAt(rest, p)})(@memPos(p, orb))}})(cells)
@fixedTermG = λ&g. λ&sizes. ! &cells = @cellsFor(@orbitsPos(g, @positions(sizes)));
  #T{@map(λ&i. @cellAt(cells, #Pos{#Z0, i}), @range(@nth(sizes, #Z0))), @map(λ&i. @cellAt(cells, #Pos{#S{#Z0}, i}), @range(@nth(sizes, #S{#Z0}))), @map(λ&i. @cellAt(cells, #Pos{#S{#S{#Z0}}, i}), @range(@nth(sizes, #S{#S{#Z0}})))}
@fixedTerms = λ&g. λ&sizes. λ{#Z0: #Nil; #S: λ&f. #Cons{@fixedTermG(g, sizes), @fixedTerms(g, sizes, f)}}
@gens = λ&sizes. λ{#Z0: #Nil; #S: λ&m. #Cons{#T{@pat(@nth(sizes, #Z0)), @pat(@nth(sizes, #S{#Z0})), @pat(@nth(sizes, #S{#S{#Z0}}))}, @gens(sizes, m)}}
// the splits r = f + m·k, as a line over f
@splits = λ&r. λ&k. @splitsGo(r, k, #Z0)
@splitsGo = λ&r. λ&k. λ&f. (λ{1: (λ{1: #Cons{#Pair{f, @divN(@subN(r, f), k)}, @splitsGo(r, k, #S{f})}; 0: @splitsGo(r, k, #S{f})})(@divides(k, @subN(r, f))); 0: #Nil})(@leN(f, r))
@leN = λ&a. λ&b. (λ{1: 1; 0: @eqN(a, b)})(@ltN(a, b))
@subN = λ{#Z0: λ&b. #Z0; #S: λ&a. λ{#Z0: #S{a}; #S: λ&b. @subN(a, b)}}
@divides = λ&k. λ{#Z0: 1; λ&n. (λ{1: 0; 0: @divides(k, @subN(n, k))})(@ltN(n, k))}
@divN = λ&n. λ&k. (λ{1: #Z0; 0: #S{@divN(@subN(n, k), k)}})(@ltN(n, k))
@choose = λ{#Nil: &{}; #Cons: λ&h. λ&t. &(?){h, @choose(t)}}
// the cube of writings for one split, with its side conditions: fixed terms invariant and canonical under G,
// the first generator's u canonical under the stabiliser of the fixed terms
@quotientAt = λ&G. λ&g. λ&k. λ&sizes. λ{#Pair: λ&f. λ&m. ! &F = @fixedTerms(g, sizes, f); ! &Gs = @gens(sizes, m);
  #Q{F, Gs, @lcat(F, @concatMap(λ&T. @orbit(g, k, T), Gs))}}
// the symmetries that act on the quotient cube are those commuting with the generator; representatives are
// canonical under them (and, for the generator, under their stabiliser of the fixed terms)
@centraliser = λ&G. λ&g. λ&sizes. ! &ms = @allMon(sizes); @filter(λ&h. @all(λ&m. @eqM(@actM(h, @actM(g, m)), @actM(g, @actM(h, m))), ms), G)
@sideConds = λ&G. λ&g. λ&sizes. λ{#Q: λ&F. λ&Gs. λ&W. ! &C = @centraliser(G, g, sizes); ! &stabF = @stabAll(C, F);
  @and(@all(λ&T. @canonT(C, T), F),
       (λ{#Nil: 1; #Cons: λ&T1. λ&rest. @canonU(stabF, T1)})(Gs))}
@stabAll = λ&G. λ{#Nil: G; #Cons: λ&T. λ&rest. @stabAll(@stab(G, T), rest)}
@canonU = λ&G. λ{#T: λ&u. λ&v. λ&w. ! &uv = @map(@val, u); @all(λ&g. @leL(uv, @fstT(@valsT(@actT(g, #T{u, v, w})))), G)}
@fstT = λ{#T: λ&u. λ&v. λ&w. u}
@quotient = λ&G. λ&sizes. λ&r. ! &g = @maxOrder(G, sizes); ! &k = @ordG(g, sizes); #Pair{#Pair{g, k}, @choose(@map(λ&sp. @quotientAt(G, g, k, sizes, sp), @splits(r, k)))}
// ---- the equation and its order ----
@entry = λ{#T: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. @mulS(@mulS(@val(@nth(u, i)), @val(@nth(v, j))), @val(@nth(w, k)))}}
@entryS = λ{#T: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. @and(@sup(@nth(u, i)), @and(@sup(@nth(v, j)), @sup(@nth(w, k))))}}
@footprint = λ{#T: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. @filter(λ&n. (λ{0: 0; λ&q. 1})(n), #Cons{@name(@nth(u, i)), #Cons{@name(@nth(v, j)), #Cons{@name(@nth(w, k)), #Nil}}})}}
@footW = λ&W. λ&m. @concatMap(λ&T. @footprint(T, m), W)
@int = λ{#O: #Z{#Z0, #Z0}; #P: #Z{#S{#Z0}, #Z0}; #N: #Z{#Z0, #S{#Z0}}}
@addZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. #Z{@addT(a, c), @addT(b, d)}}}
@addT = λ{#Z0: λ&b. b; #S: λ&a. λ&b. #S{@addT(a, b)}}
@eqZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. @eqN(@addT(a, d), @addT(b, c))}}
@sumW = λ&W. λ&m. (λ{#Nil: #Z{#Z0, #Z0}; #Cons: λ&T. λ&rest. @addZ(@int(@entry(T, m)), @sumW(rest, m))})(W)
@parW = λ&W. λ&m. (λ{#Nil: 0; #Cons: λ&T. λ&rest. @xor(@entryS(T, m), @parW(rest, m))})(W)
@targetS = λ&phi. λ&m. (λ{1: #P; 0: #O})(@member(m, phi))
// 9.4: the entries ordered greedily by how many coordinates not yet open each would open (names compared as numbers)
@order = λ&W. λ&entries. @orderGo2(W, entries, #Nil)
@orderGo2 = λ&W. λ{#Nil: λ&open. #Nil; λ&es. λ&open. ! &best = @leastNew(W, es, open); #Cons{best, @orderGo2(W, @removeM(best, es), @lcat(@footW(W, best), open))}}
@newCount = λ&open. λ&fp. @lenN(@filter(λ&n. (λ{1: 0; 0: 1})(@memN(n, open)), fp))
@memN = λ&n. λ{#Nil: 0; #Cons: λ&h. λ&t. (λ{1: 1; 0: @memN(n, t)})((n == h))}
@leastNew = λ&W. λ{#Cons: λ&h. λ&t. λ&open. @leastGo(W, t, open, h, @newCount(open, @footW(W, h)))}
@leastGo = λ&W. λ{#Nil: λ&open. λ&best. λ&bc. best; #Cons: λ&h. λ&t. λ&open. λ&best. λ&bc. ! &c = @newCount(open, @footW(W, h)); (λ{1: @leastGo(W, t, open, h, c); 0: @leastGo(W, t, open, best, bc)})(@ltN(c, bc))}
@removeM = λ&m. λ{#Nil: #Nil; #Cons: λ&h. λ&t. (λ{1: t; 0: #Cons{h, @removeM(m, t)}})(@eqM(m, h))}
// the declaration: the equation mod 2 on every entry in order, then the equation
@decl = λ&phi. λ&W. λ&entries. @and(@all(λ&m. @eqB(@parW(W, m), @member(m, phi)), entries), @all(λ&m. @eqZ(@sumW(W, m), @int(@targetS(phi, m))), entries))
@eqB = λ{0: λ{0: 1; 1: 0}; 1: λ{0: 0; 1: 1}}
// ---- complete inference: the fibre of writings of length r of the object, up to its symmetries ----
@infer = λ&phi. λ&sizes. λ&r. ! &G = @aut(phi, sizes); ! &Q = @quotient(G, sizes, r);
  (λ{#Pair: λ&gk. λ&q. (λ{#Q: λ&F. λ&Gs. λ&W. ! &es = @order(W, @allMon(sizes));
     (λ{1: @map(@valsT, W); 0: &{}})(@and(@sideConds(G, @fstP(gk), sizes, #Q{F, Gs, W}), @decl(phi, W, es)))})(q)})(Q)
@fstP = λ{#Pair: λ&a. λ&b. a}
// ---- the declaration with no length in it: the writings of the object, the length a coordinate read in order ----
// the line over lengths r = 0, 1, 2, … (9.11's order), each length its splits; the collapse walks it in order, so the
// first point it yields is the writing of least length and every length below it has been cut empty (5.27 both ways)
@lengths = λ&r. #Cons{r, @lengths(#S{r})}
@lineOf = λ&G. λ&g. λ&k. λ&sizes. λ{#Cons: λ&r. λ&rest. @lcat(@map(λ&sp. @quotientAt(G, g, k, sizes, sp), @splits(r, k)), @lineOf(G, g, k, sizes, rest))}
@inferFree = λ&phi. λ&sizes. ! &G = @aut(phi, sizes); ! &g = @maxOrder(G, sizes); ! &k = @ordG(g, sizes);
  (λ{#Q: λ&F. λ&Gs. λ&W. ! &es = @order(W, @allMon(sizes));
     (λ{1: @map(@valsT, W); 0: &{}})(@and(@sideConds(G, g, sizes, #Q{F, Gs, W}), @decl(phi, W, es)))})(@choose(@lineOf(G, g, k, sizes, @lengths(#Z0))))
@headL = λ{#Cons: λ&h. λ&t. h}

// ---- the forced execution: entries as restrictions, not a cut ----
// What is held: an environment of cells already determined (name, value).  An entry of the residual whose sum has one
// unknown cell with known co-factors determines that cell: a face on its support coordinate and on its sign
// coordinate (9.3: a restriction, the coordinate decided by the act).  An entry requiring a nonzero value from a
// product of unknown cells fixes their supports to 1.  Entries are walked in exclusion order to a fixed point.  Cells
// nothing determines stay as they are: that is the genuine choice, read by %.  A contradiction kills the side.
@lookup = λ&n. λ{#Nil: #U; #Cons: λ{#Pair: λ&k. λ&v. λ&rest. (λ{1: #K{v}; 0: @lookup(n, rest)})((n == @name(k)))}}
// a cell's value under the environment: fixed cells by their value, determined cells from the environment, else unknown
@cellV = λ&env. λ{#Sg: λ&n. λ&m. λ&s. λ&g. (λ{0: #K{(λ{0: #O; 1: g})(s)}; λ&q. @lookup(n, env)})(n)}
// a term's factors at an entry: list of (cell, value-or-unknown)
@factors = λ&env. λ{#T: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. ! &a = @nth(u, i); ! &b = @nth(v, j); ! &c = @nth(w, k);
  #Cons{#Pair{a, @cellV(env, a)}, #Cons{#Pair{b, @cellV(env, b)}, #Cons{#Pair{c, @cellV(env, c)}, #Nil}}}}}
// a term's status: #Zero (a known factor is 0), #Val{s} (all known, product s), #Unk{coef, unknown cells}
@status = λ&fs. @statusGo(fs, #P, #Nil)
@statusGo = λ{#Nil: λ&coef. λ&unk. (λ{#Nil: #Val{coef}; λ&l. #Unk{coef, unk}})(unk);
  #Cons: λ{#Pair: λ&cell. λ&cv. λ&rest. λ&coef. λ&unk. (λ{#K: λ&v. (λ{#O: #Zero; #Nz: @statusGo(rest, coef, #Cons{cell, unk}); λ&q. @statusGo(rest, @mulS(coef, v), unk)})(v); #U: @statusGo(rest, coef, #Cons{cell, unk})})(cv)}}
@isZero = λ{#Zero: 1; λ&q. 0}
// the entry: known sum, and the unknown terms
@entryState = λ&env. λ&W. λ&m. @esGo(@map(λ&T. @status(@factors(env, T, m)), W), #Z{#Z0, #Z0}, #Nil)
@esGo = λ{#Nil: λ&known. λ&unks. #ES{known, unks}; #Cons: λ&st. λ&rest. λ&known. λ&unks.
  (λ{#Zero: @esGo(rest, known, unks); #Val: λ&v. @esGo(rest, @addZ(known, @int(v)), unks); #Unk: λ&c. λ&cells. @esGo(rest, known, #Cons{#Unk{c, cells}, unks})})(st)}
// q = target − known as a sign (or #Big when |q| > 1, a contradiction)
@asSign = λ{#Z: λ&a. λ&b. @signOf(@subT(a, b), @subT(b, a))}
@signOf = λ{#Z0: λ{#Z0: #O; #S: λ{#Z0: #N; #S: λ&r. #Big}}; #S: λ{#Z0: λ{#Z0: #P; #S: λ&r. #Big}; #S: λ&r. λ&q. #Big}}
@subT = λ{#Z0: λ&b. #Z0; #S: λ&a. λ{#Z0: #S{a}; #S: λ&b. @subT(a, b)}}
// one entry's restriction: returns #Dead, or #Env{env'} (possibly unchanged)
@restrict = λ&phi. λ&env. λ&W. λ&m. (λ{#ES: λ&known. λ&unks. ! &q = @asSign(@addZ(@int(@targetS(phi, m)), @negZ(known)));
  (λ{#Big: #Dead; λ&qs. (λ{#Nil: (λ{#O: #Env{env}; λ&z. #Dead})(qs);
     #Cons: λ&one. λ&more. (λ{#Nil: @restrictOne(env, qs, one); λ&l. #Env{env}})(more)})(unks)})(q)})(@entryState(env, W, m))
@negZ = λ{#Z: λ&a. λ&b. #Z{b, a}}
@restrictOne = λ&env. λ&q. λ{#Unk: λ&c. λ{#Cons: λ&x. λ{#Nil: (λ{#O: (λ{#K: λ&v. #Dead; #U: #Env{#Cons{#Pair{x, #O}, env}}})(@lookup(@name(x), env)); λ&nz. #Env{#Cons{#Pair{x, @mulS(q, c)}, env}}})(q);
  λ&others. (λ{#O: #Env{env}; λ&nz. #Env{@markNz(env, #Cons{x, others})}})(q)}}}
@markNz = λ&env. λ{#Nil: env; #Cons: λ&x. λ&rest. (λ{#K: λ&v. @markNz(env, rest); #U: @markNz(#Cons{#Pair{x, #Nz}, env}, rest)})(@lookup(@name(x), env))}
// to a fixed point over the entries in exclusion order
@propagate = λ&phi. λ&W. λ&es. λ&env. @propGo(phi, W, es, env, es, 0)
@propGo = λ&phi. λ&W. λ&all. λ&env. λ{#Nil: λ&changed. (λ{1: @propagate(phi, W, all, env); 0: #Env{env}})(changed);
  #Cons: λ&m. λ&rest. λ&changed. (λ{#Dead: #Dead; #Env: λ&env2. @propGo(phi, W, all, env2, rest, @or2(changed, @grew(env, env2)))})(@restrict(phi, env, W, m))}
@or2 = λ{1: λ&b. 1; 0: λ&b. b}
@grew = λ&a. λ&b. (λ{1: 0; 0: 1})(@eqN(@lenN(a), @lenN(b)))
// the determined cells taken as faces on the writing: support, then sign where nonzero
@applyFaces = λ{#Nil: λ&W. W; #Cons: λ{#Pair: λ&cell. λ&v. λ&rest. λ&W. @applyFaces(rest, @faceCell(cell, v, W))}}
@faceCell = λ&cell. λ&v. λ&W. (λ{0: W; λ&n. (λ{#O: |(0)(n) W; #P: |(1)(n) (|(0)(@sname(cell)) W); #N: |(1)(n) (|(1)(@sname(cell)) W)})(v)})(@name(cell))
// the forced choices (9.5): the cells of the given terms are read, which branches the continuation per side
@force = λ&env. λ{#Nil: env; #Cons: λ&cell. λ&rest. ! &v = @val(cell); @force(#Cons{#Pair{cell, v}, env}, rest)}
@cellsOf = λ{#T: λ&u. λ&v. λ&w. @lcat(u, @lcat(v, w))}
@uOf = λ{#T: λ&u. λ&v. λ&w. u}
// the forced execution: the fixed terms' cells and the first generator's u are the choices; everything an entry
// determines is taken as a face; what remains is read
@valE = λ&env. λ&cell. (λ{#K: λ&v. (λ{#Nz: @val(cell); λ&w. v})(v); #U: @val(cell)})(@lookup(@name(cell), env))
@valsTE = λ&env. λ{#T: λ&u. λ&v. λ&w. #T{@map(@valE(env), u), @map(@valE(env), v), @map(@valE(env), w)}}
@entryE = λ&env. λ{#T: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. @mulS(@mulS(@valE(env, @nth(u, i)), @valE(env, @nth(v, j))), @valE(env, @nth(w, k)))}}
@sumWE = λ&env. λ&W. λ&m. (λ{#Nil: #Z{#Z0, #Z0}; #Cons: λ&T. λ&rest. @addZ(@int(@entryE(env, T, m)), @sumWE(env, rest, m))})(W)
@declE = λ&env. λ&phi. λ&W. λ&entries. @all(λ&m. @eqZ(@sumWE(env, W, m), @int(@targetS(phi, m))), entries)
@inferForced = λ&phi. λ&sizes. ! &G = @aut(phi, sizes); ! &g = @maxOrder(G, sizes); ! &k = @ordG(g, sizes);
  (λ{#Q: λ&F. λ&Gs. λ&W. ! &es = @order(W, @allMon(sizes));
     ! &env0 = @force(@force(#Nil, @concatMap(@cellsOf, F)), (λ{#Nil: #Nil; #Cons: λ&T1. λ&r. @uOf(T1)})(Gs));
     (λ{#Dead: &{}; #Env: λ&env. ! &Wv = @map(@valsTE(env), W);
        (λ{1: Wv; 0: &{}})(@and(@sideConds(G, g, sizes, #Q{F, Gs, W}), @declE(env, phi, W, es)))})(@propagate(phi, W, es, env0))})(@choose(@lineOf(G, g, k, sizes, @lengths(#Z0))))
