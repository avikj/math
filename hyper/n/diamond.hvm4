// index 5.11 / 5.13 / 5.24 on net.c: one term, several schedules, one ledger.  The normaliser under -R n visits a
// node's fields in a seeded order, so which copy of a shared sub-net forces it first, and which independent sub-net
// reduces first, change from run to run.  Equal length (5.13) says the interaction count cannot move; sharing (5.24)
// says an active pair is never duplicated, so the shared work is paid once whichever side reaches it.
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@add = λ{#Z: λ&b. b; #S: λ&a. λ&b. #S{@add(a, b)}}
@mul = λ{#Z: λ&b. #Z; #S: λ&a. λ&b. @add(b, @mul(a, b))}
@n3 = #S{#S{#S{#Z}}}
@n4 = #S{@n3}
@n5 = #S{@n4}
@n9 = #S{#S{#S{#S{#S{@n4}}}}}
// a shared expensive sub-net, read by four fields through two levels of pairs
@main = ! &x = @mul(@n9, @n9); #Pair{#Pair{x, @add(x, @n3)}, #Pair{@add(@n5, x), #Pair{x, %(&(?){x, @mul(@n3, @n4)})}}}
