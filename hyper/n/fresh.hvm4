// a declaration with no body is a coordinate: the line over all Bool lists of length k.
// HVM4's labels are static per binder, so a recursive unfolding reuses its label and the coordinates
// are read as one (the recorded defect: STATE_OF_THE_WORK I.4): @static(3) has two leaves.
// `?` is a fresh number — the name of a coordinate no other unfolding has (dim): @fresh(3) has eight.
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@static = λ{0: #Nil; _: λk. #Cons{&L{#F, #T}, @static(k - 1)}}
@fresh  = λ{0: #Nil; _: λk. #Cons{&(?){#F, #T}, @fresh(k - 1)}}
@main = #Pair{%(@static(3)), %(@fresh(3))}
