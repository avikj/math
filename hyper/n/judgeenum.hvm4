#include "judgment.hvm4"
// an enumeration as a type: {red, green} : Set; a symbol against it; a match with every symbol covered, and one without
@RG = #Cons{#Red, #Cons{#Green, #Nil}}
@main = #Cons{@judge(#Pair{#Set, #SEnum{@RG}}),                                                        // 1
        #Cons{@judge(#Pair{#Enum{@RG}, #SSym{#Red}}),                                                   // 1
        #Cons{@judge(#Pair{#Enum{@RG}, #SSym{#Blue}}),                                                  // 0
        #Cons{@judge(#Pair{#Nat, #SEnumM{#SAnn{#SSym{#Green}, #SEnum{@RG}}, #Cons{#SArm{#Red, #SZer}, #Cons{#SArm{#Green, #SSuc{#SZer}}, #Nil}}}}), // 1
        #Cons{@judge(#Pair{#Nat, #SEnumM{#SAnn{#SSym{#Green}, #SEnum{@RG}}, #Cons{#SArm{#Red, #SZer}, #Nil}}}),  // 0: green has no arm
        #Cons{@eval(#Nil, #SEnumM{#SAnn{#SSym{#Green}, #SEnum{@RG}}, #Cons{#SArm{#Red, #SZer}, #Cons{#SArm{#Green, #SSuc{#SZer}}, #Nil}}}), // #Suc{#Zer}
        #Nil}}}}}}
