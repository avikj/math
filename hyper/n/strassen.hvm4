// index 1.1 / 8.1 / 6.1: the same declaration as n/karatsuba.hvm4 at the 2×2 matrix product and rank 7: the fibre of
// evaluation over the product's tensor, on the cube of 7 × 12 coefficients in {−1, 0, 1} (3^84 vertices), with
// the ring alone.  Run to the ledger's limit to size it; see MAP for what the cut visits and what 6.1 asks for.
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
// a bit coordinate and a sign coordinate (−1, 0, 1 as #N, #O, #P)
@bit = &(?){#O, #P}
@sgn = &(?){#O, &(?){#P, #N}}
// the small ring {−1,0,1,…} needed: sums of ±1 products, kept exact as small integers via #Z{pos, neg} tallies
@mulS = λ{#O: λ&y. #O; #P: λ&y. y; #N: λ{#O: #O; #P: #N; #N: #P}}
@int = λ{#O: #Z{#Z0, #Z0}; #P: #Z{#S{#Z0}, #Z0}; #N: #Z{#Z0, #S{#Z0}}}
@addZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. #Z{@addT(a, c), @addT(b, d)}}}
@addT = λ{#Z0: λ&b. b; #S: λ&a. λ&b. #S{@addT(a, b)}}
@eqZ = λ{#Z: λ&a. λ&b. λ{#Z: λ&c. λ&d. @eqT(@addT(a, d), @addT(b, c))}}
@eqT = λ{#Z0: λ{#Z0: 1; #S: λ&b. 0}; #S: λ&a. λ{#Z0: 0; #S: λ&b. @eqT(a, b)}}
// one product m: (u0 a0 + u1 a1)(v0 b0 + v1 b1), contributing w_k to coefficient k; its tensor entry (i, j, k) is u_i v_j w_k
@entry = λ&u. λ&v. λ&w. λ&i. λ&j. λ&k. @mulS(@mulS(@nth(u, i), @nth(v, j)), @nth(w, k))
@nth = λ{#Cons: λ&h. λ&t. λ{#Z0: h; #S: λ&n. @nth(t, n)}}
// the 2×2 product's own tensor: A entries (a,b,c,d) = (11,12,21,22), B entries (e,f,g,h), C entries; A_i B_j lands in
// C_k iff row(i) = row(k), col(i) = row(j), col(j) = col(k)
@target = λ&i. λ&j. λ&k. (λ{1: #P; 0: #O})(@andB(@eqT(@row(i), @row(k)), @andB(@eqT(@col(i), @row(j)), @eqT(@col(j), @col(k)))))
@row = λ{#Z0: #Z0; #S: λ{#Z0: #Z0; #S: λ{#Z0: #S{#Z0}; #S: λ&q. #S{#Z0}}}}
@col = λ{#Z0: #Z0; #S: λ{#Z0: #S{#Z0}; #S: λ{#Z0: #Z0; #S: λ&q. #S{#Z0}}}}
// the declaration: three products; the sum of their tensors equals the product's tensor at all 2·2·3 entries
@decl = λ&P. @all(λ&ijk. (λ{#T3: λ&i. λ&j. λ&k. @eqZ(@sumP(P, i, j, k), @int(@target(i, j, k)))})(ijk), @entries)
@sumP = λ{#Nil: λ&i. λ&j. λ&k. #Z{#Z0, #Z0}; #Cons: λ{#Prod: λ&u. λ&v. λ&w. λ&rest. λ&i. λ&j. λ&k. @addZ(@int(@entry(u, v, w, i, j, k)), @sumP(rest, i, j, k))}}
@entries = #Cons{#T3{#Z0,#Z0,#Z0}, #Cons{#T3{#Z0,#Z0,#S{#Z0}}, #Cons{#T3{#Z0,#Z0,#S{#S{#Z0}}}, #Cons{#T3{#Z0,#Z0,#S{#S{#S{#Z0}}}}, #Cons{#T3{#Z0,#S{#Z0},#Z0}, #Cons{#T3{#Z0,#S{#Z0},#S{#Z0}}, #Cons{#T3{#Z0,#S{#Z0},#S{#S{#Z0}}}, #Cons{#T3{#Z0,#S{#Z0},#S{#S{#S{#Z0}}}}, #Cons{#T3{#Z0,#S{#S{#Z0}},#Z0}, #Cons{#T3{#Z0,#S{#S{#Z0}},#S{#Z0}}, #Cons{#T3{#Z0,#S{#S{#Z0}},#S{#S{#Z0}}}, #Cons{#T3{#Z0,#S{#S{#Z0}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#Z0,#S{#S{#S{#Z0}}},#Z0}, #Cons{#T3{#Z0,#S{#S{#S{#Z0}}},#S{#Z0}}, #Cons{#T3{#Z0,#S{#S{#S{#Z0}}},#S{#S{#Z0}}}, #Cons{#T3{#Z0,#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#Z0},#Z0,#Z0}, #Cons{#T3{#S{#Z0},#Z0,#S{#Z0}}, #Cons{#T3{#S{#Z0},#Z0,#S{#S{#Z0}}}, #Cons{#T3{#S{#Z0},#Z0,#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#Z0},#S{#Z0},#Z0}, #Cons{#T3{#S{#Z0},#S{#Z0},#S{#Z0}}, #Cons{#T3{#S{#Z0},#S{#Z0},#S{#S{#Z0}}}, #Cons{#T3{#S{#Z0},#S{#Z0},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#Z0},#S{#S{#Z0}},#Z0}, #Cons{#T3{#S{#Z0},#S{#S{#Z0}},#S{#Z0}}, #Cons{#T3{#S{#Z0},#S{#S{#Z0}},#S{#S{#Z0}}}, #Cons{#T3{#S{#Z0},#S{#S{#Z0}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#Z0},#S{#S{#S{#Z0}}},#Z0}, #Cons{#T3{#S{#Z0},#S{#S{#S{#Z0}}},#S{#Z0}}, #Cons{#T3{#S{#Z0},#S{#S{#S{#Z0}}},#S{#S{#Z0}}}, #Cons{#T3{#S{#Z0},#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#Z0}},#Z0,#Z0}, #Cons{#T3{#S{#S{#Z0}},#Z0,#S{#Z0}}, #Cons{#T3{#S{#S{#Z0}},#Z0,#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#Z0}},#Z0,#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#Z0}},#S{#Z0},#Z0}, #Cons{#T3{#S{#S{#Z0}},#S{#Z0},#S{#Z0}}, #Cons{#T3{#S{#S{#Z0}},#S{#Z0},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#Z0}},#S{#Z0},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#Z0}},#Z0}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#Z0}},#S{#Z0}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#Z0}},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#Z0}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#S{#Z0}}},#Z0}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#S{#Z0}}},#S{#Z0}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#S{#Z0}}},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#Z0}},#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#Z0,#Z0}, #Cons{#T3{#S{#S{#S{#Z0}}},#Z0,#S{#Z0}}, #Cons{#T3{#S{#S{#S{#Z0}}},#Z0,#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#Z0,#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#Z0},#Z0}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#Z0},#S{#Z0}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#Z0},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#Z0},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#Z0}},#Z0}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#Z0}},#S{#Z0}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#Z0}},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#Z0}},#S{#S{#S{#Z0}}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}},#Z0}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}},#S{#Z0}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}},#S{#S{#Z0}}}, #Cons{#T3{#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}}}, #Nil}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
@all = λ&f. λ{#Nil: 1; #Cons: λ&h. λ&t. (λ{1: @all(f, t); 0: 0})(f(h))}
// the coordinate: seven products, each (u, v, w) over the four entries, every coefficient in {−1, 0, 1}
@prod = #Prod{#Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Nil}}}}, #Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Nil}}}}, #Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Cons{@sgn, #Nil}}}}}
@P7 = #Cons{@prod, #Cons{@prod, #Cons{@prod, #Cons{@prod, #Cons{@prod, #Cons{@prod, #Cons{@prod, #Nil}}}}}}}
// 6.1: the relabellings of the products are discarded by keeping them in order (a product's code: u, then v, then w)
@code = λ{#Prod: λ&u. λ&v. λ&w. @lcat(u, @lcat(v, w))}
@rank = λ{#O: #Z0; #P: #S{#Z0}; #N: #S{#S{#Z0}}}
@leL = λ{#Nil: λ&y. 1; #Cons: λ&a. λ&as. λ{#Nil: 0; #Cons: λ&b. λ&bs. (λ{#Lt: 1; #Gt: 0; #Eq: @leL(as, bs)})(@cmpT(@rank(a), @rank(b)))}}
@cmpT = λ{#Z0: λ{#Z0: #Eq; #S: λ&b. #Lt}; #S: λ&a. λ{#Z0: #Gt; #S: λ&b. @cmpT(a, b)}}
@ordered = λ{#Nil: 1; #Cons: λ&p. λ{#Nil: 1; #Cons: λ&q. λ&rest. (λ{1: @ordered(#Cons{q, rest}); 0: 0})(@leL(@code(p), @code(q)))}}
@andB = λ{1: λ&b. b; 0: λ&b. 0}
@keep = λ&P. (λ{1: P; 0: &{}})(@andB(@decl(P), @ordered(P)))
@main = %(@keep(@P7))
