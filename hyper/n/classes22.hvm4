#include "writing22q.hvm4"
// The reading's classes under the identities the net has verified. %% returns the writings of the type up to
// relabelling of the index; the shear (conjugation of all three slots by [[1,1],[0,1]]) is an identity of
// tr(ABC) the faces verified on a writing (n/sym22.hvm4), and so is every relabelling of the index. Here each
// leaf is carried into its orbit under the relabellings and the shear within the alphabet, and two leaves are one
// class when one lies in the other's orbit: the fibre at length seven as the net reads it modulo its identities.
// A leaf's factors are shapes over the index; a shape is read into its four coefficients by faces.
@q = λ&p. λ&q. λ&x. #Q{@at(p, q, #F, #F, x), @at(p, q, #F, #T, x), @at(p, q, #T, #F, x), @at(p, q, #T, #T, x)}
@cellQ = λ&ia. λ&ja. λ&jb. λ&kb. λ&kc. λ&ic. λ{#W: λ&u. λ&v. λ&w. #C{@q(ia, ja, u), @q(jb, kb, v), @q(kc, ic, w)}}
@toQ = λ&ia. λ&ja. λ&jb. λ&kb. λ&kc. λ&ic. λ&W. @map(@cellQ(ia, ja, jb, kb, kc, ic), W)
// the identities on a coefficient cell #C{u, v, w}, u = #Q{a, b, c, d} over entries 11, 12, 21, 22
@tr = λ{#Q: λ&a. λ&b. λ&c. λ&d. #Q{a, c, b, d}}
@sw = λ{#Q: λ&a. λ&b. λ&c. λ&d. #Q{d, c, b, a}}
@dg = λ{#Q: λ&a. λ&b. λ&c. λ&d. #Q{a, @mulS(#N, b), @mulS(#N, c), d}}
@ng = λ{#Q: λ&a. λ&b. λ&c. λ&d. #Q{@mulS(#N, a), @mulS(#N, b), @mulS(#N, c), @mulS(#N, d)}}
@shq = λ{#Q: λ&a. λ&b. λ&c. λ&d. ! &z = @addS(a, c); ! &t = @addS(b, d); #Q{@addS(a, @mulS(#N, b)), b, @addS(z, @mulS(#N, t)), t}}
@cyc = λ{#C: λ&u. λ&v. λ&w. #C{v, w, u}}
@rev = λ{#C: λ&u. λ&v. λ&w. #C{@tr(w), @tr(v), @tr(u)}}
@swp = λ{#C: λ&u. λ&v. λ&w. #C{@sw(u), @sw(v), @sw(w)}}
@dia = λ{#C: λ&u. λ&v. λ&w. #C{@dg(u), @dg(v), @dg(w)}}
@scl = λ{#C: λ&u. λ&v. λ&w. #C{@ng(u), @ng(v), w}}
@shr = λ{#C: λ&u. λ&v. λ&w. #C{@shq(u), @shq(v), @shq(w)}}
@gens = #Cons{@cyc, #Cons{@rev, #Cons{@swp, #Cons{@dia, #Cons{@scl, #Cons{@shr, #Nil}}}}}}
// a writing is a multitude of cells: equal when each cell of one is a cell of the other and the lengths agree
@inQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. @and(@inS(a), @and(@inS(b), @and(@inS(c), @inS(d))))}
@inS = λ{#Big: #F; λ&q. #T}
@inC = λ{#C: λ&u. λ&v. λ&w. @and(@inQ(u), @and(@inQ(v), @inQ(w)))}
@and = λ{#T: λ&b. b; #F: λ&b. #F}
@eqQ = λ{#Q: λ&a. λ&b. λ&c. λ&d. λ{#Q: λ&e. λ&f. λ&g. λ&h. @and(@eqS(a, e), @and(@eqS(b, f), @and(@eqS(c, g), @eqS(d, h))))}}
@eqC = λ{#C: λ&u. λ&v. λ&w. λ{#C: λ&x. λ&y. λ&z. @and(@eqQ(u, x), @and(@eqQ(v, y), @eqQ(w, z)))}}
@any = λ&f. λ{#Nil: #F; #Cons: λ&h. λ&t. (λ{#T: #T; #F: @any(f, t)})(f(h))}
@allL = λ&f. λ{#Nil: #T; #Cons: λ&h. λ&t. @and(f(h), @allL(f, t))}
@filter = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. (λ{#T: #Cons{h, @filter(f, t)}; #F: @filter(f, t)})(f(h))}
@lenN = λ{#Nil: #Z; #Cons: λ&h. λ&t. #S{@lenN(t)}}
@eqN = λ{#Z: λ{#Z: #T; #S: λ&b. #F}; #S: λ&a. λ{#Z: #F; #S: λ&b. @eqN(a, b)}}
@eqW = λ&a. λ&b. @and(@eqN(@lenN(a), @lenN(b)), @allL(λ&c. @any(λ&d. @eqC(c, d), b), a))
@memW = λ&w. @any(λ&x. @eqW(w, x))
@inW = λ&w. @allL(@inC, w)
@not = λ{#T: #F; #F: #T}
// the orbit of a writing under the identities, within the alphabet
@orbit = λ&w. @orbGo(#Cons{w, #Nil}, #Cons{w, #Nil})
@orbGo = λ&els. λ{#Nil: els; #Cons: λ&f. λ&fs. ! &new = @filter(λ&w. @and(@inW(w), @not(@memW(w, els))), @distinctW(@map(λ&g. @map(g, f), @gens)));
  @orbGo(@lcat(new, els), @lcat(fs, new))}
@distinctW = λ{#Nil: #Nil; #Cons: λ&w. λ&ws. #Cons{w, @distinctW(@filter(λ&x. @not(@eqW(w, x)), ws))}}
// representatives: a writing is new when no kept orbit contains it; each representative carries its orbit
@classes = λ{#Nil: #Nil; #Cons: λ&w. λ&ws. @clGo(ws, #Cons{#Pair{w, @orbit(w)}, #Nil})}
@clGo = λ{#Nil: λ&reps. reps; #Cons: λ&w. λ&ws. λ&reps. (λ{#T: @clGo(ws, reps); #F: @clGo(ws, #Cons{#Pair{w, @orbit(w)}, reps})})(@any(λ{#Pair: λ&r. λ&o. @memW(w, o)}, reps))}
@main = ! &ia = ??; ! &ja = ??; ! &jb = ??; ! &kb = ??; ! &kc = ??; ! &ic = ??;
  ! &leaves = @map(@toQ(ia, ja, jb, kb, kc, ic), %%(@writingAt(ia, ja, jb, kb, kc, ic)));
  ! &cl = @classes(leaves);
  #Pair{@lenN(leaves), #Pair{@lenN(cl), @map(λ{#Pair: λ&r. λ&o. @lenN(o)}, cl)}}
