#include "bits.hvm4"
// The product of two matrices, posed as the object is and nothing else (5.27, 9.15 read for the product).
// Entries are numerals: bits, the additive units (n/bits.hvm4). Multiplication is addition composed: a bit of x
// selects y shifted, and the shifted copies are added — nothing primitive. The matrix is indexed by the cube
// (9.11): a leaf entry, or four blocks along the top bit of the index, in order 11, 12, 21, 22; at every node the
// object is the 2×2 product of its blocks, and that product is its own unfolding, C_ik = Σ_j A_ij B_jk, as merge is
// sortedness unfolded (9.6). An input entry over the cube is a numeral of superposed bits (@cube), the fibre; %
// reads the vertices. The identities the object has are the rules of + and × on bits and the sharing of the net
// (5.24): an entry used twice is one cell read twice, never computed twice. The ledger is the cost (5.14, 5.17).
@mulN = λ{#Nil: λ&y. #Nil; #Cons: λ{#F: λ&t. λ&y. #Cons{#F, @mulN(t, y)}; #T: λ&t. λ&y. @add(y, #Cons{#F, @mulN(t, y)})}}
@addM = λ{#Leaf: λ&x. λ{#Leaf: λ&y. #Leaf{@add(x, y)}};
  #Blk: λ&a. λ&b. λ&c. λ&d. λ{#Blk: λ&e. λ&f. λ&g. λ&h. #Blk{@addM(a, e), @addM(b, f), @addM(c, g), @addM(d, h)}}}
@prod = λ{#Leaf: λ&x. λ{#Leaf: λ&y. #Leaf{@mulN(x, y)}};
  #Blk: λ&a. λ&b. λ&c. λ&d. λ{#Blk: λ&e. λ&f. λ&g. λ&h.
    #Blk{@addM(@prod(a, e), @prod(b, g)), @addM(@prod(a, f), @prod(b, h)),
         @addM(@prod(c, e), @prod(d, g)), @addM(@prod(c, f), @prod(d, h))}}}
@tallyM = λ{#Leaf: λ&x. #Leaf{@tally(x)}; #Blk: λ&a. λ&b. λ&c. λ&d. #Blk{@tallyM(a), @tallyM(b), @tallyM(c), @tallyM(d)}}
@lenN = λ{#Nil: #Z; #Cons: λ&h. λ&t. #S{@lenN(t)}}
// the fibre: every entry a numeral of k superposed bits
@cubeM = λ&k. λ{#Z: #Leaf{@cube(k)}; #S: λ&d. #Blk{@cubeM(k, d), @cubeM(k, d), @cubeM(k, d), @cubeM(k, d)}}
@A = #Blk{#Leaf{@three}, #Leaf{@five}, #Leaf{#Cons{#T, #Nil}}, #Leaf{#Nil}}
@B = #Blk{#Leaf{@five}, #Leaf{#Cons{#F, #Cons{#T, #Nil}}}, #Leaf{@three}, #Leaf{#Cons{#T, #Nil}}}
@A4 = #Blk{@A, @B, @B, @A}
@B4 = #Blk{@B, @A, @A, @B}
@main = #Pair{@lenN(%(@prod(@cubeM(#S{#Z}, #S{#Z}), @cubeM(#S{#Z}, #S{#Z})))), #Pair{@tallyM(@prod(@A, @B)), @tallyM(@prod(@A4, @B4))}}
