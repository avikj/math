#include "infer.hvm4"
// the 2×2 product and nothing else — no length: φ = tr(ABC), entries 11,12,21,22 = 0..3, slots of four.  The first
// point the collapse yields is the writing of least length; every shorter length was cut empty on the way (5.27).
@phi = #Cons{#M{#Z0,#Z0,#Z0}, #Cons{#M{#Z0,#S{#Z0},#S{#S{#Z0}}}, #Cons{#M{#S{#Z0},#S{#S{#Z0}},#Z0}, #Cons{#M{#S{#Z0},#S{#S{#S{#Z0}}},#S{#S{#Z0}}},
       #Cons{#M{#S{#S{#Z0}},#Z0,#S{#Z0}}, #Cons{#M{#S{#S{#Z0}},#S{#Z0},#S{#S{#S{#Z0}}}}, #Cons{#M{#S{#S{#S{#Z0}}},#S{#S{#Z0}},#S{#Z0}}, #Cons{#M{#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}},#S{#S{#S{#Z0}}}}, #Nil}}}}}}}}
@four = #S{#S{#S{#S{#Z0}}}}
@sizes = #Cons{@four, #Cons{@four, #Cons{@four, #Nil}}}
@main = ! &W = @headL(%(@inferForced(@phi, @sizes))); #Pair{@lenN(W), W}
