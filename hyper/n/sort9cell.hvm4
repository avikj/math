// index §9 on the net with the comparison as one cell per pair: a_i <= a_j is made at most once, whatever side of
// the line reads it (the net's sharing), so OP2-NUM-NUM counts distinct pairs compared.  Keys are a set (9.1), so one
// cell per unordered pair is exact: b <= a is the negation of a <= b.  Everything else is as in sort9.hvm4: the input
// indexed as a numeral (9.11), the relabelling line factored over the index (9.2, 9.8), Sorted adjacent (9.6, 9.3).
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
// the input: values by index, and the comparison as one cell per pair of indices — a shared lazy value, made at most once
@vals4 = #Cons{2, #Cons{0, #Cons{3, #Cons{1, #Nil}}}}
@vals8 = #Cons{5, #Cons{2, #Cons{7, #Cons{0, #Cons{3, #Cons{6, #Cons{1, #Cons{4, #Nil}}}}}}}}
@nth = λ{#Cons: λ&h. λ&t. λ{#Z: h; #S: λ&k. @nth(t, k)}}
@row = λ&a. λ{#Nil: #Nil; #Cons: λ&b. λ&rest. #Cons{(a <= b), @row(a, rest)}}
@tbl = λ&vs. @tblGo(vs, vs)
@tblGo = λ&vs. λ{#Nil: #Nil; #Cons: λ&a. λ&rest. #Cons{@row(a, vs), @tblGo(vs, rest)}}
// one cell per unordered pair {i, j}: the cell holds a_i <= a_j for i < j; for j < i the comparison is the same cell
// read the other way (the keys are a set, 9.1: distinct, so b <= a is the negation of a <= b)
@ltI = λ{#Z: λ{#Z: 0; #S: λ&j. 1}; #S: λ&i. λ{#Z: 0; #S: λ&j. @ltI(i, j)}}
@not = λ{0: 1; 1: 0}
@le = λ&T. λ&i. λ&j. (λ{1: @nth(@nth(T, i), j); 0: @not(@nth(@nth(T, j), i))})(@ltI(i, j))
// 9.2/9.8 the relabelling line over the index tree; 9.6 Sorted through the comparison cells
@rearr = λ{#Leaf: λ&a. #Cons{a, #Nil}; #Node: λ&l. λ&r. @inter(@rearr(l), @rearr(r))}
@inter = λ{#Nil: λ&y. y; #Cons: λ&h. λ&t. λ{#Nil: #Cons{h, t}; #Cons: λ&h2. λ&t2. &(?){#Cons{h, @inter(t, #Cons{h2, t2})}, #Cons{h2, @inter(#Cons{h, t}, t2)}}}}
@sorted = λ&T. λ{#Nil: 1; #Cons: λ&h. λ{#Nil: 1; #Cons: λ&h2. λ&t. (λ{1: @sorted(T, #Cons{h2, t}); 0: 0})(@le(T, h, h2))}}
@keep = λ&T. λ&B. (λ{1: B; 0: &{}})(@sorted(T, B))
@centre = λ{#Cons: λ&h. λ&t. h}
@I4 = #Node{#Node{#Leaf{#Z}, #Leaf{#S{#Z}}}, #Node{#Leaf{#S{#S{#Z}}}, #Leaf{#S{#S{#S{#Z}}}}}}
@I8 = #Node{#Node{#Node{#Leaf{#Z}, #Leaf{#S{#Z}}}, #Node{#Leaf{#S{#S{#Z}}}, #Leaf{#S{#S{#S{#Z}}}}}}, #Node{#Node{#Leaf{#S{#S{#S{#S{#Z}}}}}, #Leaf{#S{#S{#S{#S{#S{#Z}}}}}}}, #Node{#Leaf{#S{#S{#S{#S{#S{#S{#Z}}}}}}}, #Leaf{#S{#S{#S{#S{#S{#S{#S{#Z}}}}}}}}}}}
@J8 = #Node{#Leaf{#Z}, #Node{#Leaf{#S{#Z}}, #Node{#Leaf{#S{#S{#Z}}}, #Node{#Leaf{#S{#S{#S{#Z}}}}, #Node{#Leaf{#S{#S{#S{#S{#Z}}}}}, #Node{#Leaf{#S{#S{#S{#S{#S{#Z}}}}}}, #Node{#Leaf{#S{#S{#S{#S{#S{#S{#Z}}}}}}}, #Leaf{#S{#S{#S{#S{#S{#S{#S{#Z}}}}}}}}}}}}}}}
// whole line cut once
@whole = λ&T. λ&I. %(@keep(T, @rearr(I)))
// per node, each half's fibre read as its centre
@sortC = λ&T. λ{#Leaf: λ&a. #Cons{a, #Nil}; #Node: λ&l. λ&r. ! &c = %(@keep(T, @inter(@sortC(T, l), @sortC(T, r)))); @centre(c)}
// the ledger: the whole line cut once touches every pair (6 of 6, 28 of 28); the declaration posed per node, each
// half's fibre read as its centre, touches 5 at n=4 (merge's 5), 22 on the balanced numeral at n=8 (merge's 17: the
// five extra are comparisons implied through a third element, which the pair cells hold only directly), 20 on the tally
@main = #Pair{%(@keep(@tbl(@vals4), @rearr(@I4))), #Pair{@sortC(@tbl(@vals4), @I4), #Pair{@sortC(@tbl(@vals8), @I8), @sortC(@tbl(@vals8), @J8)}}}
