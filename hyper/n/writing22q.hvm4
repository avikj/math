// The writing type at a node for the 2×2 product with the index posed as the cube it is (9.11), so that every
// symmetry of the product is a relabelling of coordinates and the quotient is the net's own (6.1: relabellings
// discarded by the reading %%). Nothing is derived outside the net: no group, no orbit, no class.
//   The index: A over (ia, ja), B over (jb, kb), C over (kc, ic), six index coordinates (??). A cell's factor is a
//   shape over its slot's pair; its coefficients are choice cells (?): a support bit and on it a sign bit.
//   The orbit: tr(ABC) = Σ A_ij B_jk C_ki is unchanged by (A,B,C) ↦ (B,C,A) and by the swap of both indices of
//   every slot; their composite is the index relabelling g, of order six. The six orbit cells are one cell's
//   shapes carried along g: the same choice cells on the cycled slots, sides swapped where g negates.
//   The fixed cell: one coordinate per orbit of positions under g, the diagonal and the off-diagonal.
//   The equations C = A·B: for every (i,j,j',k,k',i') the sum over the cells of u(i,j)·v(j',k)·w(k',i') is
//   [j=j'][k=k'][i=i']; each value is a face of a shape at its index coordinates. The reading %% at the root
//   projects the choice coordinates through the faces and keeps the index inside the values, identifying two
//   values that are one shape up to a bijection of index coordinates with orientation.
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@map = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{f(h), @map(f, t)}}
@all = λ&f. λ{#Nil: #T; #Cons: λ&h. λ&t. (λ{#T: @all(f, t); #F: #F})(f(h))}
@mulS = λ{#O: λ&y. #O; #P: λ&y. y; #N: λ{#O: #O; #P: #N; #N: #P}}
@addS = λ{#O: λ&y. y; #P: λ{#O: #P; #P: #Big; #N: #O; #Big: #Big}; #N: λ{#O: #N; #P: #O; #N: #Big; #Big: #Big}; #Big: λ&y. #Big}
@eqS = λ{#O: λ{#O: #T; λ&q. #F}; #P: λ{#P: #T; λ&q. #F}; #N: λ{#N: #T; λ&q. #F}; #Big: λ&q. #F}
@cellS = ! &s = ?; ! &g = ?; &(s){#O, &(g){#P, #N}}
// a shape over a slot's pair of index coordinates, and the same shape with both sides swapped (g negates)
@sh  = λ&p. λ&q. λ&a. λ&b. λ&c. λ&d. &(p){&(q){a, b}, &(q){c, d}}
@shN = λ&p. λ&q. λ&a. λ&b. λ&c. λ&d. &(p){&(q){d, c}, &(q){b, a}}
// the value of a factor at an entry: the face of the shape at the two index coordinates
@at = λ&p. λ&q. λ&i. λ&j. λ&x. |(j)(q) (|(i)(p) x)
@bits = #Cons{#F, #Cons{#T, #Nil}}
@eqB = λ{#F: λ{#F: #T; #T: #F}; #T: λ{#T: #T; #F: #F}}
@target = λ&i. λ&j. λ&j2. λ&k. λ&k2. λ&i2. (λ{#T: #P; #F: #O})((λ{#T: λ&r. r; #F: λ&r. #F})(@eqB(j, j2), (λ{#T: λ&r. r; #F: λ&r. #F})(@eqB(k, k2), @eqB(i, i2))))
// the writing: W = (ia, ja, jb, kb, kc, ic, cells); a cell = #W{u, v, w}; the sum at an entry over the cells
@cellAt = λ&ia. λ&ja. λ&jb. λ&kb. λ&kc. λ&ic. λ&i. λ&j. λ&j2. λ&k. λ&k2. λ&i2. λ{#W: λ&u. λ&v. λ&w.
  @mulS(@mulS(@at(ia, ja, i, j, u), @at(jb, kb, j2, k, v)), @at(kc, ic, k2, i2, w))}
@sumAt = λ&cells. λ&f. (λ{#Nil: #O; #Cons: λ&c. λ&rest. @addS(f(c), @sumAt(rest, f))})(cells)
@holds = λ&ia. λ&ja. λ&jb. λ&kb. λ&kc. λ&ic. λ&cells.
  @all(λ&i. @all(λ&j. @all(λ&j2. @all(λ&k. @all(λ&k2. @all(λ&i2.
    @eqS(@sumAt(cells, @cellAt(ia, ja, jb, kb, kc, ic, i, j, j2, k, k2, i2)), @target(i, j, j2, k, k2, i2)), @bits), @bits), @bits), @bits), @bits), @bits)
@writing = ! &ia = ??; ! &ja = ??; ! &jb = ??; ! &kb = ??; ! &kc = ??; ! &ic = ??;
  ! &x = @cellS; ! &y = @cellS;
  ! &a = @cellS; ! &b = @cellS; ! &c = @cellS; ! &d = @cellS;
  ! &e = @cellS; ! &f = @cellS; ! &g = @cellS; ! &h = @cellS;
  ! &k = @cellS; ! &l = @cellS; ! &m = @cellS; ! &n = @cellS;
  ! &cells = #Cons{#W{@sh(ia, ja, x, y, y, x), @sh(jb, kb, x, y, y, x), @sh(kc, ic, x, y, y, x)},
    #Cons{#W{@sh(ia, ja, a, b, c, d),  @sh(jb, kb, e, f, g, h),  @sh(kc, ic, k, l, m, n)},
    #Cons{#W{@shN(ia, ja, k, l, m, n), @shN(jb, kb, a, b, c, d), @shN(kc, ic, e, f, g, h)},
    #Cons{#W{@sh(ia, ja, e, f, g, h),  @sh(jb, kb, k, l, m, n),  @sh(kc, ic, a, b, c, d)},
    #Cons{#W{@shN(ia, ja, a, b, c, d), @shN(jb, kb, e, f, g, h), @shN(kc, ic, k, l, m, n)},
    #Cons{#W{@sh(ia, ja, k, l, m, n),  @sh(jb, kb, a, b, c, d),  @sh(kc, ic, e, f, g, h)},
    #Cons{#W{@shN(ia, ja, e, f, g, h), @shN(jb, kb, k, l, m, n), @shN(kc, ic, a, b, c, d)}, #Nil}}}}}}};
  (λ{#T: cells; #F: &{}})(@holds(ia, ja, jb, kb, kc, ic, cells))
@main = %%(@writing)
