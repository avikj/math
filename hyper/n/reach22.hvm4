#include "classes22.hvm4"
// Are the three classes one under all the verified identities, the per-pair basis change included? A depth-bounded
// search: some word of length at most five in the identities, staying in the alphabet, carrying one
// representative to another. Memory is linear; no orbit is stored.
@reach = λ&t. λ&w. λ{#Z: @eqW(w, t); #S: λ&d. (λ{#T: #T; #F: @any(λ&g. ! &w2 = @map(g, w); (λ{#T: @reach(t, w2, d); #F: #F})(@inW(w2)), @gensAll)})(@eqW(w, t))}
@d5 = #S{#S{#S{#S{#S{#Z}}}}}
@main = ! &ia = ??; ! &ja = ??; ! &jb = ??; ! &kb = ??; ! &kc = ??; ! &ic = ??;
  ! &leaves = @map(@toQ(ia, ja, jb, kb, kc, ic), %%(@writingAt(ia, ja, jb, kb, kc, ic)));
  ! &reps = @map(λ{#Pair: λ&r. λ&o. r}, @classes(leaves));
  (λ{#Cons: λ&r1. λ{#Cons: λ&r2. λ{#Cons: λ&r3. λ&rest. #Pair{@reach(r2, r1, @d5), #Pair{@reach(r3, r1, @d5), @reach(r3, r2, @d5)}}}}})(reps)
