// The writing type at a node, posed as sort is posed (9.15 read for the product): the object is a bilinear map
// given by its monomials φ (the degree-one polynomial product here: (a0 + a1 x)(b0 + b1 x), entries c0, c1, c2).
// A writing of length r is r product cells; a cell is u ⊗ v ⊗ w with u over the a-entries, v over the b-entries,
// w over the c-entries, every coefficient a coordinate: a support bit and, on the support, a sign bit. Nothing
// else is posed: no coefficient table, no method. The equations C = A·B are the faces: an entry (i, j, k) of the
// residual must equal φ's; walked in exclusion order (9.4: the entry that excludes most, i.e. the one with
// one undetermined cell, is taken; one already implied is never made), each equation is a face taken at the
// binder of the one cell it decides, as @sorted takes the face at the coordinate the head comparison names.
// A choice exchanged by a symmetry of what is held is free (9.5): one side is kept, the other is the same point
// relabelled. The first cell is fixed by the symmetry of φ (the swap of the two factors' halves): its support
// and signs are the ones every element of the group carries to themselves. The ledger counts the faces.
@lcat = λ{#Nil: λys. ys; #Cons: λh. λt. λys. #Cons{h, @lcat(t, ys)}}
@lenN = λ{#Nil: #Z; #Cons: λ&h. λ&t. #S{@lenN(t)}}
@map = λ&f. λ{#Nil: #Nil; #Cons: λ&h. λ&t. #Cons{f(h), @map(f, t)}}
@all = λ&f. λ{#Nil: #T; #Cons: λ&h. λ&t. (λ{#T: @all(f, t); #F: #F})(f(h))}
// signs: #O (zero), #P, #N; product and sum of signs where the sum stays in {-1,0,1} or is #Big
@mulS = λ{#O: λ&y. #O; #P: λ&y. y; #N: λ{#O: #O; #P: #N; #N: #P}}
@addS = λ{#O: λ&y. y; #P: λ{#O: #P; #P: #Big; #N: #O; #Big: #Big}; #N: λ{#O: #N; #P: #O; #N: #Big; #Big: #Big}; #Big: λ&y. #Big}
@eqS = λ{#O: λ{#O: #T; λ&q. #F}; #P: λ{#P: #T; λ&q. #F}; #N: λ{#N: #T; λ&q. #F}; #Big: λ&q. #F}
// a coordinate cell: its value is a path over support, and on the support over the sign
@cell = ! &s = ?; ! &g = ?; &(s){#O, &(g){#P, #N}}
// a known cell (fixed by the symmetry, or decided by a face)
@known = λ&v. v
// the monomials of φ: (i, j, k) with i + j = k, the degree-one product
@phi = #Cons{#M{#I0, #J0, #K0}, #Cons{#M{#I0, #J1, #K1}, #Cons{#M{#I1, #J0, #K1}, #Cons{#M{#I1, #J1, #K2}, #Nil}}}}
@entries = #Cons{#M{#I0, #J0, #K0}, #Cons{#M{#I0, #J0, #K1}, #Cons{#M{#I0, #J0, #K2}, #Cons{#M{#I0, #J1, #K0}, #Cons{#M{#I0, #J1, #K1}, #Cons{#M{#I0, #J1, #K2},
  #Cons{#M{#I1, #J0, #K0}, #Cons{#M{#I1, #J0, #K1}, #Cons{#M{#I1, #J0, #K2}, #Cons{#M{#I1, #J1, #K0}, #Cons{#M{#I1, #J1, #K1}, #Cons{#M{#I1, #J1, #K2}, #Nil}}}}}}}}}}}}
@target = λ{#M: λ&i. λ&j. λ&k. (λ{#I0: λ{#J0: λ{#K0: #P; λ&z. #O}; #J1: λ{#K1: #P; λ&z. #O}}; #I1: λ{#J0: λ{#K1: #P; λ&z. #O}; #J1: λ{#K2: #P; λ&z. #O}}})(i, j, k)}
// a cell u ⊗ v ⊗ w read at an entry
@at = λ{#W: λ&u. λ&v. λ&w. λ{#M: λ&i. λ&j. λ&k. @mulS(@mulS(@ui(u, i), @vj(v, j)), @wk(w, k))}}
@ui = λ{#U: λ&a. λ&b. λ{#I0: a; #I1: b}}
@vj = λ{#V: λ&a. λ&b. λ{#J0: a; #J1: b}}
@wk = λ{#Wc: λ&a. λ&b. λ&c. λ{#K0: a; #K1: b; #K2: c}}
// the residual at an entry over the writing
@sum = λ&W. λ&m. (λ{#Nil: #O; #Cons: λ&c. λ&rest. @addS(@at(c, m), @sum(rest, m))})(W)
// the face: the equation at an entry holds, or the side is erased
@face = λ&W. λ&m. λ&rest. (λ{#T: rest; #F: &{}})(@eqS(@sum(W, m), @target(m)))
@decl = λ&W. λ{#Nil: W; #Cons: λ&m. λ&ms. @face(W, m, @decl(W, ms))}
// THE WRITING, length 3, posed as the symmetry leaves it (6.1: the relabellings discarded):
//   the swap σ (a0↔a1, b0↔b1, c0↔c2) is the symmetry of φ; one cell is fixed by σ: its u is (x, x), v is (y, y),
//   w is (z, t, z), x = y = + by the scaling (first nonzero of u and v positive), so only z, t are coordinates;
//   the other two cells are one σ-orbit: the second is the image of the first, so only the first's twelve
//   coordinates... no: the first's u is read as its class under σ: u = (p, q) with the swap identifying (p,q)~(q,p)
//   and the scaling fixing the first nonzero positive, and v, w then decided by the faces.
// the cell fixed by the swap: (x, x) ⊗ (y, y) ⊗ (z, t, z), x = y = + by the scaling. Its w is a choice the
// substitutions exchange (below: x ↦ 1−x carries the cell at 1 to the cell at 0 and back), so it is free (9.5):
// one representative is kept, the evaluation at 1, w = (0, +, 0).
@fixedCell = #W{#U{#P, #P}, #V{#P, #P}, #Wc{#O, #P, #O}}
// the orbit cell's v as its class under the scaling (negating v and w together is the same cell): (+, v1) or (0, +)
@orbitCell = λ&p. λ&q. ! &v1 = @cell; ! &w0 = @cell; ! &w1 = @cell; ! &w2 = @cell; ! &s = ?;
  #W{#U{p, q}, &(s){#V{#P, v1}, #V{#O, #P}}, #Wc{w0, w1, w2}}
@swapCell = λ{#W: λ{#U: λ&a. λ&b. λ{#V: λ&c. λ&d. λ{#Wc: λ&e. λ&f. λ&g. #W{#U{b, a}, #V{d, c}, #Wc{g, f, e}}}}}}
// the first cell's u as its class: (+, q) with q a coordinate (the swap carries (q,+) to (+,q): one side kept),
// or (0, +) (the swap carries (+,0) to (0,+): one side kept)
@writing = ! &q = @cell; ! &c1 = @orbitCell(#P, q); #Cons{@fixedCell, #Cons{c1, #Cons{@swapCell(c1), #Nil}}}
// substitutions as identities of the polynomial product: x ↦ 1−x, x ↦ 1/x (reversal), x ↦ −x. A cell's u is a
// functional on a (u·a = a0 u0 + a1 u1, evaluation at a point), so a substitution σ acts on it by u ↦ u∘σ*: for
// 1−x, (u0, u1) ↦ (u0, u0 − u1); on w, a vector of c-coefficients, by the degree-two coefficient map of σ:
// (w0, w1, w2) ↦ (w0 + w1 + w2, −w1 − 2 w2, w2). The images are writings of φ again, which the faces check
// (8.6, decide = verify): the three cells of the point are evaluations at 0, 1, ∞, one orbit of these.
@shU = λ{#U: λ&a. λ&b. #U{a, @addS(a, @mulS(#N, b))}}
@shV = λ{#V: λ&a. λ&b. #V{a, @addS(a, @mulS(#N, b))}}
@shW = λ{#Wc: λ&a. λ&b. λ&c. #Wc{@addS(@addS(a, b), c), @addS(@addS(@mulS(#N, b), @mulS(#N, c)), @mulS(#N, c)), c}}
@negU = λ{#U: λ&a. λ&b. #U{a, @mulS(#N, b)}}
@negV = λ{#V: λ&a. λ&b. #V{a, @mulS(#N, b)}}
@negW = λ{#Wc: λ&a. λ&b. λ&c. #Wc{a, @mulS(#N, b), c}}
@revU = λ{#U: λ&a. λ&b. #U{b, a}}
@revV = λ{#V: λ&a. λ&b. #V{b, a}}
@revW = λ{#Wc: λ&a. λ&b. λ&c. #Wc{c, b, a}}
@onCell = λ&fu. λ&fv. λ&fw. λ{#W: λ&u. λ&v. λ&w. #W{fu(u), fv(v), fw(w)}}
@oneMinus = λ&W. @map(@onCell(@shU, @shV, @shW), W)
@negate = λ&W. @map(@onCell(@negU, @negV, @negW), W)
@reverse = λ&W. @map(@onCell(@revU, @revV, @revW), W)
// the faces hold on the image: the substitution is an identity of the object, its proof carried
@holds = λ&W. @all(λ&m. @eqS(@sum(W, m), @target(m)), @entries)
@point = λ{#Cons: λ&W. λ&rest. W}
@main = ! &W = @point(%(@decl(@writing, @entries)));
  #Pair{W, #Pair{#Pair{@holds(@oneMinus(W)), @oneMinus(W)}, #Pair{#Pair{@holds(@reverse(W)), @reverse(W)}, #Pair{@holds(@negate(W)), @negate(W)}}}}
