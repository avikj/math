// sort, as its type, for n = 3:  y = x ∘ σ  (the fibre of the multiset projection)  and  y ordered.
// Values are points of a four-element order; a value is the selector of its position.
T = \t \f t;
F = \t \f f;
v0 = \a \b \c \d a;
v1 = \a \b \c \d b;
v2 = \a \b \c \d c;
v3 = \a \b \c \d d;
le = \u \w (u (w T T T T) (w F T T T) (w F F T T) (w F F F T));
and = \p \q (p q F);
and = \p \q (p q F);
x = \k (k v2 v0 v3);

// the same fibre and the same cut, with each comparison between two positions one term, shared by every
// relabelling that asks it (what "every isomorphic subterm is one cell" gives, written by hand)
main = (x \a \b \c
  let ab = (le a b); let ba = (le b a); let ac = (le a c);
  let ca = (le c a); let bc = (le b c); let cb = (le c b);
  let A = (and ab bc); let B = (and ac cb); let C = (and ba ac);
  let D = (and bc ca); let E = (and ca ab); let G = (and cb ba);
  {{(A \k (k a b c) *) (B \k (k a c b) *)}#r {{(C \k (k b a c) *) (D \k (k b c a) *)}#s {(E \k (k c a b) *) (G \k (k c b a) *)}#t}#u}#v);
