;; MAP §0: the declaration is the program.  Over the numeric kind: a comparison is one op2 interaction and the
;; ledger counts exactly the comparisons.  The book holds the specification's vocabulary only — leq (the machine's
;; comparison), sorted, perm — and lists.  sort has a type and no body: Π A. Σ B. (perm A B ≡ True) × (sorted B ≡ True).
;; The point is resolved by the arrangement census (verify.c arrangement_point, cell.c arrange_sigma): the index
;; set's binary structure splits A by halves, each half is the same declaration, two resolved halves compose by
;; the one comparison the specification leaves open — which head takes the next index, `sorted` on that pair —
;; so every comparison assigns an index.  Nothing is written for sorting.
(def leq : (ctr Pi (ctr Num (ctr &U64)) (lam a (ctr Pi (ctr Num (ctr &U64)) (lam b (ctr Bool))))) = (lam a (lam b (op2 <= a b))))
(def sorted : (ctr Pi (ctr List (ctr Num (ctr &U64))) (lam l (ctr Bool))) = (fix f (lam l (case l (Nil () (ctr True)) (Cons (h t) (case t (Nil () (ctr True)) (Cons (h2 t2) (case (app leq h h2) (True () (app f t)) (False () (ctr False))))))))))
(def eqn : (ctr Pi (ctr Num (ctr &U64)) (lam a (ctr Pi (ctr Num (ctr &U64)) (lam b (ctr Bool))))) = (lam a (lam b (op2 == a b))))
(def remove : (ctr Pi (ctr Num (ctr &U64)) (lam x (ctr Pi (ctr List (ctr Num (ctr &U64))) (lam l (ctr Sig (ctr Bool) (lam found (ctr List (ctr Num (ctr &U64))))))))) = (fix f (lam x (lam l (case l (Nil () (ctr Pair (ctr False) (ctr Nil))) (Cons (h t) (case (app eqn x h) (True () (ctr Pair (ctr True) t)) (False () (case (app f x t) (Pair (fd r) (ctr Pair fd (ctr Cons h r))))))))))))
(def perm : (ctr Pi (ctr List (ctr Num (ctr &U64))) (lam a (ctr Pi (ctr List (ctr Num (ctr &U64))) (lam b (ctr Bool))))) = (fix f (lam a (lam b (case a (Nil () (case b (Nil () (ctr True)) (Cons (h t) (ctr False)))) (Cons (h t) (case (app remove h b) (Pair (fd r) (case fd (True () (app f t r)) (False () (ctr False)))))))))))
(def sort : (ctr Pi (ctr List (ctr Num (ctr &U64))) (lam A (ctr Sig (ctr List (ctr Num (ctr &U64))) (lam B (ctr Sig (ctr Eql (ctr Bool) (app perm A B) (ctr True)) (lam q (ctr Eql (ctr Bool) (app sorted B) (ctr True)))))))))
(def A : (ctr List (ctr Num (ctr &U64))) = (ctr Cons (num 3) (ctr Cons (num 1) (ctr Cons (num 2) (ctr Nil)))))
(def sort-A (app sort A))
