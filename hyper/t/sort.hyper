; sort's two charts at A (fibre/src/Fibre/Carrier.agda).  Peano naturals; isort, and sorted: each element no
; greater than the next.
(def leq (fix f (lam a (lam b (case a (Zer () (ctr True)) (Suc (a1) (case b (Zer () (ctr False)) (Suc (b1) (app f a1 b1)))))))))
(def insert (fix f (lam x (lam l (case l (Nil () (ctr Cons x (ctr Nil))) (Cons (h t) (case (app leq x h) (True () (ctr Cons x l)) (False () (ctr Cons h (app f x t))))))))))
(def isort (fix f (lam l (case l (Nil () (ctr Nil)) (Cons (h t) (app insert h (app f t)))))))
(def sorted (fix f (lam l (case l (Nil () (ctr True)) (Cons (h t) (case t (Nil () (ctr True)) (Cons (h2 t2) (case (app leq h h2) (True () (app f t)) (False () (ctr False))))))))))
(def one (ctr Suc (ctr Zer)))
(def two (ctr Suc one))
(def three (ctr Suc two))
(def A (ctr Cons three (ctr Cons one (ctr Cons two (ctr Nil)))))
; step 6: the chart move under a checked path (fibre/src/Fibre/Carrier.agda).  The cheap chart is Carrier isort:
; a list with its image under isort and the witness.  descend a = (a, isort a, refl); ascend c = base c; the two
; round trips make an iso, and isoToEquiv (prelude) makes it an equivalence.  Transport along its ua is descend
; (uaβ), so B, the carried image, is the specification's point, and the specification checks at B (b/sort_at_A).
(def carrier-ty (ctr Sig (ctr List (ctr Nat)) (lam a (ctr Sig (ctr List (ctr Nat)) (lam b (ctr Path (lam _ (ctr List (ctr Nat))) (app isort a) b))))))
(def descend-isort (lam a (ctr Pair a (ctr Pair (app isort a) (plm _ (app isort a))))))
(def ascend-isort (lam c (proj 0 c)))
(def descend-ascend-isort (lam c (case c (Pair (a r) (case r (Pair (b w) (plm i (ctr Pair a (ctr Pair (app w i) (plm j (app w (iand i j))))))))))))
(def ascend-descend-isort (lam a (plm _ a)))
(def carrier-equiv (iso-to-equiv (ctr List (ctr Nat)) carrier-ty descend-isort ascend-isort descend-ascend-isort ascend-descend-isort))
(def chart-move (proj 0 (proj 1 (trp (ua (ctr List (ctr Nat)) carrier-ty carrier-equiv) i0 i1 A))))
(def b/sort_at_A : (ctr Sig (ctr List (ctr Nat)) (lam B (ctr Sig (ctr Eql (ctr List (ctr Nat)) (app isort A) (app isort B)) (lam q (ctr Eql (ctr Bool) (app sorted B) (ctr True))))))
  = (ctr Pair (ref chart-move) (ctr Pair (ctr Refl) (ctr Refl))))
