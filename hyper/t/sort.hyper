; sort's two charts at A (fibre/src/Fibre/Carrier.agda).  Peano naturals; isort, and sorted: each element no
; greater than the next.
(def leq : (ctr Pi (ctr Nat) (lam a (ctr Pi (ctr Nat) (lam b (ctr Bool)))))
  = (fix f (lam a (lam b (case a (Zer () (ctr True)) (Suc (a1) (case b (Zer () (ctr False)) (Suc (b1) (app f a1 b1)))))))))
(def insert : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr List (ctr Nat)) (lam l (ctr List (ctr Nat))))))
  = (fix f (lam x (lam l (case l (Nil () (ctr Cons x (ctr Nil))) (Cons (h t) (case (app leq x h) (True () (ctr Cons x l)) (False () (ctr Cons h (app f x t))))))))))
(def isort : (ctr Pi (ctr List (ctr Nat)) (lam l (ctr List (ctr Nat))))
  = (fix f (lam l (case l (Nil () (ctr Nil)) (Cons (h t) (app insert h (app f t)))))))
(def sorted : (ctr Pi (ctr List (ctr Nat)) (lam l (ctr Bool)))
  = (fix f (lam l (case l (Nil () (ctr True)) (Cons (h t) (case t (Nil () (ctr True)) (Cons (h2 t2) (case (app leq h h2) (True () (app f t)) (False () (ctr False))))))))))
(def one : (ctr Nat)
  = (ctr Suc (ctr Zer)))
(def two : (ctr Nat)
  = (ctr Suc one))
(def three : (ctr Nat)
  = (ctr Suc two))
(def A : (ctr List (ctr Nat))
  = (ctr Cons three (ctr Cons one (ctr Cons two (ctr Nil)))))
; step 6: the chart move under a checked path (fibre/src/Fibre/Carrier.agda).  The cheap chart is Carrier isort:
; a list with its image under isort and the witness.  descend a = (a, isort a, refl); ascend c = base c; the two
; round trips make an iso, and isoToEquiv (prelude) makes it an equivalence.  Transport along its ua is descend
; (uaβ), so B, the carried image, is the specification's point, and the specification checks at B (b/sort_at_A).
(def carrier-ty : (ctr Set)
  = (ctr Sig (ctr List (ctr Nat)) (lam a (ctr Sig (ctr List (ctr Nat)) (lam b (ctr Path (lam _ (ctr List (ctr Nat))) (app isort a) b))))))
(def descend-isort : (ctr Pi (ctr List (ctr Nat)) (lam a carrier-ty))
  = (lam a (ctr Pair a (ctr Pair (app isort a) (plm _ (app isort a))))))
(def ascend-isort : (ctr Pi carrier-ty (lam c (ctr List (ctr Nat))))
  = (lam c (proj 0 c)))
(def descend-ascend-isort : (ctr Pi carrier-ty (lam y (ctr Path (lam _ carrier-ty) (descend-isort (ascend-isort y)) y)))
  = (lam c (case c (Pair (a r) (case r (Pair (b w) (plm i (ctr Pair a (ctr Pair (app w i) (plm j (app w (iand i j))))))))))))
(def ascend-descend-isort : (ctr Pi (ctr List (ctr Nat)) (lam x (ctr Path (lam _ (ctr List (ctr Nat))) (ascend-isort (descend-isort x)) x)))
  = (lam a (plm _ a)))
(def carrier-equiv : (Equiv-ty (ctr List (ctr Nat)) carrier-ty)
  = (iso-to-equiv (ctr List (ctr Nat)) carrier-ty descend-isort ascend-isort descend-ascend-isort ascend-descend-isort))
(def chart-move : (ctr List (ctr Nat))
  = (proj 0 (proj 1 (trp (ua (ctr List (ctr Nat)) carrier-ty carrier-equiv) i0 i1 A))))
(def b/sort_at_A : (ctr Sig (ctr List (ctr Nat)) (lam B (ctr Sig (ctr Eql (ctr List (ctr Nat)) (app isort A) (app isort B)) (lam q (ctr Eql (ctr Bool) (app sorted B) (ctr True))))))
  = (ctr Pair (ref chart-move) (ctr Pair (ctr Refl) (ctr Refl))))
(def b/sort_spec : (ctr Sig (ctr List (ctr Nat)) (lam B (ctr Sig (ctr Eql (ctr List (ctr Nat)) (app isort A) (app isort B)) (lam q (ctr Eql (ctr Bool) (app sorted B) (ctr True)))))))
; MAP §0: the declaration is the program.  sort, with no body: at any A the runtime produces B from the book,
; the proofs by refl at the point — the fibre's point read off the book by the type's shape (the census at the
; point of demand), with isort and sorted in the book as data, no organ.
(def sort : (ctr Pi (ctr List (ctr Nat)) (lam A (ctr Sig (ctr List (ctr Nat)) (lam B (ctr Sig (ctr Eql (ctr List (ctr Nat)) (app isort A) (app isort B)) (lam q (ctr Eql (ctr Bool) (app sorted B) (ctr True)))))))))
(def A2 : (ctr List (ctr Nat))
  = (ctr Cons two (ctr Cons three (ctr Cons one (ctr Cons (ctr Zer) (ctr Nil))))))
(def sort-A  (app sort A))
(def sort-A2 (app sort A2))

; ===== the identities for the generic sort: sorted (isort A) ≡ True and isort A ≡ isort (isort A) =====
(def b/eql-sym : (ctr Pi (ctr Set) (lam X (ctr Pi X (lam u (ctr Pi X (lam v (ctr Pi (ctr Eql X u v) (lam p (ctr Eql X v u)))))))))
  = (lam X (lam u (lam v (lam p (case p (Refl () (ctr Refl))))))))
(def b/leq-total : (ctr Pi (ctr Nat) (lam a (ctr Pi (ctr Nat) (lam b (ctr Pi (ctr Eql (ctr Bool) (app leq a b) (ctr False)) (lam p (ctr Eql (ctr Bool) (app leq b a) (ctr True))))))))
  = (fix f (lam a (lam b (lam p (case a (Zer () (case p)) (Suc (a1) (case b (Zer () (ctr Refl)) (Suc (b1) (app f a1 b1 p))))))))))
(def b/sorted-head' : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Bool) (lam b (ctr Pi (ctr Eql (ctr Bool) (app leq h h2) b) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h (ctr Cons h2 t2))) (ctr True)) (lam p (ctr Eql (ctr Bool) (app leq h h2) (ctr True))))))))))))))
  = (lam h (lam h2 (lam t2 (lam b (lam q (lam p (case b (True () q) (False () (case q (Refl () (case p))))))))))))
(def b/sorted-head : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h (ctr Cons h2 t2))) (ctr True)) (lam p (ctr Eql (ctr Bool) (app leq h h2) (ctr True))))))))))
  = (lam h (lam h2 (lam t2 (lam p (app b/sorted-head' h h2 t2 (app leq h h2) (ctr Refl) p))))))
(def b/sorted-tail' : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Bool) (lam b (ctr Pi (ctr Eql (ctr Bool) (app leq h h2) b) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h (ctr Cons h2 t2))) (ctr True)) (lam p (ctr Eql (ctr Bool) (app sorted (ctr Cons h2 t2)) (ctr True))))))))))))))
  = (lam h (lam h2 (lam t2 (lam b (lam q (lam p (case b (True () (case q (Refl () p))) (False () (case q (Refl () (case p))))))))))))
(def b/sorted-tail : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h t)) (ctr True)) (lam p (ctr Eql (ctr Bool) (app sorted t) (ctr True))))))))
  = (lam h (lam t (lam p (case t (Nil () (ctr Refl)) (Cons (h2 t2) (app b/sorted-tail' h h2 t2 (app leq h h2) (ctr Refl) p)))))))
(def b/sorted2 : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr Eql (ctr Bool) (app leq x h) (ctr True)) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h t)) (ctr True)) (lam s (ctr Eql (ctr Bool) (app sorted (ctr Cons x (ctr Cons h t))) (ctr True))))))))))))
  = (lam x (lam h (lam t (lam q (lam s (case q (Refl () s))))))))
(def b/sorted3 : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Eql (ctr Bool) (app leq h x) (ctr True)) (lam r (ctr Pi (ctr Eql (ctr Bool) (app leq x h2) (ctr True)) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h2 t2)) (ctr True)) (lam st (ctr Eql (ctr Bool) (app sorted (ctr Cons h (ctr Cons x (ctr Cons h2 t2)))) (ctr True))))))))))))))))
  = (lam h (lam x (lam h2 (lam t2 (lam r (lam q (lam st (case r (Refl () (case q (Refl () st))))))))))))
(def b/ins-nil : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Eql (ctr Bool) (app leq h x) (ctr True)) (lam r (ctr Eql (ctr Bool) (app sorted (ctr Cons h (ctr Cons x (ctr Nil)))) (ctr True))))))))
  = (lam x (lam h (lam r (case r (Refl () (ctr Refl)))))))
(def b/ins-cons : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Bool) (lam b (ctr Pi (ctr Eql (ctr Bool) (app leq x h2) b) (lam q (ctr Pi (ctr Eql (ctr Bool) (app leq h x) (ctr True)) (lam r (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h2 t2)) (ctr True)) (lam st (ctr Pi (ctr Eql (ctr Bool) (app leq h h2) (ctr True)) (lam hh (ctr Pi (ctr Pi (ctr Eql (ctr Bool) (app leq x h2) (ctr False)) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h2 t2)) (ctr True)) (lam st (ctr Eql (ctr Bool) (app sorted (ctr Cons h2 (app insert x t2))) (ctr True)))))) (lam ih (ctr Eql (ctr Bool) (app sorted (ctr Cons h (app insert x (ctr Cons h2 t2)))) (ctr True))))))))))))))))))))))
  = (lam x (lam h (lam h2 (lam t2 (lam b (lam q (lam r (lam st (lam hh (lam ih (case b (True () (case q (Refl () (app b/sorted3 h x h2 t2 r (ctr Refl) st)))) (False () (case q (Refl () (case hh (Refl () (app ih (ctr Refl) st))))))))))))))))))
(def b/insert-sorted : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr Eql (ctr Bool) (app leq x h) (ctr False)) (lam p (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h t)) (ctr True)) (lam s (ctr Eql (ctr Bool) (app sorted (ctr Cons h (app insert x t))) (ctr True))))))))))))
  = (fix f (lam x (lam h (lam t (lam p (lam s (case t (Nil () (app b/ins-nil x h (app b/leq-total x h p))) (Cons (h2 t2) (app b/ins-cons x h h2 t2 (app leq x h2) (ctr Refl) (app b/leq-total x h p) (app b/sorted-tail h (ctr Cons h2 t2) s) (app b/sorted-head h h2 t2 s) (lam q (lam st (app f x h2 t2 q st)))))))))))))
(def b/ins-any' : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr Bool) (lam b (ctr Pi (ctr Eql (ctr Bool) (app leq x h) b) (lam q (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h t)) (ctr True)) (lam s (ctr Pi (ctr Pi (ctr Eql (ctr Bool) (app leq x h) (ctr False)) (lam p (ctr Eql (ctr Bool) (app sorted (ctr Cons h (app insert x t))) (ctr True)))) (lam isf (ctr Eql (ctr Bool) (app sorted (app insert x (ctr Cons h t))) (ctr True))))))))))))))))
  = (lam x (lam h (lam t (lam b (lam q (lam s (lam isf (case b (True () (case q (Refl () (app b/sorted2 x h t (ctr Refl) s)))) (False () (case q (Refl () (app isf (ctr Refl))))))))))))))
(def b/ins-any : (ctr Pi (ctr Nat) (lam x (ctr Pi (ctr List (ctr Nat)) (lam l (ctr Pi (ctr Eql (ctr Bool) (app sorted l) (ctr True)) (lam s (ctr Eql (ctr Bool) (app sorted (app insert x l)) (ctr True))))))))
  = (lam x (lam l (lam s (case l (Nil () (ctr Refl)) (Cons (h t) (app b/ins-any' x h t (app leq x h) (ctr Refl) s (lam p (app b/insert-sorted x h t p s)))))))))
(def b/isort-sorted : (ctr Pi (ctr List (ctr Nat)) (lam l (ctr Eql (ctr Bool) (app sorted (app isort l)) (ctr True))))
  = (fix f (lam l (case l (Nil () (ctr Refl)) (Cons (h t) (app b/ins-any h (app isort t) (app f t)))))))
(def b/ins-head' : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr Nat) (lam h2 (ctr Pi (ctr List (ctr Nat)) (lam t2 (ctr Pi (ctr Eql (ctr Bool) (app leq h h2) (ctr True)) (lam r (ctr Eql (ctr List (ctr Nat)) (app insert h (ctr Cons h2 t2)) (ctr Cons h (ctr Cons h2 t2)))))))))))
  = (lam h (lam h2 (lam t2 (lam r (case r (Refl () (ctr Refl))))))))
(def b/ins-head : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr Eql (ctr Bool) (app sorted (ctr Cons h t)) (ctr True)) (lam s (ctr Eql (ctr List (ctr Nat)) (app insert h t) (ctr Cons h t))))))))
  = (lam h (lam t (lam s (case t (Nil () (ctr Refl)) (Cons (h2 t2) (app b/ins-head' h h2 t2 (app b/sorted-head h h2 t2 s))))))))
(def b/fixed' : (ctr Pi (ctr Nat) (lam h (ctr Pi (ctr List (ctr Nat)) (lam t (ctr Pi (ctr List (ctr Nat)) (lam u (ctr Pi (ctr Eql (ctr List (ctr Nat)) u t) (lam e (ctr Pi (ctr Eql (ctr List (ctr Nat)) (app insert h t) (ctr Cons h t)) (lam ih (ctr Eql (ctr List (ctr Nat)) (app insert h u) (ctr Cons h t))))))))))))
  = (lam h (lam t (lam u (lam e (lam ih (case e (Refl () ih))))))))
(def b/isort-fixed : (ctr Pi (ctr List (ctr Nat)) (lam l (ctr Pi (ctr Eql (ctr Bool) (app sorted l) (ctr True)) (lam s (ctr Eql (ctr List (ctr Nat)) (app isort l) l)))))
  = (fix f (lam l (lam s (case l (Nil () (ctr Refl)) (Cons (h t) (app b/fixed' h t (app isort t) (app f t (app b/sorted-tail h t s)) (app b/ins-head h t s))))))))
(def b/isort-idem : (ctr Pi (ctr List (ctr Nat)) (lam A (ctr Eql (ctr List (ctr Nat)) (app isort A) (app isort (app isort A)))))
  = (lam A (app b/eql-sym (ctr List (ctr Nat)) (app isort (app isort A)) (app isort A) (app b/isort-fixed (app isort A) (app b/isort-sorted A)))))
; sortCost: over Peano naturals leq a b costs min(a,b)+1 interactions, so the cost of sorting a list of fixed
; length is unbounded in its values: the greatest cost has no point — the fibre is empty
(def B1 : (ctr List (ctr Nat)) = (ctr Cons (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Zer)))))) (ctr Cons (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Zer))))) (ctr Nil))))
(def ten : (ctr Nat) = (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Suc (ctr Zer))))))))))))
(def plus : (ctr Pi (ctr Nat) (lam a (ctr Pi (ctr Nat) (lam b (ctr Nat))))) = (fix f (lam a (lam b (case a (Zer () b) (Suc (a1) (ctr Suc (app f a1 b))))))))
(def B2 : (ctr List (ctr Nat)) = (ctr Cons (app plus ten (app plus ten (app plus ten (app plus ten (app plus ten (ctr Zer)))))) (ctr Cons (app plus ten (app plus ten (app plus ten (app plus ten (ctr Zer))))) (ctr Nil))))
(def sort-B1 (app sort B1))
(def sort-B2 (app sort B2))
