; §3.3 erase at the projection: nothing is erased inside a run; a forgotten port costs one row where it is forgotten.
; The fibre's size never enters: `big` is never demanded, so its cost is the one port that drops it.

(def two (lam f (lam x (app f (app f x)))))
(def suc (lam n (ctr Suc n)))
(def big (app (ref two) (ref two) (ref two) (ref suc) (ctr Zer)))
(def and (lam x (lam y (case x (False () (ctr False)) (True () y)))))

(def fst-big (proj 0 (ctr Pair 1 (ref big))))                ; case 1 + erase 1 (the second field's port)
(def and-f   (app (ref and) (ctr False) (ref big)))          ; beta 2 + case 1 + erase 1 (y, read only by the dropped branch)
(def and-t   (app (ref and) (ctr True) (ctr True)))          ; beta 2 + case 1, nothing forgotten
(def const   (app (lam x 7) (ref big)))                      ; beta 1 + erase 1 (the binder is never read)
(def dflt    (case (ctr Pair 1 2) (_ () 3)))                 ; case 1 + erase 2 (the default branch drops both fields)
(def carry   (case (ctr Pair 1 (ref big)) (Pair (a b) a)))   ; case 1 + erase 1 (b is bound and never read)
