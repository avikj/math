; a superposition is a line; a face map picks a side (annihilate)
(def pick0 (dim L (fce L 0 (sup L 1 2))))
(def pick1 (dim L (fce L 1 (sup L 1 2))))
; two instances of one definition never share a name: the face map at M passes inside
(def pair (lam x (sup L x (ctr Suc x))))
(def nocapture (dim M (fce M 1 (app pair 5))))
; application distributes over a superposed function, the argument face-mapped at the same name
(def dist (app (sup L (lam x (ctr Suc x)) (lam x (ctr Suc (ctr Suc x)))) 5))
; a match commutes over a superposition
(def not (lam b (case b (True () (ctr False)) (False () (ctr True)))))
(def matchsup (app not (sup L (ctr True) (ctr False))))
(def main (ctr Pair pick0 pick1))
; a redex held by both sides of a distribution fires once: `times 3 4` is one computation, not one per side (§3: a demanded port fires once)
(def plus (fix f (lam m (lam n (case m (Zer () n) (Suc (k) (ctr Suc (app f k n))))))))
(def times (fix f (lam m (lam n (case m (Zer () (ctr Zer)) (Suc (k) (app plus n (app f k n))))))))
(def shared-redex (dim L (app plus (sup L 1 2) (app times 3 4))))
