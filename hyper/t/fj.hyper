; merge-insertion (Ford–Johnson): the chart whose worst case is ceil(log2 n!) comparisons for n <= 11 — optimal there;
; for n >= 12 no comparison sort meets that bound (S(12) = 30 > 29).  Values are the numeric kind, so a comparison
; is one op2 interaction and the ledger counts exactly the comparisons; every counter is Peano (no op2).
(def tokv (lam t (case t (Tok (v p) v))))
(def eltv (lam e (case e (Elt (v p t) v))))
(def pairs (fix f (lam l (case l (Nil () (ctr Pair (ctr Nil) (ctr None))) (Cons (x r) (case r (Nil () (ctr Pair (ctr Nil) (ctr Some x))) (Cons (y r2) (case (app f r2) (Pair (ps odd) (case (op2 <= (app tokv x) (app tokv y)) (True () (ctr Pair (ctr Cons (ctr Pr y x) ps) odd)) (False () (ctr Pair (ctr Cons (ctr Pr x y) ps) odd))))))))))))
(def wrap (fix f (lam ps (case ps (Nil () (ctr Nil)) (Cons (pr r) (case pr (Pr (b s) (case b (Tok (v p) (ctr Cons (ctr Tok v (ctr Pair p s)) (app f r)))))))))))
(def unwrap (fix f (lam i (lam ts (case ts (Nil () (ctr Pair (ctr Nil) (ctr Nil))) (Cons (t r) (case t (Elt (v pp tg) (case pp (Pair (p s) (case (app f (ctr Suc i) r) (Pair (chain smalls) (ctr Pair (ctr Cons (ctr Elt v p (ctr Main i)) chain) (ctr Cons s smalls))))))))))))))
(def splitAt (fix f (lam k (lam l (case k (Zer () (ctr Pair (ctr Nil) l)) (Suc (k1) (case l (Nil () (ctr Pair (ctr Nil) (ctr Nil))) (Cons (h r) (case (app f k1 r) (Pair (a b) (ctr Pair (ctr Cons h a) b)))))))))))
(def len (fix f (lam l (case l (Nil () (ctr Zer)) (Cons (h r) (ctr Suc (app f r)))))))
(def half (fix f (lam n (case n (Zer () (ctr Zer)) (Suc (m) (case m (Zer () (ctr Zer)) (Suc (m2) (ctr Suc (app f m2)))))))))
(def cat (fix f (lam a (lam b (case a (Nil () b) (Cons (h r) (ctr Cons h (app f r b))))))))
(def bins (fix f (lam e (lam l (case l (Nil () (ctr Cons e (ctr Nil))) (Cons (h r) (case (app splitAt (app half (app len l)) l) (Pair (left rest) (case rest (Nil () (ctr Cons e l)) (Cons (piv right) (case (op2 <= (app eltv e) (app eltv piv)) (True () (app cat (app f e left) (ctr Cons piv right))) (False () (app cat left (ctr Cons piv (app f e right)))))))))))))))
(def eqNat (fix f (lam a (lam b (case a (Zer () (case b (Zer () (ctr True)) (Suc (b1) (ctr False)))) (Suc (a1) (case b (Zer () (ctr False)) (Suc (b1) (app f a1 b1)))))))))
(def leqNat (fix f (lam a (lam b (case a (Zer () (ctr True)) (Suc (a1) (case b (Zer () (ctr False)) (Suc (b1) (app f a1 b1)))))))))
(def posOf (fix f (lam i (lam l (case l (Nil () (ctr Zer)) (Cons (e r) (case e (Elt (v p t) (case t (Main (j) (case (app eqNat i j) (True () (ctr Zer)) (False () (ctr Suc (app f i r))))) (Ins () (ctr Suc (app f i r))))))))))))
(def insertB (lam s (lam i (lam chain (case (app splitAt (app posOf i chain) chain) (Pair (pre post) (app cat (app bins (case s (Tok (v p) (ctr Elt v p (ctr Ins)))) pre) post)))))))
(def nth (fix f (lam i (lam l (case i (Zer () (ctr None)) (Suc (ia) (case l (Nil () (ctr None)) (Cons (h r) (case ia (Zer () (ctr Some h)) (Suc (ib) (app f ia r)))))))))))
(def plus (fix f (lam a (lam b (case a (Zer () b) (Suc (a1) (ctr Suc (app f a1 b))))))))
(def pred (lam n (case n (Zer () (ctr Zer)) (Suc (m) m))))
(def minNat (lam a (lam b (case (app leqNat a b) (True () a) (False () b)))))
(def downFrom (fix f (lam hi (lam lo (case (app leqNat hi lo) (True () (ctr Nil)) (False () (ctr Cons hi (app f (app pred hi) lo))))))))
(def sched (fix f (lam M (lam tprev (lam tcur (case (app leqNat M tprev) (True () (ctr Nil)) (False () (app cat (app downFrom (app minNat tcur M) tprev) (app f M tcur (app plus tcur (app plus tprev tprev)))))))))))
(def insertAll (fix f (lam ranks (lam smalls (lam chain (case ranks (Nil () chain) (Cons (i r) (case (app nth i smalls) (None () (app f r smalls chain)) (Some (s) (app f r smalls (app insertB s i chain)))))))))))
(def one (ctr Suc (ctr Zer)))
(def three (ctr Suc (ctr Suc (ctr Suc (ctr Zer)))))
(def fj (fix f (lam toks (case toks (Nil () (ctr Nil)) (Cons (t r) (case r (Nil () (ctr Cons (case t (Tok (v p) (ctr Elt v p (ctr Ins)))) (ctr Nil))) (Cons (t2 r2) (case (app pairs toks) (Pair (ps odd) (case (app unwrap one (app f (app wrap ps))) (Pair (chain smalls) (case (case odd (None () smalls) (Some (o) (app cat smalls (ctr Cons o (ctr Nil))))) (Cons (b1 rest) (app insertAll (app sched (app len (ctr Cons b1 rest)) one three) (ctr Cons b1 rest) (ctr Cons (case b1 (Tok (v p) (ctr Elt v p (ctr Ins)))) chain)))))))))))))))
(def toks (fix f (lam l (case l (Nil () (ctr Nil)) (Cons (h r) (ctr Cons (ctr Tok h (ctr Tt)) (app f r)))))))
(def vals (fix f (lam l (case l (Nil () (ctr Nil)) (Cons (h r) (ctr Cons (app eltv h) (app f r)))))))
(def L4 (ctr Cons 3 (ctr Cons 1 (ctr Cons 4 (ctr Cons 2 (ctr Nil))))))
(def L8 (ctr Cons 8 (ctr Cons 3 (ctr Cons 6 (ctr Cons 1 (ctr Cons 7 (ctr Cons 2 (ctr Cons 5 (ctr Cons 4 (ctr Nil))))))))))
(def L16 (ctr Cons 16 (ctr Cons 3 (ctr Cons 11 (ctr Cons 6 (ctr Cons 1 (ctr Cons 14 (ctr Cons 7 (ctr Cons 10 (ctr Cons 2 (ctr Cons 15 (ctr Cons 5 (ctr Cons 12 (ctr Cons 4 (ctr Cons 9 (ctr Cons 8 (ctr Cons 13 (ctr Nil))))))))))))))))))
(def fj4 (app fjsort L4))
(def fj8 (app fjsort L8))
(def fj16 (app fjsort L16))
(def sortedN (fix f (lam l (case l (Nil () (ctr True)) (Cons (h t) (case t (Nil () (ctr True)) (Cons (h2 t2) (case (op2 <= h h2) (True () (app f t)) (False () (ctr False))))))))))
(def fjsort : (ctr Pi (ctr List (ctr Num)) (lam l (ctr List (ctr Num)))) = (lam l (app vals (app fj (app toks l)))))
(def sortedN : (ctr Pi (ctr List (ctr Num)) (lam l (ctr Bool))) = (fix f (lam l (case l (Nil () (ctr True)) (Cons (h t) (case t (Nil () (ctr True)) (Cons (h2 t2) (case (op2 <= h h2) (True () (app f t)) (False () (ctr False))))))))))
; the declaration with no body on this chart
(def sort : (ctr Pi (ctr List (ctr Num)) (lam A (ctr Sig (ctr List (ctr Num)) (lam B (ctr Sig (ctr Eql (ctr List (ctr Num)) (app fjsort A) (app fjsort B)) (lam q (ctr Eql (ctr Bool) (app sortedN B) (ctr True)))))))))
(def sort8 (app sort L8))
