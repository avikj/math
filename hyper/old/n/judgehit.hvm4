#include "judgment.hvm4"
// the circle, Partial and systems, transp with a cofibration, Sub, and the set quotient
@idS = #SLam{#SVar{0}}
@idEquivS = #SPair{@idS, #SLam{#SPair{#SPair{#SVar{0}, #SPlm{#SVar{1}}}, #SLam{#SPlm{#SPair{#SPap{#SSnd{#SVar{1}}, #SNot{#SVar{0}}}, #SPlm{#SPap{#SSnd{#SVar{2}}, #SOr{#SNot{#SVar{1}}, #SVar{0}}}}}}}}}}
@reflS = #SLam{#SPlm{#SVar{1}}}
@R = #SLam{#SLam{#SUnit}}
@Q = #SQuo{#SBool, @R}
@QV = #Quo{#Bool, λ&a. λ&b. #Unit}
@main = #Cons{@judge(#Pair{#Set, #SCir}),                                                            // 1
        #Cons{@judge(#Pair{#Cir, #SBase}),                                                           // 1
        #Cons{@judge(#Pair{#Path{λi. #Cir, #Base, #Base}, #SLoop}),                                  // 1
        #Cons{@judge(#Pair{#Bool, #SCRec{#SBase, #STrue, #SPlm{#STrue}}}),                           // 1
        #Cons{@judge(#Pair{#Bool, #SCRec{#SPap{#SLoop, #SI1}, #STrue, #SPlm{#STrue}}}),              // 1
        #Cons{@judge(#Pair{#Bool, #SCRec{#SBase, #STrue, #SPlm{#SFalse}}}),                          // 0: l is not a loop at b
        #Cons{@judge(#Pair{#Set, #SPartial{#SI1, #SBool}}),                                          // 1
        #Cons{@judge(#Pair{#Partial{#I1, #Bool}, #SSys{#Cons{#SFace{#SI1, #STrue}, #Nil}}}),         // 1
        #Cons{@judge(#Pair{#Partial{#I1, #Bool}, #SSys{#Cons{#SFace{#SI0, #STrue}, #Nil}}}),         // 0: the branches do not cover
        #Cons{@judge(#Pair{#Bool, #SPout{#SAnn{#SSys{#Cons{#SFace{#SI1, #STrue}, #Nil}}, #SPartial{#SI1, #SBool}}}}), // 1
        #Cons{@judge(#Pair{#Bool, #STrp{#SBool, #SI1, #STrue}}),                                     // 1: a constant line
        #Cons{@judge(#Pair{#Bool, #STrp{#SPap{#SAnn{#SUa{#SBool, #SBool, @idEquivS}, #SPath{#SSet, #SBool, #SBool}}, #SVar{0}}, #SI1, #STrue}}), // 0: the line moves on φ = i1
        #Cons{@judge(#Pair{#Bool, #STrp{#SPap{#SAnn{#SUa{#SBool, #SBool, @idEquivS}, #SPath{#SSet, #SBool, #SBool}}, #SVar{0}}, #SI0, #STrue}}), // 1: φ = i0, nothing required
        #Cons{@judge(#Pair{#Pi{#Bool, λx. #Bool}, #STrp{#SPi{#SBool, #SBool}, #SI1, #SLam{#SVar{0}}}}), // 1: constant under a binder
        #Cons{@judge(#Pair{#Set, #SSub{#SBool, #SI1, #STrue}}),                                      // 1
        #Cons{@judge(#Pair{#Sub{#Bool, #I1, #T}, #SInS{#STrue}}),                                    // 1
        #Cons{@judge(#Pair{#Sub{#Bool, #I1, #T}, #SInS{#SFalse}}),                                   // 0: not u on φ
        #Cons{@judge(#Pair{#Bool, #SOutS{#SAnn{#SInS{#STrue}, #SSub{#SBool, #SI1, #STrue}}}}),       // 1
        #Cons{@judge(#Pair{#Set, @Q}),                                                               // 1
        #Cons{@judge(#Pair{@QV, #SQCl{#STrue}}),                                                     // 1
        #Cons{@judge(#Pair{#Path{λi. @QV, #QCl{#T}, #QCl{#F}}, #SQEq{#STrue, #SFalse, #STt}}),       // 1
        #Cons{@judge(#Pair{#Path{λi. @QV, #QCl{#T}, #QCl{#T}}, #SQEq{#STrue, #SFalse, #STt}}),       // 0: wrong end
        #Cons{@judge(#Pair{#Nat, #SQRec{#SAnn{#SQCl{#STrue}, @Q}, #SNat, #SLam{#SZer}, #SLam{#SLam{#SLam{#SPlm{#SZer}}}}}}), // 1
        // faces with a bound interval variable: coverage, agreement and the restriction to a cell are decided per cell
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Partial{i, #Bool}}, #SLam{#SSys{#Cons{#SFace{#SVar{0}, #STrue}, #Nil}}}}),                       // 1: on i = i1 the branch's face holds
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Partial{@ior(i, @inot(i)), #Bool}}, #SLam{#SSys{#Cons{#SFace{#SVar{0}, #STrue}, #Cons{#SFace{#SNot{#SVar{0}}, #SFalse}, #Nil}}}}}), // 1: two cells, each covered, no overlap
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Partial{@ior(i, @inot(i)), #Bool}}, #SLam{#SSys{#Cons{#SFace{#SVar{0}, #STrue}, #Nil}}}}),        // 0: the cell i = i0 is uncovered
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Sub{#Bool, i, #T}}, #SLam{#SInS{#STrue}}}),                                                   // 1
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Sub{#Bool, i, #T}}, #SLam{#SInS{#SFalse}}}),                                                  // 0: not u on the cell i = i1
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Glue{#Bool, #Cons{#GFace{i, #Bool, @idEquivV(#Bool)}, #Nil}}}, #SLam{#SGlb{#SBool, #Cons{#SFace{#SVar{0}, #STrue}, #Nil}, #STrue}}}), // 1: the section is carried to x on the cell
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Glue{#Bool, #Cons{#GFace{i, #Bool, @idEquivV(#Bool)}, #Nil}}}, #SLam{#SGlb{#SBool, #Cons{#SFace{#SVar{0}, #STrue}, #Nil}, #SFalse}}}), // 0: it is not
        // Glue formation requires adjacent faces to agree on their overlap: on i ∨ i (the same face twice) both faces must carry the same type
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Set}, #SLam{#SGlue{#SBool, #Cons{#SGFace{#SVar{0}, #SBool, @idEquivS}, #Cons{#SGFace{#SVar{0}, #SBool, @idEquivS}, #Nil}}}}}),  // 1
        #Cons{@judge(#Pair{#Pi{#Itv, λ&i. #Set}, #SLam{#SGlue{#SBool, #Cons{#SGFace{#SVar{0}, #SBool, @idEquivS}, #Cons{#SGFace{#SVar{0}, #SNat, @idEquivS}, #Nil}}}}}),   // 0: the types differ on the overlap
        #Nil}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}
