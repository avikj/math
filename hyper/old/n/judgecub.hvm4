#include "judgment.hvm4"
// the cubical formers: paths, path application, coe, ua, hcomp, Glue/glue/unglue, and a superposed cubical point
@idS = #SLam{#SVar{0}}
@reflS = #SLam{#SPlm{#SVar{1}}}
// the identity equivalence on Bool as syntax: (id, λy. ((y, <i> y), λw. <i> (snd w @ ~i, <j> snd w @ (~i ∨ j))))
@idEquivS = #SPair{@idS, #SLam{#SPair{#SPair{#SVar{0}, #SPlm{#SVar{1}}},
  #SLam{#SPlm{#SPair{#SPap{#SSnd{#SVar{1}}, #SNot{#SVar{0}}}, #SPlm{#SPap{#SSnd{#SVar{2}}, #SOr{#SNot{#SVar{1}}, #SVar{0}}}}}}}}}}
@main = #Cons{@judge(#Pair{#Path{λi. #Bool, #T, #T}, #SPlm{#STrue}}),                                  // 1
        #Cons{@judge(#Pair{#Path{λi. #Bool, #T, #F}, #SPlm{#STrue}}),                                  // 0: wrong end
        #Cons{@judge(#Pair{#Bool, #SPap{#SAnn{#SPlm{#STrue}, #SPath{#SBool, #STrue, #STrue}}, #SI1}}),  // 1
        #Cons{@judge(#Pair{#Bool, #SCoe{#SBool, #SI0, #SI1, #SFalse}}),                                // 1: a constant line
        #Cons{@judge(#Pair{#Nat, #SCoe{#SBool, #SI0, #SI1, #SFalse}}),                                 // 0: lands in Bool
        #Cons{@judge(#Pair{#Path{λi. #Set, #Bool, #Bool}, #SUa{#SBool, #SBool, @idEquivS}}), // 1
        #Cons{@judge(#Pair{#Nat, #SHcm{#SNat, #Cons{#SFace{#SI1, #SPlm{#SZer}}, #Nil}, #SZer}}),        // 1: the tube's i0 end is the base
        #Cons{@judge(#Pair{#Nat, #SHcm{#SNat, #Cons{#SFace{#SI1, #SPlm{#SSuc{#SZer}}}, #Nil}, #SZer}}), // 0: it is not
        #Cons{@judge(#Pair{#Set, #SGlue{#SBool, #Nil}}),                                                // 1
        #Cons{@judge(#Pair{#Bool, #SUnglue{#SAnn{#SGlb{#SBool, #Nil, #STrue}, #SGlue{#SBool, #Nil}}}}),  // 1
        #Cons{@judge(#Pair{#Set, #SGlue{#SBool, #Cons{#SGFace{#SI1, #SBool, #SPair{@idS, #SLam{#SPair{#SPair{#SVar{0}, #SPlm{#SVar{1}}}, #SLam{#SPlm{#SVar{1}}}}}}}, #Nil}}}), // 0: a wrong contraction
        #Cons{@judge(#Pair{#Set, #SGlue{#SBool, #Cons{#SGFace{#SI1, #SBool, @idEquivS}, #Nil}}}),           // 1: the identity equivalence, its contraction by the endpoint rule and path η
        #Cons{@judge(#Pair{#Pi{#Path{λi. #Bool, #T, #T}, λp. #Path{λi. #Bool, #T, #T}}, #SLam{#SPlm{#SPap{#SVar{1}, #SVar{0}}}}}), // 1: λp. <i> p @ i, path η
        #Cons{@judge(#Pair{#Nat, #SBif{#STrue, #SZer, #SSuc{#SZer}}}),                                   // 1
        #Cons{@judge(#Pair{#Nat, #SNatM{#SSuc{#SZer}, #SZer, #SLam{#SVar{0}}}}),                          // 1
        #Cons{@judge(#Pair{#List{#Bool}, #SCons{#STrue, #SNil}}),                                         // 1
        #Cons{@judge(#Pair{#Bool, #SListM{#SAnn{#SCons{#STrue, #SNil}, #SList{#SBool}}, #SFalse, #SLam{#SLam{#SVar{1}}}}}), // 1
        #Cons{@judge(#Pair{#Bool, #SFst{#SAnn{#SPair{#STrue, #SZer}, #SSig{#SBool, #SNat}}}}),            // 1
        #Cons{@judge(#Pair{#Bool, #SSnd{#SAnn{#SPair{#STrue, #SZer}, #SSig{#SBool, #SNat}}}}),            // 0: it is a Nat
        #Cons{%(@judge(#Pair{#Bool, &(?){#SCoe{#SBool, #SI0, #SI1, #SFalse}, #SI0}})),                  // [1, 0]
        #Nil}}}}}}}}}}}}}}}}}}}}
