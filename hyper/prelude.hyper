; hyper prelude — the right-hand sides of the Kan rules as terms of the identity chart (MAP.md §3.5).
; The dispatch (which row fires, regularity, r ≡ s, true/false faces, constructor-headed composites)
; is in cell.c; these are the rows, transcribed once from Core/WHNF.hs.  A type is a CTR cell.

(def pi-dom  (lam T (case T (Pi (A B) A))))
(def pi-cod  (lam T (case T (Pi (A B) B))))
(def sig-fst (lam T (case T (Sig (A B) A))))
(def sig-snd (lam T (case T (Sig (A B) B))))
(def path-ty (lam T (case T (Path (A a b) A))))     ; Path A a b : A is a line (plm j …), a : A i0, b : A i1
(def path-l  (lam T (case T (Path (A a b) a))))
(def path-r  (lam T (case T (Path (A a b) b))))
(def fst (lam p (case p (Pair (a b) a))))
(def snd (lam p (case p (Pair (a b) b))))
(def under (lam p (lam v (case p (Refl () v)))))     ; v under the identity p: J at a data type, the residual of a match on a stuck scrutinee
(def map-faces (lam f (lam fs (case fs (Nil () (ctr Nil)) (Cons (h t) (case h (Face (phi u) (ctr Cons (ctr Face phi (app f u)) (app map-faces f t)))))))))

; ---- transport along a line of types (whnfCoe) ----------------------------------------------
; Pi: the argument backwards, the result forwards
(def trp/Pi (lam L (lam r (lam s (lam x
  (lam y (trp (plm i (app (pi-cod (app L i)) (trp (plm j (pi-dom (app L j))) s i y)))
              r s
              (app x (trp (plm j (pi-dom (app L j))) s r y)))))))))
; Sig: components, the second along the filled first
(def trp/Sig (lam L (lam r (lam s (lam x
  (let a (fst x)
  (ctr Pair (trp (plm j (sig-fst (app L j))) r s a)
            (trp (plm i (app (sig-snd (app L i)) (trp (plm j (sig-fst (app L j))) r i a))) r s (snd x)))))))))
; Path: the hcomp-conjugation square;  at k = (~k ∧ r) ∨ (k ∧ s)
(def trp/Path (lam L (lam r (lam s (lam x
  (plm j (hcm (app (path-ty (app L s)) j)
              (trp (plm i (app (path-ty (app L i)) j)) r s (app x j))
              (ctr Cons (ctr Face (inot j) (plm k (trp (plm i (app (path-ty (app L i)) i0)) (ior (iand (inot k) r) (iand k s)) s (path-l (app L (ior (iand (inot k) r) (iand k s)))))))
              (ctr Cons (ctr Face j        (plm k (trp (plm i (app (path-ty (app L i)) i1)) (ior (iand (inot k) r) (iand k s)) s (path-r (app L (ior (iand (inot k) r) (iand k s)))))))
              (ctr Nil))))))))))
; a superposed line: face-map the value at the name, transport each face along its own line, re-superpose
(def trp/sup (lam L (lam r (lam s (lam x (lam J
  (sup J (trp (plm i (fce J 0 (app L i))) r s (fce J 0 x))
         (trp (plm i (fce J 1 (app L i))) r s (fce J 1 x)))))))))

; ---- derived: the filler and heterogeneous composition (neither is primitive) ------------------
(def hfill (lam A (lam base (lam faces (lam j
  (hcm A base (ctr Cons (ctr Face (inot j) (plm k base))
                        (app map-faces (lam u (plm k (app u (iand k j)))) faces))))))))
(def comp (lam P (lam base (lam faces
  (hcm (app P i1) (trp P i0 i1 base)
       (app map-faces (lam u (plm k (trp (plm i (app P (ior i k))) k i1 (app u k)))) faces))))))

; ---- hcomp within a type (whnfHCm) ---------------------------------------------------------
(def hcm/Pi (lam A (lam base (lam faces
  (lam v (hcm (app (pi-cod A) v) (app base v) (app map-faces (lam u (plm j (app (app u j) v))) faces)))))))
(def hcm/Path (lam A (lam base (lam faces
  (plm j (hcm (app (path-ty A) j) (app base j)
              (ctr Cons (ctr Face (inot j) (plm k (path-l A)))
              (ctr Cons (ctr Face j        (plm k (path-r A)))
              (app map-faces (lam u (plm k (app (app u k) j))) faces)))))))))
(def hcm/Sig (lam A (lam base (lam faces
  (let fsA (app map-faces (lam u (plm j (fst (app u j)))) faces)
  (let fsB (app map-faces (lam u (plm j (snd (app u j)))) faces)
  (let x0 (fst base)
  (ctr Pair (hcm (sig-fst A) x0 fsA)
            (comp (plm j (app (sig-snd A) (hfill (sig-fst A) x0 fsA j))) (snd base) fsB)))))))))
; a superposed type: commute
(def hcm/sup (lam A (lam base (lam faces (lam J
  (sup J (hcm (fce J 0 A) (fce J 0 base) (fce J 0 faces))
         (hcm (fce J 1 A) (fce J 1 base) (fce J 1 faces))))))))

; project field i (a number literal) of a constructor-headed tube: used by the constructor-headed hcomp rule
(def tube-field (lam i (lam u (plm k (proj i (app u k))))))

; ---- equivalences as cells (the corpus's coherent form) --------------------------------------
;   Equiv A B = Pair f (lam y (Pair (Pair x p) contr))   : f, and for each y the centre (x, p : Path (f x) y) and the contraction
(def equiv-fun (lam e (proj 0 e)))
(def equiv-inv (lam e (lam y (proj 0 (proj 0 (app (proj 1 e) y))))))          ; the centre's point
(def equiv-sec (lam e (lam y (proj 1 (proj 0 (app (proj 1 e) y))))))          ; the centre's path  f (inv y) ≡ y
(def isContrSingl (lam A (lam y (ctr Pair (ctr Pair y (plm _ y))
                                          (lam w (case w (Pair (x p) (plm i (ctr Pair (app p (inot i)) (plm j (app p (ior (inot i) j))))))))))))
(def idequiv (lam A (ctr Pair (lam x x) (lam y (isContrSingl A y)))))

; ---- Glue (GLUE.md): the type former for univalence ------------------------------------------
;   (Glue A faces) with faces a list of (ctr GFace phi T e), e : Equiv T A
(def gface-phi (lam g (case g (GFace (phi T e) phi))))
(def gface-T   (lam g (case g (GFace (phi T e) T))))
(def gface-e   (lam g (case g (GFace (phi T e) e))))
(def map-gfaces (lam f (lam fs (case fs (Nil () (ctr Nil)) (Cons (h t) (ctr Cons (app f h) (map-gfaces f t)))))))
; ua e : Path Set A B  =  <i> Glue B [(~i, A, e), (i, B, idEquiv B)]
(def ua (lam A (lam B (lam e (plm i (Glue B (ctr Cons (ctr GFace (inot i) A e)
                                            (ctr Cons (ctr GFace i B (idequiv B)) (ctr Nil)))))))))
; transport along a Glue line (whnfCoe, Glu case).  The line's cells at r and s are Glue types.
;   a_r  := unglue_r x     (a true face at r selects e's function; no face: x; else unglue x)
;   a1'  := trp base-line r s a_r
;   t1   := inv e a1'  on each face live at s;  a1 := hcomp (A s) [ψ ↦ <j> (sec e t1) @ ~j] a1'
;   result glue [ψ ↦ t1] a1
(def trp/Glue (lam L (lam r (lam s (lam x (lam T (lam k
  ; T is the Glue cell of the line at the generic dimension k. Its faces and base are read HERE, where
  ; every face is symbolic, and the interval is substituted into the parts (whnfCoe: substMarker into the
  ; normalised body): a Glue with a true face IS its partial type, so substituting into the Glue itself
  ; would lose the faces the transport needs.
  (let fsK (glue-faces T)
  (let AK (glue-base T)
  (let aR (unglue-sel (map-gfaces (lam g (isub k r g)) fsK) x (ctr False))
  (let a1p (trp (plm i (isub k i AK)) r s aR)
  (let fsS (map-gfaces (lam g (isub k s g)) fsK)
  (let a1 (hcm (isub k s AK) a1p
               (map-gfaces (lam g (ctr Face (gface-phi g) (plm j (app (equiv-sec (gface-e g) (equiv-inv (gface-e g) a1p)) (inot j))))) fsS))
  (glue (map-gfaces (lam g (ctr Face (gface-phi g) (equiv-inv (gface-e g) a1p))) fsS) a1))))))))))))))
(def unglue-at (lam G (lam x (glue-unglue G x))))
; a non-Glue type is read as a Glue with itself as base and no faces (glueAt)
(def glue-A     (lam G (glue-base G)))
(def glue-faces (lam G (glue-fs G)))
; unglue at a cell of the line (whnfCoe aR0): a true face means the cell IS T and a point of it is sent by e's
; function; no live face means the cell IS A and the point is itself; a live symbolic face means unglue.
(def glue-unglue (lam G (lam x (unglue-sel (glue-faces G) x (ctr False)))))
(def unglue-sel (lam fs (lam x (lam live (case fs
   (Nil () (case live (True () (unglue x)) (False () x)))
   (Cons (g rest) (face-case (gface-phi g)
                             (app (equiv-fun (gface-e g)) x)
                             (unglue-sel rest x live)
                             (unglue-sel rest x (ctr True)))))))))
; ---- the universe: hcomp in Set is a Glue type (whnfHCm, Set case) --------------------------
;   fibre, contractibility and equivalence as type cells (the corpus's coherent Equiv)
(def fiber-ty   (lam A (lam B (lam f (lam y (ctr Sig A (lam x (ctr Path (plm _ B) (app f x) y))))))))
(def isContr-ty (lam X (ctr Sig X (lam c (ctr Pi X (lam x (ctr Path (plm _ X) c x)))))))
(def Equiv-ty   (lam A (lam B (ctr Sig (ctr Pi A (lam _ B)) (lam f (ctr Pi B (lam y (isContr-ty (fiber-ty A B f y)))))))))
;   pathToEquiv of the reversed tube: the identity equivalence transported along k ↦ Equiv (u@1) (u@~k)
(def transpEquiv (lam u (trp (plm k (Equiv-ty (app u i1) (app u (inot k)))) i0 i1 (idequiv (app u i1)))))
(def face-to-gface (lam f (case f (Face (phi u) (ctr GFace phi (app u i1) (transpEquiv u))))))
(def hcm/Set (lam A (lam base (lam faces (Glue base (map-gfaces face-to-gface faces))))))

; ---- higher inductive types (whnfHEl, whnfCoe HTy case): the schema, with nothing per HIT ----------
;   helim of a composite in the HIT is comp along the motive over the filler
(def helim/hcm (lam P (lam elim (lam T (lam fs (lam base
  (comp (lam j (app P (hfill T base fs j)))
        (app elim base)
        (app map-faces (lam u (plm j (app elim (app u j)))) fs))))))))
;   transport commutes with a composite of the HIT
(def trp/hcm (lam L (lam r (lam s (lam fs (lam base
  (hcm (app L s) (trp L r s base) (app map-faces (lam u (plm j (trp L r s (app u j)))) fs))))))))
;   transport along a HIT line whose parameters move: each field along its own dependent type line
(def apps (lam f (lam xs (case xs (Nil () f) (Cons (x rest) (apps (app f x) rest))))))
(def map  (lam f (lam xs (case xs (Nil () (ctr Nil)) (Cons (x rest) (ctr Cons (app f x) (map f rest)))))))
(def append (lam xs (lam ys (case xs (Nil () ys) (Cons (x rest) (ctr Cons x (append rest ys)))))))
(def snoc (lam xs (lam y (case xs (Nil () (ctr Cons y (ctr Nil))) (Cons (x rest) (ctr Cons x (snoc rest y)))))))
(def inst-pis (lam T (lam xs (case xs (Nil () T) (Cons (x rest) (inst-pis (app (pi-cod T) x) rest))))))
(def hit-field-ty (lam T (lam prev (pi-dom (inst-pis T prev)))))
(def trp/hit (lam L (lam r (lam s (lam cty (lam fields (trp/hit-go L r s cty fields (ctr Nil))))))))
(def trp/hit-go (lam L (lam r (lam s (lam cty (lam fields (lam done
  (case fields
    (Nil () (ctr Nil))
    (Cons (a rest)
      (let ln (plm i (hit-field-ty (inst-pis cty (ctr-fields (app L i))) (map (lam d (app d i)) done)))
      (let a1 (lam i (trp ln r i a))
      (ctr Cons (app a1 s) (trp/hit-go L r s cty rest (snoc done a1))))))))))))))

; ---- §7: coordinates are η-long at their types; the eliminator's branch types (checkBranches) ----
(def konst (lam b (lam _ b)))
(def eta-pi (lam f (lam B (lam y (reflect (app f y) (app B y))))))
(def eta-path (lam p (lam L (lam a (lam b (plm i (reflect (pap p i a b) (app L i))))))))
(def eline (lam P (lam elim (lam L (lam u (lam i (etype P elim (app L i) (app u i))))))))
(def eterm-line (lam elim (lam L (lam u (plm j (eterm elim (app L j) (app u j)))))))
